diff --git a/database/migrations/0076__user_groups_permissions.sql b/database/migrations/0076__user_groups_permissions.sql
new file mode 100644
index 0000000..792e9a5
--- /dev/null
+++ b/database/migrations/0076__user_groups_permissions.sql
@@ -0,0 +1,431 @@
+/*
+================================================================================
+KAZUKO ERP JEWELRY - DATABASE MIGRATION SCRIPT
+================================================================================
+Migration Version: 76
+Migration Name:    USER_GROUPS_PERMISSIONS
+Description:       Nguoi dung va phan quyen theo NHOM (doc lap voi he thong
+                   USERS/ROLES/PERMISSIONS cu o base schema - KHONG dung toi):
+                   - Bang USER_GROUPS: nhom nguoi dung (CODE unique theo cong ty).
+                   - Bang GROUP_PERMISSIONS: ma tran quyen theo nhom cho 28 chuc
+                     nang he thong (FUNCTION_CODE dang SALES_RETAIL...):
+                     Xem/Them/Sua/Xoa + Bi khoa.
+                   - USERS: them GROUP_ID (FK USER_GROUPS) va WAREHOUSE_ID
+                     (FK LOCATIONS neu bang ton tai - kho mac dinh cua user).
+                   - Seed 2 nhom: ADMIN ("Quan tri", full 28 quyen) va CASHIER
+                     ("Thu ngan", quyen han che).
+Target Database:   Firebird 5.0 (Dialect 3, UTF8)
+================================================================================
+Rollback (dev):
+  ALTER TABLE USERS DROP CONSTRAINT FK_USERS_USER_GROUP;
+  ALTER TABLE USERS DROP CONSTRAINT FK_USERS_WAREHOUSE;
+  ALTER TABLE USERS DROP CONSTRAINT FK_USERS_EMPLOYEE;
+  ALTER TABLE USERS DROP GROUP_ID;
+  ALTER TABLE USERS DROP WAREHOUSE_ID;
+  (Chi DROP EMPLOYEE_ID/NOTES neu do migration 76 them - kiem tra base schema truoc.)
+  DELETE FROM GROUP_PERMISSIONS;
+  DELETE FROM USER_GROUPS;
+  DROP TABLE GROUP_PERMISSIONS;
+  DROP TABLE USER_GROUPS;
+  DELETE FROM SCHEMA_MIGRATIONS WHERE VERSION_NO = 76;
+================================================================================
+*/
+
+SET AUTODDL OFF;
+
+CREATE EXCEPTION EX_MIGRATION_CHECK 'Migration 76 validation failed';
+
+SET TERM ^ ;
+EXECUTE BLOCK AS
+DECLARE VARIABLE v_cnt INTEGER;
+BEGIN
+    SELECT COUNT(*) FROM SCHEMA_MIGRATIONS WHERE VERSION_NO = 76 INTO :v_cnt;
+    IF (:v_cnt > 0) THEN
+        EXCEPTION EX_MIGRATION_CHECK 'Phien ban migration 76 da ton tai.';
+
+    SELECT COUNT(*) FROM SCHEMA_MIGRATIONS WHERE VERSION_NO = 75 INTO :v_cnt;
+    IF (:v_cnt <> 1) THEN
+        EXCEPTION EX_MIGRATION_CHECK 'Can migration 75 truoc migration 76.';
+
+    SELECT COUNT(*) FROM RDB$RELATIONS
+    WHERE RDB$RELATION_NAME = 'USER_GROUPS'
+    INTO :v_cnt;
+    IF (:v_cnt > 0) THEN
+        EXCEPTION EX_MIGRATION_CHECK 'Bang USER_GROUPS da ton tai.';
+
+    SELECT COUNT(*) FROM RDB$RELATIONS
+    WHERE RDB$RELATION_NAME = 'GROUP_PERMISSIONS'
+    INTO :v_cnt;
+    IF (:v_cnt > 0) THEN
+        EXCEPTION EX_MIGRATION_CHECK 'Bang GROUP_PERMISSIONS da ton tai.';
+
+    SELECT COUNT(*) FROM RDB$RELATIONS
+    WHERE RDB$RELATION_NAME = 'USERS'
+    INTO :v_cnt;
+    IF (:v_cnt <> 1) THEN
+        EXCEPTION EX_MIGRATION_CHECK 'Thieu bang USERS (base schema).';
+
+    SELECT COUNT(*) FROM RDB$RELATION_FIELDS
+    WHERE RDB$RELATION_NAME = 'USERS'
+      AND RDB$FIELD_NAME IN ('GROUP_ID', 'WAREHOUSE_ID')
+    INTO :v_cnt;
+    IF (:v_cnt > 0) THEN
+        EXCEPTION EX_MIGRATION_CHECK 'Cot GROUP_ID/WAREHOUSE_ID da ton tai tren USERS.';
+END^
+SET TERM ; ^
+
+/* ---------------------------------------------------------------------------
+   1. Bang nhom nguoi dung
+--------------------------------------------------------------------------- */
+CREATE TABLE USER_GROUPS (
+    ID BIGINT GENERATED BY DEFAULT AS IDENTITY NOT NULL,
+    COMPANY_ID BIGINT NOT NULL,
+    CODE VARCHAR(30) CHARACTER SET ASCII NOT NULL,
+    NAME VARCHAR(150) NOT NULL,
+    ICON VARCHAR(60),
+    DESCRIPTION VARCHAR(500),
+    IS_ACTIVE BOOLEAN DEFAULT TRUE NOT NULL,
+    DISPLAY_ORDER INTEGER DEFAULT 0 NOT NULL,
+    CREATED_BY BIGINT,
+    CREATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,
+    UPDATED_BY BIGINT,
+    UPDATED_AT TIMESTAMP,
+    CONSTRAINT PK_USER_GROUPS PRIMARY KEY (ID),
+    CONSTRAINT FK_USER_GROUPS_COMPANY FOREIGN KEY (COMPANY_ID) REFERENCES COMPANIES (ID),
+    CONSTRAINT UQ_USER_GROUPS_CODE UNIQUE (COMPANY_ID, CODE),
+    CONSTRAINT UQ_USER_GROUPS_COMP_ID UNIQUE (COMPANY_ID, ID),
+    CONSTRAINT FK_USER_GROUPS_CREATE_USER FOREIGN KEY (CREATED_BY) REFERENCES USERS (ID),
+    CONSTRAINT FK_USER_GROUPS_UPDATE_USER FOREIGN KEY (UPDATED_BY) REFERENCES USERS (ID)
+);
+
+CREATE INDEX IX_USER_GROUPS_ACTIVE ON USER_GROUPS (COMPANY_ID, IS_ACTIVE, DISPLAY_ORDER);
+
+/* ---------------------------------------------------------------------------
+   2. Ma tran quyen theo nhom: 1 dong = 1 chuc nang cua 1 nhom
+--------------------------------------------------------------------------- */
+CREATE TABLE GROUP_PERMISSIONS (
+    ID BIGINT GENERATED BY DEFAULT AS IDENTITY NOT NULL,
+    COMPANY_ID BIGINT NOT NULL,
+    GROUP_ID BIGINT NOT NULL,
+    FUNCTION_CODE VARCHAR(60) CHARACTER SET ASCII NOT NULL,
+    CAN_VIEW BOOLEAN DEFAULT FALSE NOT NULL,
+    CAN_ADD BOOLEAN DEFAULT FALSE NOT NULL,
+    CAN_EDIT BOOLEAN DEFAULT FALSE NOT NULL,
+    CAN_DELETE BOOLEAN DEFAULT FALSE NOT NULL,
+    IS_LOCKED BOOLEAN DEFAULT FALSE NOT NULL,
+    CREATED_BY BIGINT,
+    CREATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,
+    UPDATED_BY BIGINT,
+    UPDATED_AT TIMESTAMP,
+    CONSTRAINT PK_GROUP_PERMISSIONS PRIMARY KEY (ID),
+    CONSTRAINT FK_GROUP_PERMS_COMPANY FOREIGN KEY (COMPANY_ID) REFERENCES COMPANIES (ID),
+    CONSTRAINT FK_GROUP_PERMS_GROUP FOREIGN KEY (GROUP_ID) REFERENCES USER_GROUPS (ID),
+    CONSTRAINT UQ_GROUP_PERMS_FUNC UNIQUE (GROUP_ID, FUNCTION_CODE),
+    CONSTRAINT FK_GROUP_PERMS_CREATE_USER FOREIGN KEY (CREATED_BY) REFERENCES USERS (ID),
+    CONSTRAINT FK_GROUP_PERMS_UPDATE_USER FOREIGN KEY (UPDATED_BY) REFERENCES USERS (ID)
+);
+
+CREATE INDEX IX_GROUP_PERMS_GROUP ON GROUP_PERMISSIONS (COMPANY_ID, GROUP_ID);
+
+/* ---------------------------------------------------------------------------
+   3. USERS: them GROUP_ID + WAREHOUSE_ID
+      (Luu y: EMPLOYEE_ID / NOTES co the da ton tai o base schema nen chi them
+      khi chua co - kiem tra RDB$RELATION_FIELDS truoc.)
+--------------------------------------------------------------------------- */
+ALTER TABLE USERS ADD GROUP_ID BIGINT;
+
+ALTER TABLE USERS ADD CONSTRAINT FK_USERS_USER_GROUP
+    FOREIGN KEY (GROUP_ID) REFERENCES USER_GROUPS (ID);
+
+ALTER TABLE USERS ADD WAREHOUSE_ID BIGINT;
+
+SET TERM ^ ;
+EXECUTE BLOCK AS
+DECLARE VARIABLE v_cnt INTEGER;
+BEGIN
+    /* FK toi LOCATIONS chi tao khi bang ton tai (base schema). */
+    SELECT COUNT(*) FROM RDB$RELATIONS
+    WHERE RDB$RELATION_NAME = 'LOCATIONS'
+    INTO :v_cnt;
+    IF (:v_cnt = 1) THEN
+        EXECUTE STATEMENT 'ALTER TABLE USERS ADD CONSTRAINT FK_USERS_WAREHOUSE '
+            || 'FOREIGN KEY (WAREHOUSE_ID) REFERENCES LOCATIONS (ID)';
+
+    /* Lien ket nhan vien: them neu base schema chua co. */
+    SELECT COUNT(*) FROM RDB$RELATION_FIELDS
+    WHERE RDB$RELATION_NAME = 'USERS' AND RDB$FIELD_NAME = 'EMPLOYEE_ID'
+    INTO :v_cnt;
+    IF (:v_cnt = 0) THEN
+    BEGIN
+        EXECUTE STATEMENT 'ALTER TABLE USERS ADD EMPLOYEE_ID BIGINT';
+        EXECUTE STATEMENT 'ALTER TABLE USERS ADD CONSTRAINT FK_USERS_EMPLOYEE '
+            || 'FOREIGN KEY (EMPLOYEE_ID) REFERENCES HR_EMPLOYEES (ID)';
+    END
+
+    /* Ghi chu: them neu base schema chua co. */
+    SELECT COUNT(*) FROM RDB$RELATION_FIELDS
+    WHERE RDB$RELATION_NAME = 'USERS' AND RDB$FIELD_NAME = 'NOTES'
+    INTO :v_cnt;
+    IF (:v_cnt = 0) THEN
+        EXECUTE STATEMENT 'ALTER TABLE USERS ADD NOTES VARCHAR(500)';
+END^
+SET TERM ; ^
+
+/* ---------------------------------------------------------------------------
+   4. Seed nhom nguoi dung
+--------------------------------------------------------------------------- */
+SET TERM ^ ;
+EXECUTE BLOCK AS
+DECLARE VARIABLE v_cid BIGINT;
+BEGIN
+    SELECT ID FROM COMPANIES WHERE CODE = 'KAZUKO' INTO :v_cid;
+    IF (:v_cid IS NULL) THEN
+        EXCEPTION EX_MIGRATION_CHECK 'Khong tim thay COMPANIES.KAZUKO.';
+
+    IF (NOT EXISTS (SELECT 1 FROM USER_GROUPS WHERE COMPANY_ID = :v_cid AND CODE = 'ADMIN')) THEN
+        INSERT INTO USER_GROUPS
+            (COMPANY_ID, CODE, NAME, ICON, DESCRIPTION, IS_ACTIVE, DISPLAY_ORDER)
+        VALUES
+            (:v_cid, 'ADMIN', 'Quản trị', 'Shield',
+             'Nhóm quản trị hệ thống: toàn quyền 28 chức năng.',
+             TRUE, 1);
+
+    IF (NOT EXISTS (SELECT 1 FROM USER_GROUPS WHERE COMPANY_ID = :v_cid AND CODE = 'CASHIER')) THEN
+        INSERT INTO USER_GROUPS
+            (COMPANY_ID, CODE, NAME, ICON, DESCRIPTION, IS_ACTIVE, DISPLAY_ORDER)
+        VALUES
+            (:v_cid, 'CASHIER', 'Thu ngân', 'Cash',
+             'Nhóm thu ngân: bán lẻ, phiếu thu, xem kho/báo cáo.',
+             TRUE, 2);
+END^
+SET TERM ; ^
+
+/* ---------------------------------------------------------------------------
+   5. Seed ma tran quyen: ADMIN full 28 chuc nang
+--------------------------------------------------------------------------- */
+SET TERM ^ ;
+EXECUTE BLOCK AS
+DECLARE VARIABLE v_cid BIGINT;
+DECLARE VARIABLE v_gid BIGINT;
+DECLARE VARIABLE v_code VARCHAR(60);
+BEGIN
+    SELECT ID FROM COMPANIES WHERE CODE = 'KAZUKO' INTO :v_cid;
+    IF (:v_cid IS NULL) THEN
+        EXCEPTION EX_MIGRATION_CHECK 'Khong tim thay COMPANIES.KAZUKO.';
+
+    SELECT ID FROM USER_GROUPS WHERE COMPANY_ID = :v_cid AND CODE = 'ADMIN' INTO :v_gid;
+    IF (:v_gid IS NULL) THEN
+        EXCEPTION EX_MIGRATION_CHECK 'Khong seed duoc nhom ADMIN.';
+
+    FOR SELECT C FROM (
+        SELECT 'SALES_RETAIL'        AS C FROM RDB$DATABASE UNION ALL
+        SELECT 'SALES_WHOLESALE'         FROM RDB$DATABASE UNION ALL
+        SELECT 'CRAFT_ORDER'             FROM RDB$DATABASE UNION ALL
+        SELECT 'OLD_GOLD_PURCHASE'       FROM RDB$DATABASE UNION ALL
+        SELECT 'INV_MATERIAL_RECEIPT'    FROM RDB$DATABASE UNION ALL
+        SELECT 'INV_FINISHED_RECEIPT'    FROM RDB$DATABASE UNION ALL
+        SELECT 'INV_TRANSFER'            FROM RDB$DATABASE UNION ALL
+        SELECT 'INV_STOCKTAKE'           FROM RDB$DATABASE UNION ALL
+        SELECT 'PROD_ORDER'              FROM RDB$DATABASE UNION ALL
+        SELECT 'PROD_MATERIAL_ISSUE'     FROM RDB$DATABASE UNION ALL
+        SELECT 'PROD_GOLD_RECONCILE'     FROM RDB$DATABASE UNION ALL
+        SELECT 'DEBT_CUSTOMER'           FROM RDB$DATABASE UNION ALL
+        SELECT 'DEBT_WORKER_GOLD'        FROM RDB$DATABASE UNION ALL
+        SELECT 'DEBT_SETTLEMENT'         FROM RDB$DATABASE UNION ALL
+        SELECT 'FIN_CASH_IN'             FROM RDB$DATABASE UNION ALL
+        SELECT 'FIN_CASH_OUT'            FROM RDB$DATABASE UNION ALL
+        SELECT 'FIN_FUND'                FROM RDB$DATABASE UNION ALL
+        SELECT 'CAT_CUSTOMERS'           FROM RDB$DATABASE UNION ALL
+        SELECT 'CAT_SUPPLIERS'           FROM RDB$DATABASE UNION ALL
+        SELECT 'CAT_EMPLOYEES'           FROM RDB$DATABASE UNION ALL
+        SELECT 'CAT_EXTERNAL_WORKERS'    FROM RDB$DATABASE UNION ALL
+        SELECT 'CAT_GOLD_PRICE'          FROM RDB$DATABASE UNION ALL
+        SELECT 'REP_VIEW'                FROM RDB$DATABASE UNION ALL
+        SELECT 'REP_EXPORT'              FROM RDB$DATABASE UNION ALL
+        SELECT 'SYS_USER_MANAGEMENT'     FROM RDB$DATABASE UNION ALL
+        SELECT 'SYS_SETTINGS'            FROM RDB$DATABASE UNION ALL
+        SELECT 'SYS_DATABASE'           FROM RDB$DATABASE UNION ALL
+        SELECT 'SYS_DATA_DELETE'         FROM RDB$DATABASE
+    ) INTO :v_code DO
+    BEGIN
+        IF (NOT EXISTS (
+                SELECT 1 FROM GROUP_PERMISSIONS
+                WHERE GROUP_ID = :v_gid AND FUNCTION_CODE = :v_code)) THEN
+            INSERT INTO GROUP_PERMISSIONS
+                (COMPANY_ID, GROUP_ID, FUNCTION_CODE,
+                 CAN_VIEW, CAN_ADD, CAN_EDIT, CAN_DELETE, IS_LOCKED)
+            VALUES
+                (:v_cid, :v_gid, :v_code, TRUE, TRUE, TRUE, TRUE, FALSE);
+    END
+END^
+SET TERM ; ^
+
+/* ---------------------------------------------------------------------------
+   6. Seed ma tran quyen: CASHIER (han che)
+--------------------------------------------------------------------------- */
+SET TERM ^ ;
+EXECUTE BLOCK AS
+DECLARE VARIABLE v_cid BIGINT;
+DECLARE VARIABLE v_gid BIGINT;
+BEGIN
+    SELECT ID FROM COMPANIES WHERE CODE = 'KAZUKO' INTO :v_cid;
+    IF (:v_cid IS NULL) THEN
+        EXCEPTION EX_MIGRATION_CHECK 'Khong tim thay COMPANIES.KAZUKO.';
+
+    SELECT ID FROM USER_GROUPS WHERE COMPANY_ID = :v_cid AND CODE = 'CASHIER' INTO :v_gid;
+    IF (:v_gid IS NULL) THEN
+        EXCEPTION EX_MIGRATION_CHECK 'Khong seed duoc nhom CASHIER.';
+
+    /* Ban hang: ban le xem/them/sua; ban si + don che tac + mua vang cu xem hoac them/sua */
+    INSERT INTO GROUP_PERMISSIONS (COMPANY_ID, GROUP_ID, FUNCTION_CODE, CAN_VIEW, CAN_ADD, CAN_EDIT, CAN_DELETE, IS_LOCKED)
+    SELECT :v_cid, :v_gid, 'SALES_RETAIL', TRUE, TRUE, TRUE, FALSE, FALSE FROM RDB$DATABASE
+    WHERE NOT EXISTS (SELECT 1 FROM GROUP_PERMISSIONS WHERE GROUP_ID = :v_gid AND FUNCTION_CODE = 'SALES_RETAIL');
+
+    INSERT INTO GROUP_PERMISSIONS (COMPANY_ID, GROUP_ID, FUNCTION_CODE, CAN_VIEW, CAN_ADD, CAN_EDIT, CAN_DELETE, IS_LOCKED)
+    SELECT :v_cid, :v_gid, 'SALES_WHOLESALE', TRUE, FALSE, FALSE, FALSE, FALSE FROM RDB$DATABASE
+    WHERE NOT EXISTS (SELECT 1 FROM GROUP_PERMISSIONS WHERE GROUP_ID = :v_gid AND FUNCTION_CODE = 'SALES_WHOLESALE');
+
+    INSERT INTO GROUP_PERMISSIONS (COMPANY_ID, GROUP_ID, FUNCTION_CODE, CAN_VIEW, CAN_ADD, CAN_EDIT, CAN_DELETE, IS_LOCKED)
+    SELECT :v_cid, :v_gid, 'CRAFT_ORDER', TRUE, FALSE, FALSE, FALSE, FALSE FROM RDB$DATABASE
+    WHERE NOT EXISTS (SELECT 1 FROM GROUP_PERMISSIONS WHERE GROUP_ID = :v_gid AND FUNCTION_CODE = 'CRAFT_ORDER');
+
+    INSERT INTO GROUP_PERMISSIONS (COMPANY_ID, GROUP_ID, FUNCTION_CODE, CAN_VIEW, CAN_ADD, CAN_EDIT, CAN_DELETE, IS_LOCKED)
+    SELECT :v_cid, :v_gid, 'OLD_GOLD_PURCHASE', TRUE, TRUE, TRUE, FALSE, FALSE FROM RDB$DATABASE
+    WHERE NOT EXISTS (SELECT 1 FROM GROUP_PERMISSIONS WHERE GROUP_ID = :v_gid AND FUNCTION_CODE = 'OLD_GOLD_PURCHASE');
+
+    /* Kho: xem nhap kho NVL/thanh pham; xuat-dieu chuyen + kiem ke khong quyen */
+    INSERT INTO GROUP_PERMISSIONS (COMPANY_ID, GROUP_ID, FUNCTION_CODE, CAN_VIEW, CAN_ADD, CAN_EDIT, CAN_DELETE, IS_LOCKED)
+    SELECT :v_cid, :v_gid, 'INV_MATERIAL_RECEIPT', TRUE, FALSE, FALSE, FALSE, FALSE FROM RDB$DATABASE
+    WHERE NOT EXISTS (SELECT 1 FROM GROUP_PERMISSIONS WHERE GROUP_ID = :v_gid AND FUNCTION_CODE = 'INV_MATERIAL_RECEIPT');
+
+    INSERT INTO GROUP_PERMISSIONS (COMPANY_ID, GROUP_ID, FUNCTION_CODE, CAN_VIEW, CAN_ADD, CAN_EDIT, CAN_DELETE, IS_LOCKED)
+    SELECT :v_cid, :v_gid, 'INV_FINISHED_RECEIPT', TRUE, FALSE, FALSE, FALSE, FALSE FROM RDB$DATABASE
+    WHERE NOT EXISTS (SELECT 1 FROM GROUP_PERMISSIONS WHERE GROUP_ID = :v_gid AND FUNCTION_CODE = 'INV_FINISHED_RECEIPT');
+
+    /* San xuat / Cong no: xem */
+    INSERT INTO GROUP_PERMISSIONS (COMPANY_ID, GROUP_ID, FUNCTION_CODE, CAN_VIEW, CAN_ADD, CAN_EDIT, CAN_DELETE, IS_LOCKED)
+    SELECT :v_cid, :v_gid, 'PROD_ORDER', TRUE, FALSE, FALSE, FALSE, FALSE FROM RDB$DATABASE
+    WHERE NOT EXISTS (SELECT 1 FROM GROUP_PERMISSIONS WHERE GROUP_ID = :v_gid AND FUNCTION_CODE = 'PROD_ORDER');
+
+    INSERT INTO GROUP_PERMISSIONS (COMPANY_ID, GROUP_ID, FUNCTION_CODE, CAN_VIEW, CAN_ADD, CAN_EDIT, CAN_DELETE, IS_LOCKED)
+    SELECT :v_cid, :v_gid, 'PROD_MATERIAL_ISSUE', TRUE, FALSE, FALSE, FALSE, FALSE FROM RDB$DATABASE
+    WHERE NOT EXISTS (SELECT 1 FROM GROUP_PERMISSIONS WHERE GROUP_ID = :v_gid AND FUNCTION_CODE = 'PROD_MATERIAL_ISSUE');
+
+    INSERT INTO GROUP_PERMISSIONS (COMPANY_ID, GROUP_ID, FUNCTION_CODE, CAN_VIEW, CAN_ADD, CAN_EDIT, CAN_DELETE, IS_LOCKED)
+    SELECT :v_cid, :v_gid, 'PROD_GOLD_RECONCILE', TRUE, FALSE, FALSE, FALSE, FALSE FROM RDB$DATABASE
+    WHERE NOT EXISTS (SELECT 1 FROM GROUP_PERMISSIONS WHERE GROUP_ID = :v_gid AND FUNCTION_CODE = 'PROD_GOLD_RECONCILE');
+
+    INSERT INTO GROUP_PERMISSIONS (COMPANY_ID, GROUP_ID, FUNCTION_CODE, CAN_VIEW, CAN_ADD, CAN_EDIT, CAN_DELETE, IS_LOCKED)
+    SELECT :v_cid, :v_gid, 'DEBT_CUSTOMER', TRUE, FALSE, FALSE, FALSE, FALSE FROM RDB$DATABASE
+    WHERE NOT EXISTS (SELECT 1 FROM GROUP_PERMISSIONS WHERE GROUP_ID = :v_gid AND FUNCTION_CODE = 'DEBT_CUSTOMER');
+
+    INSERT INTO GROUP_PERMISSIONS (COMPANY_ID, GROUP_ID, FUNCTION_CODE, CAN_VIEW, CAN_ADD, CAN_EDIT, CAN_DELETE, IS_LOCKED)
+    SELECT :v_cid, :v_gid, 'DEBT_WORKER_GOLD', TRUE, FALSE, FALSE, FALSE, FALSE FROM RDB$DATABASE
+    WHERE NOT EXISTS (SELECT 1 FROM GROUP_PERMISSIONS WHERE GROUP_ID = :v_gid AND FUNCTION_CODE = 'DEBT_WORKER_GOLD');
+
+    INSERT INTO GROUP_PERMISSIONS (COMPANY_ID, GROUP_ID, FUNCTION_CODE, CAN_VIEW, CAN_ADD, CAN_EDIT, CAN_DELETE, IS_LOCKED)
+    SELECT :v_cid, :v_gid, 'DEBT_SETTLEMENT', TRUE, FALSE, FALSE, FALSE, FALSE FROM RDB$DATABASE
+    WHERE NOT EXISTS (SELECT 1 FROM GROUP_PERMISSIONS WHERE GROUP_ID = :v_gid AND FUNCTION_CODE = 'DEBT_SETTLEMENT');
+
+    /* Tai chinh: phieu thu xem/them/sua; phieu chi xem/them; quy xem */
+    INSERT INTO GROUP_PERMISSIONS (COMPANY_ID, GROUP_ID, FUNCTION_CODE, CAN_VIEW, CAN_ADD, CAN_EDIT, CAN_DELETE, IS_LOCKED)
+    SELECT :v_cid, :v_gid, 'FIN_CASH_IN', TRUE, TRUE, TRUE, FALSE, FALSE FROM RDB$DATABASE
+    WHERE NOT EXISTS (SELECT 1 FROM GROUP_PERMISSIONS WHERE GROUP_ID = :v_gid AND FUNCTION_CODE = 'FIN_CASH_IN');
+
+    INSERT INTO GROUP_PERMISSIONS (COMPANY_ID, GROUP_ID, FUNCTION_CODE, CAN_VIEW, CAN_ADD, CAN_EDIT, CAN_DELETE, IS_LOCKED)
+    SELECT :v_cid, :v_gid, 'FIN_CASH_OUT', TRUE, TRUE, FALSE, FALSE, FALSE FROM RDB$DATABASE
+    WHERE NOT EXISTS (SELECT 1 FROM GROUP_PERMISSIONS WHERE GROUP_ID = :v_gid AND FUNCTION_CODE = 'FIN_CASH_OUT');
+
+    INSERT INTO GROUP_PERMISSIONS (COMPANY_ID, GROUP_ID, FUNCTION_CODE, CAN_VIEW, CAN_ADD, CAN_EDIT, CAN_DELETE, IS_LOCKED)
+    SELECT :v_cid, :v_gid, 'FIN_FUND', TRUE, FALSE, FALSE, FALSE, FALSE FROM RDB$DATABASE
+    WHERE NOT EXISTS (SELECT 1 FROM GROUP_PERMISSIONS WHERE GROUP_ID = :v_gid AND FUNCTION_CODE = 'FIN_FUND');
+
+    /* Danh muc: khach hang xem/them/sua; nhan su + tho ngoai + bang gia vang xem */
+    INSERT INTO GROUP_PERMISSIONS (COMPANY_ID, GROUP_ID, FUNCTION_CODE, CAN_VIEW, CAN_ADD, CAN_EDIT, CAN_DELETE, IS_LOCKED)
+    SELECT :v_cid, :v_gid, 'CAT_CUSTOMERS', TRUE, TRUE, TRUE, FALSE, FALSE FROM RDB$DATABASE
+    WHERE NOT EXISTS (SELECT 1 FROM GROUP_PERMISSIONS WHERE GROUP_ID = :v_gid AND FUNCTION_CODE = 'CAT_CUSTOMERS');
+
+    INSERT INTO GROUP_PERMISSIONS (COMPANY_ID, GROUP_ID, FUNCTION_CODE, CAN_VIEW, CAN_ADD, CAN_EDIT, CAN_DELETE, IS_LOCKED)
+    SELECT :v_cid, :v_gid, 'CAT_EMPLOYEES', TRUE, FALSE, FALSE, FALSE, FALSE FROM RDB$DATABASE
+    WHERE NOT EXISTS (SELECT 1 FROM GROUP_PERMISSIONS WHERE GROUP_ID = :v_gid AND FUNCTION_CODE = 'CAT_EMPLOYEES');
+
+    INSERT INTO GROUP_PERMISSIONS (COMPANY_ID, GROUP_ID, FUNCTION_CODE, CAN_VIEW, CAN_ADD, CAN_EDIT, CAN_DELETE, IS_LOCKED)
+    SELECT :v_cid, :v_gid, 'CAT_EXTERNAL_WORKERS', TRUE, FALSE, FALSE, FALSE, FALSE FROM RDB$DATABASE
+    WHERE NOT EXISTS (SELECT 1 FROM GROUP_PERMISSIONS WHERE GROUP_ID = :v_gid AND FUNCTION_CODE = 'CAT_EXTERNAL_WORKERS');
+
+    INSERT INTO GROUP_PERMISSIONS (COMPANY_ID, GROUP_ID, FUNCTION_CODE, CAN_VIEW, CAN_ADD, CAN_EDIT, CAN_DELETE, IS_LOCKED)
+    SELECT :v_cid, :v_gid, 'CAT_GOLD_PRICE', TRUE, FALSE, FALSE, FALSE, FALSE FROM RDB$DATABASE
+    WHERE NOT EXISTS (SELECT 1 FROM GROUP_PERMISSIONS WHERE GROUP_ID = :v_gid AND FUNCTION_CODE = 'CAT_GOLD_PRICE');
+
+    /* Bao cao: xem */
+    INSERT INTO GROUP_PERMISSIONS (COMPANY_ID, GROUP_ID, FUNCTION_CODE, CAN_VIEW, CAN_ADD, CAN_EDIT, CAN_DELETE, IS_LOCKED)
+    SELECT :v_cid, :v_gid, 'REP_VIEW', TRUE, FALSE, FALSE, FALSE, FALSE FROM RDB$DATABASE
+    WHERE NOT EXISTS (SELECT 1 FROM GROUP_PERMISSIONS WHERE GROUP_ID = :v_gid AND FUNCTION_CODE = 'REP_VIEW');
+END^
+SET TERM ; ^
+
+/* ---------------------------------------------------------------------------
+   7. Kiem tra sau thuc thi
+--------------------------------------------------------------------------- */
+SET TERM ^ ;
+EXECUTE BLOCK AS
+DECLARE VARIABLE v_cnt INTEGER;
+DECLARE VARIABLE v_cid BIGINT;
+DECLARE VARIABLE v_admin_gid BIGINT;
+DECLARE VARIABLE v_cashier_gid BIGINT;
+BEGIN
+    SELECT COUNT(*) FROM RDB$RELATIONS
+    WHERE RDB$RELATION_NAME IN ('USER_GROUPS', 'GROUP_PERMISSIONS')
+    INTO :v_cnt;
+    IF (:v_cnt <> 2) THEN
+        EXCEPTION EX_MIGRATION_CHECK 'Khong tao duoc bang USER_GROUPS/GROUP_PERMISSIONS.';
+
+    SELECT COUNT(*) FROM RDB$RELATION_FIELDS
+    WHERE RDB$RELATION_NAME = 'USERS'
+      AND RDB$FIELD_NAME IN ('GROUP_ID', 'WAREHOUSE_ID', 'EMPLOYEE_ID', 'NOTES')
+    INTO :v_cnt;
+    IF (:v_cnt <> 4) THEN
+        EXCEPTION EX_MIGRATION_CHECK 'Khong them duoc cot GROUP_ID/WAREHOUSE_ID/EMPLOYEE_ID/NOTES.';
+
+    SELECT COUNT(*) FROM RDB$RELATION_CONSTRAINTS
+    WHERE RDB$RELATION_NAME = 'USERS'
+      AND RDB$CONSTRAINT_NAME = 'FK_USERS_USER_GROUP'
+    INTO :v_cnt;
+    IF (:v_cnt <> 1) THEN
+        EXCEPTION EX_MIGRATION_CHECK 'Thieu FK FK_USERS_USER_GROUP.';
+
+    SELECT ID FROM COMPANIES WHERE CODE = 'KAZUKO' INTO :v_cid;
+    IF (:v_cid IS NULL) THEN
+        EXCEPTION EX_MIGRATION_CHECK 'Khong tim thay COMPANIES.KAZUKO.';
+
+    SELECT ID FROM USER_GROUPS WHERE COMPANY_ID = :v_cid AND CODE = 'ADMIN' INTO :v_admin_gid;
+    IF (:v_admin_gid IS NULL) THEN
+        EXCEPTION EX_MIGRATION_CHECK 'Khong seed duoc nhom ADMIN.';
+
+    SELECT COUNT(*) FROM GROUP_PERMISSIONS
+    WHERE GROUP_ID = :v_admin_gid
+    INTO :v_cnt;
+    IF (:v_cnt <> 28) THEN
+        EXCEPTION EX_MIGRATION_CHECK 'Nhom ADMIN phai co du 28 quyen.';
+
+    SELECT COUNT(*) FROM GROUP_PERMISSIONS
+    WHERE GROUP_ID = :v_admin_gid
+      AND CAN_VIEW = TRUE AND CAN_ADD = TRUE
+      AND CAN_EDIT = TRUE AND CAN_DELETE = TRUE
+    INTO :v_cnt;
+    IF (:v_cnt <> 28) THEN
+        EXCEPTION EX_MIGRATION_CHECK 'Nhom ADMIN phai full quyen.';
+
+    SELECT ID FROM USER_GROUPS WHERE COMPANY_ID = :v_cid AND CODE = 'CASHIER' INTO :v_cashier_gid;
+    IF (:v_cashier_gid IS NULL) THEN
+        EXCEPTION EX_MIGRATION_CHECK 'Khong seed duoc nhom CASHIER.';
+
+    SELECT COUNT(*) FROM GROUP_PERMISSIONS
+    WHERE GROUP_ID = :v_cashier_gid
+    INTO :v_cnt;
+    IF (:v_cnt <> 20) THEN
+        EXCEPTION EX_MIGRATION_CHECK 'Nhom CASHIER phai co 20 dong quyen.';
+END^
+SET TERM ; ^
+
+DROP EXCEPTION EX_MIGRATION_CHECK;
