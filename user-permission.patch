diff --git a/src/Modules/Kazuko.Modules.UserManagement/PermissionMatrixRowViewModel.cs b/src/Modules/Kazuko.Modules.UserManagement/PermissionMatrixRowViewModel.cs
new file mode 100644
index 0000000..fa6437a
--- /dev/null
+++ b/src/Modules/Kazuko.Modules.UserManagement/PermissionMatrixRowViewModel.cs
@@ -0,0 +1,162 @@
+using Kazuko.Core.Mvvm;
+using Kazuko.Core.UserManagement;
+
+namespace Kazuko.Modules.UserManagement;
+
+/// <summary>
+/// Một dòng ma trận phân quyền trên UI. Áp quy tắc kế thừa ngay khi người dùng
+/// tích/bỏ tích (xem PermissionInheritanceRules):
+/// - Thêm/Xóa → tự check Sửa + Xem; Sửa → tự check Xem.
+/// - Bỏ Xem → bỏ Thêm/Sửa/Xóa. Tất cả → check hết 4. Bị khóa → disable + bỏ hết.
+/// </summary>
+public sealed class PermissionMatrixRowViewModel : ObservableObject
+{
+    private bool _isLocked;
+    private bool _canView;
+    private bool _canAdd;
+    private bool _canEdit;
+    private bool _canDelete;
+
+    public PermissionMatrixRowViewModel(string functionCode, string functionName, string moduleGroup)
+    {
+        FunctionCode = functionCode;
+        FunctionName = functionName;
+        ModuleGroup = moduleGroup;
+    }
+
+    public string FunctionCode { get; }
+    public string FunctionName { get; }
+    public string ModuleGroup { get; }
+
+    /// <summary>Các ô check bị vô hiệu hóa khi chức năng đang "Bị khóa".</summary>
+    public bool IsCheckEnabled => !IsLocked;
+
+    public bool IsLocked
+    {
+        get => _isLocked;
+        set
+        {
+            if (!SetProperty(ref _isLocked, value))
+                return;
+            if (value)
+                SetAllChecks(false, false, false, false);
+            OnPropertyChanged(nameof(IsCheckEnabled));
+        }
+    }
+
+    public bool CanView
+    {
+        get => _canView;
+        set
+        {
+            if (!SetProperty(ref _canView, value))
+                return;
+            if (!value)
+                SetAllChecks(false, false, false, false);
+            OnPropertyChanged(nameof(All));
+        }
+    }
+
+    public bool CanAdd
+    {
+        get => _canAdd;
+        set
+        {
+            if (!SetProperty(ref _canAdd, value))
+                return;
+            if (value)
+            {
+                SetCheck(ref _canView, true, nameof(CanView));
+                SetCheck(ref _canEdit, true, nameof(CanEdit));
+            }
+            OnPropertyChanged(nameof(All));
+        }
+    }
+
+    public bool CanEdit
+    {
+        get => _canEdit;
+        set
+        {
+            if (!SetProperty(ref _canEdit, value))
+                return;
+            if (value)
+                SetCheck(ref _canView, true, nameof(CanView));
+            OnPropertyChanged(nameof(All));
+        }
+    }
+
+    public bool CanDelete
+    {
+        get => _canDelete;
+        set
+        {
+            if (!SetProperty(ref _canDelete, value))
+                return;
+            if (value)
+            {
+                SetCheck(ref _canView, true, nameof(CanView));
+                SetCheck(ref _canEdit, true, nameof(CanEdit));
+            }
+            OnPropertyChanged(nameof(All));
+        }
+    }
+
+    public bool All
+    {
+        get => _canView && _canAdd && _canEdit && _canDelete;
+        set
+        {
+            SetAllChecks(value, value, value, value);
+            OnPropertyChanged(nameof(All));
+        }
+    }
+
+    /// <summary>Gán trạng thái ban đầu từ DB (không kích hoạt kế thừa).</summary>
+    public PermissionMatrixRowViewModel Initialize(
+        bool canView, bool canAdd, bool canEdit, bool canDelete, bool isLocked)
+    {
+        _isLocked = isLocked;
+        _canView = canView;
+        _canAdd = canAdd;
+        _canEdit = canEdit;
+        _canDelete = canDelete;
+        OnPropertyChanged(string.Empty);
+        return this;
+    }
+
+    public PermissionSaveRow ToSaveRow() => new(
+        FunctionCode, _canView, _canAdd, _canEdit, _canDelete, _isLocked);
+
+    private void SetAllChecks(bool view, bool add, bool edit, bool delete)
+    {
+        SetCheck(ref _canView, view, nameof(CanView));
+        SetCheck(ref _canAdd, add, nameof(CanAdd));
+        SetCheck(ref _canEdit, edit, nameof(CanEdit));
+        SetCheck(ref _canDelete, delete, nameof(CanDelete));
+        OnPropertyChanged(nameof(All));
+    }
+
+    private void SetCheck(ref bool field, bool value, string propertyName) =>
+        SetProperty(ref field, value, propertyName);
+
+    public static IReadOnlyList<PermissionMatrixRowViewModel> BuildFrom(
+        IReadOnlyList<GroupPermissionRow> saved)
+    {
+        var byCode = saved.ToDictionary(
+            r => r.FunctionCode, StringComparer.OrdinalIgnoreCase);
+        return SystemFunctionCatalog.All
+            .Select(f =>
+            {
+                var row = byCode.TryGetValue(f.Code, out var s) ? s : null;
+                return new PermissionMatrixRowViewModel(f.Code, f.Name, f.ModuleGroup)
+                    .Initialize(
+                        row?.CanView == true,
+                        row?.CanAdd == true,
+                        row?.CanEdit == true,
+                        row?.CanDelete == true,
+                        row?.IsLocked == true);
+            })
+            .ToArray();
+    }
+}
diff --git a/src/Modules/Kazuko.Modules.UserManagement/UserEditDialog.cs b/src/Modules/Kazuko.Modules.UserManagement/UserEditDialog.cs
new file mode 100644
index 0000000..a67dc74
--- /dev/null
+++ b/src/Modules/Kazuko.Modules.UserManagement/UserEditDialog.cs
@@ -0,0 +1,260 @@
+using System.Windows;
+using System.Windows.Input;
+using Kazuko.Core.Authentication;
+using Kazuko.Core.Mvvm;
+using Kazuko.Core.UserManagement;
+
+namespace Kazuko.Modules.UserManagement;
+
+public sealed class UserEditDialogViewModel : ObservableObject
+{
+    private readonly IUserManagementRepository _repository;
+    private readonly long? _userId;
+    private readonly long _createdBy;
+
+    private EmployeeOption? _selectedEmployee;
+    private WarehouseOption? _selectedWarehouse;
+    private UserGroupOption? _selectedGroup;
+    private string _email = string.Empty;
+    private string _username = string.Empty;
+    private string _notes = string.Empty;
+    private bool _isActive = true;
+    private string _errorMessage = string.Empty;
+
+    public UserEditDialogViewModel(
+        IUserManagementRepository repository,
+        ICurrentSessionAccessor session,
+        IReadOnlyList<EmployeeOption> employees,
+        IReadOnlyList<WarehouseOption> warehouses,
+        IReadOnlyList<UserGroupOption> groups,
+        SystemUser? existing)
+    {
+        _repository = repository;
+        _createdBy = session.Current?.UserId ?? 0;
+
+        Employees = employees;
+        Warehouses = warehouses;
+        Groups = groups;
+
+        Title = existing is null ? "Thêm người dùng" : "Sửa người dùng";
+        IsCreate = existing is null;
+        PasswordHint = existing is null
+            ? "Mật khẩu là bắt buộc khi thêm mới."
+            : "Để trống nếu giữ nguyên mật khẩu cũ.";
+
+        if (existing is not null)
+        {
+            _userId = existing.Id;
+            _username = existing.Username;
+            _email = existing.Email ?? string.Empty;
+            _notes = existing.Notes ?? string.Empty;
+            _isActive = existing.IsActive;
+
+            if (existing.EmployeeId is not null)
+                SelectedEmployee = employees.FirstOrDefault(e => e.Id == existing.EmployeeId);
+            if (existing.WarehouseId is not null)
+                SelectedWarehouse = warehouses.FirstOrDefault(w => w.Id == existing.WarehouseId);
+            if (existing.GroupId is not null)
+                SelectedGroup = groups.FirstOrDefault(g => g.Id == existing.GroupId);
+        }
+
+        SaveCommand = new AsyncRelayCommand(SaveAsync);
+        CancelCommand = new RelayCommand(() => RequestClose?.Invoke(false));
+    }
+
+    public string Title { get; }
+    public bool IsCreate { get; }
+    public string PasswordHint { get; }
+
+    public IReadOnlyList<EmployeeOption> Employees { get; }
+    public IReadOnlyList<WarehouseOption> Warehouses { get; }
+    public IReadOnlyList<UserGroupOption> Groups { get; }
+
+    public EmployeeOption? SelectedEmployee
+    {
+        get => _selectedEmployee;
+        set
+        {
+            if (SetProperty(ref _selectedEmployee, value) && value is not null)
+            {
+                // Tự điền email từ hồ sơ nhân viên nếu đang trống.
+                if (string.IsNullOrWhiteSpace(Email) && !string.IsNullOrWhiteSpace(value.Email))
+                    Email = value.Email;
+            }
+        }
+    }
+
+    public WarehouseOption? SelectedWarehouse
+    {
+        get => _selectedWarehouse;
+        set => SetProperty(ref _selectedWarehouse, value);
+    }
+
+    public UserGroupOption? SelectedGroup
+    {
+        get => _selectedGroup;
+        set => SetProperty(ref _selectedGroup, value);
+    }
+
+    public string Email
+    {
+        get => _email;
+        set => SetProperty(ref _email, value);
+    }
+
+    public string Username
+    {
+        get => _username;
+        set => SetProperty(ref _username, value);
+    }
+
+    /// <summary>Mật khẩu nhập từ PasswordBox (code-behind). Rỗng khi sửa = giữ nguyên.</summary>
+    public string Password { get; set; } = string.Empty;
+
+    public string Notes
+    {
+        get => _notes;
+        set => SetProperty(ref _notes, value);
+    }
+
+    public bool IsActive
+    {
+        get => _isActive;
+        set => SetProperty(ref _isActive, value);
+    }
+
+    public string ErrorMessage
+    {
+        get => _errorMessage;
+        set => SetProperty(ref _errorMessage, value);
+    }
+
+    public SystemUser? SavedUser { get; private set; }
+    public Action<bool>? RequestClose { get; set; }
+
+    public ICommand SaveCommand { get; }
+    public ICommand CancelCommand { get; }
+
+    private async Task SaveAsync()
+    {
+        ErrorMessage = string.Empty;
+
+        if (SelectedEmployee is null)
+        {
+            ErrorMessage = "Vui lòng chọn nhân viên.";
+            return;
+        }
+        if (SelectedGroup is null)
+        {
+            ErrorMessage = "Vui lòng chọn nhóm người dùng.";
+            return;
+        }
+        if (string.IsNullOrWhiteSpace(Username))
+        {
+            ErrorMessage = "Tài khoản là bắt buộc.";
+            return;
+        }
+        if (IsCreate && string.IsNullOrWhiteSpace(Password))
+        {
+            ErrorMessage = "Mật khẩu là bắt buộc khi thêm mới.";
+            return;
+        }
+
+        try
+        {
+            SavedUser = await _repository.SaveUserAsync(
+                new UserSaveRequest(
+                    _userId,
+                    SelectedEmployee.Id,
+                    SelectedWarehouse?.Id,
+                    Email.Trim(),
+                    SelectedGroup.Id,
+                    Username.Trim(),
+                    string.IsNullOrWhiteSpace(Password) ? null : Password,
+                    Notes.Trim(),
+                    IsActive,
+                    _createdBy));
+            RequestClose?.Invoke(true);
+        }
+        catch (Exception ex)
+        {
+            ErrorMessage = ex.Message;
+        }
+    }
+}
+
+public partial class UserEditDialog : Window
+{
+    public UserEditDialog()
+    {
+        InitializeComponent();
+    }
+
+    public static SystemUser? ShowForCreate(
+        Window? owner,
+        IUserManagementRepository repository,
+        ICurrentSessionAccessor session,
+        UserGroup selectedGroup)
+    {
+        var viewModel = CreateViewModel(repository, session, null, selectedGroup.Id);
+        return ShowInternal(owner, viewModel);
+    }
+
+    public static SystemUser? ShowForEdit(
+        Window? owner,
+        IUserManagementRepository repository,
+        ICurrentSessionAccessor session,
+        SystemUser existing)
+    {
+        var viewModel = CreateViewModel(repository, session, existing, null);
+        return ShowInternal(owner, viewModel);
+    }
+
+    private static UserEditDialogViewModel CreateViewModel(
+        IUserManagementRepository repository,
+        ICurrentSessionAccessor session,
+        SystemUser? existing,
+        long? preselectedGroupId)
+    {
+        var employees = repository.GetEmployeesAsync().GetAwaiter().GetResult();
+        var warehouses = repository.GetWarehousesAsync().GetAwaiter().GetResult();
+        var groups = repository.GetGroupsAsync().GetAwaiter().GetResult()
+            .Where(g => g.IsActive)
+            .Select(g => new UserGroupOption(g.Id, g.Code, g.Name))
+            .ToArray();
+
+        var viewModel = new UserEditDialogViewModel(
+            repository, session, employees, warehouses, groups, existing);
+
+        if (existing is null && preselectedGroupId is not null)
+            viewModel.SelectedGroup = groups.FirstOrDefault(g => g.Id == preselectedGroupId);
+
+        return viewModel;
+    }
+
+    private static SystemUser? ShowInternal(Window? owner, UserEditDialogViewModel viewModel)
+    {
+        var dialog = new UserEditDialog { DataContext = viewModel };
+        if (owner is not null)
+            dialog.Owner = owner;
+
+        var saved = false;
+        viewModel.RequestClose = result =>
+        {
+            saved = result;
+            dialog.Close();
+        };
+
+        dialog.ShowDialog();
+        return saved ? viewModel.SavedUser : null;
+    }
+
+    private void PasswordBox_OnPasswordChanged(object sender, RoutedEventArgs e)
+    {
+        if (DataContext is UserEditDialogViewModel viewModel
+            && sender is System.Windows.Controls.PasswordBox passwordBox)
+        {
+            viewModel.Password = passwordBox.Password;
+        }
+    }
+}
