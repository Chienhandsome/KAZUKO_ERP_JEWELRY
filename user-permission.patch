diff --git a/tests/Kazuko.Modules.UserManagement.Tests/PermissionMatrixTests.cs b/tests/Kazuko.Modules.UserManagement.Tests/PermissionMatrixTests.cs
new file mode 100644
index 0000000..e733cc3
