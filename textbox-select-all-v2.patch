diff --git a/src/Kazuko.Shared.UI/Behaviors/NumericThousandSeparatorBehavior.cs b/src/Kazuko.Shared.UI/Behaviors/NumericThousandSeparatorBehavior.cs
new file mode 100644
index 0000000..f0585f3
--- /dev/null
+++ b/src/Kazuko.Shared.UI/Behaviors/NumericThousandSeparatorBehavior.cs
@@ -0,0 +1,128 @@
+using System.Globalization;
+using System.Linq;
+using System.Windows;
+using System.Windows.Controls;
+
+namespace Kazuko.Shared.UI.Behaviors;
+
+/// <summary>
+/// Ngắt hàng nghìn trực tiếp trong khi đang nhập số tiền.
+/// "1000000" → "1.000.000" ngay khi gõ, giữ đúng vị trí con trỏ.
+/// Không tự gắn vào style chung — các ô nhập tiền tự opt-in bằng cách set
+/// <c>behaviors:NumericThousandSeparatorBehavior.EnableLiveThousandSeparator="True"</c>.
+/// </summary>
+public static class NumericThousandSeparatorBehavior
+{
+    private static readonly CultureInfo ViVn = new("vi-VN");
+
+    public static readonly DependencyProperty EnableLiveThousandSeparatorProperty =
+        DependencyProperty.RegisterAttached(
+            "EnableLiveThousandSeparator",
+            typeof(bool),
+            typeof(NumericThousandSeparatorBehavior),
+            new PropertyMetadata(false, OnEnableChanged));
+
+    public static bool GetEnableLiveThousandSeparator(DependencyObject obj) =>
+        (bool)obj.GetValue(EnableLiveThousandSeparatorProperty);
+
+    public static void SetEnableLiveThousandSeparator(DependencyObject obj, bool value) =>
+        obj.SetValue(EnableLiveThousandSeparatorProperty, value);
+
+    // Cờ chống đệ quy: set Text trong TextChanged sẽ bắn TextChanged lần nữa.
+    private static readonly DependencyProperty IsUpdatingProperty =
+        DependencyProperty.RegisterAttached(
+            "IsUpdating",
+            typeof(bool),
+            typeof(NumericThousandSeparatorBehavior),
+            new PropertyMetadata(false));
+
+    private static void OnEnableChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
+    {
+        if (d is not TextBox textBox)
+            return;
+
+        if ((bool)e.NewValue)
+        {
+            textBox.TextChanged += OnTextChanged;
+            DataObject.AddPastingHandler(textBox, OnPaste);
+        }
+        else
+        {
+            textBox.TextChanged -= OnTextChanged;
+            DataObject.RemovePastingHandler(textBox, OnPaste);
+        }
+    }
+
+    private static void OnPaste(object sender, DataObjectPastingEventArgs e)
+    {
+        if (sender is not TextBox textBox)
+            return;
+
+        if (!e.DataObject.GetDataPresent(DataFormats.UnicodeText))
+        {
+            e.CancelCommand();
+            return;
+        }
+
+        var pasted = e.DataObject.GetData(DataFormats.UnicodeText) as string ?? string.Empty;
+        var digits = new string(pasted.Where(char.IsDigit).ToArray());
+
+        // Chỉ giữ lại chữ số, bỏ hết ký tự khác (dấu chấm/phẩy/cách/chữ...).
+        e.CancelCommand();
+        var start = textBox.SelectionStart;
+        var newText = textBox.Text.Remove(start, textBox.SelectionLength).Insert(start, digits);
+        textBox.Text = newText;
+        textBox.CaretIndex = start + digits.Length;
+        // TextChanged sẽ format lại với dấu ngắt nghìn.
+    }
+
+    private static void OnTextChanged(object sender, TextChangedEventArgs e)
+    {
+        if (sender is not TextBox textBox)
+            return;
+        if ((bool)textBox.GetValue(IsUpdatingProperty))
+            return;
+
+        var oldText = textBox.Text;
+        var oldCaret = textBox.CaretIndex;
+
+        // Đếm số chữ số đứng trước con trỏ để đặt lại vị trí sau khi format.
+        int digitsBeforeCaret = oldText.Take(oldCaret).Count(char.IsDigit);
+
+        var digitsOnly = new string(oldText.Where(char.IsDigit).ToArray());
+        if (string.IsNullOrEmpty(digitsOnly))
+            return; // Đang gõ dở (chưa có chữ số nào) → giữ nguyên.
+
+        if (!decimal.TryParse(digitsOnly, NumberStyles.None, CultureInfo.InvariantCulture, out var value))
+            return; // Số quá lớn hoặc parse lỗi → giữ nguyên.
+
+        var formatted = value.ToString("N0", ViVn);
+        if (formatted == oldText)
+            return; // Không có gì thay đổi.
+
+        textBox.SetValue(IsUpdatingProperty, true);
+        try
+        {
+            textBox.Text = formatted;
+
+            // Đặt lại con trỏ: vị trí có đúng digitsBeforeCaret chữ số đứng trước.
+            int seen = 0;
+            int newCaret = formatted.Length;
+            for (int i = 0; i < formatted.Length; i++)
+            {
+                if (seen == digitsBeforeCaret)
+                {
+                    newCaret = i;
+                    break;
+                }
+                if (char.IsDigit(formatted[i]))
+                    seen++;
+            }
+            textBox.CaretIndex = newCaret;
+        }
+        finally
+        {
+            textBox.SetValue(IsUpdatingProperty, false);
+        }
+    }
+}
diff --git a/src/Kazuko.Shared.UI/Behaviors/TextBoxSelectAllBehavior.cs b/src/Kazuko.Shared.UI/Behaviors/TextBoxSelectAllBehavior.cs
new file mode 100644
index 0000000..46cff42
--- /dev/null
+++ b/src/Kazuko.Shared.UI/Behaviors/TextBoxSelectAllBehavior.cs
@@ -0,0 +1,88 @@
+using System.Windows;
+using System.Windows.Controls;
+using System.Windows.Input;
+
+namespace Kazuko.Shared.UI.Behaviors;
+
+/// <summary>
+/// Tự động bôi đen toàn bộ nội dung khi TextBox nhận focus (click chuột hoặc Tab).
+/// Bỏ qua TextBox nhiều dòng (AcceptsReturn) và TextBox chỉ đọc (IsReadOnly).
+/// </summary>
+public static class TextBoxSelectAllBehavior
+{
+    public static readonly DependencyProperty SelectAllOnFocusProperty =
+        DependencyProperty.RegisterAttached(
+            "SelectAllOnFocus",
+            typeof(bool),
+            typeof(TextBoxSelectAllBehavior),
+            new PropertyMetadata(false, OnSelectAllOnFocusChanged));
+
+    public static bool GetSelectAllOnFocus(DependencyObject obj) =>
+        (bool)obj.GetValue(SelectAllOnFocusProperty);
+
+    public static void SetSelectAllOnFocus(DependencyObject obj, bool value) =>
+        obj.SetValue(SelectAllOnFocusProperty, value);
+
+    private static void OnSelectAllOnFocusChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
+    {
+        if (d is TextBox textBox)
+        {
+            if ((bool)e.NewValue)
+            {
+                textBox.GotFocus += OnTextBoxGotFocus;
+                textBox.PreviewMouseLeftButtonDown += OnTextBoxPreviewMouseLeftButtonDown;
+            }
+            else
+            {
+                textBox.GotFocus -= OnTextBoxGotFocus;
+                textBox.PreviewMouseLeftButtonDown -= OnTextBoxPreviewMouseLeftButtonDown;
+            }
+        }
+        else if (d is PasswordBox passwordBox)
+        {
+            if ((bool)e.NewValue)
+            {
+                passwordBox.GotFocus += OnPasswordBoxGotFocus;
+                passwordBox.PreviewMouseLeftButtonDown += OnPasswordBoxPreviewMouseLeftButtonDown;
+            }
+            else
+            {
+                passwordBox.GotFocus -= OnPasswordBoxGotFocus;
+                passwordBox.PreviewMouseLeftButtonDown -= OnPasswordBoxPreviewMouseLeftButtonDown;
+            }
+        }
+    }
+
+    private static bool ShouldSelectAll(TextBox textBox) =>
+        !textBox.IsReadOnly && !textBox.AcceptsReturn;
+
+    private static void OnTextBoxGotFocus(object sender, RoutedEventArgs e)
+    {
+        if (sender is TextBox textBox && ShouldSelectAll(textBox))
+            textBox.SelectAll();
+    }
+
+    private static void OnTextBoxPreviewMouseLeftButtonDown(object sender, MouseButtonEventArgs e)
+    {
+        if (sender is TextBox textBox && ShouldSelectAll(textBox) && !textBox.IsFocused)
+        {
+            e.Handled = true;
+            textBox.Focus();
+        }
+    }
+
+    private static void OnPasswordBoxGotFocus(object sender, RoutedEventArgs e)
+    {
+        if (sender is PasswordBox passwordBox)
+            passwordBox.SelectAll();
+    }
+
+    private static void OnPasswordBoxPreviewMouseLeftButtonDown(object sender, MouseButtonEventArgs e)
+    {
+        if (sender is PasswordBox passwordBox && !passwordBox.IsFocused)
+        {
+            e.Handled = true;
+            passwordBox.Focus();
+        }
+    }
+}
