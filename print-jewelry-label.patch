+    private async Task PrintLabelsAsync(bool onlyChecked)
+    {
+        IReadOnlyList<ManualFinishedProductItem> items = onlyChecked
+            ? Products.Where(p => _printChecked.Contains(p)).ToList()
+            : Products.ToList();
+
+        if (items.Count == 0)
+        {
+            MessageBox.Show(
+                "Vui lòng chọn ít nhất một sản phẩm để in tem.",
+                "In tem",
+                MessageBoxButton.OK, MessageBoxImage.Warning);
+            return;
+        }
+
+        var dialogVm = new LabelPrintDialogViewModel(items.Count);
+        var dialog = new LabelPrintDialog(dialogVm)
+        {
+            Owner = Application.Current?.MainWindow
+        };
+        if (dialog.ShowDialog() != true || dialogVm.DialogResult != true)
+            return;
+
+        var printerName = dialogVm.SelectedPrinter;
+        var copies = dialogVm.Copies;
+        if (string.IsNullOrWhiteSpace(printerName))
+            return;
+
+        try
+        {
+            IsBusy = true;
+
+            var profile = await _companyProfile.GetAsync(_session);
+            var shopName = profile.Name;
+            var shopAddress = profile.Address ?? string.Empty;
+
+            using var report = await _labelPrintService.CreatePreparedReportAsync(
+                items, ReceiptDate, _session, shopName, shopAddress);
+
+            // Xuất từng trang tem ra ảnh rồi in qua PrintDocument (FastReport OpenSource không có Report.Print()).
+            var images = ExportReportToImages(report);
+
+            using var document = new PrintDocument();
+            document.DocumentName = "Tem nữ trang KAZUKO";
+            document.PrinterSettings.PrinterName = printerName;
+            document.PrinterSettings.Copies = (short)copies;
+
+            var pageIndex = 0;
+            document.PrintPage += (_, e) =>
+            {
+                var g = e.Graphics!;
+                var image = images[pageIndex];
+                // Vẽ vừa khít trang tem (không co giãn).
+                g.DrawImage(image, e.MarginBounds);
+                pageIndex++;
+                e.HasMorePages = pageIndex < images.Count;
+            };
+            document.Print();
+
+            foreach (var image in images)
+                image.Dispose();
+        }
+        catch (Exception ex)
+        {
+            MessageBox.Show(
+                $"In tem thất bại: {ex.Message}",
+                "In tem",
+                MessageBoxButton.OK, MessageBoxImage.Error);
+        }
+        finally
+        {
+            IsBusy = false;
+        }
+    }
+
+    private static List<System.Drawing.Image> ExportReportToImages(Report report)
+    {
+        var images = new List<System.Drawing.Image>();
+        using var imageExport = new ImageExport
+        {
+            ImageFormat = ImageExportFormat.Png,
+            Resolution = 300
+        };
+
+        using var stream = new MemoryStream();
+        imageExport.Export(report, stream);
+
+        // ImageExport xuất nhiều trang thành nhiều ảnh — đọc lại từ stream.
+        // FastReport OpenSource: mỗi PreparedPage một ảnh PNG nối tiếp nhau.
+        stream.Position = 0;
+        // Đọc từng frame PNG trong stream.
+        var pngs = SplitPngStream(stream);
+        foreach (var png in pngs)
+            images.Add(System.Drawing.Image.FromStream(png));
+
+        return images;
+    }
+
+    private static List<MemoryStream> SplitPngStream(MemoryStream stream)
+    {
+        // PNG signature: 89 50 4E 47 0D 0A 1A 0A
+        var result = new List<MemoryStream>();
+        var data = stream.ToArray();
+        var signature = new byte[] { 0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A };
+        var positions = new List<int>();
+
+        for (var i = 0; i <= data.Length - 8; i++)
+        {
+            var match = true;
+            for (var j = 0; j < 8; j++)
+            {
+                if (data[i + j] != signature[j]) { match = false; break; }
+            }
+            if (match) positions.Add(i);
+        }
+
+        for (var i = 0; i < positions.Count; i++)
+        {
+            var start = positions[i];
+            var end = i + 1 < positions.Count ? positions[i + 1] : data.Length;
+            var ms = new MemoryStream(data, start, end - start, writable: false);
+            result.Add(ms);
+        }
+
+        return result;
+    }
