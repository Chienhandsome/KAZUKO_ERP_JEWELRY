+    #region Label printing
+
+    /// <summary>Đánh dấu / bỏ đánh dấu một SP để in tem.</summary>
+    public void SetPrintChecked(ManualFinishedProductItem item, bool isChecked)
+    {
+        if (isChecked)
+            _printChecked.Add(item);
+        else
