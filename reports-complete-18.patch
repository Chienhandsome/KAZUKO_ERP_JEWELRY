+
+        IsEmpty = Rows.Count == 0;
+        SummaryText =
+            $"Số dòng: {result.ItemCount.ToString("N0", Vi)}  ·  " +
+            $"Tổng giá vốn: {result.TotalCost.ToString("N0", Vi)}  ·  " +
+            $"Tổng giá bán: {result.TotalSale.ToString("N0", Vi)}  ·  " +
+            $"Tổng lãi: {result.TotalProfit.ToString("N0", Vi)} VND";
+    }
