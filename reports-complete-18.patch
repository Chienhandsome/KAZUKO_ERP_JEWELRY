+/// <summary>Định nghĩa cột + dựng FastReport động theo layout cột người dùng.</summary>
+public static class WarehousePendingReceiptsReportColumns
+{
+    public const string SettingsKey = "reports.warehouse.pending_receipts.columns";
+
+    public static IReadOnlyList<ReportColumnDefinition> All { get; } =
+    [
+        new("Index", "STT", 0.04f),
+        new("DocumentDateText", "Ngày nhập", 0.09f),
+        new("DocumentCode", "Số phiếu", 0.11f),
+        new("MaterialCode", "Mã NVL", 0.10f),
+        new("MaterialName", "Mặt hàng", 0.20f),
+        new("GoldTypeName", "Loại vàng", 0.09f),
+        new("QuantityText", "SL / TL", 0.10f),
+        new("UnitPriceText", "Đơn giá", 0.10f),
+        new("AmountVndText", "Thành tiền", 0.11f),
+        new("SupplierName", "NCC", 0.06f, DefaultVisible: false)
+    ];
+
+    public static (string Expression, HorzAlign Align) Bind(string key) => key switch
+    {
+        "Index" => ("[PendingRows.Index]", HorzAlign.Center),
+        "DocumentDateText" => ("[PendingRows.DocumentDateText]", HorzAlign.Center),
+        "DocumentCode" => ("[PendingRows.DocumentCode]", HorzAlign.Left),
+        "MaterialCode" => ("[PendingRows.MaterialCode]", HorzAlign.Left),
+        "MaterialName" => ("[PendingRows.MaterialName]", HorzAlign.Left),
+        "GoldTypeName" => ("[PendingRows.GoldTypeName]", HorzAlign.Center),
+        "QuantityText" => ("[PendingRows.QuantityText]", HorzAlign.Right),
+        "UnitPriceText" => ("[PendingRows.UnitPriceText]", HorzAlign.Right),
+        "AmountVndText" => ("[PendingRows.AmountVndText]", HorzAlign.Right),
+        "SupplierName" => ("[PendingRows.SupplierName]", HorzAlign.Left),
+        _ => ("", HorzAlign.Left)
+    };
+}
