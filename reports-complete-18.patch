@@ -0,0 +1,96 @@
+using System.Collections.ObjectModel;
+using System.Globalization;
+using FastReport;
+using Kazuko.Core.Authentication;
+using Kazuko.Core.Reports;
+using Kazuko.Modules.Reports.Shared;
+
+namespace Kazuko.Modules.Reports;
+
+/// <summary>Báo cáo "Tổng hợp nhập hàng theo loại" (reports.warehouse.receipts_by_type).</summary>
+public sealed class WarehouseReceiptsByTypeReportViewModel : ReportWorkspaceViewModel
+{
+    private static readonly CultureInfo Vi = CultureInfo.GetCultureInfo("vi-VN");
+
+    private readonly IWarehouseReceiptsByTypeReportService _reportService;
+    private readonly WarehouseReceiptsByTypePrintService _printService = new();
+
+    private DateTime _fromDate = new(DateTime.Today.Year, DateTime.Today.Month, 1);
+    private DateTime _toDate = DateTime.Today;
+
+    public WarehouseReceiptsByTypeReportViewModel(
+        IWarehouseReceiptsByTypeReportService reportService,
+        ICurrentSessionAccessor sessionAccessor)
+        : base(sessionAccessor, "warehouse-receipts-by-type", WarehouseReceiptsByTypeReportColumns.SettingsKey)
+    {
+        _reportService = reportService;
+    }
+
+    protected override IReadOnlyList<ReportColumnDefinition> AvailableColumns =>
+        WarehouseReceiptsByTypeReportColumns.All;
+
+    public ObservableCollection<WarehouseReceiptsByTypeRowViewModel> Rows { get; } = new();
+
+    public DateTime FromDate
+    {
+        get => _fromDate;
+        set
+        {
+            if (SetProperty(ref _fromDate, value.Date))
+                ScheduleReload();
+        }
+    }
+
+    public DateTime ToDate
+    {
+        get => _toDate;
+        set
+        {
+            if (SetProperty(ref _toDate, value.Date))
+                ScheduleReload();
+        }
+    }
+
+    protected override bool HasPrintableData => Rows.Count > 0;
+
+    protected override string EmptyResultMessage => "Không có dữ liệu nhập hàng đã xét duyệt trong khoảng ngày.";
+
+    protected override void ResetFiltersCore()
+    {
+        FromDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
+        ToDate = DateTime.Today;
+    }
+
+    protected override async Task LoadDataAsync(AuthenticatedSession session, CancellationToken token)
+    {
+        var result = await _reportService.GetAsync(
+            new WarehouseReceiptsByTypeReportFilter(FromDate, ToDate), session, token);
+        token.ThrowIfCancellationRequested();
+
+        Rows.Clear();
+        var index = 1;
+        foreach (var row in result.Rows)
+            Rows.Add(new WarehouseReceiptsByTypeRowViewModel(row, index++));
+
+        IsEmpty = Rows.Count == 0;
+        SummaryText =
+            $"Số loại: {result.TypeCount.ToString("N0", Vi)}  ·  " +
+            $"Số phiếu: {result.DocumentCount.ToString("N0", Vi)}  ·  " +
+            $"Số dòng: {result.LineCount.ToString("N0", Vi)}  ·  " +
+            $"Tổng SL/TL: {result.TotalQuantity.ToString("N3", Vi)}  ·  " +
+            $"Tổng giá trị: {result.TotalAmountVnd.ToString("N0", Vi)} VND";
+    }
+
+    protected override Report CreatePreparedReport(AuthenticatedSession session) =>
+        _printService.CreatePreparedReport(
+            Rows.ToArray(),
+            session,
+            FromDate,
+            ToDate,
+            ActiveColumns);
+
+    protected override void OnLoadFailed() => Rows.Clear();
+
+    protected override string BuildLoadedStatus() =>
+        $"Đã tải {Rows.Count.ToString("N0", Vi)} dòng.";
+}
