+            "Người lập: .....................          Thủ kho: .....................          Quản lý: .....................",
+            9, FontStyle.Regular, HorzAlign.Left));
+
+        FastReportTemplateHelper.AssignPageBands(page, titleBand, pageHeader, dataBand, footerBand);
+
+        return report;
