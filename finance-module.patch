+            <Button Content="Làm mới" Style="{DynamicResource NavButtonStyle}"
+                    Command="{Binding RefreshCommand}" MinHeight="36" MinWidth="100" Margin="0,0,0,8" />
+          </WrapPanel>
+
+          <DataGrid ItemsSource="{Binding RecentVouchers}" AutoGenerateColumns="False" IsReadOnly="True"
