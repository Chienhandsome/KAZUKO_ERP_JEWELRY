+              <DataGridTextColumn Header="Nội dung" Binding="{Binding Content}" Width="*" />
+              <DataGridTextColumn Header="Đối tượng" Binding="{Binding PartyName}" Width="180" />
+              <DataGridTextColumn Header="Hình thức" Binding="{Binding PaymentMethodText}" Width="110" />
+              <DataGridTextColumn Header="Thu (VND)" Binding="{Binding IncomeText}" Width="120">
+                <DataGridTextColumn.ElementStyle>
