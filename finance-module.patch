+
+        <Border Grid.Column="1" Style="{DynamicResource CardBorderStyle}" Padding="16" Margin="6,0">
+          <StackPanel>
+            <TextBlock Text="Công nợ phải trả (Nhà cung cấp)" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8" />
+            <DataGrid ItemsSource="{Binding TopPayables}" AutoGenerateColumns="False" IsReadOnly="True"
+                      HeadersVisibility="Column" MaxHeight="220">
+              <DataGrid.Columns>
+                <DataGridTextColumn Header="STT" Binding="{Binding Index}" Width="40" />
+                <DataGridTextColumn Header="Nhà cung cấp" Binding="{Binding Name}" Width="*" />
+                <DataGridTextColumn Header="Còn nợ" Binding="{Binding RemainingText}" Width="110">
+                  <DataGridTextColumn.ElementStyle>
