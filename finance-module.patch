+            </Border>
+          </StackPanel>
+        </Border>
+      </Grid>
+
+      <!-- Danh sách thu chi gần đây -->
+      <Border Style="{DynamicResource CardBorderStyle}" Padding="16" Margin="0,0,0,12">
+        <StackPanel>
+          <DockPanel Margin="0,0,0,8">
+            <TextBlock Text="Danh sách thu chi gần đây" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
+            <Button DockPanel.Dock="Right" Content="+ Thêm phiếu thu/chi (F1)"
+                    Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding AddVoucherCommand}"
+                    MinHeight="36" Padding="16,0" />
+          </DockPanel>
+
+          <WrapPanel Margin="0,0,0,8" VerticalAlignment="Center">
+            <ComboBox ItemsSource="{Binding VoucherKindOptions}" SelectedItem="{Binding SelectedKind}"
+                      MinWidth="140" MinHeight="36" Margin="0,0,8,8" VerticalContentAlignment="Center" />
+            <TextBlock Text="Từ ngày" VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Margin="0,0,4,8" />
+            <DatePicker SelectedDate="{Binding FromDate}" MinHeight="36" Margin="0,0,8,8" VerticalContentAlignment="Center" />
+            <TextBlock Text="Đến ngày" VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Margin="0,0,4,8" />
+            <DatePicker SelectedDate="{Binding ToDate}" MinHeight="36" Margin="0,0,8,8" VerticalContentAlignment="Center" />
+            <TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" MinWidth="200" MinHeight="36"
