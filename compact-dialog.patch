From fb51afff668d7a33d62c7340191fcbe25c78580f Mon Sep 17 00:00:00 2001
From: Muse <muse@hatch.local>
Date: Wed, 14 Oct 2026 09:51:17 +0700
Subject: [PATCH] feat(production): compact dialog to reduce vertical scrolling

---
 .../Kazuko.Modules.Production/ProductionOrderDialog.xaml  | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/Modules/Kazuko.Modules.Production/ProductionOrderDialog.xaml b/src/Modules/Kazuko.Modules.Production/ProductionOrderDialog.xaml
index c686251..124aec7 100644
--- a/src/Modules/Kazuko.Modules.Production/ProductionOrderDialog.xaml
+++ b/src/Modules/Kazuko.Modules.Production/ProductionOrderDialog.xaml
@@ -176,7 +176,7 @@
                             <TextBlock Text="Ghi chú" Style="{StaticResource ProductionFieldLabelStyle}" />
                             <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource ProductionDialogFieldStyle}"
-                                     MinHeight="80" TextWrapping="Wrap" AcceptsReturn="True"
+                                     MinHeight="48" TextWrapping="Wrap" AcceptsReturn="True"
                                      VerticalContentAlignment="Top" IsEnabled="{Binding IsDraft}" />
 
                         </StackPanel>
@@ -300,7 +300,7 @@
                     <Border Style="{StaticResource ProductionCardStyle}" Padding="0">
                         <DataGrid Style="{StaticResource ProductionDataGridStyle}"
                                   ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}"
-                                  Height="250"
+                                  Height="150"
                                   BorderThickness="0"
                                   MouseDoubleClick="LinesGrid_OnMouseDoubleClick"
                                   grid:DataGridColumnLayout.SettingsKey="production.order.lines">
@@ -415,7 +415,7 @@
                     <Border Style="{StaticResource ProductionCardStyle}" Padding="0">
                         <DataGrid Style="{StaticResource ProductionEditableDataGridStyle}"
                                   ItemsSource="{Binding IssueLines}"
-                                  Height="220"
+                                  Height="140"
                                   IsReadOnly="{Binding ShowIssueHistory}"
                                   BorderThickness="0"
                                   grid:DataGridColumnLayout.SettingsKey="production.order.issue">
@@ -458,7 +458,7 @@
                     <TextBlock Text="Ghi chú tiền công" Style="{StaticResource ProductionFieldLabelStyle}" />
                     <TextBox Text="{Binding LaborNotes, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource ProductionDialogFieldStyle}"
-                             MinHeight="60" TextWrapping="Wrap" AcceptsReturn="True"
+                             MinHeight="40" TextWrapping="Wrap" AcceptsReturn="True"
                              VerticalContentAlignment="Top"
                              IsEnabled="{Binding IsDraft}" />
                 </StackPanel>
-- 
