Subject: [PATCH 1/2] feat(production): query issued gold grouped by purity for
 reconciliation

---
 .../Production/ProductionContracts.cs         | 17 +++++++++
 .../FirebirdProductionQueryRepository.cs      | 37 +++++++++++++++++++
 2 files changed, 54 insertions(+)

diff --git a/src/Kazuko.Core/Production/ProductionContracts.cs b/src/Kazuko.Core/Production/ProductionContracts.cs
index bb834a5..477f025 100644
--- a/src/Kazuko.Core/Production/ProductionContracts.cs
+++ b/src/Kazuko.Core/Production/ProductionContracts.cs
@@ -485,6 +485,14 @@ public sealed record ManualFinishedReceiptResult(
     string DocumentCode,
     int ProductCount);
 
+/// <summary>
+/// Vàng đã giao theo từng loại vàng (PURITY_CODE của material).
+/// Dùng cho đối chiếu vàng theo loại trong dialog nhập kho thành phẩm.
+/// </summary>
+public sealed record IssuedGoldByPurityDto(
+    string? PurityCode,
+    decimal WeightChi);
+
 public sealed record RecordWorkerGoldDebtRequest(
     long WorkerId,
     string WorkerName,
@@ -568,6 +576,15 @@ public interface IProductionQueryRepository
         long productionOrderId,
         long branchId,
         CancellationToken cancellationToken = default);
+
+    /// <summary>
+    /// Vàng đã giao theo từng loại (PURITY_CODE của material), từ PRODUCTION_MATERIAL_BALANCES.
+    /// Dùng cho đối chiếu vàng theo từng loại vàng trong dialog nhập kho thành phẩm.
+    /// </summary>
+    Task<IReadOnlyList<IssuedGoldByPurityDto>> GetIssuedGoldByPurityAsync(
+        long productionOrderId,
+        long branchId,
+        CancellationToken cancellationToken = default);
 }
 
 public interface IProductionApplicationService
diff --git a/src/Kazuko.Infrastructure/Production/FirebirdProductionQueryRepository.cs b/src/Kazuko.Infrastructure/Production/FirebirdProductionQueryRepository.cs
index 9036a28..b832bc1 100644
--- a/src/Kazuko.Infrastructure/Production/FirebirdProductionQueryRepository.cs
+++ b/src/Kazuko.Infrastructure/Production/FirebirdProductionQueryRepository.cs
@@ -682,6 +682,43 @@ public sealed class FirebirdProductionQueryRepository : IProductionQueryReposito
         }
     }
 
+    public async Task<IReadOnlyList<IssuedGoldByPurityDto>> GetIssuedGoldByPurityAsync(
+        long productionOrderId,
+        long branchId,
+        CancellationToken cancellationToken = default)
+    {
+        if (productionOrderId <= 0 || branchId <= 0)
+            return Array.Empty<IssuedGoldByPurityDto>();
+
+        await using var connection = FirebirdDatabase.CreateConnection();
+        await connection.OpenAsync(cancellationToken);
+        try
+        {
+            // Vàng đã giao theo từng loại (PURITY_CODE), từ PRODUCTION_MATERIAL_BALANCES.
+            // Đơn vị chuẩn của vàng là chỉ.
+            var rows = await connection.QueryAsync<IssuedGoldByPurityDto>(
+                new CommandDefinition("""
+                    SELECT M.PURITY_CODE AS PurityCode, COALESCE(SUM(B.QUANTITY_ISSUED), 0) AS WeightChi
+                    FROM PRODUCTION_MATERIAL_BALANCES B
+                    JOIN MATERIALS M ON M.ID = B.MATERIAL_ID
+                    JOIN PRODUCTION_ORDERS PO ON PO.ID = B.PRODUCTION_ORDER_ID
+                    WHERE B.PRODUCTION_ORDER_ID = @PO
+                      AND PO.BRANCH_ID = @BID
+                      AND PO.COMPANY_ID = (SELECT ID FROM COMPANIES WHERE CODE = 'KAZUKO')
+                      AND M.MATERIAL_TYPE = 'GOLD'
+                    GROUP BY M.PURITY_CODE
+                    """,
+                    new { PO = productionOrderId, BID = branchId },
+                    cancellationToken: cancellationToken));
+            return rows.AsList();
+        }
+        catch (FbException)
+        {
+            // Migration 46 not applied yet — no material balances.
+            return Array.Empty<IssuedGoldByPurityDto>();
+        }
+    }
+
     private static async Task<IReadOnlyList<ProductionQcUnitDto>> LoadQcUnitsAsync(
         FbConnection connection,
         long orderId,
