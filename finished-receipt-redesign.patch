 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/src/Modules/Kazuko.Modules.Warehouse/ProductionFinishedReceiptDialog.xaml b/src/Modules/Kazuko.Modules.Warehouse/ProductionFinishedReceiptDialog.xaml
index a5642e8..7fc06fb 100644
--- a/src/Modules/Kazuko.Modules.Warehouse/ProductionFinishedReceiptDialog.xaml
+++ b/src/Modules/Kazuko.Modules.Warehouse/ProductionFinishedReceiptDialog.xaml
@@ -96,7 +96,13 @@
                 <!-- A2: chọn lệnh đưa lên ĐẦU dialog; chọn 1 lệnh -> tự hiển thị toàn bộ thông tin. -->
                 <TextBlock Text="Lệnh sản xuất" Style="{StaticResource FieldLabelStyle}" />
