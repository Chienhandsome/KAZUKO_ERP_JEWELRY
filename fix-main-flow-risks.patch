From 6de0832f3407a3b5bf28fcc8643d781746351c64 Mon Sep 17 00:00:00 2001
From: Muse <muse@local>
Date: Wed, 28 Oct 2026 01:41:03 +0000
Subject: [PATCH 2/7] fix(production): release sales order when cancelling its
 production order

---
 .../FirebirdProductionApplicationService.cs   | 54 ++++++++++++++++++-
 1 file changed, 52 insertions(+), 2 deletions(-)

diff --git a/src/Kazuko.Infrastructure/Production/FirebirdProductionApplicationService.cs b/src/Kazuko.Infrastructure/Production/FirebirdProductionApplicationService.cs
index f6b1e33..4f793cf 100644
--- a/src/Kazuko.Infrastructure/Production/FirebirdProductionApplicationService.cs
+++ b/src/Kazuko.Infrastructure/Production/FirebirdProductionApplicationService.cs
@@ -1388,9 +1388,10 @@ public sealed partial class FirebirdProductionApplicationService : IProductionAp
             string code;
             string status;
             long rowVersion;
+            long? salesOrderId = null;
 
             await using (var select = new FbCommand("""
-                SELECT CODE, STATUS_CODE, ROW_VERSION
+                SELECT CODE, STATUS_CODE, ROW_VERSION, SALES_ORDER_ID
                 FROM PRODUCTION_ORDERS
                 WHERE ID = @ID
                   AND COMPANY_ID = @CID
@@ -1407,6 +1408,7 @@ public sealed partial class FirebirdProductionApplicationService : IProductionAp
                 code = reader.GetString(0);
                 status = reader.GetString(1);
                 rowVersion = reader.GetInt64(2);
+                salesOrderId = reader.IsDBNull(3) ? null : reader.GetInt64(3);
                 if (rowVersion != expectedRowVersion)
                     throw new InvalidOperationException("Lệnh đã được cập nhật bởi người khác. Vui lòng tải lại.");
             }
@@ -1498,12 +1500,60 @@ public sealed partial class FirebirdProductionApplicationService : IProductionAp
                 rowVersion = Convert.ToInt64(result);
             }
 
+            // Giải phóng đơn bán: lúc tạo LSX, đơn CUSTOM đã bị đẩy sang IN_PRODUCTION
+            // (MarkCraftOrderInProductionAsync) và unique UQ_PO_SALES_ORDER + picker NOT EXISTS
+            // sẽ chặn tạo LSX mới nếu còn link. Chỉ trả khi đơn đang IN_PRODUCTION và
+            // không còn LSX nào khác còn sống trỏ tới nó. Trạng thái trả về là CONFIRMED
+            // (đơn đã được shop chấp nhận khi tạo LSX; CONFIRMED đủ điều kiện tạo LSX mới).
+            var salesOrderReleased = false;
+            if (salesOrderId is > 0)
+            {
+                await using (var liveCmd = new FbCommand("""
+                    SELECT COUNT(*) FROM PRODUCTION_ORDERS
+                    WHERE SALES_ORDER_ID = @SO AND ID <> @PO AND STATUS_CODE <> 'CANCELLED'
+                    """, connection, fbTx))
+                {
+                    liveCmd.Parameters.Add("@SO", FbDbType.BigInt).Value = salesOrderId.Value;
+                    liveCmd.Parameters.Add("@PO", FbDbType.BigInt).Value = productionOrderId;
+                    if (Convert.ToInt32(await liveCmd.ExecuteScalarAsync(cancellationToken)) == 0)
+                    {
+                        await using (var releaseCmd = new FbCommand("""
+                            UPDATE SALES_ORDERS
+                               SET STATUS_CODE = 'CONFIRMED',
+                                   UPDATED_AT = CURRENT_TIMESTAMP
+                             WHERE ID = @SO
+                               AND ORDER_TYPE = 'CUSTOM'
+                               AND STATUS_CODE = 'IN_PRODUCTION'
+                            """, connection, fbTx))
+                        {
+                            releaseCmd.Parameters.Add("@SO", FbDbType.BigInt).Value = salesOrderId.Value;
+                            if (await releaseCmd.ExecuteNonQueryAsync(cancellationToken) > 0)
+                            {
+                                salesOrderReleased = true;
+                                await using (var unlinkCmd = new FbCommand("""
+                                    UPDATE PRODUCTION_ORDERS
+                                       SET SALES_ORDER_ID = NULL
+                                     WHERE ID = @PO
+                                    """, connection, fbTx))
+                                {
+                                    unlinkCmd.Parameters.Add("@PO", FbDbType.BigInt).Value = productionOrderId;
+                                    await unlinkCmd.ExecuteNonQueryAsync(cancellationToken);
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+
             var reasonText = string.IsNullOrWhiteSpace(reason) ? null : reason.Trim();
+            var auditData = reasonText is null ? code : $"{code}|{reasonText}";
+            if (salesOrderReleased)
+                auditData += $"|releasedSalesOrder:{salesOrderId}";
             await AuditLogWriter.WriteAsync(
                 connection, fbTx, "PRODUCTION_ORDER_CANCELLED",
                 session.UserId, session.Username, session.BranchId,
                 "PRODUCTION_ORDER", productionOrderId.ToString(),
-                reasonText is null ? code : $"{code}|{reasonText}",
+                auditData,
                 cancellationToken);
 
             await transaction.CommitAsync(cancellationToken);
-- 
