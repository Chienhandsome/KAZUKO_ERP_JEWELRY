From 5bb34f5285de86e4964a51595c3ea3082eeaf356 Mon Sep 17 00:00:00 2001
From: Muse <muse@local>
Date: Wed, 28 Oct 2026 01:42:28 +0000
Subject: [PATCH 3/7] feat(production): idempotent production order creation
 via request dedupe

---
 .../0092__production_order_requests.sql       | 17 +++++++++++
 .../Production/ProductionContracts.cs         |  6 +++-
 .../FirebirdProductionApplicationService.cs   | 30 +++++++++++++++++++
 .../ProductionOrderDialogViewModel.cs         | 16 ++++++++--
 4 files changed, 66 insertions(+), 3 deletions(-)
 create mode 100644 database/migrations/0092__production_order_requests.sql

diff --git a/database/migrations/0092__production_order_requests.sql b/database/migrations/0092__production_order_requests.sql
new file mode 100644
index 0000000..cb3b98c
--- /dev/null
+++ b/database/migrations/0092__production_order_requests.sql
@@ -0,0 +1,17 @@
+/* Forward-only. Order create-request snapshot permits safe retry of LSX creation
+   (same pattern as 0091 for finished receipts). Restore pre-migration .fbk to roll back;
+   do not drop tables with posted documents. */
+SET AUTODDL OFF;
+CREATE TABLE PRODUCTION_ORDER_REQUESTS (
+ ID BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
+ COMPANY_ID BIGINT NOT NULL REFERENCES COMPANIES(ID),
+ BRANCH_ID BIGINT NOT NULL REFERENCES BRANCHES(ID),
+ REQUEST_ID CHAR(36) CHARACTER SET ASCII NOT NULL,
+ REQUEST_HASH CHAR(64) CHARACTER SET ASCII NOT NULL,
+ ORDER_ID BIGINT NOT NULL REFERENCES PRODUCTION_ORDERS(ID),
+ PAYLOAD BLOB SUB_TYPE TEXT CHARACTER SET UTF8 NOT NULL,
+ CREATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,
+ CONSTRAINT UQ_PROD_ORDER_REQUEST UNIQUE(COMPANY_ID,BRANCH_ID,REQUEST_ID),
+ CONSTRAINT UQ_PROD_ORDER_ORDER UNIQUE(ORDER_ID)
+);
+COMMIT;
diff --git a/src/Kazuko.Core/Production/ProductionContracts.cs b/src/Kazuko.Core/Production/ProductionContracts.cs
index c8a3876..3dfc77d 100644
--- a/src/Kazuko.Core/Production/ProductionContracts.cs
+++ b/src/Kazuko.Core/Production/ProductionContracts.cs
@@ -361,7 +361,11 @@ public sealed record ProductionOrderDraft(
     long? RowVersion,
     IReadOnlyList<long> EmployeeIds,
     IReadOnlyList<ProductionOrderLineDraft> Lines,
-    IReadOnlyList<ProductionAttachmentDraft> Attachments);
+    IReadOnlyList<ProductionAttachmentDraft> Attachments,
+    // Idempotency cho tạo mới (kiểu PRODUCTION_RECEIPT_REQUESTS): dialog giữ 1 Guid
+    // cho cả phiên tạo, retry cùng RequestId trả LSX cũ, khác nội dung bị chặn.
+    // Sửa bản nháp không dùng (đã có ROW_VERSION). Guid.Empty = không dedupe.
+    Guid RequestId = default);
 
 public sealed record ProductionOrderSaveResult(
     long Id,
diff --git a/src/Kazuko.Infrastructure/Production/FirebirdProductionApplicationService.cs b/src/Kazuko.Infrastructure/Production/FirebirdProductionApplicationService.cs
index 4f793cf..a5158b0 100644
--- a/src/Kazuko.Infrastructure/Production/FirebirdProductionApplicationService.cs
+++ b/src/Kazuko.Infrastructure/Production/FirebirdProductionApplicationService.cs
@@ -20,6 +20,8 @@ public sealed partial class FirebirdProductionApplicationService : IProductionAp
         _attachmentStore = attachmentStore;
     }
 
+    private sealed record OrderRequestRow(long OrderId, string Code, long RowVersion, string RequestHash);
+
     public async Task<ProductionOrderSaveResult> SaveDraftAsync(
         ProductionOrderDraft draft,
         AuthenticatedSession session,
@@ -51,6 +53,26 @@ public sealed partial class FirebirdProductionApplicationService : IProductionAp
             long rowVersion;
             var isCreate = draft.Id is null or <= 0;
 
+            // Idempotency cho tạo mới (kiểu PRODUCTION_RECEIPT_REQUESTS): retry cùng
+            // RequestId trả LSX cũ, khác nội dung bị chặn. Sửa bản nháp không dedupe.
+            string? orderRequestHash = null;
+            if (isCreate && draft.RequestId != Guid.Empty)
+            {
+                orderRequestHash = Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(JsonSerializer.Serialize(draft))));
+                var priorOrder = await connection.QuerySingleOrDefaultAsync<OrderRequestRow>(new CommandDefinition("""
+                    SELECT R.ORDER_ID AS OrderId, O.CODE AS Code, O.ROW_VERSION AS RowVersion, R.REQUEST_HASH AS RequestHash
+                    FROM PRODUCTION_ORDER_REQUESTS R JOIN PRODUCTION_ORDERS O ON O.ID = R.ORDER_ID
+                    WHERE R.COMPANY_ID = @companyId AND R.BRANCH_ID = @branch AND R.REQUEST_ID = @id
+                    """, new { companyId, branch = session.BranchId, id = draft.RequestId.ToString() }, fbTx, cancellationToken: cancellationToken));
+                if (priorOrder is not null)
+                {
+                    if (priorOrder.RequestHash.Trim() != orderRequestHash)
+                        throw new InvalidOperationException("Yêu cầu tạo lệnh này đã lưu với nội dung khác. Tải lại lệnh đã tạo.");
+                    await transaction.CommitAsync(cancellationToken);
+                    return new ProductionOrderSaveResult(priorOrder.OrderId, priorOrder.Code, priorOrder.RowVersion);
+                }
+            }
+
             if (isCreate)
             {
                 code = await StockPostingSupport.NextDocumentCodeAsync(
@@ -118,6 +140,14 @@ public sealed partial class FirebirdProductionApplicationService : IProductionAp
