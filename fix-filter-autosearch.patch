From 92710d94902eecbccb59432127ce70c5393d1ec2 Mon Sep 17 00:00:00 2001
From: Muse <muse@hatch.local>
Date: Wed, 14 Oct 2026 09:19:07 +0700
Subject: [PATCH] fix(production): don't auto-search when populating filters
 from selected order

---
 .../ProductionViewModel.cs                    | 43 +++++++++++++------
 1 file changed, 30 insertions(+), 13 deletions(-)

diff --git a/src/Modules/Kazuko.Modules.Production/ProductionViewModel.cs b/src/Modules/Kazuko.Modules.Production/ProductionViewModel.cs
index 8b67cd5..57c10a4 100644
--- a/src/Modules/Kazuko.Modules.Production/ProductionViewModel.cs
+++ b/src/Modules/Kazuko.Modules.Production/ProductionViewModel.cs
@@ -112,13 +112,21 @@ public sealed class ProductionViewModel : ObservableObject
     public ObservableCollection<ProductionOrderRowViewModel> Orders { get; } = [];
     public ObservableCollection<string> StatusFilterOptions { get; } = [];
 
+    private bool _suppressAutoSearch;
+
+    private void TriggerFilterSearch()
+    {
+        if (!_suppressAutoSearch)
+            _ = LoadAsync();
+    }
+
     public string OrderCodeFilterText
     {
         get => _orderCodeFilterText;
         set
         {
             if (SetProperty(ref _orderCodeFilterText, value))
-                _ = LoadAsync();
+                TriggerFilterSearch();
         }
     }
 
@@ -128,7 +136,7 @@ public sealed class ProductionViewModel : ObservableObject
         set
         {
             if (SetProperty(ref _customerFilterText, value))
-                _ = LoadAsync();
+                TriggerFilterSearch();
         }
     }
 
@@ -138,7 +146,7 @@ public sealed class ProductionViewModel : ObservableObject
         set
         {
             if (SetProperty(ref _salesOrderFilterText, value))
-                _ = LoadAsync();
+                TriggerFilterSearch();
         }
     }
 
@@ -148,7 +156,7 @@ public sealed class ProductionViewModel : ObservableObject
         set
         {
             if (SetProperty(ref _workerFilterText, value))
-                _ = LoadAsync();
+                TriggerFilterSearch();
         }
     }
 
@@ -158,7 +166,7 @@ public sealed class ProductionViewModel : ObservableObject
         set
         {
             if (SetProperty(ref _modelFilterText, value))
-                _ = LoadAsync();
+                TriggerFilterSearch();
         }
     }
 
@@ -168,7 +176,7 @@ public sealed class ProductionViewModel : ObservableObject
         set
         {
             if (SetProperty(ref _selectedStatusFilter, value))
-                _ = LoadAsync();
+                TriggerFilterSearch();
         }
     }
 
@@ -178,7 +186,7 @@ public sealed class ProductionViewModel : ObservableObject
         set
         {
             if (SetProperty(ref _fromDate, value))
-                _ = LoadAsync();
+                TriggerFilterSearch();
         }
     }
 
@@ -188,7 +196,7 @@ public sealed class ProductionViewModel : ObservableObject
         set
         {
             if (SetProperty(ref _toDate, value))
-                _ = LoadAsync();
+                TriggerFilterSearch();
         }
     }
 
@@ -215,12 +223,21 @@ public sealed class ProductionViewModel : ObservableObject
     /// </summary>
     private void PopulateFiltersFromOrder(ProductionOrderRowViewModel order)
     {
-        OrderCodeFilterText = order.Code ?? string.Empty;
-        CustomerFilterText = order.CustomerName ?? string.Empty;
-        SalesOrderFilterText = order.SalesOrderCode ?? string.Empty;
-        WorkerFilterText = order.WorkerDisplayName ?? string.Empty;
-        ModelFilterText = order.ModelSummary ?? string.Empty;
+        _suppressAutoSearch = true;
+        try
+        {
+            OrderCodeFilterText = order.Code ?? string.Empty;
+            CustomerFilterText = order.CustomerName ?? string.Empty;
+            SalesOrderFilterText = order.SalesOrderCode ?? string.Empty;
+            WorkerFilterText = order.WorkerDisplayName ?? string.Empty;
+            ModelFilterText = order.ModelSummary ?? string.Empty;
+        }
+        finally
+        {
+            _suppressAutoSearch = false;
+        }
         // Không tự đổi Từ/Đến ngày và Trạng thái để tránh làm hẹp kết quả lọc bất ngờ
+        // Không tự kích hoạt tìm kiếm — người dùng bấm "Tìm kiếm" khi cần
     }
 
     public string StatusMessage
-- 
2.43.0

