From d43c76b6df3cf6e39595a329bec59caa26e5efe2 Mon Sep 17 00:00:00 2001
From: Muse <muse@hatch.local>
Date: Mon, 12 Oct 2026 09:47:45 +0700
Subject: [PATCH] fix(infra): cast SUM to INTEGER for ProductionOrderSummary
 Dapper binding

---
 .../FirebirdProductionQueryRepository.cs          | 15 ++++++++-------
 1 file changed, 8 insertions(+), 7 deletions(-)

diff --git a/src/Kazuko.Infrastructure/Production/FirebirdProductionQueryRepository.cs b/src/Kazuko.Infrastructure/Production/FirebirdProductionQueryRepository.cs
index cb595d7..56bcb78 100644
--- a/src/Kazuko.Infrastructure/Production/FirebirdProductionQueryRepository.cs
+++ b/src/Kazuko.Infrastructure/Production/FirebirdProductionQueryRepository.cs
@@ -60,19 +60,20 @@ public sealed class FirebirdProductionQueryRepository : IProductionQueryReposito
         await connection.OpenAsync(cancellationToken);
         // Period filter uses ORDER_DATE (always present). COMPLETED_AT is preferred when
         // migration 45+ has been applied; COALESCE keeps summary working on legacy headers.
-        // SUM trả về BIGINT -> Dapper convert sang int (như Convert.ToInt32 bản cũ);
-        // SUM = NULL khi không có dòng nào -> Dapper map thành 0 (default int).
+        // SUM trả về BIGINT nhưng record ProductionOrderSummary khai báo int -> CAST AS INTEGER
+        // (Dapper chỉ bind constructor khi kiểu khớp chính xác, không tự Convert như bản cũ).
+        // SUM = NULL khi không có dòng nào -> COALESCE về 0 (giống IsDBNull ? 0 bản cũ).
         var hasPeriod = periodFrom is not null && periodTo is not null ? 1 : 0;
         return await connection.QuerySingleAsync<ProductionOrderSummary>(
             new CommandDefinition("""
                 SELECT
-                    SUM(CASE WHEN PO.STATUS_CODE = 'IN_PROGRESS' THEN 1 ELSE 0 END) AS InProgressCount,
-                    SUM(CASE WHEN PO.STATUS_CODE = 'COMPLETED'
+                    COALESCE(CAST(SUM(CASE WHEN PO.STATUS_CODE = 'IN_PROGRESS' THEN 1 ELSE 0 END) AS INTEGER), 0) AS InProgressCount,
+                    COALESCE(CAST(SUM(CASE WHEN PO.STATUS_CODE = 'COMPLETED'
                               AND (@HAS_PERIOD = 0
                                    OR (PO.ORDER_DATE >= @FROM_DATE AND PO.ORDER_DATE < @TO_DATE_EXCL))
-                         THEN 1 ELSE 0 END) AS CompletedInPeriodCount,
-                    SUM(CASE WHEN PO.STATUS_CODE = 'IN_PROGRESS' AND PO.EXECUTION_TYPE = 'OUTSOURCED' THEN 1 ELSE 0 END) AS OutsourcedCount,
-                    SUM(CASE WHEN PO.STATUS_CODE = 'IN_PROGRESS' AND PO.EXECUTION_TYPE = 'IN_HOUSE' THEN 1 ELSE 0 END) AS InHouseCount
+                         THEN 1 ELSE 0 END) AS INTEGER), 0) AS CompletedInPeriodCount,
+                    COALESCE(CAST(SUM(CASE WHEN PO.STATUS_CODE = 'IN_PROGRESS' AND PO.EXECUTION_TYPE = 'OUTSOURCED' THEN 1 ELSE 0 END) AS INTEGER), 0) AS OutsourcedCount,
+                    COALESCE(CAST(SUM(CASE WHEN PO.STATUS_CODE = 'IN_PROGRESS' AND PO.EXECUTION_TYPE = 'IN_HOUSE' THEN 1 ELSE 0 END) AS INTEGER), 0) AS InHouseCount
                 FROM PRODUCTION_ORDERS PO
                 WHERE PO.COMPANY_ID = (SELECT ID FROM COMPANIES WHERE CODE = 'KAZUKO')
                   AND PO.BRANCH_ID = @BRANCH_ID
-- 
2.43.0

