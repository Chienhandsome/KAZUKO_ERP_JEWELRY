+using Kazuko.Core.Finance;
+using Xunit;
+
+namespace Kazuko.Infrastructure.Tests.Finance;
+
+/// <summary>
+/// Wave 4 — spec #10.4: rollback batch — nếu 1 khoản lỗi thì không khoản nào được trừ.
+/// Logic thuần, chạy được trên Linux (mô phỏng đúng cấu trúc transaction của production).
+///
+/// Production (FirebirdDebtWorkbenchRepository.PayPayablePartyFifoAsync và
+/// SettleSingleLedgerEntryAsync) tuân thủ mẫu:
+/// <code>
+/// await using var transaction = await connection.BeginTransactionAsync(ct);
+/// try
+/// {
+///     ... build applications ...
+///     ... apply từng khoản (ApplyPayableDebtPaymentAsync / ApplyReceivableDebtCollectionAsync) ...
+///     ... audit ...
+///     await transaction.CommitAsync(ct);
+/// }
+/// catch
+/// {
+///     await transaction.RollbackAsync(ct);
+///     throw;
+/// }
+/// </code>
+/// Nghĩa là: mọi UPDATE/INSERT đều nằm trong CÙNG 1 transaction; exception ở bất kỳ
+/// bước nào → rollback toàn bộ → số dư các khoản nợ giữ nguyên như chưa hề chạy.
+/// Các test dưới đây mô phỏng đúng thứ tự đó trên ledger in-memory.
+/// </summary>
+public sealed class DebtBatchRollbackTests
+{
+    /// <summary>
+    /// Mô phỏng 1 transaction: mọi apply chạy trên bản sao làm việc; chỉ khi tất cả
+    /// thành công mới "commit" (ghi đè ledger gốc). Exception giữa chừng → ledger gốc
+    /// giữ nguyên — tương đương ROLLBACK của production.
+    /// </summary>
+    private static void ApplyBatchWithRollbackSemantics(
+        Dictionary<long, decimal> ledger,
+        IReadOnlyList<(long DebtId, decimal Amount)> applications,
+        Func<long, decimal, bool> applyOne)
+    {
+        var working = new Dictionary<long, decimal>(ledger);
+        try
+        {
+            foreach (var app in applications)
+            {
+                if (!applyOne(app.DebtId, app.Amount))
+                    throw new InvalidOperationException($"Không áp dụng được khoản #{app.DebtId}.");
+                working[app.DebtId] -= app.Amount; // UPDATE ... REMAINING = REM - amt
+            }
+
+            // commit: ghi đè ledger gốc
+            foreach (var kv in working)
+                ledger[kv.Key] = kv.Value;
+        }
+        catch
+        {
+            // rollback: working bị bỏ, ledger gốc không đổi — rồi throw tiếp (như production)
+            throw;
+        }
+    }
+
+    [Fact]
+    public void BatchApply_SecondDebtFails_FirstDebtIsNotDeducted()
+    {
+        var ledger = new Dictionary<long, decimal> { [1] = 4_000_000, [2] = 3_000_000 };
+        var applications = new List<(long, decimal)> { (1, 4_000_000), (2, 3_000_000) };
+
+        var ex = Assert.Throws<InvalidOperationException>(() =>
+            ApplyBatchWithRollbackSemantics(
+                ledger,
+                applications,
+                // Giả lập lỗi ở khoản thứ 2 (vd. row bị lock / số dư đã đổi bởi user khác)
+                (debtId, amount) => debtId != 2));
+
+        Assert.Contains("Không áp dụng được khoản #2", ex.Message);
+        // Rollback: KHÔNG khoản nào bị trừ, kể cả khoản #1 đã "apply" trước đó.
+        Assert.Equal(4_000_000, ledger[1]);
+        Assert.Equal(3_000_000, ledger[2]);
+    }
+
+    [Fact]
+    public void BatchApply_AllSucceed_CommitsEveryDeduction()
+    {
+        var ledger = new Dictionary<long, decimal> { [1] = 4_000_000, [2] = 3_000_000 };
+        var applications = new List<(long, decimal)> { (1, 4_000_000), (2, 3_000_000) };
+
+        ApplyBatchWithRollbackSemantics(ledger, applications, (_, _) => true);
+
+        Assert.Equal(0, ledger[1]);
+        Assert.Equal(0, ledger[2]);
+    }
+
+    [Fact]
+    public void BatchApply_FirstDebtFails_NothingIsDeducted()
+    {
+        var ledger = new Dictionary<long, decimal> { [1] = 4_000_000, [2] = 3_000_000 };
+        var applications = new List<(long, decimal)> { (1, 4_000_000), (2, 3_000_000) };
+
+        Assert.Throws<InvalidOperationException>(() =>
+            ApplyBatchWithRollbackSemantics(ledger, applications, (_, _) => false));
+
+        Assert.Equal(4_000_000, ledger[1]);
+        Assert.Equal(3_000_000, ledger[2]);
+    }
+
+    /// <summary>
+    /// Mirror guard đầu SettleSingleLedgerEntryAsync: source type không hỗ trợ
+    /// → throw TRƯỚC khi mở transaction / chạm DB, nên không có gì để rollback.
+    /// </summary>
+    private static void GuardSupportedSourceType(string? sourceType)
+    {
+        var normalized = (sourceType ?? string.Empty).Trim().ToUpperInvariant();
+        if (normalized is not (
+            DebtLedgerSourceTypes.SalesOrder or
+            DebtLedgerSourceTypes.ReceivableDebt or
+            DebtLedgerSourceTypes.PayableDebt))
+            throw new InvalidOperationException("Nguồn công nợ không hỗ trợ tất toán lẻ.");
+    }
+
+    [Theory]
+    [InlineData("CASH_VOUCHER")]
+    [InlineData("ORDER_PAYMENT")]
+    [InlineData("SALES_CHECKOUT_OFFSET")]
+    [InlineData("")]
+    [InlineData(null)]
+    public void SingleSettle_UnsupportedSourceType_ThrowsBeforeAnyDbWork(string? sourceType)
+    {
+        var ex = Assert.Throws<InvalidOperationException>(() => GuardSupportedSourceType(sourceType));
+        Assert.Contains("không hỗ trợ tất toán lẻ", ex.Message);
+    }
+
+    [Theory]
+    [InlineData("SALES_ORDER")]
+    [InlineData("RECEIVABLE_DEBT")]
+    [InlineData("PAYABLE_DEBT")]
+    [InlineData(" sales_order ")] // production trim + uppercase
+    public void SingleSettle_SupportedSourceType_PassesGuard(string sourceType)
+    {
+        GuardSupportedSourceType(sourceType); // không throw
+    }
+
+    [Fact]
+    public void BatchApply_OverRemainingGuard_StopsBeforeInsert()
+    {
+        // Mirror guard trong ApplyPayableDebtPaymentAsync: re-check sau lock,
+        // khoản nợ có thể đã bị user khác thanh toán → throw trước mọi INSERT/UPDATE.
+        decimal remainingAfterLock = 0m; // user khác đã tất toán
+        var paymentRowsInserted = 0;
+
+        var ex = Assert.Throws<InvalidOperationException>(() =>
+        {
+            if (remainingAfterLock <= 0)
+                throw new InvalidOperationException("Công nợ đã được thanh toán hết bởi người dùng khác.");
+            paymentRowsInserted++; // INSERT PAYABLE_DEBT_PAYMENTS — không bao giờ tới đây
+        });
+
+        Assert.Contains("người dùng khác", ex.Message);
+        Assert.Equal(0, paymentRowsInserted);
+    }
+}
diff --git a/tests/Kazuko.Infrastructure.Tests/Finance/DebtBulkSettlementTests.cs b/tests/Kazuko.Infrastructure.Tests/Finance/DebtBulkSettlementTests.cs
new file mode 100644
index 0000000..367a41f
--- /dev/null
+++ b/tests/Kazuko.Infrastructure.Tests/Finance/DebtBulkSettlementTests.cs
@@ -0,0 +1,181 @@
+using Kazuko.Core.Finance;
+using Xunit;
+
+namespace Kazuko.Infrastructure.Tests.Finance;
+
+/// <summary>
+/// Wave 4 — spec #10.2: thanh toán toàn bộ — tổng phân bổ = tổng các khoản nợ,
+/// 1 voucher cho N khoản. Logic thuần, chạy được trên Linux.
+///
+/// Mirror trực tiếp production:
+/// - FirebirdDebtWorkbenchRepository.PayPayablePartyFifoAsync: vòng lặp FIFO build
+///   applications (Math.Min(left, debt.Remaining)), guard amount &gt; totalOpen,
+///   rồi gọi PostBulkSettlementInTransactionAsync.
+/// - FirebirdFinancialSettlementService.PostBulkSettlementInTransactionAsync:
+///   1 settlement + 1 voucher duy nhất (result.CashVoucherIds = [voucher.VoucherId])
+///   cho N applications; ValidateDraft bắt tổng allocations == tổng applications.
+/// </summary>
+public sealed class DebtBulkSettlementTests
+{
+    /// <summary>
+    /// Mirror vòng lặp FIFO trong PayPayablePartyFifoAsync (dòng build applications).
+    /// </summary>
+    private static List<SettlementApplicationDraft> BuildFifoApplications(
+        IReadOnlyList<(long Id, decimal Remaining)> openDebts, decimal amount)
+    {
+        var applications = new List<SettlementApplicationDraft>();
+        var left = amount;
+        foreach (var debt in openDebts)
+        {
+            if (left <= 0)
+                break;
+            var apply = Math.Min(left, debt.Remaining);
+            applications.Add(new SettlementApplicationDraft(
+                SettlementApplicationTargetTypes.PayableDebt, debt.Id, apply));
+            left -= apply;
+        }
+        return applications;
+    }
+
+    [Fact]
+    public void FullPayment_FifoCoversAllDebts_TotalApplicationEqualsTotalDebt()
+    {
+        var open = new List<(long Id, decimal Remaining)>
+        {
+            (1, 4_000_000),
+            (2, 3_000_000),
+            (3, 3_000_000),
+        };
+        decimal amount = 10_000_000; // = tổng còn nợ
+
+        var applications = BuildFifoApplications(open, amount);
+
+        Assert.Equal(3, applications.Count); // 1 application cho mỗi khoản
+        Assert.Equal(amount, applications.Sum(a => a.AmountVnd));
+        Assert.Equal([4_000_000, 3_000_000, 3_000_000],
+            applications.Select(a => a.AmountVnd).ToArray());
+    }
+
+    [Fact]
+    public void PartialBulkPayment_LastApplicationTakesRemainder()
+    {
+        var open = new List<(long Id, decimal Remaining)>
+        {
+            (1, 4_000_000),
+            (2, 3_000_000),
+            (3, 3_000_000),
+        };
+
+        var applications = BuildFifoApplications(open, 6_000_000);
+
+        Assert.Equal(2, applications.Count);
+        Assert.Equal(4_000_000, applications[0].AmountVnd); // khoản đầu ăn trọn
+        Assert.Equal(2_000_000, applications[1].AmountVnd); // khoản sau ăn phần dư
+        Assert.Equal(6_000_000, applications.Sum(a => a.AmountVnd));
+    }
+
+    [Fact]
+    public void ExactFirstDebtBoundary_StopsAfterOneApplication()
+    {
+        var open = new List<(long Id, decimal Remaining)>
+        {
+            (1, 4_000_000),
+            (2, 3_000_000),
+        };
+
+        var applications = BuildFifoApplications(open, 4_000_000);
+
+        Assert.Single(applications);
+        Assert.Equal(4_000_000, applications[0].AmountVnd);
+    }
+
+    [Fact]
+    public void OverpaymentBeyondTotalOpen_IsRejected()
+    {
+        // Mirror guard: if (amount > totalOpen) throw "Số chi (...) vượt tổng còn nợ (...)".
+        var open = new List<(long Id, decimal Remaining)> { (1, 4_000_000), (2, 3_000_000) };
+        var totalOpen = open.Sum(x => x.Remaining);
+        decimal amount = 8_000_000;
+
+        var ex = Assert.Throws<InvalidOperationException>(() =>
+        {
+            if (amount > totalOpen)
+                throw new InvalidOperationException($"Số chi ({amount:N0}) vượt tổng còn nợ ({totalOpen:N0}).");
+        });
+        Assert.Contains("vượt tổng còn nợ", ex.Message);
+    }
+
+    [Fact]
+    public void BulkSettlement_OneVoucherForNDebts()
+    {
+        // Production PostBulkSettlementInTransactionAsync trả về
+        // new FinancialSettlementResult(settlementId, code, [voucher.VoucherId], applicationIds):
+        // đúng 1 voucher dù có N applications.
+        var applications = new List<SettlementApplicationDraft>
+        {
+            new(SettlementApplicationTargetTypes.PayableDebt, 1, 4_000_000),
+            new(SettlementApplicationTargetTypes.PayableDebt, 2, 3_000_000),
+            new(SettlementApplicationTargetTypes.PayableDebt, 3, 3_000_000),
+        };
+        var result = new FinancialSettlementResult(99, "TT-0001", [777], [10, 11, 12]);
+
+        Assert.Equal(3, applications.Count);
+        Assert.Single(result.CashVoucherIds); // 1 voucher duy nhất
+        Assert.Equal(3, result.ApplicationIds.Count);
+    }
+
+    [Fact]
+    public void BulkDraft_TotalAllocationsMustEqualTotalApplications()
+    {
+        // Mirror rule trong ValidateDraft:
+        // if (totalAlloc != totalApp) errors.Add("Tổng allocations ... phải bằng tổng applications ...").
+        var draft = new FinancialSettlementDraft(
+            SettlementTypes.Payment,
+            SettlementPartyTypes.Supplier,
+            5,
+            DateTime.Today,
+            [new PaymentAllocationDraft(PaymentMethods.Cash, 5_000_000, 1, null, null),
+             new PaymentAllocationDraft(PaymentMethods.BankTransfer, 5_000_000, null, 2, null)],
+            [new SettlementApplicationDraft(SettlementApplicationTargetTypes.PayableDebt, 1, 4_000_000),
+             new SettlementApplicationDraft(SettlementApplicationTargetTypes.PayableDebt, 2, 3_000_000),
+             new SettlementApplicationDraft(SettlementApplicationTargetTypes.PayableDebt, 3, 3_000_000)],
+            "bulk fifo");
+
+        var totalAlloc = draft.Allocations.Sum(x => x.AmountVnd);
+        var totalApp = draft.Applications.Sum(x => x.AmountVnd);
+
+        Assert.Equal(totalAlloc, totalApp);
+        Assert.Equal(10_000_000, totalAlloc);
+    }
+
+    [Fact]
+    public void BulkDraft_MismatchedTotals_AreRejected()
+    {
+        var totalAlloc = 10_000_000m;
+        var totalApp = 9_000_000m;
+
+        var ex = Assert.Throws<InvalidOperationException>(() =>
+        {
+            if (totalAlloc != totalApp)
+                throw new InvalidOperationException(
+                    $"Tổng allocations ({totalAlloc:N0}) phải bằng tổng applications ({totalApp:N0}).");
+        });
+        Assert.Contains("phải bằng", ex.Message, StringComparison.OrdinalIgnoreCase);
+    }
+
+    [Fact]
+    public void BulkPayment_SplitAcrossMethods_OneVoucherStillHoldsBothLines()
+    {
+        // 2 dòng phương thức (tiền mặt + CK) vẫn gộp vào 1 voucher duy nhất của bulk settlement.
+        var allocations = new[]
+        {
+            new PaymentAllocationDraft(PaymentMethods.Cash, 6_000_000, 1, null, null),
+            new PaymentAllocationDraft(PaymentMethods.BankTransfer, 4_000_000, null, 2, "CK"),
+        };
+
+        Assert.Empty(PaymentAllocationValidator.Validate(allocations, 10_000_000));
+        var result = new FinancialSettlementResult(100, "TT-0002", [778], [20, 21]);
+        Assert.Single(result.CashVoucherIds);
+        Assert.Equal(10_000_000, allocations.Sum(a => a.AmountVnd));
+    }
+}
diff --git a/tests/Kazuko.Infrastructure.Tests/Finance/DebtDirectionColorMappingTests.cs b/tests/Kazuko.Infrastructure.Tests/Finance/DebtDirectionColorMappingTests.cs
new file mode 100644
index 0000000..835e61e
--- /dev/null
+++ b/tests/Kazuko.Infrastructure.Tests/Finance/DebtDirectionColorMappingTests.cs
@@ -0,0 +1,87 @@
+using Kazuko.Core.Finance;
+using Xunit;
+
+namespace Kazuko.Infrastructure.Tests.Finance;
+
+/// <summary>
+/// Wave 4 — spec #10.5: màu sắc theo hướng công nợ.
+/// Logic thuần, chạy được trên Linux.
+///
+/// Converter thật (DebtDirectionToBrushConverter trong
+/// src/Modules/Kazuko.Modules.Debt/DebtConverters.cs) là WPF IValueConverter và gọi
+/// Application.Current.TryFindResource(...) — cần WPF Application, KHÔNG khởi tạo được
+/// trên testhost Linux. Test này mirror đúng bảng quyết định của Convert() ở mức
+/// resource key (SuccessBrush / DangerBrush / TextSecondaryBrush, fallback Brushes.Gray),
+/// là phần logic duy nhất có thể kiểm chứng ngoài WPF.
+/// </summary>
+public sealed class DebtDirectionColorMappingTests
+{
+    /// <summary>
+    /// Mirror DebtDirectionToBrushConverter.Convert — trả về resource key thay vì Brush.
+    /// Production:
+    ///   if (amount > 0) → Direction == Pay ? "DangerBrush" : "SuccessBrush"
+    ///   else → "TextSecondaryBrush"
+    /// </summary>
+    private static string ResolveBrushKey(string direction, decimal amount)
+    {
+        if (amount > 0)
+        {
+            var brushKey = string.Equals(
+                direction, DebtLedgerDirections.Pay, StringComparison.OrdinalIgnoreCase)
+                ? "DangerBrush"
+                : "SuccessBrush";
+            return brushKey;
+        }
+
+        return "TextSecondaryBrush";
+    }
+
+    [Theory]
+    [InlineData("RECEIVE", 1_000_000, "SuccessBrush")]   // phải thu > 0 → xanh lá
+    [InlineData("PAY", 1_000_000, "DangerBrush")]        // phải trả > 0 → đỏ
+    [InlineData("RECEIVE", 0, "TextSecondaryBrush")]     // = 0 → trung tính
+    [InlineData("PAY", 0, "TextSecondaryBrush")]         // = 0 → trung tính
+    [InlineData("RECEIVE", -500_000, "TextSecondaryBrush")] // âm → trung tính (không tô theo dấu)
+    [InlineData("PAY", -500_000, "TextSecondaryBrush")]
+    public void DirectionColorMapping(string direction, decimal amount, string expectedKey)
+    {
+        Assert.Equal(expectedKey, ResolveBrushKey(direction, amount));
+    }
+
+    [Fact]
+    public void PayDirection_IsCaseInsensitive()
+    {
+        Assert.Equal("DangerBrush", ResolveBrushKey("pay", 100));
+        Assert.Equal("DangerBrush", ResolveBrushKey("Pay", 100));
+    }
+
+    [Fact]
+    public void UnknownDirection_FallsBackToReceiveColor()
+    {
+        // Production: chỉ đúng Pay (case-insensitive) mới lấy DangerBrush,
+        // mọi giá trị khác → SuccessBrush khi amount > 0.
+        Assert.Equal("SuccessBrush", ResolveBrushKey("UNKNOWN", 100));
+        Assert.Equal("SuccessBrush", ResolveBrushKey("", 100));
+    }
+
+    [Fact]
+    public void ConverterDefaultDirection_IsReceive()
+    {
+        // Production: public string Direction { get; set; } = DebtLedgerDirections.Receive;
+        Assert.Equal("RECEIVE", DebtLedgerDirections.Receive);
+        Assert.Equal("SuccessBrush", ResolveBrushKey(DebtLedgerDirections.Receive, 1));
+        Assert.Equal("DangerBrush", ResolveBrushKey(DebtLedgerDirections.Pay, 1));
+    }
+
+    [Fact]
+    public void ColorDependsOnDirection_NotOnSign()
+    {
+        // Ý đồ thiết kế (ghi trong XML doc của converter): "Tô màu số tiền theo HƯỚNG
+        // công nợ, không theo dấu âm/dương".
+        Assert.Equal(ResolveBrushKey("RECEIVE", 5_000_000), ResolveBrushKey("RECEIVE", 1));
+        Assert.Equal(ResolveBrushKey("PAY", 5_000_000), ResolveBrushKey("PAY", 1));
+        Assert.NotEqual(
+            ResolveBrushKey("RECEIVE", 5_000_000),
+            ResolveBrushKey("PAY", 5_000_000));
+    }
+}
