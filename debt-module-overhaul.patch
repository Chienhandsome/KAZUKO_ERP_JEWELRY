+        command.Parameters.Add("@METHOD", FbDbType.VarChar, 20).Value = paymentMethod;
+        command.Parameters.Add("@AMT", FbDbType.Decimal).Value = amountVnd;
+        command.Parameters.Add("@FUND", FbDbType.BigInt).Value =
