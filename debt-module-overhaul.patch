+    public bool CanShowCollectButton =>
+        Entry.CanSettle
+        && string.Equals(Entry.Direction, DebtLedgerDirections.Receive, StringComparison.OrdinalIgnoreCase)
+        && Entry.RemainingAmountVnd > 0;
