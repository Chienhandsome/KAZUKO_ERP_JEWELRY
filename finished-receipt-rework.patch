From f0bccd21cabf8bab2da70dcf2a8d5947b09e9572 Mon Sep 17 00:00:00 2001
From: Muse <muse@hatch.local>
Date: Wed, 14 Oct 2026 07:33:17 +0000
Subject: [PATCH 1/6] feat(db): add WORKER_GOLD_DEBTS table (migration 64)

---
 .../migrations/0064__worker_gold_debts.sql    | 93 +++++++++++++++++++
 1 file changed, 93 insertions(+)
 create mode 100644 database/migrations/0064__worker_gold_debts.sql

diff --git a/database/migrations/0064__worker_gold_debts.sql b/database/migrations/0064__worker_gold_debts.sql
new file mode 100644
index 0000000..5442c79
--- /dev/null
+++ b/database/migrations/0064__worker_gold_debts.sql
@@ -0,0 +1,93 @@
+/*
+================================================================================
+KAZUKO ERP JEWELRY - DATABASE MIGRATION SCRIPT
+================================================================================
+Migration Version: 64
+Migration Name:    WORKER_GOLD_DEBTS
+Description:       Add the WORKER_GOLD_DEBTS table to record gold debts owed by
+                   workers (HR employees) after the finished-receipt gold
+                   reconciliation (gold issued vs gold received vs loss).
+                   One production order can be recorded only once.
+Target Database:   Firebird 5.0 (Dialect 3, UTF8)
+================================================================================
+*/
+
+SET AUTODDL OFF;
+
+CREATE EXCEPTION EX_MIGRATION_CHECK 'Migration 64 validation failed';
+
+SET TERM ^ ;
+EXECUTE BLOCK AS
+DECLARE VARIABLE v_cnt INTEGER;
+BEGIN
+    SELECT COUNT(*) FROM SCHEMA_MIGRATIONS WHERE VERSION_NO = 64 INTO :v_cnt;
+    IF (:v_cnt > 0) THEN
+        EXCEPTION EX_MIGRATION_CHECK 'Phien ban migration 64 da ton tai.';
+
+    SELECT COUNT(*) FROM SCHEMA_MIGRATIONS WHERE VERSION_NO = 63 INTO :v_cnt;
+    IF (:v_cnt <> 1) THEN
+        EXCEPTION EX_MIGRATION_CHECK 'Can migration 63 truoc migration 64.';
+
+    SELECT COUNT(*) FROM RDB$RELATIONS WHERE RDB$RELATION_NAME = 'PRODUCTION_ORDERS' INTO :v_cnt;
+    IF (:v_cnt <> 1) THEN
+        EXCEPTION EX_MIGRATION_CHECK 'Thieu bang PRODUCTION_ORDERS.';
+
+    SELECT COUNT(*) FROM RDB$RELATIONS WHERE RDB$RELATION_NAME = 'WORKER_GOLD_DEBTS' INTO :v_cnt;
+    IF (:v_cnt > 0) THEN
+        EXCEPTION EX_MIGRATION_CHECK 'Bang WORKER_GOLD_DEBTS da ton tai.';
+END^
+SET TERM ; ^
+
+CREATE TABLE WORKER_GOLD_DEBTS (
+    ID BIGINT GENERATED BY DEFAULT AS IDENTITY NOT NULL,
+    COMPANY_ID BIGINT NOT NULL,
+    BRANCH_ID BIGINT NOT NULL,
+    CODE VARCHAR(40) NOT NULL,
+    WORKER_TYPE VARCHAR(20) NOT NULL,
+    WORKER_ID BIGINT NOT NULL,
+    WORKER_NAME VARCHAR(200) NOT NULL,
+    GOLD_PURITY_CODE VARCHAR(30),
+    WEIGHT_CHI NUMERIC(18,3) NOT NULL,
+    WEIGHT_ISSUED_CHI NUMERIC(18,3) NOT NULL,
+    WEIGHT_RECEIVED_CHI NUMERIC(18,3) NOT NULL,
+    WEIGHT_LOSS_CHI NUMERIC(18,3) DEFAULT 0 NOT NULL,
+    PRODUCTION_ORDER_ID BIGINT NOT NULL,
+    PRODUCTION_ORDER_CODE VARCHAR(40) NOT NULL,
+    STATUS_CODE VARCHAR(20) DEFAULT 'OPEN' NOT NULL,
+    NOTES VARCHAR(500),
+    CREATED_BY BIGINT,
+    CREATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,
+    CONSTRAINT PK_WORKER_GOLD_DEBTS PRIMARY KEY (ID),
+    CONSTRAINT FK_WGD_COMPANY FOREIGN KEY (COMPANY_ID) REFERENCES COMPANIES (ID),
+    CONSTRAINT FK_WGD_BRANCH FOREIGN KEY (BRANCH_ID) REFERENCES BRANCHES (ID),
+    CONSTRAINT UQ_WGD_CODE UNIQUE (COMPANY_ID, CODE),
+    CONSTRAINT UQ_WGD_ORDER UNIQUE (COMPANY_ID, PRODUCTION_ORDER_ID),
+    CONSTRAINT CK_WGD_WEIGHT_POSITIVE CHECK (WEIGHT_CHI > 0),
+    CONSTRAINT CK_WGD_WORKER_TYPE CHECK (WORKER_TYPE IN ('EMPLOYEE')),
+    CONSTRAINT CK_WGD_STATUS CHECK (STATUS_CODE IN ('OPEN', 'PARTIAL', 'PAID', 'CANCELLED'))
+);
+
+CREATE INDEX IX_WGD_WORKER_STATUS
+    ON WORKER_GOLD_DEBTS (COMPANY_ID, WORKER_ID, STATUS_CODE);
+
+CREATE INDEX IX_WGD_ORDER
+    ON WORKER_GOLD_DEBTS (COMPANY_ID, PRODUCTION_ORDER_ID);
+
+SET TERM ^ ;
+EXECUTE BLOCK AS
+DECLARE VARIABLE v_cnt INTEGER;
+BEGIN
+    SELECT COUNT(*) FROM RDB$RELATIONS WHERE RDB$RELATION_NAME = 'WORKER_GOLD_DEBTS' INTO :v_cnt;
+    IF (:v_cnt <> 1) THEN
+        EXCEPTION EX_MIGRATION_CHECK 'Khong tao duoc bang WORKER_GOLD_DEBTS.';
+
+    SELECT COUNT(*) FROM RDB$RELATION_CONSTRAINTS
+    WHERE RDB$RELATION_NAME = 'WORKER_GOLD_DEBTS'
+      AND RDB$CONSTRAINT_NAME IN ('UQ_WGD_CODE', 'UQ_WGD_ORDER')
+    INTO :v_cnt;
+    IF (:v_cnt <> 2) THEN
+        EXCEPTION EX_MIGRATION_CHECK 'Thieu unique constraint tren WORKER_GOLD_DEBTS.';
+END^
+SET TERM ; ^
+
+DROP EXCEPTION EX_MIGRATION_CHECK;
-- 
2.43.0


