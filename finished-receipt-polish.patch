From: Muse <muse@hatch.local>
Date: Wed, 14 Oct 2026 08:37:34 +0000
Subject: [PATCH 1/2] feat(warehouse): add separate gold reconciliation dialog

---
 .../GoldReconcileDialog.xaml                  | 112 ++++++++++++++++++
 .../GoldReconcileDialog.xaml.cs               |  21 ++++
 2 files changed, 133 insertions(+)
 create mode 100644 src/Modules/Kazuko.Modules.Warehouse/GoldReconcileDialog.xaml
 create mode 100644 src/Modules/Kazuko.Modules.Warehouse/GoldReconcileDialog.xaml.cs

diff --git a/src/Modules/Kazuko.Modules.Warehouse/GoldReconcileDialog.xaml b/src/Modules/Kazuko.Modules.Warehouse/GoldReconcileDialog.xaml
new file mode 100644
index 0000000..f0a4753
--- /dev/null
+++ b/src/Modules/Kazuko.Modules.Warehouse/GoldReconcileDialog.xaml
@@ -0,0 +1,112 @@
+<Window x:Class="Kazuko.Modules.Warehouse.GoldReconcileDialog"
+        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
+        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
+        xmlns:conv="clr-namespace:Kazuko.Modules.Warehouse.Converters"
+        Title="Đối chiếu vàng" Width="720" Height="480"
+        MinWidth="640" MinHeight="440" WindowStartupLocation="CenterOwner"
+        ShowInTaskbar="False"
+        Background="{DynamicResource AppBackgroundBrush}">
+  <Window.Resources>
+    <ResourceDictionary>
+      <ResourceDictionary.MergedDictionaries>
+        <ResourceDictionary Source="Themes/WarehouseResources.xaml" />
+      </ResourceDictionary.MergedDictionaries>
+      <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
+      <conv:NullOrEmptyToVisibilityConverter x:Key="NotNullToVis" Invert="True" />
+    </ResourceDictionary>
+  </Window.Resources>
+
+  <Grid Margin="20">
+    <Grid.RowDefinitions>
+      <RowDefinition Height="Auto" />
+      <RowDefinition Height="*" />
+      <RowDefinition Height="Auto" />
+    </Grid.RowDefinitions>
+
+    <TextBlock Grid.Row="0"
+               Text="Đối chiếu vàng — chênh lệch ghi công nợ thợ"
+               Style="{StaticResource WhSectionHeaderStyle}"
+               Foreground="{DynamicResource PrimaryBrush}"
+               FontWeight="SemiBold"
+               Margin="0,0,0,16" />
+
+    <Border Grid.Row="1"
+            Style="{DynamicResource CardBorderStyle}"
+            Padding="16"
+            VerticalAlignment="Top">
+      <Grid>
+        <Grid.ColumnDefinitions>
+          <ColumnDefinition Width="*" />
+          <ColumnDefinition Width="16" />
+          <ColumnDefinition Width="*" />
+        </Grid.ColumnDefinitions>
+        <Grid.RowDefinitions>
+          <RowDefinition Height="Auto" />
+          <RowDefinition Height="12" />
+          <RowDefinition Height="Auto" />
+          <RowDefinition Height="12" />
+          <RowDefinition Height="Auto" />
+        </Grid.RowDefinitions>
+
+        <StackPanel Grid.Row="0" Grid.Column="0">
+          <TextBlock Text="Vàng đã giao (chỉ)" Style="{StaticResource WhFieldLabelStyle}" />
+          <TextBlock Text="{Binding IssuedGold, StringFormat={}{0:0.###}}"
+                     Style="{StaticResource WhSummaryValueStyle}" />
+        </StackPanel>
+        <StackPanel Grid.Row="0" Grid.Column="2">
+          <TextBlock Text="Vàng đã nhận (chỉ)" Style="{StaticResource WhFieldLabelStyle}" />
+          <TextBlock Text="{Binding ReceivedGold, StringFormat={}{0:0.###}}"
+                     Style="{StaticResource WhSummaryValueStyle}" />
+        </StackPanel>
+
+        <StackPanel Grid.Row="2" Grid.Column="0">
+          <TextBlock Text="Hao hụt (chỉ)" Style="{StaticResource WhFieldLabelStyle}" />
+          <TextBox Text="{Binding LossWeightText, UpdateSourceTrigger=PropertyChanged}"
+                   Style="{StaticResource WhRoundedTextBoxStyle}" MinHeight="36"
+                   ToolTip="Nhân viên tự gõ. Hao hụt không ghi công nợ." />
+        </StackPanel>
+        <StackPanel Grid.Row="2" Grid.Column="2">
+          <TextBlock Text="Nợ vàng (chỉ)" Style="{StaticResource WhFieldLabelStyle}" />
+          <TextBlock Text="{Binding DebtGoldDisplay}"
+                     Style="{StaticResource WhSummaryValueStyle}"
+                     Foreground="{DynamicResource DangerBrush}" />
+        </StackPanel>
+
+        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2">
+          <TextBlock Text="Thợ" Style="{StaticResource WhFieldLabelStyle}" />
+          <ComboBox ItemsSource="{Binding WorkerOptions}"
+                    SelectedItem="{Binding SelectedWorker}"
+                    Style="{StaticResource WhComboStyle}" MinHeight="36">
+            <ComboBox.ItemTemplate>
+              <DataTemplate>
+                <TextBlock>
+                  <Run Text="{Binding FullName, Mode=OneWay}" />
+                  <Run Text=" (" Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding EmployeeCode, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text=")" Foreground="{DynamicResource TextSecondaryBrush}" />
+                </TextBlock>
+              </DataTemplate>
+            </ComboBox.ItemTemplate>
+          </ComboBox>
+        </StackPanel>
+      </Grid>
+    </Border>
+
+    <StackPanel Grid.Row="2" Margin="0,16,0,0">
+      <TextBlock Text="{Binding ReconcileMessage}"
+                 Foreground="{DynamicResource TextSecondaryBrush}"
+                 FontSize="{DynamicResource FontSize.Caption}"
+                 TextWrapping="Wrap" Margin="0,0,0,12"
+                 Visibility="{Binding ReconcileMessage, Converter={StaticResource NotNullToVis}}" />
+      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
+        <Button Content="Ghi công nợ"
+                Command="{Binding RecordDebtCommand}"
+                Style="{StaticResource WhPrimaryButtonStyle}"
+                MinWidth="140" MinHeight="40" Margin="0,0,8,0" />
+        <Button Content="Đóng"
+                Click="CloseButton_OnClick"
+                Style="{StaticResource WhOutlineButtonStyle}"
+                MinWidth="100" MinHeight="40"
+                IsCancel="True" />
+      </StackPanel>
+    </StackPanel>
+  </Grid>
+</Window>
diff --git a/src/Modules/Kazuko.Modules.Warehouse/GoldReconcileDialog.xaml.cs b/src/Modules/Kazuko.Modules.Warehouse/GoldReconcileDialog.xaml.cs
new file mode 100644
index 0000000..94b6ad2
--- /dev/null
+++ b/src/Modules/Kazuko.Modules.Warehouse/GoldReconcileDialog.xaml.cs
@@ -0,0 +1,21 @@
+using System.Windows;
+
+namespace Kazuko.Modules.Warehouse;
+
+/// <summary>
+/// Dialog đối chiếu vàng: hiển thị vàng đã giao / đã nhận / hao hụt / nợ vàng
+/// và cho phép ghi công nợ thợ. Dùng chung DataContext với dialog nhập kho.
+/// </summary>
+public partial class GoldReconcileDialog : Window
+{
+    public GoldReconcileDialog(ProductionFinishedReceiptDialogViewModel viewModel)
+    {
+        InitializeComponent();
+        DataContext = viewModel;
+    }
+
+    private void CloseButton_OnClick(object sender, RoutedEventArgs e)
+    {
+        DialogResult = false;
+    }
+}
-- 
