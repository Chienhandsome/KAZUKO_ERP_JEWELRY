<Application x:Class="Kazuko.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnLastWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Kazuko.Shared.UI;component/Themes/Light.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Kazuko.Shared.UI;component/Themes/Typography.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Kazuko.Shared.UI;component/Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
