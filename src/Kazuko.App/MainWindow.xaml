<Window x:Class="Kazuko.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kazuko ERP Jewelry"
        MinWidth="1180" MinHeight="720"
        WindowStyle="None" ResizeMode="CanResize"
        WindowState="Maximized" WindowStartupLocation="CenterScreen"
        Closed="Window_Closed">
    <Window.Resources>
        <Style x:Key="PriceBoardButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="8,4" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PriceBoardBorder" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PriceBoardBorder" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PriceBoardBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Subtitle}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChromeBackground" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChromeBackground" Property="Background"
                                        Value="{DynamicResource PrimaryHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="50" />
            <Setter Property="Margin" Value="15,3" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background"
                                        Value="{DynamicResource SurfaceAltBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="True">
                                <Setter TargetName="NavBorder" Property="Background"
                                        Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="True">
                    <Setter Property="Margin" Value="10,3" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="52" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarLogoutButtonStyle" TargetType="Button"
               BasedOn="{StaticResource SidebarNavButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="15,7,15,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="True">
                    <Setter Property="Margin" Value="10,7,10,0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="52" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" MinWidth="135" />
                    <ColumnDefinition Width="500" />
                    <ColumnDefinition Width="144" />
                </Grid.ColumnDefinitions>

                <TextBlock Margin="18,0,12,0"
                           Text="KAZUKO ERP JEWELRY - PHẦN MỀM QUẢN LÝ XƯỞNG CHẾ TÁC TRANG SỨC"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource OnPrimaryBrush}"
                           FontSize="{DynamicResource FontSize.Subtitle}"
                           FontWeight="Bold" TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" />

                <Button Grid.Column="1" Command="{Binding NavigatePriceBoardCommand}"
                        Visibility="{Binding PriceBoardVisibility}"
                        Style="{StaticResource PriceBoardButtonStyle}"
                        Content="❖  TỈ GIÁ" />

                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="HOTLINE: 0917.66.4444  -  "
                               Foreground="{DynamicResource OnPrimaryBrush}"
                               FontSize="{DynamicResource FontSize.Body}" FontWeight="Bold" />
                    <TextBlock FontSize="{DynamicResource FontSize.Body}" FontWeight="Bold">
                        <Hyperlink NavigateUri="http://www.kazukovietnam.com/"
                                   Foreground="{DynamicResource OnPrimaryBrush}"
                                   RequestNavigate="Website_RequestNavigate">www.kazukovietnam.com</Hyperlink>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Style="{StaticResource TitleBarButtonStyle}" Content="&#xE921;"
                            ToolTip="Thu nhỏ" Click="Minimize_Click" />
                    <Button Style="{StaticResource TitleBarButtonStyle}" Content="&#xE922;"
                            ToolTip="Phóng to/Khôi phục" Click="MaximizeRestore_Click" />
                    <Button Style="{StaticResource TitleBarButtonStyle}" Content="&#xE8BB;"
                            ToolTip="Đóng" Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding SidebarWidth, Mode=OneWay}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    ClipToBounds="True">
                <Grid Margin="0,12,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Option 2: toggle lives inside the sidebar, styled like nav items -->
                    <Button Grid.Row="0"
                            Command="{Binding ToggleSidebarCommand}"
                            ToolTip="{Binding SidebarToggleToolTip, Mode=OneWay}"
                            Style="{StaticResource SidebarNavButtonStyle}">
                        <Grid>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{Binding SidebarToggleGlyph, Mode=OneWay}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="{DynamicResource FontSize.Subtitle}"
                                           Width="40" TextAlignment="Center"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SidebarToggleLabel, Mode=OneWay}"
                                           Margin="6,0,0,0" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSize.Subtitle}"
                                           FontWeight="Bold" />
                            </StackPanel>
                            <TextBlock Text="{Binding SidebarToggleGlyph, Mode=OneWay}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{DynamicResource FontSize.Subtitle}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Button>

                    <ScrollViewer Grid.Row="1" Margin="0,6,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False">
                        <ItemsControl ItemsSource="{Binding NavigationItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding NavigateCommand}"
                                            Tag="{Binding IsActive}"
                                            ToolTip="{Binding Item.Label, Mode=OneWay}"
                                            Style="{StaticResource SidebarNavButtonStyle}">
                                        <Grid>
                                            <!-- Expanded: icon + label -->
                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                         Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Grid Width="40" Height="38">
                                                    <Image Source="{Binding Item.IconUri, Mode=OneWay, Converter={StaticResource PathToImageSourceConverter}}"
                                                           Width="40" Height="38" Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Item.IconUri, Mode=OneWay}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                    <TextBlock Text="{Binding Item.IconGlyph, Mode=OneWay}"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="{DynamicResource FontSize.Display}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Item.IconUri, Mode=OneWay}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                                <TextBlock Text="{Binding Item.Label, Mode=OneWay}"
                                                           Margin="10,0,0,0" VerticalAlignment="Center"
                                                           FontSize="{DynamicResource FontSize.Subtitle}"
                                                           FontWeight="Bold" TextWrapping="NoWrap" />
                                            </StackPanel>

                                            <!-- Collapsed: centered icon only -->
                                            <Grid Width="40" Height="38"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                         Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Image Source="{Binding Item.IconUri, Mode=OneWay, Converter={StaticResource PathToImageSourceConverter}}"
                                                       Width="36" Height="34" Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Item.IconUri, Mode=OneWay}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                                <TextBlock Text="{Binding Item.IconGlyph, Mode=OneWay}"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="{DynamicResource FontSize.Heading}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Item.IconUri, Mode=OneWay}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="2" Text="Hotline tư vấn:&#x0a;0917.66.4444"
                               Margin="0,8,0,4"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" Foreground="{DynamicResource PrimaryHoverBrush}"
                               FontSize="{DynamicResource FontSize.Subtitle}" FontWeight="Bold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button Grid.Row="3"
                            Command="{Binding LogoutCommand}"
                            Style="{StaticResource SidebarLogoutButtonStyle}">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="{DynamicResource FontSize.Display}"
                                           Width="40" TextAlignment="Center"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="ĐĂNG XUẤT" Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSize.Subtitle}"
                                           FontWeight="Bold" />
                            </StackPanel>
                            <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="{DynamicResource FontSize.Heading}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding CurrentView, Mode=OneWay}" />
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource PrimaryBrush}">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34*" />
                    <ColumnDefinition Width="32*" />
                    <ColumnDefinition Width="34*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="KAZUKO ERP JEWELRY"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource OnPrimaryBrush}"
                           FontSize="{DynamicResource FontSize.Subtitle}" FontWeight="Bold" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                           Foreground="{DynamicResource OnPrimaryBrush}"
                           FontSize="{DynamicResource FontSize.Subtitle}">
                    <Run Text="Người dùng:  " /><Run Text="{Binding DisplayName, Mode=OneWay}" />
                </TextBlock>
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="▣  " Foreground="{DynamicResource OnPrimaryBrush}"
                               FontSize="{DynamicResource FontSize.Subtitle}" />
                    <TextBlock Text="{Binding DateText, Mode=OneWay}" Foreground="{DynamicResource OnPrimaryBrush}"
                               FontSize="{DynamicResource FontSize.Subtitle}" />
                    <TextBlock Text="     ◷  " Foreground="{DynamicResource OnPrimaryBrush}"
                               FontSize="{DynamicResource FontSize.Subtitle}" />
                    <TextBlock Text="{Binding TimeText, Mode=OneWay}" Foreground="{DynamicResource OnPrimaryBrush}"
                               FontSize="{DynamicResource FontSize.Subtitle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
