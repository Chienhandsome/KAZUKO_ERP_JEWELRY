<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.Primary">#FFFF6B00</Color>
    <Color x:Key="Color.PrimaryHover">#FFE65F00</Color>
    <Color x:Key="Color.AppBackground">#FFF7F3EC</Color>
    <Color x:Key="Color.Surface">#FFFFFFFF</Color>
    <Color x:Key="Color.SurfaceAlt">#FFFFF8F1</Color>
    <Color x:Key="Color.TextPrimary">#FF000000</Color>
    <!-- Giao diện sáng dùng chữ đen thống nhất cho label, chú thích và dữ liệu nhập. -->
    <Color x:Key="Color.TextSecondary">#FF000000</Color>
    <Color x:Key="Color.Border">#FFE7DED4</Color>
    <Color x:Key="Color.Success">#FF268A56</Color>
    <Color x:Key="Color.Danger">#FFC94141</Color>
    <Color x:Key="Color.Money">#FFE24A0F</Color>
    <Color x:Key="Color.OnPrimary">#FFFFFFFF</Color>
    <Color x:Key="Color.Chart.Finished">#FF3B82F6</Color>
    <Color x:Key="Color.Chart.Sale">#FF22A06B</Color>
    <Color x:Key="Color.Chart.Purple">#FF7C5CFC</Color>
    <Color x:Key="Color.Chart.Muted">#FF9CA3AF</Color>
    <Color x:Key="Color.Link">#FF2563EB</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Color.Primary}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource Color.PrimaryHover}" />
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource Color.AppBackground}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="MoneyBrush" Color="{StaticResource Color.Money}" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource Color.OnPrimary}" />
    <SolidColorBrush x:Key="ChartBrush.Raw" Color="{StaticResource Color.Primary}" />
    <SolidColorBrush x:Key="ChartBrush.Finished" Color="{StaticResource Color.Chart.Finished}" />
    <SolidColorBrush x:Key="ChartBrush.Sale" Color="{StaticResource Color.Chart.Sale}" />
    <SolidColorBrush x:Key="ChartBrush.Purple" Color="{StaticResource Color.Chart.Purple}" />
    <SolidColorBrush x:Key="ChartBrush.Muted" Color="{StaticResource Color.Chart.Muted}" />
    <SolidColorBrush x:Key="LinkBrush" Color="{StaticResource Color.Link}" />
</ResourceDictionary>
