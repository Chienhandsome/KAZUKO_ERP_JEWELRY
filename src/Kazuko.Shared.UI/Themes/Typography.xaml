<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">
    <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>
    <system:Double x:Key="FontSize.Caption">12</system:Double>
    <system:Double x:Key="FontSize.Body">14</system:Double>
    <system:Double x:Key="FontSize.Subtitle">16</system:Double>
    <system:Double x:Key="FontSize.Heading">22</system:Double>
    <system:Double x:Key="FontSize.Display">32</system:Double>
</ResourceDictionary>
