<Window x:Class="Kazuko.Shared.UI.Controls.CatalogDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="940" Height="640" MinWidth="660" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="DetailLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,10,0,2" />
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="{Binding SearchHint}"
                       Style="{StaticResource DetailLabel}" Margin="0,0,0,4" />
            <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource FormTextBoxStyle}"
                     AutomationProperties.Name="{Binding SearchHint}" />
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="5*" />
            </Grid.ColumnDefinitions>
            <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
                     AutomationProperties.Name="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                     Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                     SelectionChanged="OnCustomerSelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="8,4">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource DetailLabel}" Margin="0,2,0,0">
                                <Run Text="{Binding Code, Mode=OneWay}" />
                                <Run Text="{Binding Phone, Mode=OneWay, StringFormat='  {0}'}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <ContentControl Content="{Binding Selected}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           FontSize="{DynamicResource FontSize.Subtitle}" />
                                                <TextBlock Text="{Binding DataContext.SelectedContext, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                <TextBlock Text="Mã" Style="{StaticResource DetailLabel}" />
                                                <TextBlock Text="{Binding Code}" />
                                                <StackPanel Visibility="{Binding ShowContactDetails, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Điện thoại" Style="{StaticResource DetailLabel}" />
                                                <TextBlock Text="{Binding Phone}" />
                                                <TextBlock Text="Nhóm" Style="{StaticResource DetailLabel}" />
                                                <TextBlock Text="{Binding DataContext.SelectedGroupName, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                <TextBlock Text="Địa chỉ" Style="{StaticResource DetailLabel}" />
                                                <TextBlock Text="{Binding Address}" />
                                                <TextBlock Text="Email" Style="{StaticResource DetailLabel}" />
                                                <TextBlock Text="{Binding Email}" />
                                                </StackPanel>
                                                <TextBlock Text="Trạng thái" Style="{StaticResource DetailLabel}" />
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Text" Value="Đang giao dịch" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Text" Value="Ngừng giao dịch" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="Content" Value="{x:Null}">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ContentControl">
                                                    <TextBlock Text="Chọn một dòng để xem chi tiết."
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </ScrollViewer>
            </Border>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" />
            <TextBlock Text="Đang xử lý…" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <WrapPanel Margin="0,6,0,0">
                <Button Content="Thêm mới" Command="{Binding AddCommand}"
                        Style="{DynamicResource FormPrimaryButtonStyle}" Margin="0,0,8,6" />
                <Button Content="Sửa" Command="{Binding EditCommand}"
                        Style="{DynamicResource FormSecondaryButtonStyle}" Margin="0,0,8,6" />
                <Button Content="Xóa" Command="{Binding DeleteCommand}" ToolTip="{Binding DeleteHint}"
                        Foreground="{DynamicResource DangerBrush}"
                        Style="{DynamicResource FormSecondaryButtonStyle}" Margin="0,0,8,6" />
                <Button Content="Chọn" Command="{Binding ChooseCommand}"
                        Visibility="{Binding CanChoose, Converter={StaticResource BoolToVisibility}}"
                        Style="{DynamicResource FormSecondaryButtonStyle}" Margin="0,0,8,6" />
                <Button Content="Đóng" IsCancel="True" Style="{DynamicResource FormSecondaryButtonStyle}"
                        Margin="0,0,0,6" />
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
