<Window x:Class="Kazuko.Modules.Finance.VoucherCategoryEditorDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Thêm loại thu/chi" Width="500" Height="430" MinWidth="440" MinHeight="380"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource AppBackgroundBrush}"
 Foreground="{DynamicResource TextPrimaryBrush}" FontSize="{DynamicResource FontSize.Body}">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="Themes/FinanceResources.xaml" />
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <DockPanel Margin="20">
  <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,16,0,0">
   <Button Content="Lưu loại mới" Command="{Binding SaveCommand}" Style="{StaticResource FinancePrimaryButtonStyle}"
           IsDefault="True" Margin="0,0,8,0" />
   <Button Content="Hủy" IsCancel="True" Click="Cancel_Click" Style="{StaticResource FinanceOutlineButtonStyle}" />
  </WrapPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
   <StackPanel IsEnabled="{Binding CanEdit}">
    <TextBlock x:Name="Heading" Style="{StaticResource FinanceSectionHeaderStyle}" Margin="0,0,0,12" />
    <TextBlock Text="Mã loại" Style="{StaticResource FinanceFieldLabelStyle}" />
    <TextBox x:Name="CodeInput" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" MaxLength="40"
             Style="{StaticResource FinanceRoundedTextBoxStyle}" Margin="0,0,0,6" />
    <TextBlock Text="Chữ không dấu, số, dấu gạch ngang hoặc gạch dưới."
               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSize.Caption}"
               TextWrapping="Wrap" Margin="0,0,0,12" />
    <TextBlock Text="Tên loại" Style="{StaticResource FinanceFieldLabelStyle}" />
    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="150"
             Style="{StaticResource FinanceRoundedTextBoxStyle}" Margin="0,0,0,12" />
    <CheckBox Content="Đang sử dụng" IsChecked="{Binding IsActive}" Foreground="{DynamicResource TextPrimaryBrush}" />
    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
               AutomationProperties.LiveSetting="Polite" />
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</Window>
