<UserControl x:Class="Kazuko.Modules.Finance.FinanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kazuko.Modules.Finance"
             MinWidth="960" MinHeight="560">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/FinanceResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,14">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Image Source="/Kazuko.Modules.Finance;component/Assets/icons/TC.png"
               Width="48" Height="48" Stretch="Uniform" Margin="0,0,12,0" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="TÀI CHÍNH"
                     Foreground="{DynamicResource PrimaryBrush}"
                     FontSize="{DynamicResource FontSize.Heading}"
                     FontWeight="Bold" />
          <TextBlock Text="Tổng quan thu chi — phiếu thu / chi — số dư quỹ &amp; ngân hàng"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     FontSize="{DynamicResource FontSize.Body}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}" Padding="12">
      <TabControl SelectedIndex="{Binding SelectedTabIndex}"
                  Background="Transparent"
                  BorderThickness="0"
                  ItemContainerStyle="{StaticResource FinanceTabItemStyle}">
        <TabItem Header="Tổng quan">
          <local:FinanceOverviewView DataContext="{Binding Overview}" Margin="0,12,0,0" />
        </TabItem>
        <TabItem Header="Thu">
          <local:VoucherListView DataContext="{Binding Income}" Margin="0,12,0,0" />
        </TabItem>
        <TabItem Header="Chi">
          <local:VoucherListView DataContext="{Binding Expense}" Margin="0,12,0,0" />
        </TabItem>
      </TabControl>
    </Border>
  </Grid>
</UserControl>
