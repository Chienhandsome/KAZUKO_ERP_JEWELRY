<Window x:Class="Kazuko.Modules.Finance.CashVoucherDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:Kazuko.Shared.UI.Behaviors;assembly=Kazuko.Shared.UI"
        xmlns:local="clr-namespace:Kazuko.Modules.Finance"
        Title="{Binding Title}"
        Width="620" Height="700"
        MinWidth="560" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/FinanceResources.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <local:NullOrEmptyToVisibilityConverter x:Key="NotEmptyToVis" Invert="True" />
      <BooleanToVisibilityConverter x:Key="BoolToVis" />

      <Style x:Key="DialogFieldStyle" TargetType="TextBox" BasedOn="{StaticResource FinanceRoundedTextBoxStyle}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Margin" Value="0,0,0,12" />
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Hủy"
              Style="{StaticResource FinanceOutlineButtonStyle}"
              Command="{Binding CancelCommand}"
              MinHeight="40" MinWidth="100" Margin="0,0,8,0" IsCancel="True" />
      <Button Content="Lưu"
              Style="{StaticResource FinancePrimaryButtonStyle}"
              Command="{Binding SaveCommand}"
              MinHeight="40" MinWidth="120" IsDefault="True" />
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="{Binding Title}"
                   FontSize="{DynamicResource FontSize.Heading}"
                   Foreground="{DynamicResource PrimaryBrush}"
                   FontWeight="Bold" />
        <TextBlock Text="{Binding SubtitleText}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="{DynamicResource FontSize.Body}"
                   Margin="0,4,0,12"
                   TextWrapping="Wrap" />
        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="{DynamicResource DangerBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmptyToVis}}" />

        <!-- Section phân bổ công nợ: chỉ hiện khi mở từ module Công nợ -->
        <StackPanel Visibility="{Binding IsDebtMode, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="Phân bổ công nợ" Style="{StaticResource FinanceFieldLabelStyle}" FontWeight="Bold" />
          <DataGrid ItemsSource="{Binding DebtAllocations}"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False" CanUserDeleteRows="False"
                    HeadersVisibility="Column"
                    MinHeight="80" MaxHeight="220"
                    Margin="0,0,0,8">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Khoản nợ" Binding="{Binding DisplayName}" Width="*" IsReadOnly="True" />
              <DataGridTextColumn Header="Còn lại (VND)" Binding="{Binding RemainingAmountVnd, StringFormat=N0}" Width="130" IsReadOnly="True">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextAlignment" Value="Right" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTemplateColumn Header="Thanh toán (VND)" Width="150">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBox Text="{Binding PaymentAmountText, UpdateSourceTrigger=LostFocus}"
                             IsReadOnly="{Binding IsAmountReadOnly}"
                             behaviors:NumericThousandSeparatorBehavior.EnableLiveThousandSeparator="True"
                             HorizontalContentAlignment="Right" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
            <TextBlock Text="Tổng phân bổ: " Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Text="{Binding TotalAllocationAmount, StringFormat=N0}" FontWeight="Bold" />
            <TextBlock Text=" VND" Foreground="{DynamicResource TextSecondaryBrush}" />
          </StackPanel>
        </StackPanel>

        <TextBlock Text="Loại" Style="{StaticResource FinanceFieldLabelStyle}" />
        <TextBox Text="{Binding VoucherTypeName, Mode=OneWay}" Style="{StaticResource DialogFieldStyle}"
                 IsReadOnly="True" Background="{DynamicResource SurfaceAltBrush}" />

        <TextBlock Text="Ngày" Style="{StaticResource FinanceFieldLabelStyle}" />
        <DatePicker SelectedDate="{Binding VoucherDate}" MinHeight="40" Margin="0,0,0,12"
                    VerticalContentAlignment="Center" />

        <!-- 3 ô phương thức thanh toán luôn hiển thị -->
        <TextBlock Text="Phương thức thanh toán" Style="{StaticResource FinanceFieldLabelStyle}" FontWeight="Bold" />
        <Grid Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,6,0">
            <TextBlock Text="Tiền mặt (VND)" Style="{StaticResource FinanceFieldLabelStyle}" />
            <TextBox Text="{Binding CashAmountText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource DialogFieldStyle}"
                     HorizontalContentAlignment="Right"
                             behaviors:NumericThousandSeparatorBehavior.EnableLiveThousandSeparator="True" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="3,0,3,0">
            <TextBlock Text="Chuyển khoản (VND)" Style="{StaticResource FinanceFieldLabelStyle}" />
            <TextBox Text="{Binding BankTransferAmountText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource DialogFieldStyle}"
                     HorizontalContentAlignment="Right"
                             behaviors:NumericThousandSeparatorBehavior.EnableLiveThousandSeparator="True" />
          </StackPanel>
          <StackPanel Grid.Column="2" Margin="6,0,0,0">
            <TextBlock Text="Thẻ (VND)" Style="{StaticResource FinanceFieldLabelStyle}" />
            <TextBox Text="{Binding CardAmountText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource DialogFieldStyle}"
                     HorizontalContentAlignment="Right"
                             behaviors:NumericThousandSeparatorBehavior.EnableLiveThousandSeparator="True" />
          </StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
          <TextBlock Text="Tổng thanh toán: " Foreground="{DynamicResource TextSecondaryBrush}" />
          <TextBlock Text="{Binding TotalPaymentAmount, StringFormat=N0}" FontWeight="Bold" />
          <TextBlock Text=" VND" Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <TextBlock Text="Quỹ tiền mặt (cho tiền mặt)" Style="{StaticResource FinanceFieldLabelStyle}" />
        <ComboBox ItemsSource="{Binding Funds}" SelectedItem="{Binding SelectedFund}"
                  DisplayMemberPath="Name"
                  Style="{StaticResource FinanceFilterComboStyle}"
                  MinHeight="40" Margin="0,0,0,12" />

        <TextBlock Text="Tài khoản ngân hàng (cho CK/thẻ)" Style="{StaticResource FinanceFieldLabelStyle}" />
        <ComboBox ItemsSource="{Binding Banks}" SelectedItem="{Binding SelectedBank}"
                  Style="{StaticResource FinanceFilterComboStyle}"
                  MinHeight="40" Margin="0,0,0,12">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock>
                <Run Text="{Binding BankName}" />
                <Run Text=" - " />
                <Run Text="{Binding AccountNumber}" />
              </TextBlock>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="Đối tượng" Style="{StaticResource FinanceFieldLabelStyle}" />
        <TextBox Text="{Binding PartyName, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource DialogFieldStyle}" />

        <TextBlock Text="Diễn giải" Style="{StaticResource FinanceFieldLabelStyle}" />
        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource DialogFieldStyle}"
                 MinHeight="72" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalContentAlignment="Top" Padding="12,8" />

        <TextBlock Text="Tham chiếu (không bắt buộc)" Style="{StaticResource FinanceFieldLabelStyle}" />
        <TextBox Text="{Binding ReferenceNumber, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource DialogFieldStyle}" Margin="0,0,0,4" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
