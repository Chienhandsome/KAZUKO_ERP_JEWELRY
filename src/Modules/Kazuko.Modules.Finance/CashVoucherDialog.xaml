<Window x:Class="Kazuko.Modules.Finance.CashVoucherDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kazuko.Modules.Finance"
        Title="{Binding Title}"
        Width="520" Height="600"
        MinWidth="480" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}">
  <Window.Resources>
    <local:NullOrEmptyToVisibilityConverter x:Key="NotEmptyToVis" Invert="True" />

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="DialogFieldStyle" TargetType="TextBox">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Hủy" Style="{DynamicResource NavButtonStyle}" Command="{Binding CancelCommand}"
              MinHeight="40" MinWidth="100" Margin="0,0,8,0" IsCancel="True" />
      <Button Content="Lưu" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding SaveCommand}"
              MinHeight="40" MinWidth="120" IsDefault="True" />
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="{Binding Title}"
                   FontSize="{DynamicResource FontSize.Heading}"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   FontWeight="SemiBold" />
        <TextBlock Text="Phiếu được ghi sổ ngay sau khi lưu."
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,4,0,12"
                   TextWrapping="Wrap" />
        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="{DynamicResource DangerBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmptyToVis}}" />

        <TextBlock Text="Loại" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Text="{Binding VoucherTypeName, Mode=OneWay}" Style="{StaticResource DialogFieldStyle}"
                 IsReadOnly="True" Margin="0,0,0,12" />

        <TextBlock Text="Ngày" Style="{StaticResource FieldLabelStyle}" />
        <DatePicker SelectedDate="{Binding VoucherDate}" MinHeight="40" Margin="0,0,0,12"
                    VerticalContentAlignment="Center" />

        <TextBlock Text="Số tiền (VND)" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource DialogFieldStyle}" Margin="0,0,0,12" />

        <TextBlock Text="Phương thức" Style="{StaticResource FieldLabelStyle}" />
        <ComboBox ItemsSource="{Binding PaymentMethodOptions}" SelectedItem="{Binding SelectedPaymentMethod}"
                  MinHeight="40" Margin="0,0,0,12" VerticalContentAlignment="Center"
                  FontSize="{DynamicResource FontSize.Body}" />

        <TextBlock Text="Đối tượng" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Text="{Binding PartyName, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource DialogFieldStyle}" Margin="0,0,0,12" />

        <TextBlock Text="Diễn giải" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource DialogFieldStyle}" Margin="0,0,0,12"
                 MinHeight="72" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalContentAlignment="Top" Padding="12,8" />

        <TextBlock Text="Tham chiếu (không bắt buộc)" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Text="{Binding ReferenceNumber, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource DialogFieldStyle}" Margin="0,0,0,4" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
