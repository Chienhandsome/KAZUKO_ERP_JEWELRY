<UserControl x:Class="Kazuko.Modules.Finance.FinanceOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kazuko.Modules.Finance"
             Background="{DynamicResource AppBackgroundBrush}">
  <UserControl.Resources>
    <local:BoolToVisibilityConverter x:Key="BoolToVis" />
    <local:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
    <local:NullOrEmptyToVisibilityConverter x:Key="NotEmptyToVis" Invert="True" />
    <local:BrushKeyToBrushConverter x:Key="BrushKeyToBrush" />

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Subtitle}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
    </Style>

    <Style x:Key="KpiValueStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Heading}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,4,0,2" />
    </Style>
  </UserControl.Resources>

  <UserControl.InputBindings>
    <KeyBinding Key="F1" Command="{Binding AddVoucherCommand}" />
  </UserControl.InputBindings>

  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
    <StackPanel>
      <TextBlock Text="{Binding ErrorMessage}"
                 Foreground="{DynamicResource DangerBrush}"
                 TextWrapping="Wrap"
                 Margin="0,0,0,8"
                 Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmptyToVis}}" />

      <!-- 4 thẻ KPI -->
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}" Padding="16" Margin="0,0,6,0">
          <StackPanel>
            <TextBlock Text="Tổng thu trong tháng" Style="{StaticResource FieldLabelStyle}" />
            <TextBlock Text="{Binding TotalIncomeMonthText, StringFormat={}{0} đ}" Style="{StaticResource KpiValueStyle}" Foreground="{DynamicResource SuccessBrush}" />
            <TextBlock Foreground="{Binding IncomeGrowthBrushKey, Converter={StaticResource BrushKeyToBrush}}">
              <Run Text="▲ " /><Run Text="{Binding IncomeGrowthText}" /><Run Text=" so với tháng trước" />
            </TextBlock>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{DynamicResource CardBorderStyle}" Padding="16" Margin="6,0">
          <StackPanel>
            <TextBlock Text="Tổng chi trong tháng" Style="{StaticResource FieldLabelStyle}" />
            <TextBlock Text="{Binding TotalExpenseMonthText, StringFormat={}{0} đ}" Style="{StaticResource KpiValueStyle}" Foreground="{DynamicResource DangerBrush}" />
            <TextBlock Foreground="{Binding ExpenseGrowthBrushKey, Converter={StaticResource BrushKeyToBrush}}">
              <Run Text="▲ " /><Run Text="{Binding ExpenseGrowthText}" /><Run Text=" so với tháng trước" />
            </TextBlock>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{DynamicResource CardBorderStyle}" Padding="16" Margin="6,0">
          <StackPanel>
            <TextBlock Text="Tồn quỹ tiền mặt" Style="{StaticResource FieldLabelStyle}" />
            <TextBlock Text="{Binding CashFundBalanceText, StringFormat={}{0} đ}" Style="{StaticResource KpiValueStyle}" />
            <TextBlock Text="VND" Style="{StaticResource FieldLabelStyle}" HorizontalAlignment="Right" />
          </StackPanel>
        </Border>

        <Border Grid.Column="3" Style="{DynamicResource CardBorderStyle}" Padding="16" Margin="6,0,0,0">
          <StackPanel>
            <TextBlock Text="Tổng số dư ngân hàng" Style="{StaticResource FieldLabelStyle}" />
            <TextBlock Text="{Binding BankBalanceTotalText, StringFormat={}{0} đ}" Style="{StaticResource KpiValueStyle}" Foreground="{DynamicResource PrimaryBrush}" />
            <TextBlock Text="VND" Style="{StaticResource FieldLabelStyle}" HorizontalAlignment="Right" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- Biểu đồ + cơ cấu + số dư quỹ -->
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="1.1*" />
          <ColumnDefinition Width="1.1*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}" Padding="16" Margin="0,0,6,0">
          <StackPanel>
            <DockPanel Margin="0,0,0,8">
              <TextBlock Text="Biểu đồ thu chi trong 12 tháng" Style="{StaticResource SectionHeaderStyle}" />
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Rectangle Width="12" Height="12" Fill="{DynamicResource ChartBrush.Sale}" RadiusX="2" RadiusY="2" />
                <TextBlock Text="Thu" Style="{StaticResource FieldLabelStyle}" Margin="4,0,12,0" VerticalAlignment="Center" />
                <Rectangle Width="12" Height="12" Fill="{DynamicResource DangerBrush}" RadiusX="2" RadiusY="2" />
                <TextBlock Text="Chi" Style="{StaticResource FieldLabelStyle}" Margin="4,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding MonthlyBars}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="5,0" Width="44">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Height="150">
                      <Rectangle Width="11" VerticalAlignment="Bottom"
                                 Height="{Binding IncomeHeight}"
                                 Fill="{DynamicResource ChartBrush.Sale}"
                                 RadiusX="2" RadiusY="2"
                                 ToolTip="{Binding IncomeText, StringFormat=Thu: {0} đ}" />
                      <Rectangle Width="11" VerticalAlignment="Bottom" Margin="3,0,0,0"
                                 Height="{Binding ExpenseHeight}"
                                 Fill="{DynamicResource DangerBrush}"
                                 RadiusX="2" RadiusY="2"
                                 ToolTip="{Binding ExpenseText, StringFormat=Chi: {0} đ}" />
                    </StackPanel>
                    <TextBlock Text="{Binding MonthLabel}" HorizontalAlignment="Center"
                               Style="{StaticResource FieldLabelStyle}" Margin="0,4,0,0" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{DynamicResource CardBorderStyle}" Padding="16" Margin="6,0">
          <StackPanel>
            <TextBlock Text="Cơ cấu chi phí tháng này" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding ExpenseBreakdown}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,5">
                    <Ellipse Width="12" Height="12" VerticalAlignment="Center"
                             Fill="{Binding BrushKey, Converter={StaticResource BrushKeyToBrush}}" />
                    <TextBlock Text="{Binding PercentText}" DockPanel.Dock="Right"
                               Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"
                               VerticalAlignment="Center" MinWidth="52" TextAlignment="Right" />
                    <TextBlock Text="{Binding Category}" Style="{StaticResource FieldLabelStyle}"
                               Margin="8,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Chưa có dữ liệu chi phí tháng này"
                       Style="{StaticResource FieldLabelStyle}" FontStyle="Italic">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Setter Property="FontStyle" Value="Italic" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ExpenseBreakdown.Count}" Value="0">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{DynamicResource CardBorderStyle}" Padding="16" Margin="6,0,0,0">
          <StackPanel>
            <TextBlock Text="Số dư quỹ &amp; ngân hàng" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding FundBalances}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,5">
                    <Border Width="30" Height="30" CornerRadius="6" Margin="0,0,8,0"
                            Background="{DynamicResource SurfaceAltBrush}">
                      <TextBlock Text="{Binding KindBadge}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold"
                                 FontSize="{DynamicResource FontSize.Caption}" />
                    </Border>
                    <TextBlock Text="{Binding BalanceText}" DockPanel.Dock="Right"
                               Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding FundName}" Style="{StaticResource FieldLabelStyle}"
                               VerticalAlignment="Center" TextWrapping="Wrap" />
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0">
              <DockPanel>
                <TextBlock Text="Tổng cộng" Style="{StaticResource SectionHeaderStyle}" />
                <TextBlock Text="{Binding FundTotalText}" DockPanel.Dock="Right"
                           Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold"
                           FontSize="{DynamicResource FontSize.Subtitle}" />
              </DockPanel>
            </Border>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Danh sách thu chi gần đây -->
      <Border Style="{DynamicResource CardBorderStyle}" Padding="16" Margin="0,0,0,12">
        <StackPanel>
          <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Danh sách thu chi gần đây" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="+ Thêm phiếu thu/chi (F1)"
                    Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding AddVoucherCommand}"
                    MinHeight="36" Padding="16,0" />
          </DockPanel>

          <WrapPanel Margin="0,0,0,8" VerticalAlignment="Center">
            <ComboBox ItemsSource="{Binding VoucherKindOptions}" SelectedItem="{Binding SelectedKind}"
                      MinWidth="140" MinHeight="36" Margin="0,0,8,8" VerticalContentAlignment="Center" />
            <TextBlock Text="Từ ngày" VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Margin="0,0,4,8" />
            <DatePicker SelectedDate="{Binding FromDate}" MinHeight="36" Margin="0,0,8,8" VerticalContentAlignment="Center" />
            <TextBlock Text="Đến ngày" VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Margin="0,0,4,8" />
            <DatePicker SelectedDate="{Binding ToDate}" MinHeight="36" Margin="0,0,8,8" VerticalContentAlignment="Center" />
            <TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" MinWidth="200" MinHeight="36"
                     Margin="0,0,8,8" VerticalContentAlignment="Center" Padding="8,4" />
            <Button Content="Tìm kiếm" Style="{DynamicResource PrimaryButtonStyle}"
                    Command="{Binding SearchCommand}" MinHeight="36" MinWidth="110" Margin="0,0,8,8" />
            <Button Content="Làm mới" Style="{DynamicResource NavButtonStyle}"
                    Command="{Binding RefreshCommand}" MinHeight="36" MinWidth="100" Margin="0,0,0,8" />
          </WrapPanel>

          <DataGrid ItemsSource="{Binding RecentVouchers}" AutoGenerateColumns="False" IsReadOnly="True"
                    MaxHeight="320" VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
              <DataGridTextColumn Header="STT" Binding="{Binding Index}" Width="45" />
              <DataGridTextColumn Header="Ngày" Binding="{Binding DateText}" Width="90" />
              <DataGridTextColumn Header="Số phiếu" Binding="{Binding Code}" Width="110" />
              <DataGridTextColumn Header="Loại" Binding="{Binding TypeText}" Width="60" />
              <DataGridTextColumn Header="Nội dung" Binding="{Binding Content}" Width="*" />
              <DataGridTextColumn Header="Đối tượng" Binding="{Binding PartyName}" Width="180" />
              <DataGridTextColumn Header="Hình thức" Binding="{Binding PaymentMethodText}" Width="110" />
              <DataGridTextColumn Header="Thu (VND)" Binding="{Binding IncomeText}" Width="120">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Chi (VND)" Binding="{Binding ExpenseText}" Width="120">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Người thực hiện" Binding="{Binding CreatedByName}" Width="140" />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <!-- Công nợ + lợi nhuận -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="0.8*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}" Padding="16" Margin="0,0,6,0">
          <StackPanel>
            <TextBlock Text="Công nợ phải thu (Khách hàng)" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8" />
            <DataGrid ItemsSource="{Binding TopReceivables}" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" MaxHeight="220">
              <DataGrid.Columns>
                <DataGridTextColumn Header="STT" Binding="{Binding Index}" Width="40" />
                <DataGridTextColumn Header="Mã KH" Binding="{Binding Code}" Width="90" />
                <DataGridTextColumn Header="Tên khách hàng" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Còn nợ" Binding="{Binding RemainingText}" Width="110">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="HorizontalAlignment" Value="Right" />
                      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                      <Setter Property="FontWeight" Value="SemiBold" />
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{DynamicResource CardBorderStyle}" Padding="16" Margin="6,0">
          <StackPanel>
            <TextBlock Text="Công nợ phải trả (Nhà cung cấp)" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8" />
            <DataGrid ItemsSource="{Binding TopPayables}" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" MaxHeight="220">
              <DataGrid.Columns>
                <DataGridTextColumn Header="STT" Binding="{Binding Index}" Width="40" />
                <DataGridTextColumn Header="Nhà cung cấp" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Còn nợ" Binding="{Binding RemainingText}" Width="110">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="HorizontalAlignment" Value="Right" />
                      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                      <Setter Property="FontWeight" Value="SemiBold" />
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{DynamicResource CardBorderStyle}" Padding="16" Margin="6,0,0,0">
          <StackPanel>
            <TextBlock Text="Lợi nhuận tháng này" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8" />
            <Grid Margin="0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Doanh thu" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding RevenueText}" HorizontalAlignment="Right"
                         Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" />
            </Grid>
            <Grid Margin="0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Chi phí" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding ProfitExpenseText}" HorizontalAlignment="Right"
                         Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" />
            </Grid>
            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12" Margin="0,8,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Lợi nhuận" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding ProfitText}" HorizontalAlignment="Right"
                           FontSize="{DynamicResource FontSize.Subtitle}" FontWeight="Bold"
                           Foreground="{Binding ProfitBrushKey, Converter={StaticResource BrushKeyToBrush}}" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
