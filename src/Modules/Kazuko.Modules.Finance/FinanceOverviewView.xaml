<UserControl x:Class="Kazuko.Modules.Finance.FinanceOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:access="clr-namespace:Kazuko.Shared.UI.Behaviors;assembly=Kazuko.Shared.UI"
             xmlns:local="clr-namespace:Kazuko.Modules.Finance"
             xmlns:grid="clr-namespace:Kazuko.Shared.UI.DataGridLayout;assembly=Kazuko.Shared.UI"
             Background="Transparent">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/FinanceResources.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <local:BoolToVisibilityConverter x:Key="BoolToVis" />
      <local:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
      <local:NullOrEmptyToVisibilityConverter x:Key="NotEmptyToVis" Invert="True" />
      <local:BrushKeyToBrushConverter x:Key="BrushKeyToBrush" />
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.InputBindings>
    <KeyBinding Key="F1" Command="{Binding AddVoucherCommand}" />
  </UserControl.InputBindings>

  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
    <StackPanel>
      <TextBlock Text="{Binding ErrorMessage}"
                 Foreground="{DynamicResource DangerBrush}"
                 TextWrapping="Wrap"
                 Margin="0,0,0,8"
                 Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmptyToVis}}" />

      <!-- 4 thẻ KPI -->
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}" Padding="14,10">
          <StackPanel>
            <TextBlock Text="Tổng thu trong tháng" Style="{StaticResource FinanceFieldLabelStyle}" />
            <TextBlock Text="{Binding TotalIncomeMonthText, StringFormat={}{0} đ}"
                       Style="{StaticResource FinanceKpiValueStyle}"
                       Foreground="{DynamicResource SuccessBrush}" />
            <TextBlock Foreground="{Binding IncomeGrowthBrushKey, Converter={StaticResource BrushKeyToBrush}}"
                       FontSize="{DynamicResource FontSize.Caption}">
              <Run Text="▲ " /><Run Text="{Binding IncomeGrowthText, Mode=OneWay}" /><Run Text=" so với tháng trước" />
            </TextBlock>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{DynamicResource CardBorderStyle}" Padding="14,10">
          <StackPanel>
            <TextBlock Text="Tổng chi trong tháng" Style="{StaticResource FinanceFieldLabelStyle}" />
            <TextBlock Text="{Binding TotalExpenseMonthText, StringFormat={}{0} đ}"
                       Style="{StaticResource FinanceKpiValueStyle}"
                       Foreground="{DynamicResource DangerBrush}" />
            <TextBlock Foreground="{Binding ExpenseGrowthBrushKey, Converter={StaticResource BrushKeyToBrush}}"
                       FontSize="{DynamicResource FontSize.Caption}">
              <Run Text="▲ " /><Run Text="{Binding ExpenseGrowthText, Mode=OneWay}" /><Run Text=" so với tháng trước" />
            </TextBlock>
          </StackPanel>
        </Border>

        <Border Grid.Column="4" Style="{DynamicResource CardBorderStyle}" Padding="14,10">
          <StackPanel>
            <TextBlock Text="Tồn quỹ tiền mặt" Style="{StaticResource FinanceFieldLabelStyle}" />
            <TextBlock Text="{Binding CashFundBalanceText, StringFormat={}{0} đ}"
                       Style="{StaticResource FinanceKpiValueStyle}" />
            <TextBlock Text="VND" Style="{StaticResource FinanceFieldLabelStyle}" HorizontalAlignment="Right" />
          </StackPanel>
        </Border>

        <Border Grid.Column="6" Style="{DynamicResource CardBorderStyle}" Padding="14,10">
          <StackPanel>
            <TextBlock Text="Tổng số dư ngân hàng" Style="{StaticResource FinanceFieldLabelStyle}" />
            <TextBlock Text="{Binding BankBalanceTotalText, StringFormat={}{0} đ}"
                       Style="{StaticResource FinanceKpiValueStyle}"
                       Foreground="{DynamicResource PrimaryBrush}" />
            <TextBlock Text="VND" Style="{StaticResource FinanceFieldLabelStyle}" HorizontalAlignment="Right" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- Biểu đồ + cơ cấu + số dư quỹ -->
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="1.1*" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="1.1*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}" Padding="14">
          <StackPanel>
            <DockPanel Margin="0,0,0,8">
              <TextBlock Text="Biểu đồ thu chi trong 12 tháng" Style="{StaticResource FinanceSectionHeaderStyle}" />
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Rectangle Width="12" Height="12" Fill="{DynamicResource ChartBrush.Sale}" RadiusX="2" RadiusY="2" />
                <TextBlock Text="Thu" Style="{StaticResource FinanceFieldLabelStyle}" Margin="4,0,12,0" VerticalAlignment="Center" />
                <Rectangle Width="12" Height="12" Fill="{DynamicResource DangerBrush}" RadiusX="2" RadiusY="2" />
                <TextBlock Text="Chi" Style="{StaticResource FinanceFieldLabelStyle}" Margin="4,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding MonthlyBars}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="5,0" Width="44">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Height="150">
                      <Rectangle Width="11" VerticalAlignment="Bottom"
                                 Height="{Binding IncomeHeight}"
                                 Fill="{DynamicResource ChartBrush.Sale}"
                                 RadiusX="2" RadiusY="2"
                                 ToolTip="{Binding IncomeText, StringFormat=Thu: {0} đ}" />
                      <Rectangle Width="11" VerticalAlignment="Bottom" Margin="3,0,0,0"
                                 Height="{Binding ExpenseHeight}"
                                 Fill="{DynamicResource DangerBrush}"
                                 RadiusX="2" RadiusY="2"
                                 ToolTip="{Binding ExpenseText, StringFormat=Chi: {0} đ}" />
                    </StackPanel>
                    <TextBlock Text="{Binding MonthLabel}" HorizontalAlignment="Center"
                               Style="{StaticResource FinanceFieldLabelStyle}" Margin="0,4,0,0" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{DynamicResource CardBorderStyle}" Padding="14">
          <StackPanel>
            <TextBlock Text="Cơ cấu chi phí tháng này" Style="{StaticResource FinanceSectionHeaderStyle}" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding ExpenseBreakdown}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,5">
                    <Ellipse Width="12" Height="12" VerticalAlignment="Center"
                             Fill="{Binding BrushKey, Converter={StaticResource BrushKeyToBrush}}" />
                    <TextBlock Text="{Binding PercentText}" DockPanel.Dock="Right"
                               Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"
                               VerticalAlignment="Center" MinWidth="52" TextAlignment="Right" />
                    <TextBlock Text="{Binding Category}" Style="{StaticResource FinanceFieldLabelStyle}"
                               Margin="8,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Chưa có dữ liệu chi phí tháng này">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource FinanceFieldLabelStyle}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Setter Property="FontStyle" Value="Italic" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ExpenseBreakdown.Count}" Value="0">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Border>

        <Border Grid.Column="4" Style="{DynamicResource CardBorderStyle}" Padding="14">
          <StackPanel>
            <TextBlock Text="Số dư quỹ &amp; ngân hàng" Style="{StaticResource FinanceSectionHeaderStyle}" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding FundBalances}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,5">
                    <Border Width="30" Height="30" CornerRadius="6" Margin="0,0,8,0"
                            Background="{DynamicResource SurfaceAltBrush}">
                      <TextBlock Text="{Binding KindBadge}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold"
                                 FontSize="{DynamicResource FontSize.Caption}" />
                    </Border>
                    <TextBlock Text="{Binding BalanceText}" DockPanel.Dock="Right"
                               Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding FundName}" Style="{StaticResource FinanceFieldLabelStyle}"
                               VerticalAlignment="Center" TextWrapping="Wrap" />
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0">
              <DockPanel>
                <TextBlock Text="Tổng cộng" Style="{StaticResource FinanceSectionHeaderStyle}" />
                <TextBlock Text="{Binding FundTotalText}" DockPanel.Dock="Right"
                           Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold"
                           FontSize="{DynamicResource FontSize.Subtitle}" />
              </DockPanel>
            </Border>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Danh sách thu chi gần đây -->
      <Border Style="{DynamicResource CardBorderStyle}" Padding="14" Margin="0,0,0,12">
        <DockPanel LastChildFill="True">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="False">
            <Button access:PermissionAccess.Rule="FIN_CASH_IN:Add|FIN_CASH_OUT:Add" DockPanel.Dock="Right"
                    Content="+ Thêm phiếu thu/chi (F1)"
                    Style="{StaticResource FinancePrimaryButtonStyle}"
                    Command="{Binding AddVoucherCommand}"
                    MinWidth="200"
                    HorizontalAlignment="Right" />
            <TextBlock Text="Danh sách thu chi gần đây"
                       Style="{StaticResource FinanceSectionHeaderStyle}"
                       VerticalAlignment="Center" />
          </DockPanel>

          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="Tìm kiếm"
                      Style="{StaticResource FinancePrimaryButtonStyle}"
                      Command="{Binding SearchCommand}"
                      MinWidth="110"
                      Margin="0,0,8,0" />
              <Button Content="Làm mới"
                      Style="{StaticResource FinanceOutlineButtonStyle}"
                      Command="{Binding RefreshCommand}"
                      MinWidth="100"
                      Margin="0" />
            </StackPanel>
            <WrapPanel VerticalAlignment="Center">
              <ComboBox ItemsSource="{Binding VoucherKindOptions}" SelectedItem="{Binding SelectedKind}"
                        Style="{StaticResource FinanceFilterComboStyle}" MinWidth="140" />
              <TextBlock Text="Từ ngày" VerticalAlignment="Center" Margin="0,0,6,0"
                         Style="{StaticResource FinanceFieldLabelStyle}" />
              <DatePicker SelectedDate="{Binding FromDate}" Width="120" Height="36" Margin="0,0,8,0"
                          VerticalContentAlignment="Center" />
              <TextBlock Text="Đến ngày" VerticalAlignment="Center" Margin="0,0,6,0"
                         Style="{StaticResource FinanceFieldLabelStyle}" />
              <DatePicker SelectedDate="{Binding ToDate}" Width="120" Height="36" Margin="0,0,8,0"
                          VerticalContentAlignment="Center" />
              <TextBox MinWidth="180" Style="{StaticResource FinanceFilterFieldStyle}"
                       Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Tìm số phiếu, nội dung, đối tượng...">
                <TextBox.InputBindings>
                  <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                </TextBox.InputBindings>
              </TextBox>
            </WrapPanel>
          </DockPanel>

          <DataGrid ItemsSource="{Binding RecentVouchers}"
                    Style="{StaticResource FinanceDataGridStyle}"
                    ColumnHeaderStyle="{StaticResource FinanceDataGridColumnHeaderStyle}"
                    MaxHeight="320"
                    VerticalScrollBarVisibility="Auto"
                    grid:DataGridColumnLayout.SettingsKey="finance-overview-recent"
                    grid:DataGridColumnLayout.EnableHeaderMenu="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="STT" Binding="{Binding Index, Mode=OneWay}" Width="45"
                                  grid:DataGridColumnLayout.Key="Index" />
              <DataGridTextColumn Header="Ngày" Binding="{Binding DateText, Mode=OneWay}" Width="90"
                                  grid:DataGridColumnLayout.Key="Date" />
              <DataGridTextColumn Header="Số phiếu" Binding="{Binding Code, Mode=OneWay}" Width="110"
                                  grid:DataGridColumnLayout.Key="Code" />
              <DataGridTextColumn Header="Loại" Binding="{Binding TypeText, Mode=OneWay}" Width="60"
                                  grid:DataGridColumnLayout.Key="Type" />
              <DataGridTextColumn Header="Nội dung" Binding="{Binding Content, Mode=OneWay}" Width="*"
                                  grid:DataGridColumnLayout.Key="Content" />
              <DataGridTextColumn Header="Đối tượng" Binding="{Binding PartyName, Mode=OneWay}" Width="160"
                                  grid:DataGridColumnLayout.Key="Party" />
              <DataGridTextColumn Header="Hình thức" Binding="{Binding PaymentMethodText, Mode=OneWay}" Width="110"
                                  grid:DataGridColumnLayout.Key="Method" />
              <DataGridTextColumn Header="Thu (VND)" Binding="{Binding IncomeText, Mode=OneWay}" Width="110"
                                  grid:DataGridColumnLayout.Key="Income">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Chi (VND)" Binding="{Binding ExpenseText, Mode=OneWay}" Width="110"
                                  grid:DataGridColumnLayout.Key="Expense">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Người thực hiện" Binding="{Binding CreatedByName, Mode=OneWay}" Width="130"
                                  grid:DataGridColumnLayout.Key="Creator" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>

      <!-- Công nợ + lợi nhuận -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="0.8*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}" Padding="14">
          <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Top" Text="Công nợ phải thu (Khách hàng)"
                       Style="{StaticResource FinanceSectionHeaderStyle}" Margin="0,0,0,8" />
            <DataGrid ItemsSource="{Binding TopReceivables}"
                      Style="{StaticResource FinanceDataGridStyle}"
                      ColumnHeaderStyle="{StaticResource FinanceDataGridColumnHeaderStyle}"
                      MaxHeight="220"
                      grid:DataGridColumnLayout.SettingsKey="finance-overview-receivables"
                      grid:DataGridColumnLayout.EnableHeaderMenu="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="STT" Binding="{Binding Index, Mode=OneWay}" Width="40"
                                    grid:DataGridColumnLayout.Key="Index" />
                <DataGridTextColumn Header="Mã KH" Binding="{Binding Code, Mode=OneWay}" Width="90"
                                    grid:DataGridColumnLayout.Key="Code" />
                <DataGridTextColumn Header="Tên khách hàng" Binding="{Binding Name, Mode=OneWay}" Width="*"
                                    grid:DataGridColumnLayout.Key="Name" />
                <DataGridTextColumn Header="Còn nợ" Binding="{Binding RemainingText, Mode=OneWay}" Width="110"
                                    grid:DataGridColumnLayout.Key="Remaining">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="HorizontalAlignment" Value="Right" />
                      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                      <Setter Property="FontWeight" Value="SemiBold" />
                      <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>

        <Border Grid.Column="2" Style="{DynamicResource CardBorderStyle}" Padding="14">
          <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Top" Text="Công nợ phải trả (Nhà cung cấp)"
                       Style="{StaticResource FinanceSectionHeaderStyle}" Margin="0,0,0,8" />
            <DataGrid ItemsSource="{Binding TopPayables}"
                      Style="{StaticResource FinanceDataGridStyle}"
                      ColumnHeaderStyle="{StaticResource FinanceDataGridColumnHeaderStyle}"
                      MaxHeight="220"
                      grid:DataGridColumnLayout.SettingsKey="finance-overview-payables"
                      grid:DataGridColumnLayout.EnableHeaderMenu="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="STT" Binding="{Binding Index, Mode=OneWay}" Width="40"
                                    grid:DataGridColumnLayout.Key="Index" />
                <DataGridTextColumn Header="Nhà cung cấp" Binding="{Binding Name, Mode=OneWay}" Width="*"
                                    grid:DataGridColumnLayout.Key="Name" />
                <DataGridTextColumn Header="Còn nợ" Binding="{Binding RemainingText, Mode=OneWay}" Width="110"
                                    grid:DataGridColumnLayout.Key="Remaining">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="HorizontalAlignment" Value="Right" />
                      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                      <Setter Property="FontWeight" Value="SemiBold" />
                      <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>

        <Border Grid.Column="4" Style="{DynamicResource CardBorderStyle}" Padding="14">
          <StackPanel>
            <TextBlock Text="Lợi nhuận tháng này" Style="{StaticResource FinanceSectionHeaderStyle}" Margin="0,0,0,8" />
            <Grid Margin="0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Doanh thu" Style="{StaticResource FinanceFieldLabelStyle}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding RevenueText}" HorizontalAlignment="Right"
                         Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" />
            </Grid>
            <Grid Margin="0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Chi phí" Style="{StaticResource FinanceFieldLabelStyle}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding ProfitExpenseText}" HorizontalAlignment="Right"
                         Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" />
            </Grid>
            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12" Margin="0,8,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Lợi nhuận" Style="{StaticResource FinanceSectionHeaderStyle}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding ProfitText}" HorizontalAlignment="Right"
                           FontSize="{DynamicResource FontSize.Subtitle}" FontWeight="Bold"
                           Foreground="{Binding ProfitBrushKey, Converter={StaticResource BrushKeyToBrush}}" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
