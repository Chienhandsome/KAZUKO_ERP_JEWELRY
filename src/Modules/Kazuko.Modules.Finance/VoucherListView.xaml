<UserControl x:Class="Kazuko.Modules.Finance.VoucherListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kazuko.Modules.Finance"
             xmlns:grid="clr-namespace:Kazuko.Shared.UI.DataGridLayout;assembly=Kazuko.Shared.UI"
             Background="Transparent">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/FinanceResources.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <local:NullOrEmptyToVisibilityConverter x:Key="NotEmptyToVis" Invert="True" />
      <local:NullOrEmptyToVisibilityConverter x:Key="EmptyToVis" />
      <local:BoolToVisibilityConverter x:Key="BoolToVis" />
      <local:VoucherTypeToTextConverter x:Key="VoucherTypeToText" />
      <local:PaymentMethodToTextConverter x:Key="PaymentMethodToText" />
      <local:VoucherStatusToTextConverter x:Key="VoucherStatusToText" />
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1.25*" MinWidth="420" />
      <ColumnDefinition Width="10" />
      <ColumnDefinition Width="0.75*" MinWidth="280" />
    </Grid.ColumnDefinitions>

    <!-- Danh sách phiếu -->
    <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}" Padding="14">
      <DockPanel LastChildFill="True">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="False">
          <Button DockPanel.Dock="Right"
                  Content="{Binding AddButtonText}"
                  Style="{StaticResource FinancePrimaryButtonStyle}"
                  Command="{Binding AddCommand}"
                  MinWidth="150"
                  HorizontalAlignment="Right" />
          <TextBlock Text="{Binding Title}"
                     Style="{StaticResource FinanceSectionHeaderStyle}"
                     VerticalAlignment="Center" />
        </DockPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="True">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="Tìm kiếm"
                    Style="{StaticResource FinancePrimaryButtonStyle}"
                    Command="{Binding SearchCommand}"
                    MinWidth="110"
                    Margin="0,0,8,0" />
            <Button Content="Làm mới"
                    Style="{StaticResource FinanceOutlineButtonStyle}"
                    Command="{Binding RefreshCommand}"
                    MinWidth="100"
                    Margin="0" />
          </StackPanel>
          <WrapPanel VerticalAlignment="Center">
            <TextBlock Text="Từ ngày" VerticalAlignment="Center" Margin="0,0,6,0"
                       Style="{StaticResource FinanceFieldLabelStyle}" />
            <DatePicker SelectedDate="{Binding FromDate}" Width="120" Height="36" Margin="0,0,8,0"
                        VerticalContentAlignment="Center" />
            <TextBlock Text="Đến ngày" VerticalAlignment="Center" Margin="0,0,6,0"
                       Style="{StaticResource FinanceFieldLabelStyle}" />
            <DatePicker SelectedDate="{Binding ToDate}" Width="120" Height="36" Margin="0,0,8,0"
                        VerticalContentAlignment="Center" />
            <TextBox MinWidth="160" Style="{StaticResource FinanceFilterFieldStyle}"
                     Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Tìm số phiếu, nội dung, đối tượng...">
              <TextBox.InputBindings>
                <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
              </TextBox.InputBindings>
            </TextBox>
          </WrapPanel>
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}"
                   Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmptyToVis}}" />

        <DataGrid ItemsSource="{Binding Vouchers}"
                  SelectedItem="{Binding SelectedVoucher}"
                  Style="{StaticResource FinanceDataGridStyle}"
                  ColumnHeaderStyle="{StaticResource FinanceDataGridColumnHeaderStyle}"
                  VerticalScrollBarVisibility="Auto"
                  grid:DataGridColumnLayout.SettingsKey="finance-vouchers"
                  grid:DataGridColumnLayout.EnableHeaderMenu="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="STT" Binding="{Binding Index, Mode=OneWay}" Width="45"
                                grid:DataGridColumnLayout.Key="Index" />
            <DataGridTextColumn Header="Ngày" Binding="{Binding DateText, Mode=OneWay}" Width="90"
                                grid:DataGridColumnLayout.Key="Date" />
            <DataGridTextColumn Header="Số phiếu" Binding="{Binding Code, Mode=OneWay}" Width="110"
                                grid:DataGridColumnLayout.Key="Code" />
            <DataGridTextColumn Header="Nội dung" Binding="{Binding Content, Mode=OneWay}" Width="*"
                                grid:DataGridColumnLayout.Key="Content" />
            <DataGridTextColumn Header="Số tiền (VND)" Binding="{Binding AmountText, Mode=OneWay}" Width="140"
                                grid:DataGridColumnLayout.Key="Amount">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="HorizontalAlignment" Value="Right" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                  <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>

    <!-- Pane chi tiết -->
    <Border Grid.Column="2" Style="{DynamicResource CardBorderStyle}" Padding="14">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="Chi tiết phiếu"
                     Style="{StaticResource FinanceSectionHeaderStyle}"
                     Margin="0,0,0,12" />

          <TextBlock Text="Chọn một phiếu bên trái để xem chi tiết."
                     Style="{StaticResource FinanceFieldLabelStyle}"
                     FontStyle="Italic"
                     TextWrapping="Wrap"
                     Visibility="{Binding SelectedDetail, Converter={StaticResource EmptyToVis}}" />

          <StackPanel Visibility="{Binding SelectedDetail, Converter={StaticResource NotEmptyToVis}}">
            <TextBlock Text="Số phiếu" Style="{StaticResource FinanceFieldLabelStyle}" />
            <TextBox Text="{Binding SelectedDetail.Code, Mode=OneWay}"
                     Style="{StaticResource FinanceDetailValueStyle}"
                     FontWeight="SemiBold" />

            <TextBlock Text="Ngày" Style="{StaticResource FinanceFieldLabelStyle}" />
            <TextBox Text="{Binding SelectedDetail.VoucherDate, Mode=OneWay, StringFormat=dd/MM/yyyy}"
                     Style="{StaticResource FinanceDetailValueStyle}" />

            <TextBlock Text="Loại" Style="{StaticResource FinanceFieldLabelStyle}" />
            <TextBox Text="{Binding SelectedDetail.VoucherType, Mode=OneWay, Converter={StaticResource VoucherTypeToText}}"
                     Style="{StaticResource FinanceDetailValueStyle}" />

            <TextBlock Text="Hình thức" Style="{StaticResource FinanceFieldLabelStyle}" />
            <TextBox Text="{Binding SelectedDetail.PaymentMethod, Mode=OneWay, Converter={StaticResource PaymentMethodToText}}"
                     Style="{StaticResource FinanceDetailValueStyle}" />

            <TextBlock Text="Số tiền (VND)" Style="{StaticResource FinanceFieldLabelStyle}" />
            <TextBox Text="{Binding SelectedDetail.AmountVnd, Mode=OneWay, StringFormat=N0}"
                     Style="{StaticResource FinanceDetailValueStyle}"
                     FontWeight="Bold"
                     FontSize="{DynamicResource FontSize.Subtitle}" />

            <TextBlock Text="Đối tượng" Style="{StaticResource FinanceFieldLabelStyle}" />
            <TextBox Text="{Binding SelectedDetail.PartyName, Mode=OneWay, TargetNullValue=—}"
                     Style="{StaticResource FinanceDetailValueStyle}" />

            <TextBlock Text="Diễn giải" Style="{StaticResource FinanceFieldLabelStyle}" />
            <TextBox Text="{Binding SelectedDetail.Notes, Mode=OneWay, TargetNullValue=—}"
                     Style="{StaticResource FinanceDetailValueStyle}"
                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="48"
                     VerticalContentAlignment="Top" />

            <TextBlock Text="Tham chiếu" Style="{StaticResource FinanceFieldLabelStyle}" />
            <TextBox Text="{Binding SelectedDetail.ReferenceNumber, Mode=OneWay, TargetNullValue=—}"
                     Style="{StaticResource FinanceDetailValueStyle}" />

            <TextBlock Text="Người tạo" Style="{StaticResource FinanceFieldLabelStyle}" />
            <TextBox Text="{Binding SelectedDetail.CreatedByName, Mode=OneWay}"
                     Style="{StaticResource FinanceDetailValueStyle}" />

            <TextBlock Text="Trạng thái" Style="{StaticResource FinanceFieldLabelStyle}" />
            <TextBox Text="{Binding SelectedDetail.StatusCode, Mode=OneWay, Converter={StaticResource VoucherStatusToText}}"
                     Style="{StaticResource FinanceDetailValueStyle}"
                     FontWeight="SemiBold" />

            <Button Content="Hủy phiếu"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource FinanceDangerLinkButtonStyle}"
                    HorizontalAlignment="Left"
                    Margin="0,8,0,0"
                    Visibility="{Binding DetailCancellable, Converter={StaticResource BoolToVis}}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
