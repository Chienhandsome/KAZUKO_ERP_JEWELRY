<Window x:Class="Kazuko.Modules.HumanResources.ShiftEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm ca làm việc"
        Width="440" Height="380"
        MinWidth="400" MinHeight="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources><ResourceDictionary Source="Themes/HumanResourcesDialogResources.xaml" /></Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding DialogTitle, Mode=OneWay}"
                       FontSize="{DynamicResource FontSize.Subtitle}"
                       FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryBrush}" />
            <TextBlock Text="Mỗi ca tính 1 công. Enter để lưu, Escape để hủy."
                       FontSize="{DynamicResource FontSize.Caption}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
            <StackPanel>
                <TextBlock Text="Tên ca *" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSize.Caption}" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MinHeight="40" Margin="0,0,0,10"
                         Padding="10,6" FontSize="{DynamicResource FontSize.Body}" MaxLength="50"
                         Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Giờ bắt đầu (HH:mm)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSize.Caption}" />
                        <TextBox Text="{Binding StartTimeText, UpdateSourceTrigger=PropertyChanged}" MinHeight="40"
                                 Padding="10,6" FontSize="{DynamicResource FontSize.Body}" MaxLength="5"
                                 Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Giờ kết thúc (HH:mm)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSize.Caption}" />
                        <TextBox Text="{Binding EndTimeText, UpdateSourceTrigger=PropertyChanged}" MinHeight="40"
                                 Padding="10,6" FontSize="{DynamicResource FontSize.Body}" MaxLength="5"
                                 Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding ErrorMessage, Mode=OneWay}" Foreground="{DynamicResource DangerBrush}"
                           FontSize="{DynamicResource FontSize.Body}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Hủy (Esc)" Command="{Binding CancelCommand}" MinWidth="110" MinHeight="40" Margin="0,0,8,0"
                    Padding="16,8" FontSize="{DynamicResource FontSize.Body}"
                    Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand" IsCancel="True" />
            <Button Content="Lưu (Enter)" Command="{Binding SaveCommand}" MinWidth="130" MinHeight="40"
                    Padding="16,8" FontSize="{DynamicResource FontSize.Body}"
                    Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource OnPrimaryBrush}"
                    BorderThickness="0" Cursor="Hand" IsDefault="True" Style="{StaticResource HrDialogBasePrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
