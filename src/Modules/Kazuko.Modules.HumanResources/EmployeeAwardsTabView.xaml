<UserControl x:Class="Kazuko.Modules.HumanResources.EmployeeAwardsTabView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:access="clr-namespace:Kazuko.Shared.UI.Behaviors;assembly=Kazuko.Shared.UI"
 xmlns:layout="clr-namespace:Kazuko.Shared.UI.DataGridLayout;assembly=Kazuko.Shared.UI">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/HumanResourcesDialogResources.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <DockPanel Margin="0,12,8,0">
  <StackPanel DockPanel.Dock="Top">
   <WrapPanel Margin="0,0,0,10" IsEnabled="{Binding CanEdit}">
    <StackPanel Margin="0,0,10,6"><TextBlock Text="Từ ngày"/><DatePicker SelectedDate="{Binding From}" Width="170"/></StackPanel>
    <StackPanel Margin="0,0,10,6"><TextBlock Text="Đến ngày"/><DatePicker SelectedDate="{Binding To}" Width="170"/></StackPanel>
    <StackPanel Margin="0,0,10,6"><TextBlock Text="Tìm nhân viên / nội dung"/><TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" MinWidth="220"/></StackPanel>
    <Button Content="Tải lại" Command="{Binding LoadCommand}" VerticalAlignment="Bottom" Margin="0,0,10,6"/>
    <Button Content="Thêm khoản phát sinh" Command="{Binding AddCommand}" Style="{StaticResource HrDialogBasePrimaryButtonStyle}" access:PermissionAccess.Rule="CAT_EMPLOYEES:Add" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
   </WrapPanel>
   <TextBlock Text="Khoản vào lương được lấy khi Tính lại đúng kỳ; thu/chi riêng không cộng/trừ lại vào lương." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
   <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding Message}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
   <TextBlock Text="{Binding SelectedDescription}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
   <WrapPanel IsEnabled="{Binding CanEdit}">
    <StackPanel MinWidth="280" MaxWidth="500" Margin="0,0,10,6"><TextBlock Text="Lý do hủy"/><TextBox Text="{Binding CancelReason,UpdateSourceTrigger=PropertyChanged}" MaxLength="500"/></StackPanel>
    <Button Content="Hủy khoản đã chọn" Command="{Binding CancelCommand}" access:PermissionAccess.Rule="CAT_EMPLOYEES:Delete" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
   </WrapPanel>
  </StackPanel>
  <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
    Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" RowBackground="{DynamicResource SurfaceBrush}"
    AlternatingRowBackground="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" GridLinesVisibility="Horizontal"
    HorizontalGridLinesBrush="{DynamicResource BorderBrush}" FontSize="{DynamicResource FontSize.Body}" MinHeight="140"
    layout:DataGridColumnLayout.SettingsKey="HR.EmployeeAwards.v1" layout:DataGridColumnLayout.EnableHeaderMenu="True">
   <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="Padding" Value="8"/></Style></DataGrid.ColumnHeaderStyle>
   <DataGrid.Columns>
    <DataGridTextColumn Header="Ngày" Binding="{Binding EventDate,Mode=OneWay,StringFormat=dd/MM/yyyy}" Width="110" layout:DataGridColumnLayout.Key="Date"/>
    <DataGridTextColumn Header="Mã NV" Binding="{Binding EmployeeCode,Mode=OneWay}" Width="100" layout:DataGridColumnLayout.Key="EmployeeCode"/>
    <DataGridTextColumn Header="Nhân viên" Binding="{Binding EmployeeName,Mode=OneWay}" Width="180" layout:DataGridColumnLayout.Key="EmployeeName"/>
    <DataGridTextColumn Header="Loại" Binding="{Binding KindText,Mode=OneWay}" Width="115" layout:DataGridColumnLayout.Key="Kind"/>
    <DataGridTextColumn Header="Xử lý" Binding="{Binding HandlingText,Mode=OneWay}" Width="145" layout:DataGridColumnLayout.Key="Handling"/>
    <DataGridTextColumn Header="Số tiền" Binding="{Binding Amount,Mode=OneWay,StringFormat=N0}" Width="130" layout:DataGridColumnLayout.Key="Amount"/>
    <DataGridTextColumn Header="Kỳ lương" Binding="{Binding PeriodText,Mode=OneWay}" Width="100" layout:DataGridColumnLayout.Key="Period"/>
    <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText,Mode=OneWay}" Width="170" layout:DataGridColumnLayout.Key="Status"/>
    <DataGridTextColumn Header="Phiếu thu/chi" Binding="{Binding VoucherCode,Mode=OneWay}" Width="140" layout:DataGridColumnLayout.Key="Voucher"/>
    <DataGridTextColumn Header="Nội dung" Binding="{Binding Description,Mode=OneWay}" Width="250" layout:DataGridColumnLayout.Key="Description"/>
   </DataGrid.Columns>
  </DataGrid>
 </DockPanel>
</UserControl>
