<UserControl x:Class="Kazuko.Modules.HumanResources.PayrollTabView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:access="clr-namespace:Kazuko.Shared.UI.Behaviors;assembly=Kazuko.Shared.UI"
 xmlns:layout="clr-namespace:Kazuko.Shared.UI.DataGridLayout;assembly=Kazuko.Shared.UI">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/HumanResourcesDialogResources.xaml" /></ResourceDictionary.MergedDictionaries>
   <BooleanToVisibilityConverter x:Key="BoolToVis" />
   <Style x:Key="PayrollGridStyle" TargetType="DataGrid">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="RowBackground" Value="{DynamicResource SurfaceBrush}"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceAltBrush}"/>
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="VerticalGridLinesBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/><Setter Property="HeadersVisibility" Value="Column"/>
    <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/>
    <Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="GridLinesVisibility" Value="Horizontal"/>
    <Setter Property="CellStyle"><Setter.Value><Style TargetType="DataGridCell"><Setter Property="Padding" Value="8,4"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/></Trigger></Style.Triggers>
    </Style></Setter.Value></Setter>
    <Setter Property="ColumnHeaderStyle"><Setter.Value><Style TargetType="DataGridColumnHeader">
     <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
     <Setter Property="Padding" Value="8,8"/><Setter Property="BorderThickness" Value="0,0,1,1"/><Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style></Setter.Value></Setter>
   </Style>
   <Style x:Key="PayrollMoneyText" TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <Grid Margin="0,8,8,0" MinHeight="{Binding ViewportHeight,RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <WrapPanel Grid.Row="0" Margin="0,0,0,8">
   <StackPanel Margin="0,0,10,8" IsEnabled="{Binding CanSelectPeriod}"><TextBlock Text="Tháng"/><ComboBox ItemsSource="{Binding Months}" SelectedItem="{Binding Month}" MinWidth="80"/></StackPanel>
   <StackPanel Margin="0,0,10,8" IsEnabled="{Binding CanSelectPeriod}"><TextBlock Text="Năm"/><TextBox Text="{Binding YearText,UpdateSourceTrigger=PropertyChanged}" MaxLength="4" MinWidth="100"/></StackPanel>
   <Button Content="Tải kỳ" Command="{Binding LoadCommand}" VerticalAlignment="Bottom" Margin="0,0,10,8"/>
   <StackPanel Margin="0,0,10,8" IsEnabled="{Binding CanEditSettings}"><TextBlock Text="Ca chuẩn/ngày"/><TextBox Text="{Binding ShiftsPerDayText,UpdateSourceTrigger=PropertyChanged}" MaxLength="2" MinWidth="110"/></StackPanel>
   <CheckBox Content="Nghỉ có phép được tính lương" IsChecked="{Binding IncludePaidLeave}" IsEnabled="{Binding CanEditSettings}" VerticalAlignment="Bottom" Margin="0,0,12,16"/>
   <Button Content="Tính lại" Command="{Binding CalculateCommand}" Style="{StaticResource HrDialogBasePrimaryButtonStyle}" access:PermissionAccess.Rule="HR_PAYROLL:Add" VerticalAlignment="Bottom" Margin="0,0,10,8"/>
   <Button Content="Chốt bảng lương" Command="{Binding CloseCommand}" access:PermissionAccess.Rule="HR_PAYROLL:Edit" VerticalAlignment="Bottom" Margin="0,0,10,8"/>
   <Button Content="Chi tiết / Điều chỉnh" Command="{Binding DetailsCommand}" VerticalAlignment="Bottom" Margin="0,0,10,8"/>
   <Button Content="Xuất Excel" Command="{Binding ExportCommand}" CommandParameter="{Binding ElementName=PayrollGrid}" access:PermissionAccess.Rule="DATA_EXPORT" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
  </WrapPanel>
  <WrapPanel Grid.Row="1" Margin="0,0,0,8">
   <StackPanel MinWidth="230" Margin="0,0,14,0"><TextBlock Text="Tìm nhân viên"/><TextBox Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}" ToolTip="Tìm theo mã hoặc tên nhân viên"/></StackPanel>
   <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,4"/>
  </WrapPanel>
  <StackPanel Grid.Row="2" Margin="0,0,0,8">
   <TextBlock Text="Công chuẩn trừ ngày nghỉ tuần theo hồ sơ; lương tháng chia công chuẩn. Công chuẩn theo ca = ngày chuẩn × ca chuẩn/ngày. Đổi lựa chọn cần tính lại trước khi chốt." FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding Message}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
  </StackPanel>
  <DataGrid x:Name="PayrollGrid" Grid.Row="3" MinHeight="180" MaxHeight="600" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedLine}" Style="{StaticResource PayrollGridStyle}" MouseDoubleClick="PayrollGrid_MouseDoubleClick"
    layout:DataGridColumnLayout.SettingsKey="HR.Payroll.v1" layout:DataGridColumnLayout.EnableHeaderMenu="True" layout:DataGridColumnLayout.AutoFitOnFirstLoad="True">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Mã NV" Binding="{Binding Code}" Width="100" layout:DataGridColumnLayout.Key="Code"/>
    <DataGridTextColumn Header="Nhân viên" Binding="{Binding FullName}" Width="190" layout:DataGridColumnLayout.Key="FullName"/>
    <DataGridTextColumn Header="Cách tính" Binding="{Binding MethodLabel}" Width="165" layout:DataGridColumnLayout.Key="MethodLabel"/>
    <DataGridTextColumn Header="Công chuẩn" Binding="{Binding StandardUnits,StringFormat=N0}" Width="100" layout:DataGridColumnLayout.Key="StandardUnits" ElementStyle="{StaticResource PayrollMoneyText}"/>
    <DataGridTextColumn Header="Công tính lương" Binding="{Binding ActualUnits,StringFormat=N0}" Width="115" layout:DataGridColumnLayout.Key="ActualUnits" ElementStyle="{StaticResource PayrollMoneyText}"/>
    <DataGridTextColumn Header="Lương ca/tháng" Binding="{Binding Rate,StringFormat=N0}" Width="140" layout:DataGridColumnLayout.Key="Rate" ElementStyle="{StaticResource PayrollMoneyText}"/>
    <DataGridTextColumn Header="Lương tính được" Binding="{Binding Salary,StringFormat=N0}" Width="145" layout:DataGridColumnLayout.Key="Salary" ElementStyle="{StaticResource PayrollMoneyText}"/>
    <DataGridTextColumn Header="Thưởng" Binding="{Binding Bonus,StringFormat=N0}" Width="110" layout:DataGridColumnLayout.Key="Bonus" ElementStyle="{StaticResource PayrollMoneyText}"/>
    <DataGridTextColumn Header="Khấu trừ" Binding="{Binding Deduction,StringFormat=N0}" Width="110" layout:DataGridColumnLayout.Key="Deduction" ElementStyle="{StaticResource PayrollMoneyText}"/>
    <DataGridTextColumn Header="Thực nhận" Binding="{Binding NetSalary,StringFormat=N0}" Width="145" layout:DataGridColumnLayout.Key="NetSalary" ElementStyle="{StaticResource PayrollMoneyText}"/>
    <DataGridTextColumn Header="Diễn giải thưởng" Binding="{Binding BonusNote}" Width="180" layout:DataGridColumnLayout.Key="BonusNote"/>
    <DataGridTextColumn Header="Diễn giải khấu trừ" Binding="{Binding DeductionNote}" Width="180" layout:DataGridColumnLayout.Key="DeductionNote"/>
    <DataGridTextColumn Header="Cảnh báo" Binding="{Binding Warning}" Width="250" layout:DataGridColumnLayout.Key="Warning"/>
   </DataGrid.Columns>
  </DataGrid>
  <StackPanel Grid.Row="4" Margin="0,10,0,0">
   <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap"/>
   <WrapPanel Visibility="{Binding IsClosed,Converter={StaticResource BoolToVis}}" Margin="0,8,0,0" IsEnabled="{Binding CanSelectPeriod}">
    <StackPanel MinWidth="300" MaxWidth="500" Margin="0,0,10,0"><TextBlock Text="Lý do mở chốt (bắt buộc)"/><TextBox Text="{Binding ReopenReason,UpdateSourceTrigger=PropertyChanged}" MaxLength="500"/></StackPanel>
    <Button Content="Mở chốt" Command="{Binding ReopenCommand}" access:PermissionAccess.Rule="HR_PAYROLL_REOPEN:Edit" VerticalAlignment="Bottom"/>
   </WrapPanel>
  </StackPanel>
 </Grid>
 </ScrollViewer>
</UserControl>
