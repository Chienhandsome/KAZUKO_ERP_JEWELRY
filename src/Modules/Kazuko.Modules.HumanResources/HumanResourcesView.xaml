<UserControl x:Class="Kazuko.Modules.HumanResources.HumanResourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:access="clr-namespace:Kazuko.Shared.UI.Behaviors;assembly=Kazuko.Shared.UI"
             xmlns:conv="clr-namespace:Kazuko.Modules.HumanResources.Converters"
             xmlns:behaviors="clr-namespace:Kazuko.Shared.UI.Behaviors;assembly=Kazuko.Shared.UI"
             xmlns:local="clr-namespace:Kazuko.Modules.HumanResources"
             xmlns:grid="clr-namespace:Kazuko.Shared.UI.DataGridLayout;assembly=Kazuko.Shared.UI"
             MinWidth="900" MinHeight="520"
             PreviewKeyDown="UserControl_PreviewKeyDown">
    <UserControl.InputBindings>
        <KeyBinding Key="F1" Command="{Binding AddCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/HumanResourcesDialogResources.xaml" /></ResourceDictionary.MergedDictionaries>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:BooleanToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <conv:NullOrEmptyToVisibilityConverter x:Key="NullToVis" />
        <conv:NullOrEmptyToVisibilityConverter x:Key="NotNullToVis" Invert="True" />

        <Style x:Key="HrPrimaryButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"
                        TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HrOutlineButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HrFilterFieldStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HrFilterComboStyle" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboBd"
                                                Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="28" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="Transparent" />
                                                <Path Grid.Column="1"
                                                      Data="M 0 0 L 6 6 L 12 0"
                                                      Stroke="{DynamicResource TextSecondaryBrush}"
                                                      StrokeThickness="1.5"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="12,0,32,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Margin="0,2,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HrDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowBackground" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="RowHeight" Value="36" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="grid:DataGridColumnLayout.EnableHeaderMenu" Value="True" />
            <Setter Property="grid:DataGridColumnLayout.AutoFitOnFirstLoad" Value="True" />
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="MinHeight" Value="36" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="SnapsToDevicePixels" Value="True" />
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="8,2" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HrDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Height" Value="32" />
        </Style>

        <Style x:Key="HrGridActionButtonStyle" TargetType="Button" BasedOn="{StaticResource HrOutlineButtonStyle}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MinWidth" Value="56" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
        </Style>

        <Style x:Key="HrPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="HrStubPanelStyle" TargetType="Border" BasedOn="{StaticResource HrPanelStyle}">
            <Setter Property="MinHeight" Value="160" />
        </Style>

        <!-- Ô chấm công: nền theo trạng thái, viền cam khi đang chọn -->
        <Style x:Key="AttendanceCellStyle" TargetType="Border">
            <Setter Property="Width" Value="25" />
            <Setter Property="Height" Value="25" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0.5" />
            <Setter Property="Cursor" Value="Hand" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="AttendanceCell_PreviewMouseLeftButtonDown" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusCode}" Value="WORK">
                    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusCode}" Value="PAID_LEAVE">
                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusCode}" Value="UNPAID_LEAVE">
                    <Setter Property="Background" Value="{DynamicResource InfoBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AttendanceHeaderCellStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0.5,0.5" />
        </Style>

        <Style x:Key="HrTabItemStyle" TargetType="TabItem">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}"
                                SnapsToDevicePixels="True">
                            <TextBlock x:Name="HeaderText"
                                       Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
                            <Setter TargetName="TabBorder" Property="TextBlock.Foreground" Value="{DynamicResource OnPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
            </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="NHÂN SỰ"
                       FontSize="{DynamicResource FontSize.Heading}"
                       FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryBrush}" />
            <TextBlock Text="Quản lý nhân viên, hồ sơ, chấm công và lương"
                       FontSize="{DynamicResource FontSize.Body}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />
        </StackPanel>

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}"
                    Background="Transparent" BorderThickness="0" Padding="0"
                    ItemContainerStyle="{StaticResource HrTabItemStyle}">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      Margin="0,0,0,10">
                            <TabPanel IsItemsHost="True" />
                        </ScrollViewer>
                        <Border Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>
            <TabItem Header="Danh sách nhân viên" access:PermissionAccess.Rule="CAT_EMPLOYEES">
                <Grid Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="180" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="220" MinHeight="180" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button access:PermissionAccess.Rule="CAT_EMPLOYEES:Add" Content="Thêm nhân viên (F1)" Style="{StaticResource HrPrimaryButtonStyle}"
                                    Command="{Binding AddCommand}" Margin="0,0,8,8" MinWidth="180" />
                            <Button access:PermissionAccess.Rule="DATA_EXPORT" Content="Xuất Excel" Style="{StaticResource HrOutlineButtonStyle}"
                                    Command="{Binding ExportExcelCommand}"
                                    CommandParameter="{Binding ElementName=EmployeeListGrid}"
                                    Margin="0,0,0,8" MinWidth="110" />
                        </StackPanel>
                        <WrapPanel>
                            <TextBox Width="220" Style="{StaticResource HrFilterFieldStyle}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Tìm theo mã, tên, số điện thoại" />
                            <ComboBox Width="140" Style="{StaticResource HrFilterComboStyle}"
                                      ItemsSource="{Binding StatusOptions}"
                                      SelectedItem="{Binding SelectedStatus}" />
                            <Button Content="Tìm kiếm" Style="{StaticResource HrPrimaryButtonStyle}"
                                    Command="{Binding SearchCommand}" Margin="0,0,8,8" MinWidth="100" />
                            <Button Content="Làm mới" Style="{StaticResource HrOutlineButtonStyle}"
                                    Command="{Binding RefreshCommand}" Margin="0,0,8,8" MinWidth="100" />
                        </WrapPanel>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <DataGrid x:Name="EmployeeListGrid"
                                  ItemsSource="{Binding Employees}"
                                  SelectedItem="{Binding SelectedEmployee}"
                                  Style="{StaticResource HrDataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource HrDataGridColumnHeaderStyle}"
                                  grid:DataGridColumnLayout.SettingsKey="hr-employees-grid-layout"
                                  behaviors:DataGridRowActions.EditCommand="{Binding EditCommand}"
                                  behaviors:DataGridRowActions.DeleteCommand="{Binding DeleteCommand}"
                                  behaviors:DataGridRowActions.ToggleActiveCommand="{Binding ToggleActiveCommand}"
                                  Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVis}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT" grid:DataGridColumnLayout.Key="Index"
                                                    Binding="{Binding Index, Mode=OneWay}" Width="50" />
                                <DataGridTextColumn Header="Mã NV" grid:DataGridColumnLayout.Key="Code"
                                                    Binding="{Binding Code, Mode=OneWay}" Width="90" />
                                <DataGridTextColumn Header="Họ và tên" grid:DataGridColumnLayout.Key="FullName"
                                                    Binding="{Binding FullName, Mode=OneWay}" Width="*" MinWidth="140" />
                                <DataGridTemplateColumn Header="Ảnh" grid:DataGridColumnLayout.Key="Photo" Width="56">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="28" Height="28" CornerRadius="14"
                                                    Background="{DynamicResource SurfaceAltBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    ClipToBounds="True"
                                                    ToolTip="{Binding PhotoPath, Mode=OneWay}">
                                                <Grid>
                                                    <TextBlock Text="NV" FontSize="{DynamicResource FontSize.Caption}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding HasPhoto, Converter={StaticResource InverseBoolToVis}}" />
                                                    <Image Source="{Binding PhotoPath, Mode=OneWay, Converter={StaticResource PathToImageSourceConverter}}"
                                                           Stretch="UniformToFill"
                                                           Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVis}}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Giới tính" grid:DataGridColumnLayout.Key="Gender"
                                                    Binding="{Binding Gender, Mode=OneWay}" Width="70" />
                                <DataGridTextColumn Header="Ngày sinh" grid:DataGridColumnLayout.Key="DateOfBirth"
                                                    Binding="{Binding DateOfBirthText, Mode=OneWay}" Width="90" />
                                <DataGridTextColumn Header="Số điện thoại" grid:DataGridColumnLayout.Key="Phone"
                                                    Binding="{Binding Phone, Mode=OneWay}" Width="110" />
                                <DataGridTextColumn Header="Email" grid:DataGridColumnLayout.Key="Email"
                                                    Binding="{Binding Email, Mode=OneWay}" Width="150" />
                                <DataGridTextColumn Header="Ngày vào làm" grid:DataGridColumnLayout.Key="HireDate"
                                                    Binding="{Binding HireDateText, Mode=OneWay}" Width="100" />
                                <DataGridTemplateColumn Header="Trạng thái" grid:DataGridColumnLayout.Key="Status" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource SuccessBrush}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive, Mode=OneWay}" Value="False">
                                                                <Setter Property="Background" Value="{DynamicResource TextSecondaryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusText, Mode=OneWay}"
                                                           Foreground="{DynamicResource OnPrimaryBrush}"
                                                           FontSize="{DynamicResource FontSize.Caption}"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Thao tác" grid:DataGridColumnLayout.Key="Actions" Width="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <Button access:PermissionAccess.Rule="CAT_EMPLOYEES:Edit" Content="Sửa" Style="{StaticResource HrGridActionButtonStyle}"
                                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button access:PermissionAccess.Rule="CAT_EMPLOYEES:Delete" Content="Xóa" Style="{StaticResource HrGridActionButtonStyle}"
                                                        ToolTip="Xóa (ngừng làm việc)"
                                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button access:PermissionAccess.Rule="CAT_EMPLOYEES:Edit" Content="TT"
                                                        Style="{StaticResource HrGridActionButtonStyle}"
                                                        Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="{Binding ToggleActiveLabel, Mode=OneWay}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Chưa có nhân viên hoặc không khớp bộ lọc."
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="{DynamicResource FontSize.Body}"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding ErrorMessage, Mode=OneWay}"
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"
                                   Foreground="{DynamicResource DangerBrush}"
                                   FontSize="{DynamicResource FontSize.Body}" TextWrapping="Wrap"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding StatusMessage, Mode=OneWay}"
                                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="{DynamicResource FontSize.Caption}"
                                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                    </Grid>

                    <TextBlock Grid.Row="2" Text="{Binding StatusMessage, Mode=OneWay}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="{DynamicResource FontSize.Caption}" Margin="0,6,0,6" />

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*" MinWidth="320" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" MinWidth="200" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" MinWidth="200" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource HrPanelStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid>
                                    <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                                        <DockPanel Margin="0,0,0,10">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button access:PermissionAccess.Rule="CAT_EMPLOYEES:Edit" Content="Sửa" Style="{StaticResource HrOutlineButtonStyle}"
                                                        Command="{Binding EditSelectedCommand}" MinWidth="90" MinHeight="40"
                                                        Margin="0,0,8,0" />
                                                <Button access:PermissionAccess.Rule="CAT_EMPLOYEES:Delete" Content="Xóa" Style="{StaticResource HrOutlineButtonStyle}"
                                                        Command="{Binding DeleteSelectedCommand}" MinWidth="90" MinHeight="40" />
                                            </StackPanel>
                                            <TextBlock Text="Thông tin nhân viên" FontWeight="SemiBold"
                                                       FontSize="{DynamicResource FontSize.Body}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="72" Height="72" CornerRadius="36"
                                                    Background="{DynamicResource SurfaceAltBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                    VerticalAlignment="Top" ClipToBounds="True">
                                                <Grid>
                                                    <TextBlock Text="Ảnh" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontSize="{DynamicResource FontSize.Caption}"
                                                               Visibility="{Binding HasPhoto, Converter={StaticResource InverseBoolToVis}}" />
                                                    <Image Source="{Binding SelectedPhotoPath, Mode=OneWay, Converter={StaticResource PathToImageSourceConverter}}"
                                                           Stretch="UniformToFill"
                                                           Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVis}}" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Mã NV" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSize.Caption}" />
                                                <TextBlock Text="{Binding SelectedCode, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="{DynamicResource FontSize.Body}" Margin="0,0,0,6"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedCode, Mode=OneWay}" />
                                                <TextBlock Text="Họ tên" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSize.Caption}" />
                                                <TextBlock Text="{Binding SelectedFullName, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="{DynamicResource FontSize.Body}" Margin="0,0,0,6"
                                                           TextWrapping="Wrap" ToolTip="{Binding SelectedFullName, Mode=OneWay}" />
                                                <TextBlock Text="Giới tính" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSize.Caption}" />
                                                <TextBlock Text="{Binding SelectedGender, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="{DynamicResource FontSize.Body}" Margin="0,0,0,6" />
                                                <TextBlock Text="Ngày sinh" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSize.Caption}" />
                                                <TextBlock Text="{Binding SelectedDateOfBirthText, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="{DynamicResource FontSize.Body}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Điện thoại" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSize.Caption}" />
                                                <TextBlock Text="{Binding SelectedPhone, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="{DynamicResource FontSize.Body}" Margin="0,0,0,6" />
                                                <TextBlock Text="Email" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSize.Caption}" />
                                                <TextBlock Text="{Binding SelectedEmail, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="{DynamicResource FontSize.Body}" Margin="0,0,0,6"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedEmail, Mode=OneWay}" />
                                                <TextBlock Text="Ngày vào làm" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSize.Caption}" />
                                                <TextBlock Text="{Binding SelectedHireDateText, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="{DynamicResource FontSize.Body}" Margin="0,0,0,6" />
                                                <TextBlock Text="Trạng thái" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSize.Caption}" />
                                                <TextBlock Text="{Binding SelectedStatusText, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="{DynamicResource FontSize.Body}" Margin="0,0,0,6" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                    <TextBlock Text="Chọn một nhân viên để xem hồ sơ."
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="{DynamicResource FontSize.Body}"
                                               Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}" />
                                </Grid>
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource HrStubPanelStyle}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="Chấm công tháng"
                                           FontWeight="SemiBold" FontSize="{DynamicResource FontSize.Body}"
                                           Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="Chấm công theo ca/ngày được thực hiện ở tab Chấm công."
                                           FontSize="{DynamicResource FontSize.Caption}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Style="{StaticResource HrStubPanelStyle}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="Lương tháng"
                                           FontWeight="SemiBold" FontSize="{DynamicResource FontSize.Body}"
                                           Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="Mở tab Tính lương để tính theo chấm công, điều chỉnh thưởng/khấu trừ và chốt bảng lương từng tháng."
                                           FontSize="{DynamicResource FontSize.Caption}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Chấm công" access:PermissionAccess.Rule="CAT_EMPLOYEES">
                <Grid Margin="0,4,0,0" DataContext="{Binding Attendance}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Pane trái: danh sách kỳ tháng -->
                    <Border Grid.Column="0" Style="{StaticResource HrPanelStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Bảng chấm công" FontWeight="SemiBold"
                                       FontSize="{DynamicResource FontSize.Body}"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                            <ListBox Grid.Row="1" ItemsSource="{Binding Periods}"
                                     SelectedItem="{Binding SelectedPeriod}"
                                     Background="Transparent" BorderThickness="0"
                                     FontSize="{DynamicResource FontSize.Body}"
                                     Foreground="{DynamicResource TextPrimaryBrush}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" Padding="4,3" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                <Button access:PermissionAccess.Rule="CAT_EMPLOYEES:Add" Content="Thêm kỳ tháng"
                                        Style="{StaticResource HrPrimaryButtonStyle}"
                                        Command="{Binding AddPeriodCommand}" Margin="0,0,0,8" />
                                <Button access:PermissionAccess.Rule="CAT_EMPLOYEES:Delete" Content="Xóa kỳ"
                                        Style="{StaticResource HrOutlineButtonStyle}"
                                        Command="{Binding DeletePeriodCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Phần chính: toolbar + lưới -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button access:PermissionAccess.Rule="CAT_EMPLOYEES:Edit"
                                        Style="{StaticResource HrOutlineButtonStyle}" Margin="0,0,8,0"
                                        Command="{Binding SetStatusCommand}" CommandParameter="NONE"
                                        ToolTip="Đặt các ô đang chọn về Không có lịch">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="14" Height="14" CornerRadius="3" Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
                                        <TextBlock Text="Không có lịch" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button access:PermissionAccess.Rule="CAT_EMPLOYEES:Edit"
                                        Style="{StaticResource HrOutlineButtonStyle}" Margin="0,0,8,0"
                                        Command="{Binding SetStatusCommand}" CommandParameter="WORK"
                                        ToolTip="Đặt các ô đang chọn là Đi làm">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="14" Height="14" CornerRadius="3" Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource DangerBrush}" />
                                        <TextBlock Text="Đi làm" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button access:PermissionAccess.Rule="CAT_EMPLOYEES:Edit"
                                        Style="{StaticResource HrOutlineButtonStyle}" Margin="0,0,8,0"
                                        Command="{Binding SetStatusCommand}" CommandParameter="PAID_LEAVE"
                                        ToolTip="Đặt các ô đang chọn là Nghỉ có phép">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="14" Height="14" CornerRadius="3" Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource SuccessBrush}" />
                                        <TextBlock Text="Nghỉ có phép" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button access:PermissionAccess.Rule="CAT_EMPLOYEES:Edit"
                                        Style="{StaticResource HrOutlineButtonStyle}" Margin="0,0,8,0"
                                        Command="{Binding SetStatusCommand}" CommandParameter="UNPAID_LEAVE"
                                        ToolTip="Đặt các ô đang chọn là Nghỉ không phép">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="14" Height="14" CornerRadius="3" Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource InfoBrush}" />
                                        <TextBlock Text="Nghỉ không phép" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button access:PermissionAccess.Rule="CAT_EMPLOYEES:Add" Content="Thêm ca"
                                        Style="{StaticResource HrPrimaryButtonStyle}"
                                        Command="{Binding AddShiftCommand}" Margin="0,0,8,0" MinWidth="110" />
                                <Button Content="Làm mới" Style="{StaticResource HrOutlineButtonStyle}"
                                        Command="{Binding RefreshCommand}" MinWidth="100" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Grid.Row="1" Margin="0,0,0,8" LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding SelectionText, Mode=OneWay}"
                                       FontWeight="SemiBold"
                                       FontSize="{DynamicResource FontSize.Caption}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding ErrorMessage, Mode=OneWay}"
                                       Foreground="{DynamicResource DangerBrush}"
                                       FontSize="{DynamicResource FontSize.Caption}"
                                       TextWrapping="Wrap" VerticalAlignment="Center"
                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding StatusMessage, Mode=OneWay}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="{DynamicResource FontSize.Caption}"
                                       TextWrapping="Wrap" VerticalAlignment="Center"
                                       Visibility="{Binding HasError, Converter={StaticResource InverseBoolToVis}}" />
                        </DockPanel>

                        <Border Grid.Row="2" Style="{StaticResource HrPanelStyle}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Hàng tiêu đề ngày (cuộn ngang đồng bộ với thân lưới) -->
                                <ScrollViewer x:Name="AttendanceHeaderScroller" Grid.Row="0"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="66" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource AttendanceHeaderCellStyle}">
                                            <TextBlock Text="Nhân viên" FontWeight="SemiBold"
                                                       FontSize="{DynamicResource FontSize.Caption}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center" Margin="8,4" />
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource AttendanceHeaderCellStyle}">
                                            <TextBlock Text="Ca" FontWeight="SemiBold"
                                                       FontSize="{DynamicResource FontSize.Caption}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4" />
                                        </Border>
                                        <ItemsControl Grid.Column="2" ItemsSource="{Binding Days}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="27" Style="{StaticResource AttendanceHeaderCellStyle}">
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Day}" HorizontalAlignment="Center"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="{DynamicResource FontSize.Caption}"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            <TextBlock Text="{Binding WeekdayLabel}" HorizontalAlignment="Center"
                                                                       FontSize="{DynamicResource FontSize.Caption}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSunday}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </ScrollViewer>

                                <!-- Thân lưới: nhóm nhân viên > hàng ca > ô ngày -->
                                <ScrollViewer x:Name="AttendanceBodyScroller" Grid.Row="1"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              ScrollChanged="AttendanceBodyScroller_ScrollChanged">
                                    <ItemsControl x:Name="AttendanceGroupsControl" ItemsSource="{Binding Groups}"
                                                  MouseMove="AttendanceGrid_MouseMove"
                                                  MouseLeftButtonUp="AttendanceGrid_MouseLeftButtonUp">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0"
                                                            Background="{DynamicResource SurfaceAltBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="0,0,1,1">
                                                        <TextBlock Text="{Binding EmployeeName}"
                                                                   FontSize="{DynamicResource FontSize.Body}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   VerticalAlignment="Center" Margin="8,2"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding EmployeeName}" />
                                                    </Border>
                                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding ShiftRows}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="66" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Grid.Column="0"
                                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                                            BorderThickness="0,0,1,1">
                                                                        <TextBlock Text="{Binding ShiftName}"
                                                                                   FontSize="{DynamicResource FontSize.Caption}"
                                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center" Margin="4,2" />
                                                                    </Border>
                                                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <StackPanel Orientation="Horizontal" />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Border Style="{StaticResource AttendanceCellStyle}" />
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBlock Text="Chưa có nhân viên đang làm việc hoặc chưa có ca làm việc."
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="{DynamicResource FontSize.Body}"
                                           Visibility="{Binding HasRows, Converter={StaticResource InverseBoolToVis}}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Tính lương" access:PermissionAccess.Rule="HR_PAYROLL">
                <local:PayrollTabView DataContext="{Binding Payroll}"/>
            </TabItem>
            <TabItem Header="Khen thưởng - Kỷ luật">
                <Border Style="{StaticResource HrStubPanelStyle}" Margin="0,12,0,0">
                    <TextBlock Text="Tab Khen thưởng - Kỷ luật chưa triển khai."
                               FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                </Border>
            </TabItem>
            <TabItem Header="Báo cáo">
                <Border Style="{StaticResource HrStubPanelStyle}" Margin="0,12,0,0">
                    <TextBlock Text="Tab Báo cáo nhân sự chưa triển khai."
                               FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
