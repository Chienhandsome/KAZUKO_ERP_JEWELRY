<Window x:Class="Kazuko.Modules.HumanResources.WorkShiftCatalogDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:grid="clr-namespace:Kazuko.Shared.UI.DataGridLayout;assembly=Kazuko.Shared.UI"
 xmlns:access="clr-namespace:Kazuko.Shared.UI.Behaviors;assembly=Kazuko.Shared.UI"
 Title="Danh mục ca làm việc" Width="900" Height="620" MinWidth="740" MinHeight="500"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource AppBackgroundBrush}"
 Foreground="{DynamicResource TextPrimaryBrush}" FontSize="{DynamicResource FontSize.Body}">
 <Window.Resources><ResourceDictionary Source="Themes/HumanResourcesDialogResources.xaml"/></Window.Resources>
 <DockPanel Margin="16">
  <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" HorizontalAlignment="Right">
   <Button Content="Xóa ca" Command="{Binding DeleteCommand}" access:PermissionAccess.Rule="CAT_EMPLOYEES:Delete"
           Style="{StaticResource HrDialogBaseOutlineButtonStyle}" Foreground="{DynamicResource DangerBrush}" Margin="0,0,8,0"/>
   <Button Content="Thêm ca mới" Command="{Binding NewCommand}" access:PermissionAccess.Rule="CAT_EMPLOYEES:Add"
           Style="{StaticResource HrDialogBaseOutlineButtonStyle}" Margin="0,0,8,0"/>
   <Button Content="Lưu ca" Command="{Binding SaveCommand}" access:PermissionAccess.Rule="CAT_EMPLOYEES:Edit"
           Style="{StaticResource HrDialogBasePrimaryButtonStyle}" IsDefault="True" Margin="0,0,8,0"/>
   <Button Content="Đóng" IsCancel="True" Click="Close_Click" Style="{StaticResource HrDialogBaseOutlineButtonStyle}"/>
  </WrapPanel>
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="Danh mục ca làm việc" Foreground="{DynamicResource PrimaryBrush}" FontSize="{DynamicResource FontSize.Subtitle}" FontWeight="SemiBold"/>
   <TextBlock Text="Bỏ chọn Đang sử dụng để ngừng dùng một ca. Dữ liệu chấm công đã lưu vẫn được giữ lại."
              TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,10"/>
   <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,8" TextWrapping="Wrap"/>
  </StackPanel>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
   <DataGrid grid:DataGridColumnLayout.EnableHeaderMenu="True" grid:DataGridColumnLayout.SettingsKey="humanresources.WorkShiftCatalogDialog.Items" x:Name="ShiftGrid" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" IsEnabled="{Binding CanSelect}"
             AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
             Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}"
             RowBackground="{DynamicResource SurfaceBrush}" AlternatingRowBackground="{DynamicResource SurfaceAltBrush}" MinRowHeight="40"
             HeadersVisibility="Column" HorizontalGridLinesBrush="{DynamicResource BorderBrush}" VerticalGridLinesBrush="{DynamicResource BorderBrush}">
    <DataGrid.Resources>
     <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="Padding" Value="8,10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}"/></Style>
     <Style TargetType="DataGridCell">
      <Setter Property="Padding" Value="6,8"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/></Trigger></Style.Triggers>
     </Style>
    </DataGrid.Resources>
    <DataGrid.Columns>
     <DataGridTextColumn grid:DataGridColumnLayout.Key="Name" Header="Tên ca" Binding="{Binding Name,Mode=OneWay}" Width="*" MinWidth="110">
      <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Name}"/></Style></DataGridTextColumn.ElementStyle>
     </DataGridTextColumn>
     <DataGridTextColumn grid:DataGridColumnLayout.Key="StartTimeText" Header="Bắt đầu" Binding="{Binding StartTimeText,Mode=OneWay}" Width="SizeToHeader" MinWidth="85"/>
     <DataGridTextColumn grid:DataGridColumnLayout.Key="EndTimeText" Header="Kết thúc" Binding="{Binding EndTimeText,Mode=OneWay}" Width="SizeToHeader" MinWidth="85"/>
     <DataGridCheckBoxColumn grid:DataGridColumnLayout.Key="IsActive" Header="Sử dụng" Binding="{Binding IsActive,Mode=OneWay}" Width="SizeToHeader" MinWidth="85"/>
    </DataGrid.Columns>
   </DataGrid>
   <Border Grid.Column="2" Style="{DynamicResource CardBorderStyle}" Padding="12">
    <DockPanel>
     <Button DockPanel.Dock="Bottom" Content="Tải lại danh mục" Command="{Binding ReloadCommand}" Style="{StaticResource HrDialogBaseOutlineButtonStyle}" Margin="0,16,0,0"/>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel IsEnabled="{Binding CanEditSelected}">
       <TextBlock Text="Tên ca *" Foreground="{DynamicResource TextSecondaryBrush}"/>
       <TextBox Text="{Binding Editor.Name,UpdateSourceTrigger=PropertyChanged}" MaxLength="50" Style="{StaticResource HrDialogBaseRoundedTextBoxStyle}" Margin="0,4,0,12"/>
       <TextBlock Text="Giờ bắt đầu (HH:mm)" Foreground="{DynamicResource TextSecondaryBrush}"/>
       <TextBox Text="{Binding Editor.StartTimeText,UpdateSourceTrigger=PropertyChanged}" MaxLength="5" Style="{StaticResource HrDialogBaseRoundedTextBoxStyle}" Margin="0,4,0,12"/>
       <TextBlock Text="Giờ kết thúc (HH:mm)" Foreground="{DynamicResource TextSecondaryBrush}"/>
       <TextBox Text="{Binding Editor.EndTimeText,UpdateSourceTrigger=PropertyChanged}" MaxLength="5" Style="{StaticResource HrDialogBaseRoundedTextBoxStyle}" Margin="0,4,0,12"/>
       <CheckBox Content="Đang sử dụng" IsChecked="{Binding Editor.IsActive}" Foreground="{DynamicResource TextPrimaryBrush}"/>
       <TextBlock Text="{Binding Editor.ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </Border>
  </Grid>
 </DockPanel>
</Window>
