<Window x:Class="Kazuko.Modules.UserManagement.UserGroupEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:access="clr-namespace:Kazuko.Shared.UI.Behaviors;assembly=Kazuko.Shared.UI"
        xmlns:local="clr-namespace:Kazuko.Modules.UserManagement"
        Title="{Binding Title}"
        Width="480" Height="370"
        MinWidth="440" MinHeight="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}">
  <Window.Resources>
    <local:NullOrEmptyToVisibilityConverter x:Key="NotEmptyToVis" Invert="True" />
    <local:InverseBooleanToVisibilityConverter x:Key="NotAdminToVis" />

    <Style x:Key="UmDialogLabelStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="UmDialogFieldStyle" TargetType="Control">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="UmDialogPrimaryButtonStyle" TargetType="Button">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="MinWidth" Value="120" />
      <Setter Property="Padding" Value="16,4" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="UmDialogOutlineButtonStyle" TargetType="Button">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="MinWidth" Value="110" />
      <Setter Property="Padding" Value="16,4" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </Window.Resources>

  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="Thoát"
              Style="{StaticResource UmDialogOutlineButtonStyle}"
              Command="{Binding CancelCommand}"
              Margin="0,0,8,0" IsCancel="True" />
      <Button access:PermissionAccess.Rule="SYS_USER_MANAGEMENT:Add|SYS_USER_MANAGEMENT:Edit" Content="Ghi dữ liệu"
              Style="{StaticResource UmDialogPrimaryButtonStyle}"
              Command="{Binding SaveCommand}"
              IsDefault="True" />
    </StackPanel>

    <StackPanel>
      <TextBlock Text="{Binding Title}"
                 FontSize="{DynamicResource FontSize.Heading}"
                 Foreground="{DynamicResource PrimaryBrush}"
                 FontWeight="Bold" Margin="0,0,0,12" />
      <TextBlock Text="{Binding ErrorMessage}"
                 Foreground="{DynamicResource DangerBrush}"
                 TextWrapping="Wrap" Margin="0,0,0,8"
                 Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmptyToVis}}" />

      <TextBlock Text="Tên nhóm (*)" Style="{StaticResource UmDialogLabelStyle}" />
      <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
               Style="{StaticResource UmDialogFieldStyle}" MaxLength="150" />

      <TextBlock Text="Mã nhóm" Style="{StaticResource UmDialogLabelStyle}" />
      <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
               Style="{StaticResource UmDialogFieldStyle}" MaxLength="30"
               IsReadOnly="{Binding IsAdminGroup}"
               ToolTip="Để trống sẽ tự sinh. Mã duy nhất trong công ty." />

      <TextBlock Text="Diễn giải" Style="{StaticResource UmDialogLabelStyle}" />
      <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
               Style="{StaticResource UmDialogFieldStyle}" MaxLength="500"
               TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60"
               VerticalContentAlignment="Top" Padding="8" />

      <CheckBox Content="Đang hoạt động"
                IsChecked="{Binding IsActive}"
                Foreground="{DynamicResource TextPrimaryBrush}"
                FontSize="{DynamicResource FontSize.Body}"
                Visibility="{Binding IsAdminGroup, Converter={StaticResource NotAdminToVis}}" />
    </StackPanel>
  </DockPanel>
</Window>
