<Window x:Class="Kazuko.Modules.UserManagement.UserEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kazuko.Modules.UserManagement"
        Title="{Binding Title}"
        Width="520" Height="680"
        MinWidth="480" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}">
  <Window.Resources>
    <local:NullOrEmptyToVisibilityConverter x:Key="NotEmptyToVis" Invert="True" />

    <Style x:Key="UmDialogLabelStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="UmDialogFieldStyle" TargetType="Control">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="UmDialogPrimaryButtonStyle" TargetType="Button">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="MinWidth" Value="120" />
      <Setter Property="Padding" Value="16,4" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="UmDialogOutlineButtonStyle" TargetType="Button">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="MinWidth" Value="110" />
      <Setter Property="Padding" Value="16,4" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </Window.Resources>

  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="Thoát"
              Style="{StaticResource UmDialogOutlineButtonStyle}"
              Command="{Binding CancelCommand}"
              Margin="0,0,8,0" IsCancel="True" />
      <Button Content="Ghi dữ liệu"
              Style="{StaticResource UmDialogPrimaryButtonStyle}"
              Command="{Binding SaveCommand}"
              IsDefault="True" />
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="{Binding Title}"
                   FontSize="{DynamicResource FontSize.Heading}"
                   Foreground="{DynamicResource PrimaryBrush}"
                   FontWeight="Bold" Margin="0,0,0,12" />
        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="{DynamicResource DangerBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,8"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmptyToVis}}" />

        <TextBlock Text="Nhân viên (*)" Style="{StaticResource UmDialogLabelStyle}" />
        <ComboBox ItemsSource="{Binding Employees}"
                  SelectedItem="{Binding SelectedEmployee}"
                  Style="{StaticResource UmDialogFieldStyle}"
                  IsTextSearchEnabled="True" />

        <TextBlock Text="Kho" Style="{StaticResource UmDialogLabelStyle}" />
        <ComboBox ItemsSource="{Binding Warehouses}"
                  SelectedItem="{Binding SelectedWarehouse}"
                  Style="{StaticResource UmDialogFieldStyle}"
                  IsTextSearchEnabled="True"
                  ToolTip="Kho mặc định của người dùng (để trống nếu không giới hạn)" />

        <TextBlock Text="Email" Style="{StaticResource UmDialogLabelStyle}" />
        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource UmDialogFieldStyle}" MaxLength="150"
                 ToolTip="Tự điền từ hồ sơ nhân viên; lưu vào hồ sơ nhân viên" />

        <TextBlock Text="Nhóm người dùng (*)" Style="{StaticResource UmDialogLabelStyle}" />
        <ComboBox ItemsSource="{Binding Groups}"
                  SelectedItem="{Binding SelectedGroup}"
                  Style="{StaticResource UmDialogFieldStyle}" />

        <TextBlock Text="Tài khoản (*)" Style="{StaticResource UmDialogLabelStyle}" />
        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource UmDialogFieldStyle}" MaxLength="80"
                 ToolTip="Duy nhất, không phân biệt hoa thường" />

        <TextBlock Text="Mật khẩu" Style="{StaticResource UmDialogLabelStyle}" />
        <PasswordBox Style="{StaticResource UmDialogFieldStyle}"
                     PasswordChanged="PasswordBox_OnPasswordChanged"
                     ToolTip="{Binding PasswordHint}" />
        <TextBlock Text="{Binding PasswordHint}"
                   FontSize="{DynamicResource FontSize.Caption}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,-8,0,12" />

        <TextBlock Text="Ghi chú" Style="{StaticResource UmDialogLabelStyle}" />
        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource UmDialogFieldStyle}" MaxLength="500"
                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60"
                 VerticalContentAlignment="Top" Padding="8" />

        <CheckBox Content="Đang hoạt động"
                  IsChecked="{Binding IsActive}"
                  FontSize="{DynamicResource FontSize.Body}" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
