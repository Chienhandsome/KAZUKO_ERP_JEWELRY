<UserControl x:Class="Kazuko.Modules.Sales.CraftOrderTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:access="clr-namespace:Kazuko.Shared.UI.Behaviors;assembly=Kazuko.Shared.UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/SalesResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" MinWidth="300" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" MinWidth="420" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource SalesCardStyle}" Padding="12">
            <DockPanel LastChildFill="True">
                <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,0,8">
                    <Button access:PermissionAccess.Rule="CRAFT_ORDER:Add" DockPanel.Dock="Right"
                            Content="Tạo đơn đặt"
                            Style="{StaticResource SalesPrimaryButtonStyle}"
                            Command="{Binding CreateOrderCommand}"
                            MinHeight="36" MinWidth="110"
                            Margin="8,0,0,0"
                            ToolTip="Mở lệnh sản xuất với nguồn Theo đơn đặt" />
                    <TextBlock Text="Danh sách đơn đặt"
                               Style="{StaticResource SalesSectionHeaderStyle}"
                               VerticalAlignment="Center" />
                </DockPanel>

                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Từ ngày" Style="{StaticResource SalesFieldLabelStyle}" />
                        <DatePicker SelectedDate="{Binding FromDate}" Margin="0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Đến ngày" Style="{StaticResource SalesFieldLabelStyle}" />
                        <DatePicker SelectedDate="{Binding ToDate}" Margin="0" />
                    </StackPanel>
                </Grid>

                <ComboBox DockPanel.Dock="Top"
                          ItemsSource="{Binding StatusFilterOptions}"
                          SelectedItem="{Binding SelectedStatusFilter}"
                          DisplayMemberPath="DisplayName"
                          Margin="0,0,0,8"
                          MinHeight="36" />

                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SalesRoundedTextBoxStyle}"
                             Margin="0"
                             ToolTip="Tìm theo mã đơn, tên hoặc SĐT khách" />
                    <Button Grid.Column="2" Content="Tìm"
                            Style="{StaticResource SalesOutlineButtonStyle}"
                            Command="{Binding SearchCommand}"
                            MinHeight="36" MinWidth="72" Padding="12,4" Margin="0" />
                </Grid>

                <TextBlock DockPanel.Dock="Bottom"
                           Text="{Binding StatusMessage}"
                           Style="{StaticResource SalesHintStyle}"
                           Margin="0,8,0,0" />

                <ListBox ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem}"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,4" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,8"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    CornerRadius="6"
                                    HorizontalAlignment="Stretch">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Code}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryBrush}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding OrderDate, StringFormat=dd/MM/yyyy}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="{DynamicResource FontSize.Caption}" />
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                               Text="{Binding CustomerName}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <Grid Grid.Row="2" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding StatusCode}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="{DynamicResource FontSize.Caption}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding RemainingDueVnd, StringFormat=N0}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="{DynamicResource FontSize.Caption}"
                                                   FontWeight="SemiBold" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource SalesCardStyle}" Padding="16">
            <DockPanel LastChildFill="True">
                <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,12">
                    <TextBlock Text="{Binding DetailTitle}"
                               Style="{StaticResource SalesSectionHeaderStyle}"
                               VerticalAlignment="Center" />
                    <Button access:PermissionAccess.Rule="CRAFT_ORDER:Edit" DockPanel.Dock="Right"
                            Content="Thu phần còn"
                            Style="{StaticResource SalesOutlineButtonStyle}"
                            Command="{Binding CollectCommand}"
                            MinHeight="36" MinWidth="110"
                            Margin="8,0,0,0"
                            ToolTip="Khi đã xuất kho nhưng chưa tất toán" />
                    <Button access:PermissionAccess.Rule="CRAFT_ORDER:Edit" DockPanel.Dock="Right"
                            Content="Giao hàng"
                            Style="{StaticResource SalesPrimaryButtonStyle}"
                            Command="{Binding DeliverCommand}"
                            MinHeight="36" MinWidth="110"
                            ToolTip="Xuất thành phẩm + thu phần còn (nếu còn)" />
                </DockPanel>

                <StackPanel>
                    <TextBlock Text="{Binding DetailCustomerText}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding DetailStatusText}"
                               Style="{StaticResource SalesHintStyle}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="{Binding IssueStatusText}"
                               Style="{StaticResource SalesHintStyle}"
                               Margin="0,0,0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Tổng báo giá" Style="{StaticResource SalesFieldLabelStyle}" />
                            <TextBlock Text="{Binding GrandTotalText}"
                                       FontWeight="SemiBold"
                                       FontSize="{DynamicResource FontSize.Subtitle}"
                                       Foreground="{DynamicResource PrimaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Đã thu (cọc)" Style="{StaticResource SalesFieldLabelStyle}" />
                            <TextBlock Text="{Binding PaidAmountText}"
                                       FontWeight="SemiBold"
                                       FontSize="{DynamicResource FontSize.Subtitle}"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Còn lại" Style="{StaticResource SalesFieldLabelStyle}" />
                            <TextBlock Text="{Binding RemainingDueText}"
                                       FontWeight="SemiBold"
                                       FontSize="{DynamicResource FontSize.Subtitle}"
                                       Foreground="{DynamicResource DangerBrush}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding SettlementHintText}"
                               Style="{StaticResource SalesHintStyle}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0" />

                    <TextBlock Text="Mặt hàng / mẫu"
                               Style="{StaticResource SalesSectionHeaderStyle}"
                               Margin="0,16,0,8" />
                    <DataGrid ItemsSource="{Binding Lines}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              MinHeight="120"
                              MaxHeight="280"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding LineNumber, Mode=OneWay}" Width="40" />
                            <DataGridTextColumn Header="Tên mẫu" Binding="{Binding ProductName, Mode=OneWay}" Width="*" />
                            <DataGridTextColumn Header="Tuổi vàng" Binding="{Binding GoldPurity, Mode=OneWay}" Width="90" />
                            <DataGridTextColumn Header="SL" Binding="{Binding Quantity, Mode=OneWay}" Width="50" />
                            <DataGridTextColumn Header="Tiền công/SP" Binding="{Binding LaborAmountPerUnitVnd, Mode=OneWay, StringFormat=N0}" Width="110" />
                            <DataGridTextColumn Header="Thành tiền" Binding="{Binding LineTotalVnd, Mode=OneWay, StringFormat=N0}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Tạo đơn đặt và thu cọc tại đây; sau đó tạo lệnh sản xuất theo đơn. Giao hàng xuất serial và thu phần còn khi đơn READY."
                               Style="{StaticResource SalesHintStyle}"
                               TextWrapping="Wrap"
                               Margin="0,16,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
