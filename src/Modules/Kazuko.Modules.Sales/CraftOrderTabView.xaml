<UserControl x:Class="Kazuko.Modules.Sales.CraftOrderTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Kazuko.Modules.Sales.Converters"
             xmlns:grid="clr-namespace:Kazuko.Shared.UI.DataGridLayout;assembly=Kazuko.Shared.UI"
             xmlns:access="clr-namespace:Kazuko.Shared.UI.Behaviors;assembly=Kazuko.Shared.UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/SalesResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:CraftOrderStatusTextConverter x:Key="CraftOrderStatusText" />
            <BooleanToVisibilityConverter x:Key="CraftBoolToVisibility" />
            <Style x:Key="CraftOrderStatusBadgeStyle" TargetType="ContentControl">
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <Border CornerRadius="6" Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}" BorderThickness="1"
                                    BorderBrush="{TemplateBinding BorderBrush}">
                                <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                           TextWrapping="Wrap" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Tag" Value="DEPOSITED">
                        <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource LinkBrush}" />
                    </Trigger>
                    <Trigger Property="Tag" Value="CONFIRMED">
                        <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource LinkBrush}" />
                    </Trigger>
                    <Trigger Property="Tag" Value="IN_PRODUCTION">
                        <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource LinkBrush}" />
                    </Trigger>
                    <Trigger Property="Tag" Value="READY">
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                    </Trigger>
                    <Trigger Property="Tag" Value="PARTIALLY_DELIVERED">
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                    </Trigger>
                    <Trigger Property="Tag" Value="COMPLETED">
                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                    </Trigger>
                    <Trigger Property="Tag" Value="CANCELLED">
                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="CraftOrderRemainingTextStyle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="{DynamicResource FontSize.Subtitle}" />
                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedHeader.RemainingDueVnd}" Value="0">
                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HasDetail}" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="CraftOrderFilterComboStyle" TargetType="ComboBox" BasedOn="{StaticResource SalesComboStyle}">
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter Property="Padding" Value="10,8" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border x:Name="ItemBorder" Padding="{TemplateBinding Padding}" CornerRadius="6" Background="{DynamicResource SurfaceBrush}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border CornerRadius="8"
                                                    Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                    BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                    BorderThickness="1">
                                                <Path Data="M 0 0 L 5 5 L 10 0" StrokeThickness="1.5"
                                                      Stroke="{DynamicResource TextPrimaryBrush}"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter IsHitTestVisible="False" Margin="12,6,34,6" VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                                <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                       IsOpen="{TemplateBinding IsDropDownOpen}">
                                    <Border CornerRadius="8" Padding="4" Margin="0,3,0,0"
                                            MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                            MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsDropDownOpen" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.55" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CraftOrderAmountCellStyle" TargetType="TextBlock">
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="CraftOrderNameCellStyle" TargetType="TextBlock">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="ToolTip" Value="{Binding ProductName}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" MinWidth="300" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" MinWidth="420" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource SalesCardStyle}" Padding="12">
            <DockPanel LastChildFill="True">
                <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,0,8">
                    <Button access:PermissionAccess.Rule="CRAFT_ORDER:Add" DockPanel.Dock="Right"
                            Content="Tạo đơn đặt"
                            Style="{StaticResource SalesPrimaryButtonStyle}"
                            Command="{Binding CreateOrderCommand}"
                            MinHeight="36" MinWidth="110"
                            Margin="8,0,0,0"
                            ToolTip="Mở lệnh sản xuất với nguồn Theo đơn đặt" />
                    <TextBlock Text="Danh sách đơn đặt"
                               Style="{StaticResource SalesSectionHeaderStyle}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </DockPanel>

                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Từ ngày" Style="{StaticResource SalesFieldLabelStyle}" />
                        <DatePicker SelectedDate="{Binding FromDate}" Margin="0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Đến ngày" Style="{StaticResource SalesFieldLabelStyle}" />
                        <DatePicker SelectedDate="{Binding ToDate}" Margin="0" />
                    </StackPanel>
                </Grid>

                <ComboBox DockPanel.Dock="Top"
                          Style="{StaticResource CraftOrderFilterComboStyle}"
                          ItemsSource="{Binding StatusFilterOptions}"
                          SelectedItem="{Binding SelectedStatusFilter}"
                          DisplayMemberPath="DisplayName"
                          Margin="0,0,0,8" />

                <TextBox DockPanel.Dock="Top"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource SalesRoundedTextBoxStyle}"
                         Margin="0,0,0,8"
                         ToolTip="Tự động tìm theo mã đơn, tên hoặc SĐT khách khi nhập" />

                <TextBlock DockPanel.Dock="Bottom"
                           Text="{Binding StatusMessage}"
                           Style="{StaticResource SalesHintStyle}"
                           Margin="0,8,0,0" />

                <ListBox ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem}"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,4" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,8"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    CornerRadius="6"
                                    HorizontalAlignment="Stretch">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Code}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryBrush}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding OrderDate, StringFormat=dd/MM/yyyy}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="{DynamicResource FontSize.Caption}" />
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                               Text="{Binding CustomerName}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <Grid Grid.Row="2" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ContentControl Tag="{Binding StatusCode}" ToolTip="{Binding StatusCode}"
                                                        Content="{Binding StatusCode, Converter={StaticResource CraftOrderStatusText}}"
                                                        Style="{StaticResource CraftOrderStatusBadgeStyle}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding RemainingDueVnd, StringFormat=N0}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="{DynamicResource FontSize.Caption}"
                                                   FontWeight="SemiBold" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource SalesCardStyle}" Padding="16">
            <DockPanel LastChildFill="True">
                <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,12">
                    <TextBlock Text="{Binding DetailTitle}"
                               Style="{StaticResource SalesSectionHeaderStyle}"
                               VerticalAlignment="Center" />
                    <Button access:PermissionAccess.Rule="CRAFT_ORDER:Edit" DockPanel.Dock="Right"
                            Content="Thu phần còn"
                            Style="{StaticResource SalesOutlineButtonStyle}"
                            Command="{Binding CollectCommand}"
                            MinHeight="36" MinWidth="110"
                            Margin="8,0,0,0"
                            ToolTip="Khi đã xuất kho nhưng chưa tất toán" />
                    <Button DockPanel.Dock="Right" Content="Kiểm tra kết quả" Command="{Binding CheckResultCommand}"
                            Style="{StaticResource SalesOutlineButtonStyle}" MinHeight="36" Margin="8,0,0,0"/>
                    <Button access:PermissionAccess.Rule="CRAFT_ORDER:Edit" DockPanel.Dock="Right"
                            Content="Giao hàng"
                            Style="{StaticResource SalesPrimaryButtonStyle}"
                            Command="{Binding DeliverCommand}"
                            MinHeight="36" MinWidth="110"
                            ToolTip="Xuất thành phẩm + thu phần còn (nếu còn)" />
                </DockPanel>

                <StackPanel>
                    <TextBlock Text="{Binding DetailCustomerText}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,8" />
                    <ContentControl Tag="{Binding SelectedHeader.StatusCode}" ToolTip="{Binding SelectedHeader.StatusCode}"
                                    Content="{Binding SelectedHeader.StatusCode, Converter={StaticResource CraftOrderStatusText}}"
                                    Style="{StaticResource CraftOrderStatusBadgeStyle}" Margin="0,0,0,6"
                                    Visibility="{Binding HasDetail, Converter={StaticResource CraftBoolToVisibility}}" />
                    <TextBlock Text="{Binding IssueStatusText}"
                               Style="{StaticResource SalesHintStyle}"
                               Margin="0,0,0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Tổng báo giá" Style="{StaticResource SalesFieldLabelStyle}" />
                            <TextBlock Text="{Binding GrandTotalText}"
                                       FontWeight="SemiBold"
                                       FontSize="{DynamicResource FontSize.Subtitle}"
                                       Foreground="{DynamicResource PrimaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Đã thu" Style="{StaticResource SalesFieldLabelStyle}" />
                            <TextBlock Text="{Binding PaidAmountText}"
                                       FontWeight="SemiBold"
                                       FontSize="{DynamicResource FontSize.Subtitle}"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Còn lại" Style="{StaticResource SalesFieldLabelStyle}" />
                            <TextBlock Text="{Binding RemainingDueText}"
                                       Style="{StaticResource CraftOrderRemainingTextStyle}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding SettlementHintText}"
                               Style="{StaticResource SalesHintStyle}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0" />

                    <TextBlock Text="Mặt hàng / mẫu"
                               Style="{StaticResource SalesSectionHeaderStyle}"
                               Margin="0,16,0,8" />
                    <Border CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="1">
                    <DataGrid ItemsSource="{Binding Lines}" Style="{StaticResource SalesDataGridStyle}"
                              grid:DataGridColumnLayout.SettingsKey="Sales.CraftOrderLines.v1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              MinHeight="120"
                              MaxHeight="280"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn grid:DataGridColumnLayout.Key="LineNumber" Header="#" Binding="{Binding LineNumber, Mode=OneWay}" Width="40" />
                            <DataGridTextColumn grid:DataGridColumnLayout.Key="ProductName" Header="Tên mẫu" Binding="{Binding ProductName, Mode=OneWay}" Width="*" MinWidth="140" ElementStyle="{StaticResource CraftOrderNameCellStyle}" />
                            <DataGridTextColumn grid:DataGridColumnLayout.Key="GoldPurity" Header="Tuổi vàng" Binding="{Binding GoldPurity, Mode=OneWay}" Width="90" />
                            <DataGridTextColumn grid:DataGridColumnLayout.Key="Quantity" Header="SL" Binding="{Binding Quantity, Mode=OneWay}" Width="55" ElementStyle="{StaticResource CraftOrderAmountCellStyle}" />
                            <DataGridTextColumn grid:DataGridColumnLayout.Key="LaborAmount" Header="Tiền công/SP" Binding="{Binding LaborAmountPerUnitVnd, Mode=OneWay, StringFormat=N0}" Width="145" MinWidth="145" ElementStyle="{StaticResource CraftOrderAmountCellStyle}" />
                            <DataGridTextColumn grid:DataGridColumnLayout.Key="LineTotal" Header="Thành tiền" Binding="{Binding LineTotalVnd, Mode=OneWay, StringFormat=N0}" Width="140" ElementStyle="{StaticResource CraftOrderAmountCellStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    </Border>

                    <TextBlock Text="Tạo đơn đặt và thu cọc tại đây; sau đó tạo lệnh sản xuất theo đơn. Giao hàng xuất serial và thu phần còn khi đơn READY."
                               Style="{StaticResource SalesHintStyle}"
                               TextWrapping="Wrap"
                               Margin="0,16,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
