<UserControl x:Class="Kazuko.Modules.Sales.BuySellTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kazuko.Modules.Sales"
             xmlns:grid="clr-namespace:Kazuko.Shared.UI.DataGridLayout;assembly=Kazuko.Shared.UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/SalesResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header phiếu -->
        <Border Grid.Row="0" Style="{StaticResource SalesCardStyle}" Padding="12,10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Ngày" Style="{StaticResource SalesFieldLabelStyle}" />
                    <DatePicker SelectedDate="{Binding DocumentDate}" MinHeight="36"
                                VerticalContentAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Số phiếu" Style="{StaticResource SalesFieldLabelStyle}" />
                    <TextBox Text="{Binding DocumentCode}" Style="{StaticResource SalesCodeTextBoxStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Khách hàng" Style="{StaticResource SalesFieldLabelStyle}" />
                    <ComboBox ItemsSource="{Binding CustomerOptions}" SelectedItem="{Binding SelectedCustomer}"
                              DisplayMemberPath="Name"
                              Style="{StaticResource SalesComboStyle}" IsEditable="True" />
                </StackPanel>
                <Button Grid.Column="6" Content="+"
                        Style="{StaticResource SalesIconButtonStyle}"
                        Margin="0,20,0,0"
                        Command="{Binding AddCustomerCommand}"
                        ToolTip="Thêm khách hàng" />
                <StackPanel Grid.Column="8">
                    <TextBlock Text="Nhân viên" Style="{StaticResource SalesFieldLabelStyle}" />
                    <ComboBox ItemsSource="{Binding StaffOptions}" SelectedItem="{Binding SelectedStaff}"
                              DisplayMemberPath="DisplayName"
                              Style="{StaticResource SalesComboStyle}"
                              IsEnabled="{Binding CanChangeSalesperson}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="280" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <!-- Hai bảng chia đều chiều cao còn lại -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.25*" MinHeight="240" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" MinHeight="240" />
                </Grid.RowDefinitions>

                <!-- Vàng mới bán ra -->
                <Border Grid.Row="0" Style="{StaticResource SalesCardStyle}" Padding="10">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Text="Vàng mới bán ra"
                                   Style="{StaticResource SalesSectionHeaderStyle}"
                                   Margin="0,0,0,8" />
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="260" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Mã hàng" Style="{StaticResource SalesFieldLabelStyle}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Grid x:Name="ProductSearchHost" Grid.Column="1">
                                <TextBox x:Name="ProductCodeBox"
                                         Text="{Binding ProductCodeInput, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SalesRoundedTextBoxStyle}"
                                         PreviewKeyDown="ProductCodeBox_PreviewKeyDown" />
                                <Popup IsOpen="{Binding IsProductSuggestionOpen, Mode=TwoWay}"
                                       PlacementTarget="{Binding ElementName=ProductCodeBox}"
                                       Placement="Bottom"
                                       StaysOpen="True"
                                       AllowsTransparency="True"
                                       PopupAnimation="Fade">
                                    <Border Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            MinWidth="{Binding ActualWidth, ElementName=ProductCodeBox}"
                                            MaxHeight="260"
                                            Padding="0,4">
                                        <ListBox x:Name="ProductSuggestionList"
                                                 ItemsSource="{Binding ProductSuggestions}"
                                                 SelectedItem="{Binding SelectedProductSuggestion, Mode=TwoWay}"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 PreviewKeyDown="ProductSuggestionList_PreviewKeyDown"
                                                 PreviewMouseLeftButtonUp="ProductSuggestionList_PreviewMouseLeftButtonUp">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:ProductSuggestionItem}">
                                                    <Grid MinWidth="320" Margin="4,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="100" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="72" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding ProductCode}" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding ProductName}"
                                                                   Margin="8,0" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding WeightText, StringFormat=TL {0}}"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Right" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </Popup>
                            </Grid>
                            <Button Grid.Column="3" Content="Nhập (Enter)"
                                    Style="{StaticResource SalesPrimaryButtonStyle}"
                                    Command="{Binding AddSellLineCommand}"
                                    MinHeight="36" Padding="12,4" />
                            <Button Grid.Column="5" Content="Xóa"
                                    Style="{StaticResource SalesGhostButtonStyle}"
                                    Command="{Binding RemoveSellLineCommand}"
                                    MinHeight="36" MinWidth="72" Margin="0" />
                            <Button Grid.Column="7" Content="Sửa giá"
                                    Style="{StaticResource SalesOutlineButtonStyle}"
                                    Command="{Binding EditSellPriceCommand}"
                                    MinHeight="36" MinWidth="88" Margin="0"
                                    ToolTip="Điều chỉnh giá vàng / công / đá (cần quyền)" />
                            <Button Grid.Column="9" Content="Xóa hết"
                                    Style="{StaticResource SalesDangerButtonStyle}"
                                    Command="{Binding ClearSellLinesCommand}"
                                    MinHeight="36" MinWidth="88" Margin="0" />
                        </Grid>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{Binding StatusMessage}"
                                   Foreground="{DynamicResource DangerBrush}"
                                   FontSize="{DynamicResource FontSize.Caption}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6" />
                        <DataGrid Style="{StaticResource SalesDataGridStyle}"
                                  ItemsSource="{Binding SellLines}"
                                  SelectedItem="{Binding SelectedSellLine}"
                                  BorderThickness="0"
                                  VerticalScrollBarVisibility="Auto"
                                  grid:DataGridColumnLayout.SettingsKey="sales.buysell.sell-lines">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT" grid:DataGridColumnLayout.Key="Index"
                                                    Binding="{Binding Index, Mode=OneWay}" Width="44" />
                                <DataGridTextColumn Header="Mã hàng" grid:DataGridColumnLayout.Key="ProductCode"
                                                    Binding="{Binding ProductCode, Mode=OneWay}" Width="90" />
                                <DataGridTextColumn Header="Tên hàng" grid:DataGridColumnLayout.Key="ProductName"
                                                    Binding="{Binding ProductName, Mode=OneWay}" Width="*" MinWidth="120" />
                                <DataGridTextColumn Header="Loại vàng" grid:DataGridColumnLayout.Key="GoldType"
                                                    Binding="{Binding GoldType, Mode=OneWay}" Width="80" />
                                <DataGridTextColumn Header="TL Vàng (chỉ)" grid:DataGridColumnLayout.Key="GoldWeight"
                                                    Binding="{Binding GoldWeightText, Mode=OneWay}" Width="90" />
                                <DataGridTextColumn Header="TL Đá (chỉ)" grid:DataGridColumnLayout.Key="StoneWeight"
                                                    Binding="{Binding StoneWeightText, Mode=OneWay}" Width="80" />
                                <DataGridTextColumn Header="Công bán" grid:DataGridColumnLayout.Key="LaborFee"
                                                    Binding="{Binding LaborFeeText, Mode=OneWay}" Width="90" />
                                <DataGridTextColumn Header="Giá bán" grid:DataGridColumnLayout.Key="SellPrice"
                                                    Binding="{Binding SellPriceText, Mode=OneWay}" Width="90" />
                                <DataGridTextColumn Header="Tiền đá" grid:DataGridColumnLayout.Key="StoneAmount"
                                                    Binding="{Binding StoneAmountText, Mode=OneWay}" Width="90" />
                                <DataGridTextColumn Header="Thành tiền" grid:DataGridColumnLayout.Key="LineTotal"
                                                    Binding="{Binding LineTotalText, Mode=OneWay}" Width="100" />
                                <DataGridTextColumn Header="Kho" grid:DataGridColumnLayout.Key="Warehouse"
                                                    Binding="{Binding Warehouse, Mode=OneWay}" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- Vàng cũ thu mua -->
                <Border Grid.Row="2" Style="{StaticResource SalesCardStyle}" Padding="10">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Text="Vàng cũ thu mua về"
                                   Style="{StaticResource SalesSectionHeaderStyle}"
                                   Margin="0,0,0,8" />
                        <ScrollViewer DockPanel.Dock="Top"
                                      VerticalScrollBarVisibility="Disabled"
                                      HorizontalScrollBarVisibility="Auto"
                                      Margin="0,0,0,8">
                            <Grid MinWidth="900">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Loại v.cũ" Style="{StaticResource SalesFieldLabelStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Tổng TL (chỉ)" Style="{StaticResource SalesFieldLabelStyle}"
                                           ToolTip="Trọng lượng cân cả món, đơn vị chỉ" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="TL Đá (chỉ)" Style="{StaticResource SalesFieldLabelStyle}"
                                           ToolTip="Trọng lượng đá trừ ra, đơn vị chỉ" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="TL vàng (chỉ)" Style="{StaticResource SalesFieldLabelStyle}"
                                           ToolTip="Tự tính: Tổng TL − TL Đá, đơn vị chỉ" />
                                <TextBlock Grid.Row="0" Grid.Column="4" Text="Giá trị %" Style="{StaticResource SalesFieldLabelStyle}"
                                           ToolTip="Phần trăm quy đổi theo tuổi vàng (vd. 585 → 58,5%)" />
                                <TextBlock Grid.Row="0" Grid.Column="5" Text="TL quy đổi (chỉ)" Style="{StaticResource SalesFieldLabelStyle}"
                                           ToolTip="Tự tính: TL vàng × Giá trị % / 100, đơn vị chỉ" />
                                <TextBlock Grid.Row="0" Grid.Column="6" Text="Giá mua (/chỉ)" Style="{StaticResource SalesFieldLabelStyle}"
                                           ToolTip="Đơn giá mua mỗi chỉ sau quy đổi (VND)" />
                                <TextBlock Grid.Row="0" Grid.Column="7" Text="Lý do giá" Style="{StaticResource SalesFieldLabelStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="8" Text="Số lượng" Style="{StaticResource SalesFieldLabelStyle}"
                                           ToolTip="Số món mô tả; không nhân vào thành tiền" />

                                <ComboBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding OldGoldTypeOptions}"
                                          SelectedItem="{Binding SelectedOldGoldMaterial}"
                                          DisplayMemberPath="Name"
                                          Style="{StaticResource SalesComboStyle}" Margin="0,0,6,0" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OldTotalWeightText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SalesNumericTextBoxStyle}" Margin="0,0,6,0"
                                         ToolTip="Nhập số chỉ (thập phân dùng . hoặc ,)" />
                                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding OldStoneWeightText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SalesNumericTextBoxStyle}" Margin="0,0,6,0"
                                         ToolTip="Nhập số chỉ đá (thập phân dùng . hoặc ,)" />
                                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding OldGoldWeightText, Mode=OneWay}"
                                         Style="{StaticResource SalesNumericTextBoxStyle}" Margin="0,0,6,0" IsReadOnly="True"
                                         ToolTip="Tự tính: Tổng TL − TL Đá (chỉ)" />
                                <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding OldValuePercentText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SalesNumericTextBoxStyle}" Margin="0,0,6,0" />
                                <TextBox Grid.Row="1" Grid.Column="5" Text="{Binding OldConvertedWeightText, Mode=OneWay}"
                                         Style="{StaticResource SalesNumericTextBoxStyle}" Margin="0,0,6,0" IsReadOnly="True"
                                         ToolTip="Tự tính: TL vàng × Giá trị % / 100 (chỉ)" />
                                <TextBox Grid.Row="1" Grid.Column="6" Text="{Binding OldBuyPriceText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SalesNumericTextBoxStyle}" Margin="0,0,6,0"
                                         ToolTip="VND / chỉ quy đổi" />
                                <TextBox Grid.Row="1" Grid.Column="7" Text="{Binding OldOverrideReason, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SalesRoundedTextBoxStyle}" Margin="0,0,6,0"
                                         ToolTip="Lý do điều chỉnh giá (nếu có)" />
                                <TextBox Grid.Row="1" Grid.Column="8" Text="{Binding OldQuantityText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SalesNumericTextBoxStyle}" Margin="0,0,6,0"
                                         ToolTip="Số món mô tả; không nhân vào thành tiền" />
                                <Button Grid.Row="1" Grid.Column="9" Content="Nhập"
                                        Style="{StaticResource SalesPrimaryButtonStyle}"
                                        Command="{Binding AddBuyLineCommand}"
                                        MinHeight="36" MinWidth="72" Padding="12,4" Margin="0,0,6,0" />
                                <Button Grid.Row="1" Grid.Column="10" Content="Xóa"
                                        Style="{StaticResource SalesDangerButtonStyle}"
                                        Command="{Binding RemoveBuyLineCommand}"
                                        MinHeight="36" MinWidth="64" Margin="0" />
                            </Grid>
                        </ScrollViewer>
                        <DataGrid Style="{StaticResource SalesDataGridStyle}"
                                  ItemsSource="{Binding BuyLines}"
                                  SelectedItem="{Binding SelectedBuyLine}"
                                  BorderThickness="0"
                                  VerticalScrollBarVisibility="Auto"
                                  grid:DataGridColumnLayout.SettingsKey="sales.buysell.buy-lines">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT" grid:DataGridColumnLayout.Key="Index"
                                                    Binding="{Binding Index, Mode=OneWay}" Width="44" />
                                <DataGridTextColumn Header="Loại v.cũ" grid:DataGridColumnLayout.Key="OldGoldType"
                                                    Binding="{Binding OldGoldType, Mode=OneWay}" Width="90" />
                                <DataGridTextColumn Header="Tổng TL (chỉ)" grid:DataGridColumnLayout.Key="TotalWeight"
                                                    Binding="{Binding TotalWeightText, Mode=OneWay}" Width="100" />
                                <DataGridTextColumn Header="TL Đá (chỉ)" grid:DataGridColumnLayout.Key="StoneWeight"
                                                    Binding="{Binding StoneWeightText, Mode=OneWay}" Width="90" />
                                <DataGridTextColumn Header="TL Vàng (chỉ)" grid:DataGridColumnLayout.Key="GoldWeight"
                                                    Binding="{Binding GoldWeightText, Mode=OneWay}" Width="100" />
                                <DataGridTextColumn Header="TL Quy đổi (chỉ)" grid:DataGridColumnLayout.Key="ConvertedWeight"
                                                    Binding="{Binding ConvertedWeightText, Mode=OneWay}" Width="110" />
                                <DataGridTextColumn Header="Giá trị %" grid:DataGridColumnLayout.Key="ValuePercent"
                                                    Binding="{Binding ValuePercentText, Mode=OneWay}" Width="80" />
                                <DataGridTextColumn Header="Giá mua" grid:DataGridColumnLayout.Key="BuyPrice"
                                                    Binding="{Binding BuyPriceText, Mode=OneWay}" Width="90" />
                                <DataGridTextColumn Header="Thành tiền" grid:DataGridColumnLayout.Key="LineTotal"
                                                    Binding="{Binding LineTotalText, Mode=OneWay}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Tổng cộng + thanh toán -->
            <Border Grid.Column="2" Style="{StaticResource SalesCardStyle}" Padding="14"
                    VerticalAlignment="Stretch">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Tổng cộng"
                               Style="{StaticResource SalesSectionHeaderStyle}"
                               HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <Button DockPanel.Dock="Bottom"
                            Content="Thanh toán (F9)"
                            Style="{StaticResource SalesPrimaryButtonStyle}"
                            Command="{Binding DataContext.PayCommand, RelativeSource={RelativeSource AncestorType=local:SalesView}}"
                            MinHeight="44"
                            Margin="0,10,0,0" />
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource SalesAmountHeroStyle}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Phải thu"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="{DynamicResource FontSize.Caption}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding AmountDueText}"
                                       Foreground="{DynamicResource DangerBrush}"
                                       FontSize="{DynamicResource FontSize.Display}"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Tiền vàng mới" Style="{StaticResource SalesFieldLabelStyle}" />
                        <TextBox Style="{StaticResource SalesSummaryValueStyle}" Text="{Binding NewGoldTotalText, Mode=OneWay}" />
                        <TextBlock Text="Tiền vàng cũ" Style="{StaticResource SalesFieldLabelStyle}" />
                        <TextBox Style="{StaticResource SalesSummaryValueStyle}" Text="{Binding OldGoldTotalText, Mode=OneWay}" />
                        <TextBlock Text="Cộng" Style="{StaticResource SalesFieldLabelStyle}" />
                        <TextBox Style="{StaticResource SalesSummaryValueStyle}" Text="{Binding SubtotalText, Mode=OneWay}" />
                        <TextBlock Text="Tiền bớt" Style="{StaticResource SalesFieldLabelStyle}" />
                        <TextBox Text="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SalesNumericTextBoxStyle}"
                                 Margin="0,0,0,10" />
                        <TextBlock Text="Tổng cộng" Style="{StaticResource SalesFieldLabelStyle}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBox Style="{StaticResource SalesSummaryValueStyle}" Text="{Binding GrandTotalText, Mode=OneWay}"
                                 FontWeight="SemiBold" Margin="0" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
