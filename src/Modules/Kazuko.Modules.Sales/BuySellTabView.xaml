<UserControl x:Class="Kazuko.Modules.Sales.BuySellTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:grid="clr-namespace:Kazuko.Shared.UI.DataGridLayout;assembly=Kazuko.Shared.UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/SalesResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header phiếu -->
        <Border Grid.Row="0" Style="{DynamicResource CardBorderStyle}" Padding="12" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Ngày" Style="{StaticResource SalesFieldLabelStyle}" />
                    <DatePicker SelectedDate="{Binding DocumentDate}" MinHeight="36" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Số phiếu" Style="{StaticResource SalesFieldLabelStyle}" />
                    <TextBox Text="{Binding DocumentCode}" IsReadOnly="True" MinHeight="36"
                             Padding="10,4" VerticalContentAlignment="Center"
                             Foreground="{DynamicResource PrimaryBrush}"
                             Background="{DynamicResource SurfaceAltBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             FontSize="{DynamicResource FontSize.Body}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Khách hàng" Style="{StaticResource SalesFieldLabelStyle}" />
                    <ComboBox ItemsSource="{Binding CustomerOptions}" SelectedItem="{Binding SelectedCustomer}"
                              MinHeight="36" IsEditable="True" />
                </StackPanel>
                <Button Grid.Column="6" Content="…" MinHeight="36" MinWidth="40" Margin="0,20,0,0"
                        Style="{DynamicResource NavButtonStyle}"
                        Command="{Binding LookupCustomerCommand}"
                        ToolTip="Tìm khách hàng" />
                <StackPanel Grid.Column="8">
                    <TextBlock Text="Nhân viên" Style="{StaticResource SalesFieldLabelStyle}" />
                    <ComboBox ItemsSource="{Binding StaffOptions}" SelectedItem="{Binding SelectedStaff}"
                              MinHeight="36" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="260" MinWidth="220" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.2*" MinHeight="180" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" MinHeight="160" />
                </Grid.RowDefinitions>

                <!-- Vàng mới / HĐĐT -->
                <Border Grid.Row="0" Style="{DynamicResource CardBorderStyle}" Padding="8">
                    <TabControl SelectedIndex="{Binding ContentTabIndex}">
                        <TabItem Header="VÀNG MỚI BÁN RA">
                            <DockPanel Margin="4">
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Mã hàng" Style="{StaticResource SalesFieldLabelStyle}"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox Grid.Column="1" Text="{Binding ProductCodeInput, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="36" Padding="10,4" VerticalContentAlignment="Center" />
                                    <Button Grid.Column="3" Content="Nhập (Enter)" Style="{DynamicResource PrimaryButtonStyle}"
                                            Command="{Binding AddSellLineCommand}" MinHeight="36" Padding="12,0" />
                                    <Button Grid.Column="5" Content="Xóa" Style="{DynamicResource NavButtonStyle}"
                                            Command="{Binding RemoveSellLineCommand}" MinHeight="36" MinWidth="72" />
                                    <Button Grid.Column="7" Content="Xóa hết" Style="{DynamicResource NavButtonStyle}"
                                            Command="{Binding ClearSellLinesCommand}" MinHeight="36" MinWidth="88"
                                            Foreground="{DynamicResource DangerBrush}" />
                                </Grid>
                                <DataGrid Style="{StaticResource SalesDataGridStyle}"
                                          ItemsSource="{Binding SellLines}"
                                          SelectedItem="{Binding SelectedSellLine}"
                                          grid:DataGridColumnLayout.SettingsKey="sales.buysell.sell-lines">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="STT" grid:DataGridColumnLayout.Key="Index"
                                                            Binding="{Binding Index, Mode=OneWay}" Width="44" />
                                        <DataGridTextColumn Header="Mã hàng" grid:DataGridColumnLayout.Key="ProductCode"
                                                            Binding="{Binding ProductCode, Mode=OneWay}" Width="90" />
                                        <DataGridTextColumn Header="Tên hàng" grid:DataGridColumnLayout.Key="ProductName"
                                                            Binding="{Binding ProductName, Mode=OneWay}" Width="*" MinWidth="100" />
                                        <DataGridTextColumn Header="Loại vàng" grid:DataGridColumnLayout.Key="GoldType"
                                                            Binding="{Binding GoldType, Mode=OneWay}" Width="80" />
                                        <DataGridTextColumn Header="TL Vàng (Chỉ)" grid:DataGridColumnLayout.Key="GoldWeight"
                                                            Binding="{Binding GoldWeightText, Mode=OneWay}" Width="90" />
                                        <DataGridTextColumn Header="TL Đá" grid:DataGridColumnLayout.Key="StoneWeight"
                                                            Binding="{Binding StoneWeightText, Mode=OneWay}" Width="70" />
                                        <DataGridTextColumn Header="Công bán" grid:DataGridColumnLayout.Key="LaborFee"
                                                            Binding="{Binding LaborFeeText, Mode=OneWay}" Width="90" />
                                        <DataGridTextColumn Header="Cắt Ni" grid:DataGridColumnLayout.Key="SizeCut"
                                                            Binding="{Binding SizeCutText, Mode=OneWay}" Width="70" />
                                        <DataGridTextColumn Header="Vàng thực tế" grid:DataGridColumnLayout.Key="ActualGold"
                                                            Binding="{Binding ActualGoldText, Mode=OneWay}" Width="90" />
                                        <DataGridTextColumn Header="Giá bán" grid:DataGridColumnLayout.Key="SellPrice"
                                                            Binding="{Binding SellPriceText, Mode=OneWay}" Width="90" />
                                        <DataGridTextColumn Header="Tiền đá" grid:DataGridColumnLayout.Key="StoneAmount"
                                                            Binding="{Binding StoneAmountText, Mode=OneWay}" Width="90" />
                                        <DataGridTextColumn Header="Thành tiền" grid:DataGridColumnLayout.Key="LineTotal"
                                                            Binding="{Binding LineTotalText, Mode=OneWay}" Width="100" />
                                        <DataGridTextColumn Header="Kho" grid:DataGridColumnLayout.Key="Warehouse"
                                                            Binding="{Binding Warehouse, Mode=OneWay}" Width="110" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="HÓA ĐƠN ĐIỆN TỬ">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                                        <TextBlock Text="Mã số thuế" Style="{StaticResource SalesFieldLabelStyle}" />
                                        <TextBox Text="{Binding EinvoiceTaxCode, UpdateSourceTrigger=PropertyChanged}"
                                                 MinHeight="36" Padding="10,4" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                                        <TextBlock Text="Tên người mua / đơn vị" Style="{StaticResource SalesFieldLabelStyle}" />
                                        <TextBox Text="{Binding EinvoiceBuyerName, UpdateSourceTrigger=PropertyChanged}"
                                                 MinHeight="36" Padding="10,4" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,10">
                                        <TextBlock Text="Địa chỉ" Style="{StaticResource SalesFieldLabelStyle}" />
                                        <TextBox Text="{Binding EinvoiceAddress, UpdateSourceTrigger=PropertyChanged}"
                                                 MinHeight="36" Padding="10,4" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,10">
                                        <TextBlock Text="Email nhận HĐ" Style="{StaticResource SalesFieldLabelStyle}" />
                                        <TextBox Text="{Binding EinvoiceEmail, UpdateSourceTrigger=PropertyChanged}"
                                                 MinHeight="36" Padding="10,4" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,10">
                                        <TextBlock Text="Số điện thoại" Style="{StaticResource SalesFieldLabelStyle}" />
                                        <TextBox Text="{Binding EinvoicePhone, UpdateSourceTrigger=PropertyChanged}"
                                                 MinHeight="36" Padding="10,4" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,10">
                                        <TextBlock Text="Hình thức hóa đơn" Style="{StaticResource SalesFieldLabelStyle}" />
                                        <ComboBox ItemsSource="{Binding InvoiceFormOptions}"
                                                  SelectedItem="{Binding EinvoiceInvoiceForm}" MinHeight="36" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
                                        <TextBlock Text="Ghi chú HĐĐT" Style="{StaticResource SalesFieldLabelStyle}" />
                                        <TextBox Text="{Binding EinvoiceNotes, UpdateSourceTrigger=PropertyChanged}"
                                                 MinHeight="72" TextWrapping="Wrap" AcceptsReturn="True" Padding="10,6" />
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Border>

                <!-- Vàng cũ thu mua -->
                <Border Grid.Row="2" Style="{DynamicResource CardBorderStyle}" Padding="12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="VÀNG CŨ THU MUA VỀ"
                                   Style="{StaticResource SalesSectionHeaderStyle}" />
                        <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Disabled"
                                      HorizontalScrollBarVisibility="Auto" Margin="0,0,0,8">
                            <Grid MinWidth="900">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Loại v.cũ" Style="{StaticResource SalesFieldLabelStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Tổng TL" Style="{StaticResource SalesFieldLabelStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="TL Đá" Style="{StaticResource SalesFieldLabelStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Trừ dơ" Style="{StaticResource SalesFieldLabelStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="4" Text="TL vàng" Style="{StaticResource SalesFieldLabelStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="5" Text="Giá trị %" Style="{StaticResource SalesFieldLabelStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="6" Text="TL quy đổi" Style="{StaticResource SalesFieldLabelStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="7" Text="Giá mua" Style="{StaticResource SalesFieldLabelStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="8" Text="Mã hàng" Style="{StaticResource SalesFieldLabelStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="9" Text="Số lượng" Style="{StaticResource SalesFieldLabelStyle}" />

                                <ComboBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding OldGoldTypeOptions}"
                                          SelectedItem="{Binding OldGoldType}" MinHeight="36" Margin="0,0,4,0" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OldTotalWeight, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="36" Margin="0,0,4,0" Padding="6,4" HorizontalContentAlignment="Right" />
                                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding OldStoneWeight, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="36" Margin="0,0,4,0" Padding="6,4" HorizontalContentAlignment="Right" />
                                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding OldImpurityDeduction, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="36" Margin="0,0,4,0" Padding="6,4" HorizontalContentAlignment="Right" />
                                <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding OldGoldWeight, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="36" Margin="0,0,4,0" Padding="6,4" HorizontalContentAlignment="Right" />
                                <TextBox Grid.Row="1" Grid.Column="5" Text="{Binding OldValuePercent, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="36" Margin="0,0,4,0" Padding="6,4" HorizontalContentAlignment="Right" />
                                <TextBox Grid.Row="1" Grid.Column="6" Text="{Binding OldConvertedWeight, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="36" Margin="0,0,4,0" Padding="6,4" HorizontalContentAlignment="Right" />
                                <TextBox Grid.Row="1" Grid.Column="7" Text="{Binding OldBuyPrice, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="36" Margin="0,0,4,0" Padding="6,4" HorizontalContentAlignment="Right" />
                                <TextBox Grid.Row="1" Grid.Column="8" Text="{Binding OldProductCode, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="36" Margin="0,0,4,0" Padding="6,4" />
                                <TextBox Grid.Row="1" Grid.Column="9" Text="{Binding OldQuantity, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="36" Margin="0,0,4,0" Padding="6,4" HorizontalContentAlignment="Right" />
                                <Button Grid.Row="1" Grid.Column="10" Content="Nhập" Style="{DynamicResource PrimaryButtonStyle}"
                                        Command="{Binding AddBuyLineCommand}" MinHeight="36" MinWidth="72" Margin="0,0,4,0" />
                                <Button Grid.Row="1" Grid.Column="11" Content="Xóa" Style="{DynamicResource NavButtonStyle}"
                                        Command="{Binding RemoveBuyLineCommand}" MinHeight="36" MinWidth="64"
                                        Foreground="{DynamicResource DangerBrush}" />
                            </Grid>
                        </ScrollViewer>
                        <DataGrid Style="{StaticResource SalesDataGridStyle}"
                                  ItemsSource="{Binding BuyLines}"
                                  SelectedItem="{Binding SelectedBuyLine}"
                                  grid:DataGridColumnLayout.SettingsKey="sales.buysell.buy-lines">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT" grid:DataGridColumnLayout.Key="Index"
                                                    Binding="{Binding Index, Mode=OneWay}" Width="44" />
                                <DataGridTextColumn Header="Loại v.cũ" grid:DataGridColumnLayout.Key="OldGoldType"
                                                    Binding="{Binding OldGoldType, Mode=OneWay}" Width="90" />
                                <DataGridTextColumn Header="Tổng TL (Chỉ)" grid:DataGridColumnLayout.Key="TotalWeight"
                                                    Binding="{Binding TotalWeightText, Mode=OneWay}" Width="100" />
                                <DataGridTextColumn Header="TL Đá (Chỉ)" grid:DataGridColumnLayout.Key="StoneWeight"
                                                    Binding="{Binding StoneWeightText, Mode=OneWay}" Width="90" />
                                <DataGridTextColumn Header="TL Vàng (Chỉ)" grid:DataGridColumnLayout.Key="GoldWeight"
                                                    Binding="{Binding GoldWeightText, Mode=OneWay}" Width="100" />
                                <DataGridTextColumn Header="TL Quy đổi (Chỉ)" grid:DataGridColumnLayout.Key="ConvertedWeight"
                                                    Binding="{Binding ConvertedWeightText, Mode=OneWay}" Width="110" />
                                <DataGridTextColumn Header="Giá trị %" grid:DataGridColumnLayout.Key="ValuePercent"
                                                    Binding="{Binding ValuePercentText, Mode=OneWay}" Width="80" />
                                <DataGridTextColumn Header="Giá mua" grid:DataGridColumnLayout.Key="BuyPrice"
                                                    Binding="{Binding BuyPriceText, Mode=OneWay}" Width="90" />
                                <DataGridTextColumn Header="Thành tiền" grid:DataGridColumnLayout.Key="LineTotal"
                                                    Binding="{Binding LineTotalText, Mode=OneWay}" Width="100" />
                                <DataGridTemplateColumn Header="In tem nhập kho" grid:DataGridColumnLayout.Key="PrintLabel" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="In tem" Style="{DynamicResource NavButtonStyle}"
                                                    MinHeight="28" Padding="8,0"
                                                    Command="{Binding DataContext.PrintStockLabelCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Sidebar tổng -->
            <Border Grid.Column="2" Style="{DynamicResource CardBorderStyle}" Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="TỔNG CỘNG"
                               Style="{StaticResource SalesSectionHeaderStyle}"
                               HorizontalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                        <TextBlock Text="PHẢI THU"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   FontSize="{DynamicResource FontSize.Subtitle}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding AmountDueText}"
                                   Foreground="{DynamicResource DangerBrush}"
                                   FontSize="{DynamicResource FontSize.Display}"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Tiền vàng mới" Style="{StaticResource SalesFieldLabelStyle}" />
                        <TextBox Style="{StaticResource SalesSummaryValueStyle}" Text="{Binding NewGoldTotalText, Mode=OneWay}" Margin="0,0,0,10" />
                        <TextBlock Text="Tiền vàng cũ" Style="{StaticResource SalesFieldLabelStyle}" />
                        <TextBox Style="{StaticResource SalesSummaryValueStyle}" Text="{Binding OldGoldTotalText, Mode=OneWay}" Margin="0,0,0,10" />
                        <TextBlock Text="Cộng" Style="{StaticResource SalesFieldLabelStyle}" />
                        <TextBox Style="{StaticResource SalesSummaryValueStyle}" Text="{Binding SubtotalText, Mode=OneWay}" Margin="0,0,0,10" />
                        <TextBlock Text="Tiền bớt" Style="{StaticResource SalesFieldLabelStyle}" />
                        <TextBox Text="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="32" Padding="8,4" HorizontalContentAlignment="Right"
                                 Background="{DynamicResource SurfaceBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 FontSize="{DynamicResource FontSize.Body}"
                                 Margin="0,0,0,10" />
                        <TextBlock Text="TỔNG CỘNG" Style="{StaticResource SalesFieldLabelStyle}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBox Style="{StaticResource SalesSummaryValueStyle}" Text="{Binding GrandTotalText, Mode=OneWay}"
                                 FontWeight="SemiBold" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
