<UserControl x:Class="Kazuko.Modules.Sales.WholesaleTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:access="clr-namespace:Kazuko.Shared.UI.Behaviors;assembly=Kazuko.Shared.UI"
             xmlns:local="clr-namespace:Kazuko.Modules.Sales"
             xmlns:grid="clr-namespace:Kazuko.Shared.UI.DataGridLayout;assembly=Kazuko.Shared.UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/SalesResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource SalesCardStyle}" Padding="12,10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Ngày" Style="{StaticResource SalesFieldLabelStyle}" />
                    <DatePicker SelectedDate="{Binding DocumentDate}" MinHeight="36"
                                VerticalContentAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Số phiếu" Style="{StaticResource SalesFieldLabelStyle}" />
                    <TextBox Text="{Binding DocumentCode}" Style="{StaticResource SalesCodeTextBoxStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Kho xuất" Style="{StaticResource SalesFieldLabelStyle}" />
                    <ComboBox ItemsSource="{Binding LocationOptions}" SelectedItem="{Binding SelectedLocation}"
                              DisplayMemberPath="Name"
                              Style="{StaticResource SalesComboStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <TextBlock Text="Khách hàng" Style="{StaticResource SalesFieldLabelStyle}" />
                    <ComboBox ItemsSource="{Binding CustomerOptions}" SelectedItem="{Binding SelectedCustomer}"
                              DisplayMemberPath="Name"
                              Style="{StaticResource SalesComboStyle}" IsEditable="True" />
                </StackPanel>
                <Button access:PermissionAccess.Rule="CAT_CUSTOMERS:Add" Grid.Column="8" Content="+"
                        Style="{StaticResource SalesIconButtonStyle}"
                        Margin="0,20,0,0"
                        Command="{Binding AddCustomerCommand}"
                        ToolTip="Thêm khách hàng" />
                <StackPanel Grid.Column="10">
                    <TextBlock Text="Nhân viên" Style="{StaticResource SalesFieldLabelStyle}" />
                    <ComboBox ItemsSource="{Binding StaffOptions}" SelectedItem="{Binding SelectedStaff}"
                              DisplayMemberPath="DisplayName"
                              Style="{StaticResource SalesComboStyle}"
                              IsEnabled="{Binding CanChangeSalesperson}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="340" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SalesCardStyle}" Padding="10">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="Hàng bán sỉ"
                               Style="{StaticResource SalesSectionHeaderStyle}"
                               Margin="0,0,0,8" />
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="260" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Mã hàng" Style="{StaticResource SalesFieldLabelStyle}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Grid x:Name="ProductSearchHost" Grid.Column="1">
                            <TextBox x:Name="ProductCodeBox"
                                     Text="{Binding ProductCodeInput, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SalesRoundedTextBoxStyle}"
                                     PreviewKeyDown="ProductCodeBox_PreviewKeyDown" />
                            <Popup IsOpen="{Binding IsProductSuggestionOpen, Mode=TwoWay}"
                                   PlacementTarget="{Binding ElementName=ProductCodeBox}"
                                   Placement="Bottom"
                                   StaysOpen="True"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        MinWidth="{Binding ActualWidth, ElementName=ProductCodeBox}"
                                        MaxHeight="260"
                                        Padding="0,4">
                                    <ListBox x:Name="ProductSuggestionList"
                                             ItemsSource="{Binding ProductSuggestions}"
                                             SelectedItem="{Binding SelectedProductSuggestion, Mode=TwoWay}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             PreviewKeyDown="ProductSuggestionList_PreviewKeyDown"
                                             PreviewMouseLeftButtonUp="ProductSuggestionList_PreviewMouseLeftButtonUp">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:WholesaleProductSuggestionItem}">
                                                <Grid MinWidth="320" Margin="4,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="72" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding ProductCode}" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ProductName}"
                                                               Margin="8,0" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding WeightText, StringFormat=TL {0}}"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Right" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                        </Grid>
                        <Button Grid.Column="3" Content="Nhập (Enter)"
                                Style="{StaticResource SalesPrimaryButtonStyle}"
                                Command="{Binding AddLineCommand}"
                                MinHeight="36" Padding="12,4" />
                        <Button Grid.Column="5" Content="Xóa"
                                Style="{StaticResource SalesGhostButtonStyle}"
                                Command="{Binding RemoveLineCommand}"
                                MinHeight="36" MinWidth="72" Margin="0" />
                        <Button Grid.Column="7" Content="Xóa hết"
                                Style="{StaticResource SalesDangerButtonStyle}"
                                Command="{Binding ClearLinesCommand}"
                                MinHeight="36" MinWidth="88" Margin="0" />
                    </Grid>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource DangerBrush}"
                               FontSize="{DynamicResource FontSize.Caption}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6" />
                    <DataGrid Style="{StaticResource SalesDataGridStyle}"
                              ItemsSource="{Binding Lines}"
                              SelectedItem="{Binding SelectedLine}"
                              BorderThickness="0"
                              VerticalScrollBarVisibility="Auto"
                              grid:DataGridColumnLayout.SettingsKey="sales.wholesale.lines">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT" grid:DataGridColumnLayout.Key="Index"
                                                Binding="{Binding Index, Mode=OneWay}" Width="44" />
                            <DataGridTextColumn Header="Mã hàng" grid:DataGridColumnLayout.Key="ProductCode"
                                                Binding="{Binding ProductCode, Mode=OneWay}" Width="90" />
                            <DataGridTextColumn Header="Tên hàng" grid:DataGridColumnLayout.Key="ProductName"
                                                Binding="{Binding ProductName, Mode=OneWay}" Width="*" MinWidth="120" />
                            <DataGridTextColumn Header="Loại vàng" grid:DataGridColumnLayout.Key="GoldType"
                                                Binding="{Binding GoldType, Mode=OneWay}" Width="80" />
                            <DataGridTextColumn Header="TL Vàng (chỉ)" grid:DataGridColumnLayout.Key="GoldWeight"
                                                Binding="{Binding GoldWeightText, Mode=OneWay}" Width="90" />
                            <DataGridTextColumn Header="Giá bán kho" grid:DataGridColumnLayout.Key="SellPrice"
                                                Binding="{Binding SellPriceText, Mode=OneWay}" Width="100" />
                            <DataGridTextColumn Header="Tiền công" grid:DataGridColumnLayout.Key="LaborFee"
                                                Binding="{Binding LaborFeeText, Mode=OneWay}" Width="90" />
                            <DataGridTextColumn Header="Chi phí khác" grid:DataGridColumnLayout.Key="StoneAmount"
                                                Binding="{Binding StoneAmountText, Mode=OneWay}" Width="90" />
                            <DataGridTextColumn Header="Thành tiền" grid:DataGridColumnLayout.Key="LineTotal"
                                                Binding="{Binding LineTotalText, Mode=OneWay}" Width="100" />
                            <DataGridTextColumn Header="Kho" grid:DataGridColumnLayout.Key="Warehouse"
                                                Binding="{Binding LocationName, Mode=OneWay}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SalesCardStyle}" Padding="16"
                    VerticalAlignment="Stretch">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Tổng cộng"
                               Style="{StaticResource SalesTotalPaneHeaderStyle}" />
                    <Button access:PermissionAccess.Rule="SALES_RETAIL:Add|OLD_GOLD_PURCHASE:Add|SALES_WHOLESALE:Add" DockPanel.Dock="Bottom"
                            Content="Thanh toán (F9)"
                            Style="{StaticResource SalesPrimaryButtonStyle}"
                            Command="{Binding DataContext.PayCommand, RelativeSource={RelativeSource AncestorType=local:SalesView}}"
                            MinHeight="48"
                            Margin="0,12,0,0" />
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource SalesAmountDueHeroStyle}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Phải thu"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       FontSize="{DynamicResource FontSize.Subtitle}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding AmountDueText}"
                                       Foreground="{DynamicResource DangerBrush}"
                                       FontSize="{DynamicResource FontSize.Display}"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Tổng TL vàng (chỉ)" Style="{StaticResource SalesFieldLabelStyle}" />
                        <TextBox Style="{StaticResource SalesSummaryValueStyle}" Text="{Binding TotalGoldWeightText, Mode=OneWay}" />
                        <TextBlock Text="Tổng tiền bán sỉ" Style="{StaticResource SalesFieldLabelStyle}" />
                        <TextBox Style="{StaticResource SalesSummaryValueStyle}" Text="{Binding GrandTotalText, Mode=OneWay}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
