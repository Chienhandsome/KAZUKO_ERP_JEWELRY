<UserControl x:Class="Kazuko.Modules.Sales.InvoiceHistoryTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:grid="clr-namespace:Kazuko.Shared.UI.DataGridLayout;assembly=Kazuko.Shared.UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/SalesResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" MinWidth="300" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" MinWidth="420" />
        </Grid.ColumnDefinitions>

        <!-- List -->
        <Border Grid.Column="0" Style="{StaticResource SalesCardStyle}" Padding="12">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="Danh sách hóa đơn"
                           Style="{StaticResource SalesSectionHeaderStyle}" />

                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Từ ngày" Style="{StaticResource SalesFieldLabelStyle}" />
                        <DatePicker SelectedDate="{Binding FromDate}" Margin="0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Đến ngày" Style="{StaticResource SalesFieldLabelStyle}" />
                        <DatePicker SelectedDate="{Binding ToDate}" Margin="0" />
                    </StackPanel>
                </Grid>

                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SalesRoundedTextBoxStyle}"
                             Margin="0"
                             ToolTip="Tìm theo mã HĐ, tên hoặc SĐT khách" />
                    <Button Grid.Column="2" Content="Tìm"
                            Style="{StaticResource SalesPrimaryButtonStyle}"
                            Command="{Binding SearchCommand}"
                            MinHeight="36" MinWidth="72" Padding="12,4" Margin="0" />
                </Grid>

                <TextBlock DockPanel.Dock="Bottom"
                           Text="{Binding StatusMessage}"
                           Style="{StaticResource SalesHintStyle}"
                           Margin="0,8,0,0" />

                <ListBox ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem}"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,4" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,8"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    CornerRadius="6"
                                    HorizontalAlignment="Stretch">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DocumentCode}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryBrush}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DocumentDate, StringFormat=dd/MM/yyyy}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="{DynamicResource FontSize.Caption}" />
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                               Text="{Binding CustomerName}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0" />
                                    <TextBlock Grid.Row="2"
                                               Text="{Binding CheckoutType}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="{DynamicResource FontSize.Caption}"
                                               Margin="0,2,0,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="1"
                                               Text="{Binding NetAmountVnd, StringFormat=N0}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right"
                                               Margin="0,2,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Detail -->
        <Border Grid.Column="2" Style="{StaticResource SalesCardStyle}" Padding="14">
            <DockPanel LastChildFill="True">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right"
                            Content="In hóa đơn"
                            Style="{StaticResource SalesOutlineButtonStyle}"
                            Command="{Binding PrintCommand}"
                            MinHeight="36"
                            Margin="0" />
                    <StackPanel>
                        <TextBlock Text="{Binding DetailTitle}"
                                   Style="{StaticResource SalesSectionHeaderStyle}"
                                   Margin="0,0,0,2" />
                        <TextBlock Text="{Binding DetailTypeText}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="{DynamicResource FontSize.Caption}" />
                    </StackPanel>
                </DockPanel>

                <Border DockPanel.Dock="Bottom"
                        Margin="0,10,0,0"
                        Padding="12">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource SalesAmountHeroStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDetail}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Doanh thu" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSize.Caption}" />
                            <TextBlock Text="{Binding SaleGrossText}" FontWeight="SemiBold" />
                            <TextBlock Text="Chiết khấu" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSize.Caption}" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding DiscountText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Vàng cũ" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSize.Caption}" />
                            <TextBlock Text="{Binding OldGoldTotalText}" FontWeight="SemiBold" />
                            <TextBlock Text="Bù trừ" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSize.Caption}" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding OffsetText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Chênh lệch thu/chi" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSize.Caption}"
                                       ToolTip="Tiền khách còn phải trả hoặc cửa hàng cần hoàn lại sau khi bù trừ vàng cũ." />
                            <TextBlock Text="{Binding NetAmountText}" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" FontSize="{DynamicResource FontSize.Subtitle}"
                                       ToolTip="Số dương: khách còn phải trả. Số âm: cửa hàng cần hoàn lại." />
                            <TextBlock Text="Công nợ" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSize.Caption}" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding ReceivableText}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <TextBlock Text="Chọn một hóa đơn bên trái để xem chi tiết (chỉ đọc)."
                                   Margin="0,8,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SalesHintStyle}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasDetail}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasDetail}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Ngày" Style="{StaticResource SalesFieldLabelStyle}" />
                                    <TextBlock Text="{Binding DetailDateText}" FontWeight="SemiBold" />
                                    <TextBlock Text="Khách hàng" Style="{StaticResource SalesFieldLabelStyle}" Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding DetailCustomerText}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="NV bán" Style="{StaticResource SalesFieldLabelStyle}" />
                                    <TextBlock Text="{Binding DetailStaffText}" FontWeight="SemiBold" />
                                    <TextBlock Text="Ghi chú" Style="{StaticResource SalesFieldLabelStyle}" Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding DetailNotes}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Thành phẩm" Style="{StaticResource SalesSectionHeaderStyle}" Margin="0,0,0,6" />
                            <DataGrid grid:DataGridColumnLayout.EnableHeaderMenu="True" grid:DataGridColumnLayout.SettingsKey="sales.InvoiceHistoryTabView.SelectedDetail-SaleLines" ItemsSource="{Binding SelectedDetail.SaleLines}"
                                      Style="{StaticResource SalesDataGridStyle}"
                                      IsReadOnly="True"
                                      MaxHeight="180"
                                      Margin="0,0,0,12"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn grid:DataGridColumnLayout.Key="ProductCode" Header="Mã" Binding="{Binding ProductCode}" Width="120" />
                                    <DataGridTextColumn grid:DataGridColumnLayout.Key="ProductName" Header="Tên" Binding="{Binding ProductName}" Width="*" />
                                    <DataGridTextColumn grid:DataGridColumnLayout.Key="GoldWeightChi" Header="TL vàng" Binding="{Binding GoldWeightChi, StringFormat=0.####}" Width="80" />
                                    <DataGridTextColumn grid:DataGridColumnLayout.Key="Amounts.TotalAmountVnd" Header="Thành tiền" Binding="{Binding Amounts.TotalAmountVnd, StringFormat=N0}" Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Text="Vàng cũ" Style="{StaticResource SalesSectionHeaderStyle}" Margin="0,0,0,6" />
                            <DataGrid grid:DataGridColumnLayout.EnableHeaderMenu="True" grid:DataGridColumnLayout.SettingsKey="sales.InvoiceHistoryTabView.SelectedDetail-OldGoldLines" ItemsSource="{Binding SelectedDetail.OldGoldLines}"
                                      Style="{StaticResource SalesDataGridStyle}"
                                      IsReadOnly="True"
                                      MaxHeight="160"
                                      Margin="0,0,0,12"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn grid:DataGridColumnLayout.Key="MaterialName" Header="Loại" Binding="{Binding MaterialName}" Width="*" />
                                    <DataGridTextColumn grid:DataGridColumnLayout.Key="Amounts.GoldWeightChi" Header="TL vàng" Binding="{Binding Amounts.GoldWeightChi, StringFormat=0.####}" Width="80" />
                                    <DataGridTextColumn grid:DataGridColumnLayout.Key="Amounts.ConvertedWeightChi" Header="TL QĐ" Binding="{Binding Amounts.ConvertedWeightChi, StringFormat=0.####}" Width="80" />
                                    <DataGridTextColumn grid:DataGridColumnLayout.Key="Amounts.AmountVnd" Header="Thành tiền" Binding="{Binding Amounts.AmountVnd, StringFormat=N0}" Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Text="Thanh toán" Style="{StaticResource SalesSectionHeaderStyle}" Margin="0,0,0,6" />
                            <DataGrid grid:DataGridColumnLayout.EnableHeaderMenu="True" grid:DataGridColumnLayout.SettingsKey="sales.InvoiceHistoryTabView.SelectedDetail-Allocations" ItemsSource="{Binding SelectedDetail.Allocations}"
                                      Style="{StaticResource SalesDataGridStyle}"
                                      IsReadOnly="True"
                                      MaxHeight="140"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn grid:DataGridColumnLayout.Key="PaymentMethod" Header="P.thức" Binding="{Binding PaymentMethod}" Width="100" />
                                    <DataGridTextColumn grid:DataGridColumnLayout.Key="AmountVnd" Header="Số tiền" Binding="{Binding AmountVnd, StringFormat=N0}" Width="120" />
                                    <DataGridTextColumn grid:DataGridColumnLayout.Key="ReferenceNumber" Header="Tham chiếu" Binding="{Binding ReferenceNumber}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
