<UserControl x:Class="Kazuko.Modules.Sales.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kazuko.Modules.Sales"
             MinWidth="980" MinHeight="560"
             PreviewKeyDown="UserControl_PreviewKeyDown">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/SalesResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="F9" Command="{Binding PayCommand}" />
    </UserControl.InputBindings>

    <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Kazuko.Modules.Sales;component/Assets/icons/BAN_HANG.png"
                       Width="48" Height="48" Stretch="Uniform" Margin="0,0,12,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="BÁN HÀNG"
                               Foreground="{DynamicResource PrimaryBrush}"
                               FontSize="{DynamicResource FontSize.Heading}"
                               FontWeight="Bold" />
                    <TextBlock Text="Phiếu mua–bán, thu vàng cũ và thanh toán tại quầy"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="{DynamicResource FontSize.Body}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Mới"
                        Style="{StaticResource SalesOutlineButtonStyle}"
                        Command="{Binding NewCommand}" />
                <Button Content="Trước"
                        Style="{StaticResource SalesGhostButtonStyle}"
                        Command="{Binding PreviousCommand}" />
                <Button Content="Sau"
                        Style="{StaticResource SalesGhostButtonStyle}"
                        Command="{Binding NextCommand}" />
                <Button Content="In A4"
                        Style="{StaticResource SalesOutlineButtonStyle}"
                        Command="{Binding PrintCommand}"
                        Margin="0" />
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1"
                    SelectedIndex="{Binding MainTabIndex}"
                    Style="{StaticResource SalesTabControlStyle}"
                    ItemContainerStyle="{StaticResource SalesTabItemStyle}">
            <TabItem Header="Mua - Bán">
                <local:BuySellTabView DataContext="{Binding BuySell}" Margin="0,12,0,0" />
            </TabItem>
            <TabItem Header="Mua vàng cũ">
                <local:BuyOldGoldTabView DataContext="{Binding BuyOldGold}" Margin="0,12,0,0" />
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Style="{StaticResource SalesCardStyle}" Padding="12,10" Margin="0,12,0,0">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="F9 — thanh toán nhanh · Enter — nhập dòng hàng"
                               Style="{StaticResource SalesHintStyle}" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding SuccessMessage}" Foreground="{DynamicResource PrimaryBrush}"
                               TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
                <Button DockPanel.Dock="Right"
                        Content="Thanh toán (F9)"
                        Style="{StaticResource SalesPrimaryButtonStyle}"
                        Command="{Binding PayCommand}"
                        MinWidth="168"
                        Margin="0" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
