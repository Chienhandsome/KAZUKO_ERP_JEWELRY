<UserControl x:Class="Kazuko.Modules.Sales.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kazuko.Modules.Sales"
             MinWidth="980" MinHeight="560"
             PreviewKeyDown="UserControl_PreviewKeyDown">
    <UserControl.InputBindings>
        <KeyBinding Key="F9" Command="{Binding PayCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0"
                    SelectedIndex="{Binding MainTabIndex}"
                    Margin="0,0,0,8">
            <TabItem Header="Mua - Bán">
                <local:BuySellTabView DataContext="{Binding BuySell}" />
            </TabItem>
            <TabItem Header="Mua vàng cũ">
                <local:BuyOldGoldTabView DataContext="{Binding BuyOldGold}" />
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,4,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="Mới" Style="{DynamicResource NavButtonStyle}"
                        Command="{Binding NewCommand}" MinHeight="40" MinWidth="88" Margin="0,0,8,0" />
                <Button Content="Trước" Style="{DynamicResource NavButtonStyle}"
                        Command="{Binding PreviousCommand}" MinHeight="40" MinWidth="88" Margin="0,0,8,0" />
                <Button Content="Sau" Style="{DynamicResource NavButtonStyle}"
                        Command="{Binding NextCommand}" MinHeight="40" MinWidth="88" />
            </StackPanel>
            <Button DockPanel.Dock="Right"
                    Content="Thanh toán (F9)"
                    Style="{DynamicResource PrimaryButtonStyle}"
                    Command="{Binding PayCommand}"
                    MinHeight="44" MinWidth="160" Padding="16,0" />
        </DockPanel>
    </Grid>
</UserControl>
