<UserControl x:Class="Kazuko.Modules.Sales.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:access="clr-namespace:Kazuko.Shared.UI.Behaviors;assembly=Kazuko.Shared.UI"
             xmlns:local="clr-namespace:Kazuko.Modules.Sales"
             MinWidth="980" MinHeight="560"
             PreviewKeyDown="UserControl_PreviewKeyDown">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/SalesResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="F9" Command="{Binding PayCommand}" />
    </UserControl.InputBindings>

    <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="12,10,12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Kazuko.Modules.Sales;component/Assets/icons/BAN_HANG.png"
                       Width="44" Height="44" Stretch="Uniform" Margin="0,0,12,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="BÁN HÀNG"
                               Foreground="{DynamicResource PrimaryBrush}"
                               FontSize="{DynamicResource FontSize.Heading}"
                               FontWeight="Bold" />
                    <TextBlock Text="Phiếu mua–bán, thu vàng cũ và thanh toán tại quầy"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="{DynamicResource FontSize.Body}"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button access:PermissionAccess.Rule="SALES_RETAIL:Add" Content="Phiếu mới"
                        Style="{StaticResource SalesOutlineButtonStyle}"
                        Command="{Binding NewCommand}"
                        ToolTip="Xóa nội dung đang nhập và bắt đầu phiếu mới." Margin="0" />
            </StackPanel>
            <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                       Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap" Margin="0,4,0,0" />
            <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                       Text="{Binding SuccessMessage}"
                       Foreground="{DynamicResource PrimaryBrush}"
                       TextWrapping="Wrap" Margin="0,4,0,0"
                       VerticalAlignment="Bottom" />
        </Grid>

        <TabControl Grid.Row="1"
                    SelectedIndex="{Binding MainTabIndex}"
                    Style="{StaticResource SalesTabControlStyle}"
                    ItemContainerStyle="{StaticResource SalesTabItemStyle}">
            <TabItem access:PermissionAccess.Rule="SALES_RETAIL" Header="Mua - Bán">
                <local:BuySellTabView DataContext="{Binding BuySell}" Margin="0,6,0,0" />
            </TabItem>
            <TabItem access:PermissionAccess.Rule="OLD_GOLD_PURCHASE" Header="Mua vàng cũ">
                <local:BuyOldGoldTabView DataContext="{Binding BuyOldGold}" Margin="0,6,0,0" />
            </TabItem>
            <TabItem access:PermissionAccess.Rule="SALES_WHOLESALE" Header="Bán sỉ" Visibility="{Binding WholesaleTabVisibility}">
                <local:WholesaleTabView DataContext="{Binding Wholesale}" Margin="0,6,0,0" />
            </TabItem>
            <TabItem access:PermissionAccess.Rule="CRAFT_ORDER" Header="Đơn đặt">
                <local:CraftOrderTabView DataContext="{Binding CraftOrders}" Margin="0,6,0,0" />
            </TabItem>
            <TabItem access:PermissionAccess.Rule="SALES_HISTORY" Header="Hóa đơn">
                <local:InvoiceHistoryTabView DataContext="{Binding History}" Margin="0,6,0,0" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
