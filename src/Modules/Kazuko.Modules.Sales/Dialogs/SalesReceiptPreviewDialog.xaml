<Window x:Class="Kazuko.Modules.Sales.Dialogs.SalesReceiptPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Xem phiếu bán hàng"
        Width="980" Height="720" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closed="Window_Closed">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding DocumentCode, StringFormat=Chứng từ: {0}}" />
                <TextBlock Text="Khổ in:"
                           Margin="20,0,8,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <ComboBox Width="130"
                          ItemsSource="{Binding OrientationOptions}"
                          SelectedItem="{Binding SelectedOrientation}"
                          DisplayMemberPath="Label"
                          IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding StatusMessage}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Đóng" Command="{Binding CloseCommand}" IsCancel="True"
                        Style="{DynamicResource NavButtonStyle}" MinHeight="40" MinWidth="96" Margin="0,0,8,0" />
                <Button Content="Mở PDF" Command="{Binding OpenPdfCommand}"
                        Style="{DynamicResource NavButtonStyle}" MinHeight="40" MinWidth="110" Margin="0,0,8,0" />
                <Button Content="In" Command="{Binding PrintCommand}" IsDefault="True"
                        Style="{DynamicResource PrimaryButtonStyle}" MinHeight="40" MinWidth="120" />
            </StackPanel>
        </DockPanel>

        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Background="{DynamicResource SurfaceBrush}">
            <Grid>
                <wpf:WebView2 x:Name="PdfViewer" DefaultBackgroundColor="White" />
                <TextBlock x:Name="FallbackText"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="{DynamicResource FontSize.Body}"
                           TextWrapping="Wrap" Margin="24"
                           Visibility="Collapsed"
                           Text="Đang tải bản xem trước PDF…" />
            </Grid>
        </Border>
    </DockPanel>
</Window>
