<Window x:Class="Kazuko.Modules.Sales.Dialogs.SalesPriceOverrideDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:Kazuko.Shared.UI.Behaviors;assembly=Kazuko.Shared.UI"
        Title="Điều chỉnh giá bán"
        Width="480" Height="440" MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Khôi phục" Command="{Binding ResetCommand}"
                    Style="{DynamicResource NavButtonStyle}" MinHeight="40" MinWidth="96" Margin="0,0,8,0" />
            <Button Content="Hủy" Command="{Binding CancelCommand}" IsCancel="True"
                    Style="{DynamicResource NavButtonStyle}" MinHeight="40" MinWidth="96" Margin="0,0,8,0" />
            <Button Content="Áp dụng" Command="{Binding ConfirmCommand}" IsDefault="True"
                    Style="{DynamicResource PrimaryButtonStyle}" MinHeight="40" MinWidth="120" />
        </StackPanel>

        <StackPanel>
            <TextBlock FontSize="{DynamicResource FontSize.Heading}" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}">
                <Run Text="{Binding ProductCode, Mode=OneWay}" />
                <Run Text=" — " />
                <Run Text="{Binding ProductName, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Text="Giá nguồn từ bảng giá (chỉ đọc tham chiếu)"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,8" />
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Giá vàng nguồn" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding SourceGoldPricePerChi, StringFormat=N0}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Công nguồn" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding SourceLaborAmountVnd, StringFormat=N0}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Đá nguồn" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding SourceStoneAmountVnd, StringFormat=N0}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Giá áp dụng" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
            <TextBlock Text="Giá vàng / chỉ" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBox Text="{Binding GoldPrice, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ViMoneyConverter}}"
                     behaviors:NumericThousandSeparatorBehavior.EnableLiveThousandSeparator="True"
                     MinHeight="36" Margin="0,0,0,8" />
            <TextBlock Text="Tiền công" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBox Text="{Binding LaborAmount, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ViMoneyConverter}}"
                     behaviors:NumericThousandSeparatorBehavior.EnableLiveThousandSeparator="True"
                     MinHeight="36" Margin="0,0,0,8" />
            <TextBlock Text="Tiền đá" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBox Text="{Binding StoneAmount, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ViMoneyConverter}}"
                     behaviors:NumericThousandSeparatorBehavior.EnableLiveThousandSeparator="True"
                     MinHeight="36" Margin="0,0,0,8" />
            <TextBlock Text="Lý do điều chỉnh (tuỳ chọn)" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBox Text="{Binding OverrideReason, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" Margin="0,0,0,8" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </DockPanel>
</Window>
