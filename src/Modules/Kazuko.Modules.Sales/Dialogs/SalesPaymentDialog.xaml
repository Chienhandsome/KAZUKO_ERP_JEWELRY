<Window x:Class="Kazuko.Modules.Sales.Dialogs.SalesPaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thanh toán bán hàng"
        Width="720" Height="520" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Hủy" Command="{Binding CancelCommand}" IsCancel="True"
                    Style="{DynamicResource NavButtonStyle}" MinHeight="40" MinWidth="96" Margin="0,0,8,0" />
            <Button Content="Xác nhận" Command="{Binding ConfirmCommand}" IsDefault="True"
                    Style="{DynamicResource PrimaryButtonStyle}" MinHeight="40" MinWidth="120" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding ModeLabel}" FontSize="{DynamicResource FontSize.Heading}"
                           FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding DocumentHint}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextPrimaryBrush}">
                    <Run Text="Số tiền: " />
                    <Run Text="{Binding AbsoluteAmountText, Mode=OneWay}" FontWeight="Bold" />
                </TextBlock>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap" Margin="0,8,0,0" />

                <DockPanel Margin="0,12,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Thêm dòng" Command="{Binding AddAllocationCommand}"
                                Style="{DynamicResource NavButtonStyle}" MinHeight="36" Margin="0,0,8,0" />
                        <Button Content="Xóa dòng" Command="{Binding RemoveAllocationCommand}"
                                Style="{DynamicResource NavButtonStyle}" MinHeight="36" />
                    </StackPanel>
                    <TextBlock Text="Phân bổ thanh toán" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </DockPanel>

                <DataGrid ItemsSource="{Binding Allocations}" SelectedItem="{Binding SelectedAllocation}"
                          AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                          FontSize="{DynamicResource FontSize.Body}" MinHeight="160">
                    <DataGrid.Columns>
                        <DataGridComboBoxColumn Header="Phương thức" Width="140"
                                                SelectedItemBinding="{Binding PaymentMethod, UpdateSourceTrigger=PropertyChanged}"
                                                ItemsSource="{Binding DataContext.AvailableMethods, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <DataGridTextColumn Header="Số tiền" Width="120"
                                            Binding="{Binding AmountVnd, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" />
                        <DataGridComboBoxColumn Header="Quỹ TM" Width="160"
                                                SelectedItemBinding="{Binding CashFund, UpdateSourceTrigger=PropertyChanged}"
                                                ItemsSource="{Binding DataContext.CashFunds, RelativeSource={RelativeSource AncestorType=Window}}"
                                                DisplayMemberPath="Name" />
                        <DataGridComboBoxColumn Header="Tài khoản NH" Width="180"
                                                SelectedItemBinding="{Binding BankAccount, UpdateSourceTrigger=PropertyChanged}"
                                                ItemsSource="{Binding DataContext.BankAccounts, RelativeSource={RelativeSource AncestorType=Window}}"
                                                DisplayMemberPath="DisplayName" />
                        <DataGridTextColumn Header="Tham chiếu" Width="*"
                                            Binding="{Binding ReferenceNumber, UpdateSourceTrigger=PropertyChanged}" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="Công nợ phải thu" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               IsEnabled="{Binding CanUseReceivable}" />
                    <TextBox Text="{Binding ReceivableAmountVnd, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="36" Margin="0,4,0,0" Width="200" HorizontalAlignment="Left"
                             VerticalContentAlignment="Center"
                             IsEnabled="{Binding CanUseReceivable}" />
                </StackPanel>

                <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource TextSecondaryBrush}">
                    <Run Text="Đã phân bổ: " />
                    <Run Text="{Binding AllocatedTotalText, Mode=OneWay}" FontWeight="Bold" />
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
