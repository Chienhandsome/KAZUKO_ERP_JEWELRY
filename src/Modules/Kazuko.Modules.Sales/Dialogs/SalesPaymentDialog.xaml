<Window x:Class="Kazuko.Modules.Sales.Dialogs.SalesPaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thanh toán bán hàng"
        Width="864" Height="768" MinWidth="768" MinHeight="672"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Kazuko.Modules.Sales;component/Themes/SalesResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <Style x:Key="PaymentMethodLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource SalesFieldLabelStyle}">
                <Setter Property="FontSize" Value="{DynamicResource FontSize.Subtitle}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="MinWidth" Value="48" />
                <Setter Property="Margin" Value="0,0,12,0" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Hủy" Command="{Binding CancelCommand}" IsCancel="True"
                    Style="{StaticResource SalesGhostButtonStyle}" MinHeight="40" MinWidth="96" Margin="0,0,8,0" />
            <Button Content="Xác nhận (Enter)" Command="{Binding ConfirmCommand}" IsDefault="True"
                    Style="{StaticResource SalesPrimaryButtonStyle}" MinHeight="40" MinWidth="148" />
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header tóm tắt -->
            <Border Grid.Row="0" Style="{StaticResource SalesCardStyle}" Padding="16" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding ModeLabel}"
                                   FontSize="{DynamicResource FontSize.Heading}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryBrush}" />
                        <TextBlock Text="{Binding DocumentHint}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{DynamicResource DangerBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource SalesAmountHeroStyle}"
                            MinWidth="200" Margin="16,0,0,0" Padding="16,10">
                        <StackPanel>
                            <TextBlock Text="Số tiền"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="{DynamicResource FontSize.Caption}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding AbsoluteAmountText}"
                                       Foreground="{DynamicResource DangerBrush}"
                                       FontSize="{DynamicResource FontSize.Display}"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Phân bổ cố định TM / CK / Thẻ -->
            <Border Grid.Row="1" Style="{StaticResource SalesCardStyle}" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Phân bổ thanh toán"
                                   Style="{StaticResource SalesSectionHeaderStyle}"
                                   Margin="0,0,0,14" />

                        <!-- TM -->
                        <Border Style="{StaticResource SalesCardStyle}" Padding="12" Margin="0,0,0,10"
                                Background="{DynamicResource SurfaceAltBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                                           Text="TM" Style="{StaticResource PaymentMethodLabelStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Số tiền"
                                           Style="{StaticResource SalesFieldLabelStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Quỹ tiền mặt"
                                           Style="{StaticResource SalesFieldLabelStyle}" />
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         Text="{Binding CashAllocation.AmountVnd, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                         Style="{StaticResource SalesNumericTextBoxStyle}" Margin="0" />
                                <ComboBox Grid.Row="1" Grid.Column="3"
                                          ItemsSource="{Binding CashFunds}"
                                          SelectedItem="{Binding CashAllocation.CashFund, UpdateSourceTrigger=PropertyChanged}"
                                          DisplayMemberPath="DisplayName"
                                          Style="{StaticResource SalesComboStyle}" />
                            </Grid>
                        </Border>

                        <!-- CK -->
                        <Border Style="{StaticResource SalesCardStyle}" Padding="12" Margin="0,0,0,10"
                                Background="{DynamicResource SurfaceAltBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                                           Text="CK" Style="{StaticResource PaymentMethodLabelStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Số tiền"
                                           Style="{StaticResource SalesFieldLabelStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Tài khoản NH"
                                           Style="{StaticResource SalesFieldLabelStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="5" Text="Mã GD (tuỳ chọn)"
                                           Style="{StaticResource SalesFieldLabelStyle}" />
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         Text="{Binding BankTransferAllocation.AmountVnd, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                         Style="{StaticResource SalesNumericTextBoxStyle}" Margin="0" />
                                <ComboBox Grid.Row="1" Grid.Column="3"
                                          ItemsSource="{Binding BankAccounts}"
                                          SelectedItem="{Binding BankTransferAllocation.BankAccount, UpdateSourceTrigger=PropertyChanged}"
                                          DisplayMemberPath="DisplayName"
                                          Style="{StaticResource SalesComboStyle}" />
                                <TextBox Grid.Row="1" Grid.Column="5"
                                         Text="{Binding BankTransferAllocation.ReferenceNumber, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SalesRoundedTextBoxStyle}" Margin="0"
                                         ToolTip="Số chuyển khoản / mã UTR — để đối soát. Có thể để trống." />
                            </Grid>
                        </Border>

                        <!-- Thẻ (ẩn khi chi) -->
                        <Border Style="{StaticResource SalesCardStyle}" Padding="12" Margin="0,0,0,10"
                                Background="{DynamicResource SurfaceAltBrush}"
                                Visibility="{Binding ShowCardAllocation, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                                           Text="Thẻ" Style="{StaticResource PaymentMethodLabelStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Số tiền"
                                           Style="{StaticResource SalesFieldLabelStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Tài khoản NH"
                                           Style="{StaticResource SalesFieldLabelStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="5" Text="Mã GD (tuỳ chọn)"
                                           Style="{StaticResource SalesFieldLabelStyle}" />
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         Text="{Binding CardAllocation.AmountVnd, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                         Style="{StaticResource SalesNumericTextBoxStyle}" Margin="0" />
                                <ComboBox Grid.Row="1" Grid.Column="3"
                                          ItemsSource="{Binding BankAccounts}"
                                          SelectedItem="{Binding CardAllocation.BankAccount, UpdateSourceTrigger=PropertyChanged}"
                                          DisplayMemberPath="DisplayName"
                                          Style="{StaticResource SalesComboStyle}" />
                                <TextBox Grid.Row="1" Grid.Column="5"
                                         Text="{Binding CardAllocation.ReferenceNumber, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SalesRoundedTextBoxStyle}" Margin="0"
                                         ToolTip="Mã chuẩn chi thẻ — để đối soát. Có thể để trống." />
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding ReferenceHint}"
                                   Style="{StaticResource SalesHintStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Footer totals -->
            <Border Grid.Row="2" Style="{StaticResource SalesCardStyle}" Padding="14,12" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Công nợ phải thu"
                                   Style="{StaticResource SalesFieldLabelStyle}"
                                   IsEnabled="{Binding CanUseReceivable}" />
                        <TextBox Text="{Binding ReceivableAmountVnd, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SalesNumericTextBoxStyle}"
                                 Width="180" HorizontalAlignment="Left" Margin="0"
                                 IsEnabled="{Binding CanUseReceivable}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Foreground="{DynamicResource TextPrimaryBrush}">
                            <Run Text="Đã phân bổ: " />
                            <Run Text="{Binding AllocatedTotalText, Mode=OneWay}" FontWeight="Bold" />
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0">
                            <Run Text="Còn thiếu: " />
                            <Run Text="{Binding RemainingText, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
