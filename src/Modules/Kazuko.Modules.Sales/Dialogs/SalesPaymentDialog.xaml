<Window x:Class="Kazuko.Modules.Sales.Dialogs.SalesPaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thanh toán bán hàng"
        Width="960" Height="680" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Kazuko.Modules.Sales;component/Themes/SalesResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="PaymentAllocationCellStyle" TargetType="DataGridCell">
                <Setter Property="Padding" Value="4,2" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="ClipToBounds" Value="False" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    SnapsToDevicePixels="True"
                                    ClipToBounds="False">
                                <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="Stretch"
                                                  ClipToBounds="False" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="PaymentAllocationRowStyle" TargetType="DataGridRow">
                <Setter Property="MinHeight" Value="56" />
                <Setter Property="Height" Value="56" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>
            <Style x:Key="PaymentAllocationGridStyle" TargetType="DataGrid" BasedOn="{StaticResource SalesDataGridStyle}">
                <Setter Property="IsReadOnly" Value="False" />
                <Setter Property="RowHeight" Value="56" />
                <Setter Property="ColumnHeaderHeight" Value="40" />
                <Setter Property="MinHeight" Value="240" />
                <Setter Property="RowStyle" Value="{StaticResource PaymentAllocationRowStyle}" />
                <Setter Property="CellStyle" Value="{StaticResource PaymentAllocationCellStyle}" />
            </Style>
            <!-- Controls compact hơn trong ô: tránh MinHeight+Margin vượt RowHeight -->
            <Style x:Key="PaymentGridComboStyle" TargetType="ComboBox" BasedOn="{StaticResource SalesComboStyle}">
                <Setter Property="Height" Value="40" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Margin" Value="2,0" />
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="PaymentGridTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource SalesRoundedTextBoxStyle}">
                <Setter Property="Height" Value="40" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Margin" Value="2,0" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="PaymentGridNumericTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource SalesNumericTextBoxStyle}">
                <Setter Property="Height" Value="40" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Margin" Value="2,0" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Hủy" Command="{Binding CancelCommand}" IsCancel="True"
                    Style="{StaticResource SalesGhostButtonStyle}" MinHeight="40" MinWidth="96" Margin="0,0,8,0" />
            <Button Content="Xác nhận (Enter)" Command="{Binding ConfirmCommand}" IsDefault="True"
                    Style="{StaticResource SalesPrimaryButtonStyle}" MinHeight="40" MinWidth="148" />
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header tóm tắt -->
            <Border Grid.Row="0" Style="{StaticResource SalesCardStyle}" Padding="16" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding ModeLabel}"
                                   FontSize="{DynamicResource FontSize.Heading}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryBrush}" />
                        <TextBlock Text="{Binding DocumentHint}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{DynamicResource DangerBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource SalesAmountHeroStyle}"
                            MinWidth="200" Margin="16,0,0,0" Padding="16,10">
                        <StackPanel>
                            <TextBlock Text="Số tiền"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="{DynamicResource FontSize.Caption}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding AbsoluteAmountText}"
                                       Foreground="{DynamicResource DangerBrush}"
                                       FontSize="{DynamicResource FontSize.Display}"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Phân bổ -->
            <Border Grid.Row="1" Style="{StaticResource SalesCardStyle}" Padding="12">
                <DockPanel LastChildFill="True">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Thêm dòng" Command="{Binding AddAllocationCommand}"
                                    Style="{StaticResource SalesOutlineButtonStyle}" MinHeight="36" Margin="0,0,8,0" />
                            <Button Content="Xóa dòng" Command="{Binding RemoveAllocationCommand}"
                                    Style="{StaticResource SalesGhostButtonStyle}" MinHeight="36" Margin="0" />
                        </StackPanel>
                        <TextBlock Text="Phân bổ thanh toán"
                                   Style="{StaticResource SalesSectionHeaderStyle}"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock DockPanel.Dock="Bottom"
                               Text="{Binding ReferenceHint}"
                               Style="{StaticResource SalesHintStyle}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0" />

                    <DataGrid x:Name="AllocationGrid"
                              ItemsSource="{Binding Allocations}"
                              SelectedItem="{Binding SelectedAllocation}"
                              Style="{StaticResource PaymentAllocationGridStyle}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Phương thức" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.MethodOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  SelectedValue="{Binding PaymentMethod, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="Code"
                                                  DisplayMemberPath="Label"
                                                  Style="{StaticResource PaymentGridComboStyle}"
                                                  SelectionChanged="PaymentMethodCombo_SelectionChanged" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Số tiền" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding AmountVnd, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                                 Style="{StaticResource PaymentGridNumericTextBoxStyle}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Quỹ tiền mặt" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.CashFunds, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  SelectedItem="{Binding CashFund, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="DisplayName"
                                                  Style="{StaticResource PaymentGridComboStyle}"
                                                  IsEnabled="{Binding RequiresCashFund}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Tài khoản NH" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.BankAccounts, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  SelectedItem="{Binding BankAccount, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="DisplayName"
                                                  Style="{StaticResource PaymentGridComboStyle}"
                                                  IsEnabled="{Binding RequiresBankAccount}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Mã GD (tuỳ chọn)" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding ReferenceNumber, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource PaymentGridTextBoxStyle}"
                                                 ToolTip="Số chuyển khoản / mã UTR / mã chuẩn chi thẻ — để đối soát. Có thể để trống." />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Footer totals -->
            <Border Grid.Row="2" Style="{StaticResource SalesCardStyle}" Padding="14,12" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Công nợ phải thu"
                                   Style="{StaticResource SalesFieldLabelStyle}"
                                   IsEnabled="{Binding CanUseReceivable}" />
                        <TextBox Text="{Binding ReceivableAmountVnd, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SalesNumericTextBoxStyle}"
                                 Width="180" HorizontalAlignment="Left" Margin="0"
                                 IsEnabled="{Binding CanUseReceivable}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Foreground="{DynamicResource TextPrimaryBrush}">
                            <Run Text="Đã phân bổ: " />
                            <Run Text="{Binding AllocatedTotalText, Mode=OneWay}" FontWeight="Bold" />
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0">
                            <Run Text="Còn thiếu: " />
                            <Run Text="{Binding RemainingText, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
