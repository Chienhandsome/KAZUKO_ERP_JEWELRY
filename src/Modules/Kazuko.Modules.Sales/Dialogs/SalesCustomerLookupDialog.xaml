<Window x:Class="Kazuko.Modules.Sales.Dialogs.SalesCustomerLookupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tìm khách hàng"
        Width="640" Height="480" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Hủy" Command="{Binding CancelCommand}" IsCancel="True"
                    Style="{DynamicResource NavButtonStyle}" MinHeight="40" MinWidth="96" Margin="0,0,8,0" />
            <Button Content="Chọn" Command="{Binding ConfirmCommand}" IsDefault="True"
                    Style="{DynamicResource PrimaryButtonStyle}" MinHeight="40" MinWidth="120" />
        </StackPanel>

        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Tìm theo mã, tên hoặc số điện thoại"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="{DynamicResource FontSize.Body}"
                           Margin="0,0,0,8" />
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="36"
                         Padding="10,6"
                         FontSize="{DynamicResource FontSize.Body}" />
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,8" />
            </StackPanel>
            <DataGrid ItemsSource="{Binding Results}"
                      SelectedItem="{Binding SelectedCustomer}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      MouseDoubleClick="DataGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Loại khách" Binding="{Binding KindText}" Width="160" />
                    <DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="100" />
                    <DataGridTextColumn Header="Tên khách" Binding="{Binding Name}" Width="*" MinWidth="160" />
                    <DataGridTextColumn Header="Điện thoại" Binding="{Binding Phone}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </DockPanel>
</Window>
