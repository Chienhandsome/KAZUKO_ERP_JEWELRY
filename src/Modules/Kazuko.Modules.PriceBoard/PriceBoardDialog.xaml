<Window x:Class="Kazuko.Modules.PriceBoard.PriceBoardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CẬP NHẬT GIÁ BÁN - KAZUKO ERP JEWELRY"
        Width="980" Height="650"
        MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="PbPrimaryButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="MinWidth" Value="130" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PbOutlineButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PbAccentOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource PbOutlineButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="MinWidth" Value="140" />
        </Style>
        <Style x:Key="PbDangerOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource PbOutlineButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="MinWidth" Value="125" />
        </Style>
        <Style x:Key="PbCurrencyBuyRateTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Subtitle}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PbCurrencySellRateTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Subtitle}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PbCurrencyRateEditingTextStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Subtitle}" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
        <Style x:Key="PbTabItemStyle" TargetType="TabItem">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent" BorderThickness="0,0,0,3"
                                BorderBrush="Transparent" Padding="{TemplateBinding Padding}" Margin="0,0,8,0"
                                CornerRadius="6,6,0,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PbDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowBackground" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="RowHeight" Value="38" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="8,2" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PbDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Height" Value="42" />
        </Style>
        <Style x:Key="PbCurrencyColumnHeaderStyle" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource PbDataGridColumnHeaderStyle}">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Subtitle}" />
        </Style>
        <Style x:Key="PbGoldPriceColumnHeaderStyle" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource PbCurrencyColumnHeaderStyle}">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Heading}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Height" Value="54" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" Padding="16,10" Margin="0,0,0,10"
                CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets"
                               FontSize="{DynamicResource FontSize.Heading}"
                               Foreground="{DynamicResource PrimaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Text="Thông tin giá bán hiện tại"
                               FontSize="{DynamicResource FontSize.Subtitle}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="HOTLINE HỖ TRỢ: 0917.66.4444"
                           FontWeight="Bold"
                           FontSize="{DynamicResource FontSize.Caption}"
                           Foreground="{DynamicResource PrimaryBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Body tabs -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0"
                    ItemContainerStyle="{StaticResource PbTabItemStyle}">
            <TabItem Header="Giá vàng">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                                   FontSize="{DynamicResource FontSize.Body}">
                            <Run Text="Loại tiền: " Foreground="{DynamicResource TextPrimaryBrush}" />
                            <Run Text="{Binding UnitLabel, Mode=OneWay}" FontWeight="Bold"
                                 Foreground="{DynamicResource PrimaryBrush}" />
                        </TextBlock>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="+  Thêm loại vàng" Style="{StaticResource PbAccentOutlineButtonStyle}"
                                    Command="{Binding AddGoldCommand}" Margin="0,0,8,0" />
                            <Button Content="✕  Xóa loại vàng" Style="{StaticResource PbDangerOutlineButtonStyle}"
                                    Command="{Binding DeleteGoldCommand}" />
                        </StackPanel>
                    </DockPanel>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding GoldPrices}"
                              SelectedItem="{Binding SelectedGold}"
                              Style="{StaticResource PbDataGridStyle}"
                              FontSize="{DynamicResource FontSize.Heading}"
                              FontWeight="Bold"
                              RowHeight="54"
                              ColumnHeaderStyle="{StaticResource PbGoldPriceColumnHeaderStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT" Binding="{Binding Index, Mode=OneWay}" Width="50" IsReadOnly="True" />
                            <DataGridTextColumn Header="Loại vàng" Binding="{Binding Name, Mode=OneWay}" Width="*" MinWidth="140" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Mua vào" Binding="{Binding BuyPrice, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N0}" Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="FontSize" Value="{DynamicResource FontSize.Heading}" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        <Setter Property="HorizontalContentAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Bán ra" Binding="{Binding SellPrice, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N0}" Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="FontSize" Value="{DynamicResource FontSize.Heading}" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="HorizontalContentAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Cập nhật lúc" Binding="{Binding UpdatedAtDisplay, Mode=OneWay}" Width="140" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Tỉ giá ngoại tệ">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                                   Text="Danh sách tỉ giá các đồng ngoại tệ quy đổi sang VND"
                                   FontSize="{DynamicResource FontSize.Body}"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="+  Thêm ngoại tệ" Style="{StaticResource PbAccentOutlineButtonStyle}"
                                    Command="{Binding AddCurrencyCommand}" Margin="0,0,8,0" />
                            <Button Content="✕  Xóa ngoại tệ" Style="{StaticResource PbDangerOutlineButtonStyle}"
                                    Command="{Binding DeleteCurrencyCommand}" />
                        </StackPanel>
                    </DockPanel>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Currencies}"
                              SelectedItem="{Binding SelectedCurrency}"
                              Style="{StaticResource PbDataGridStyle}"
                              FontSize="{DynamicResource FontSize.Subtitle}"
                              ColumnHeaderStyle="{StaticResource PbCurrencyColumnHeaderStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT" Binding="{Binding Index, Mode=OneWay}" Width="50" IsReadOnly="True" />
                            <DataGridTextColumn Header="Ngoại tệ" Binding="{Binding CurrencyCode, Mode=OneWay}" Width="80" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Tên ngoại tệ" Binding="{Binding CurrencyName, Mode=OneWay}" Width="*" MinWidth="120" IsReadOnly="True" />
                            <DataGridTextColumn Header="Mua vào (VND)" Binding="{Binding BuyRate, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <StaticResource ResourceKey="PbCurrencyBuyRateTextStyle" />
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource PbCurrencyRateEditingTextStyle}">
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Bán ra (VND)" Binding="{Binding SellRate, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <StaticResource ResourceKey="PbCurrencySellRateTextStyle" />
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource PbCurrencyRateEditingTextStyle}">
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Cập nhật cuối cùng lúc" Binding="{Binding UpdatedAtDisplay, Mode=OneWay}" Width="160" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Lịch sử biến động giá" Style="{StaticResource PbOutlineButtonStyle}"
                        Command="{Binding HistoryCommand}" MinWidth="190" />
                <TextBlock Text="{Binding StatusMessage, Mode=OneWay}"
                           Foreground="{DynamicResource DangerBrush}"
                           FontSize="{DynamicResource FontSize.Caption}"
                           VerticalAlignment="Center" Margin="12,0,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cập nhật" Style="{StaticResource PbPrimaryButtonStyle}"
                        Command="{Binding SaveCommand}" Margin="0,0,8,0" IsDefault="True" />
                <Button Content="Thoát" Style="{StaticResource PbOutlineButtonStyle}"
                        Command="{Binding CloseCommand}" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
