<Window x:Class="Kazuko.Modules.PriceBoard.PriceBoardTvSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 Title="Bảng giá vàng trên TV" Width="1280" Height="820" MinWidth="980" MinHeight="640" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource AppBackgroundBrush}">
 <Window.Resources>
  <Style x:Key="TvLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/><Setter Property="Margin" Value="0,8,0,4"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="TvButton" TargetType="Button"><Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,0,8,8"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <DataTemplate x:Key="TvColorItem"><StackPanel Orientation="Horizontal"><Border Width="18" Height="18" Background="{Binding Value}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,6,0"/><TextBlock Text="{Binding Name}"/></StackPanel></DataTemplate>
 </Window.Resources>
 <Grid Margin="16">
  <Grid.ColumnDefinitions><ColumnDefinition Width="400"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
   <StackPanel x:Name="Editors">
    <TextBlock Text="Bảng giá TV" FontSize="{DynamicResource FontSize.Heading}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold"/>
    <CheckBox Content="Bật hiển thị bảng giá TV" IsChecked="{Binding Enabled}" Margin="0,12,0,4"/>
    <TextBlock Text="Tên tiệm" Style="{StaticResource TvLabel}"/><TextBox Text="{Binding ShopName,UpdateSourceTrigger=PropertyChanged}" MaxLength="150"/>
    <TextBlock Text="Nội dung chữ chạy" Style="{StaticResource TvLabel}"/><TextBox Text="{Binding Ticker,UpdateSourceTrigger=PropertyChanged}" MaxLength="1000"/>
    <TextBlock Text="Màu tên tiệm / chữ chạy" Style="{StaticResource TvLabel}"/>
    <DockPanel><TextBox DockPanel.Dock="Right" Width="100" Text="{Binding TitleColor,UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0"/><ComboBox ItemsSource="{Binding Colors}" SelectedValuePath="Value" SelectedValue="{Binding TitleColor}" ItemTemplate="{StaticResource TvColorItem}"/></DockPanel>
    <TextBlock Text="Màu nền" Style="{StaticResource TvLabel}"/>
    <DockPanel><TextBox DockPanel.Dock="Right" Width="100" Text="{Binding BackgroundColor,UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0"/><ComboBox ItemsSource="{Binding Colors}" SelectedValuePath="Value" SelectedValue="{Binding BackgroundColor}" ItemTemplate="{StaticResource TvColorItem}"/></DockPanel>
    <TextBlock Text="Màu viền" Style="{StaticResource TvLabel}"/>
    <DockPanel><TextBox DockPanel.Dock="Right" Width="100" Text="{Binding BorderColor,UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0"/><ComboBox ItemsSource="{Binding Colors}" SelectedValuePath="Value" SelectedValue="{Binding BorderColor}" ItemTemplate="{StaticResource TvColorItem}"/></DockPanel>
    <TextBlock Text="Màu giá mua / bán" Style="{StaticResource TvLabel}"/>
    <DockPanel><TextBox DockPanel.Dock="Right" Width="100" Text="{Binding PriceColor,UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0"/><ComboBox ItemsSource="{Binding Colors}" SelectedValuePath="Value" SelectedValue="{Binding PriceColor}" ItemTemplate="{StaticResource TvColorItem}"/></DockPanel>
    <TextBlock Text="Căn lề giá" Style="{StaticResource TvLabel}"/><ComboBox ItemsSource="{Binding Alignments}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Alignment}"/>
    <TextBlock Text="Đơn vị giá" Style="{StaticResource TvLabel}"/><ComboBox ItemsSource="{Binding Units}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding UnitCode}"/>
    <TextBlock Text="Số loại vàng mỗi trang (3–15)" Style="{StaticResource TvLabel}"/><TextBox Text="{Binding RowCountText,UpdateSourceTrigger=PropertyChanged}"/>
    <TextBlock Text="Nếu nhiều hơn số dòng này, bảng tự chuyển trang sau 12 giây." Style="{StaticResource TvLabel}"/>
    <TextBlock Text="Loại vàng hiển thị (giá đã lưu ở bảng bán lẻ)" Style="{StaticResource TvLabel}"/>
    <ListBox Height="200" ItemsSource="{Binding GoldRows}" SelectedItem="{Binding SelectedGold}" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Visible}" Content="{Binding Name}" Padding="4"/></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <WrapPanel Margin="0,8,0,0"><Button Content="Đưa lên" Command="{Binding MoveUpCommand}" Style="{StaticResource TvButton}"/><Button Content="Đưa xuống" Command="{Binding MoveDownCommand}" Style="{StaticResource TvButton}"/></WrapPanel>
    <TextBlock Text="TV cắm HDMI / màn hình thứ hai" Style="{StaticResource TvLabel}"/><ComboBox ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor}"/>
    <CheckBox Content="Cho TV xem bằng trình duyệt qua LAN" IsChecked="{Binding AllowLan}" Margin="0,16,0,4"/>
    <TextBlock Text="Cổng kết nối LAN" Style="{StaticResource TvLabel}"/><TextBox Text="{Binding PortText,UpdateSourceTrigger=PropertyChanged}"/>
   </StackPanel>
  </ScrollViewer>
  <Grid Grid.Column="2">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="Xem thử — bấm Áp dụng để cập nhật" Style="{StaticResource TvLabel}"/>
   <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><wv:WebView2 x:Name="PreviewBrowser"/></Border>
   <StackPanel Grid.Row="2" Margin="0,12,0,0">
    <TextBlock Text="Địa chỉ để mở trên TV (cùng mạng LAN)" Style="{StaticResource TvLabel}"/>
    <TextBox Text="{Binding LanAddresses,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="100" VerticalScrollBarVisibility="Auto"/>
    <Button Content="Chép địa chỉ đầu tiên" Command="{Binding CopyUrlCommand}" Style="{StaticResource TvButton}" HorizontalAlignment="Left" Margin="0,8,0,4"/>
    <TextBlock Text="Giữ ERP mở. TV mở địa chỉ trên bằng trình duyệt, bấm ⛶ để toàn màn hình. Nếu không kết nối được, kiểm tra cùng mạng và cho phép ERP trên mạng riêng trong Windows Firewall."
     Style="{StaticResource TvLabel}"/>
   </StackPanel>
  </Grid>
  <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
   <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" FontSize="{DynamicResource FontSize.Body}" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding Message}" Foreground="{DynamicResource SuccessBrush}" FontSize="{DynamicResource FontSize.Body}" TextWrapping="Wrap"/>
   <TextBlock x:Name="BusyText" Text="Đang xử lý…" Style="{StaticResource TvLabel}"/>
   <WrapPanel><Button Content="Áp dụng &amp; xem thử" Command="{Binding ApplyCommand}" Style="{StaticResource TvButton}"/>
    <Button Content="Mở toàn màn hình HDMI" Command="{Binding OpenHdmiCommand}" Style="{StaticResource TvButton}"/>
   </WrapPanel>
  </StackPanel>
 </Grid>
</Window>
