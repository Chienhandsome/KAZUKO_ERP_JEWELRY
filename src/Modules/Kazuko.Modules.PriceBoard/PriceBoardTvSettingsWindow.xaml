<Window x:Class="Kazuko.Modules.PriceBoard.PriceBoardTvSettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 Title="Bảng giá vàng trên TV" Width="1280" Height="820" MinWidth="980" MinHeight="640"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}">
 <Window.Resources>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="10"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Grid Background="{TemplateBinding Background}" Margin="2">
     <Track x:Name="PART_Track" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}" Orientation="Vertical">
      <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb Background="{DynamicResource BorderBrush}"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="4"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource TextSecondaryBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
     </Track>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="TvLabel" TargetType="TextBlock">
   <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}"/><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
   <Setter Property="Margin" Value="0,10,0,5"/><Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="TvSection" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,0,12"/>
  </Style>
  <Style x:Key="TvSectionTitle" TargetType="TextBlock">
   <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="Margin" Value="0,0,0,4"/>
  </Style>
  <Style x:Key="TvButton" TargetType="Button">
   <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
   <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="14,8"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.88"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="TvPrimaryButton" TargetType="Button" BasedOn="{StaticResource TvButton}">
   <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/><Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/><Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="10,8"/><Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
   <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border x:Name="FieldBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
     <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FieldBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/></Trigger>
     <Trigger Property="IsReadOnly" Value="True"><Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Padding" Value="10,8"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
    <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="MinHeight" Value="40"/><Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
   <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="MaxDropDownHeight" Value="300"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid>
     <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
       <Border x:Name="ComboBorder" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
        <Grid><Path Data="M 0 0 L 5 5 L 10 0" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/></Grid>
       </Border>
       <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <ContentPresenter Margin="10,8,32,8" VerticalAlignment="Center" IsHitTestVisible="False" ClipToBounds="True" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
     <Border x:Name="ComboFocus" BorderThickness="1" CornerRadius="8" BorderBrush="Transparent" IsHitTestVisible="False"/>
     <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,4,0,0" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
      </Border>
     </Popup>
    </Grid>
    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboFocus" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border x:Name="CheckBorder" Width="20" Height="20" VerticalAlignment="Center" CornerRadius="5" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
      <Path x:Name="CheckMark" Data="M 0 4 L 3 7 L 9 0" Stroke="{DynamicResource OnPrimaryBrush}" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
     </Border>
     <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource PrimaryBrush}"/><Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <DataTemplate x:Key="TvColorItem"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="18" Height="18" CornerRadius="4" Background="{Binding Value}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,8,0"/><TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></Grid></DataTemplate>
 </Window.Resources>
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16">
   <TextBlock Text="Bảng giá TV" FontSize="{DynamicResource FontSize.Heading}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold"/>
   <TextBlock Text="Thiết lập giao diện và chọn cách hiển thị bảng giá trên TV." Style="{StaticResource TvLabel}" Margin="0,4,0,0"/>
  </StackPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
    <StackPanel x:Name="Editors">
   <Border Style="{StaticResource TvSection}"><StackPanel><TextBlock Text="Nội dung hiển thị" Style="{StaticResource TvSectionTitle}"/>
    <CheckBox Content="Bật hiển thị bảng giá TV" IsChecked="{Binding Enabled}" Margin="0,10,0,4"/>
    <TextBlock Text="Tên tiệm" Style="{StaticResource TvLabel}"/>
    <TextBox Text="{Binding ShopName,UpdateSourceTrigger=PropertyChanged}" MaxLength="150"/>
    <TextBlock Text="Nội dung chữ chạy" Style="{StaticResource TvLabel}"/>
    <TextBox Text="{Binding Ticker,UpdateSourceTrigger=PropertyChanged}" MaxLength="1000"/>
   </StackPanel></Border>
   <Border Style="{StaticResource TvSection}"><StackPanel><TextBlock Text="Màu sắc" Style="{StaticResource TvSectionTitle}"/>
    <TextBlock Text="Tên tiệm / chữ chạy" Style="{StaticResource TvLabel}"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="104"/></Grid.ColumnDefinitions>
     <ComboBox ItemsSource="{Binding Colors}" SelectedValuePath="Value" SelectedValue="{Binding TitleColor}" ItemTemplate="{StaticResource TvColorItem}"/>
     <TextBox Grid.Column="2" Text="{Binding TitleColor,UpdateSourceTrigger=PropertyChanged}" MaxLength="7" ToolTip="Mã màu #RRGGBB"/>
    </Grid>
    <TextBlock Text="Nền bảng giá" Style="{StaticResource TvLabel}"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="104"/></Grid.ColumnDefinitions>
     <ComboBox ItemsSource="{Binding Colors}" SelectedValuePath="Value" SelectedValue="{Binding BackgroundColor}" ItemTemplate="{StaticResource TvColorItem}"/>
     <TextBox Grid.Column="2" Text="{Binding BackgroundColor,UpdateSourceTrigger=PropertyChanged}" MaxLength="7" ToolTip="Mã màu #RRGGBB"/>
    </Grid>
    <TextBlock Text="Đường viền" Style="{StaticResource TvLabel}"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="104"/></Grid.ColumnDefinitions>
     <ComboBox ItemsSource="{Binding Colors}" SelectedValuePath="Value" SelectedValue="{Binding BorderColor}" ItemTemplate="{StaticResource TvColorItem}"/>
     <TextBox Grid.Column="2" Text="{Binding BorderColor,UpdateSourceTrigger=PropertyChanged}" MaxLength="7" ToolTip="Mã màu #RRGGBB"/>
    </Grid>
    <TextBlock Text="Giá mua / bán" Style="{StaticResource TvLabel}"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="104"/></Grid.ColumnDefinitions>
     <ComboBox ItemsSource="{Binding Colors}" SelectedValuePath="Value" SelectedValue="{Binding PriceColor}" ItemTemplate="{StaticResource TvColorItem}"/>
     <TextBox Grid.Column="2" Text="{Binding PriceColor,UpdateSourceTrigger=PropertyChanged}" MaxLength="7" ToolTip="Mã màu #RRGGBB"/>
    </Grid>
   </StackPanel></Border>
   <Border Style="{StaticResource TvSection}"><StackPanel><TextBlock Text="Bố cục bảng giá" Style="{StaticResource TvSectionTitle}"/>
    <TextBlock Text="Căn lề giá" Style="{StaticResource TvLabel}"/>
    <ComboBox ItemsSource="{Binding Alignments}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Alignment}"/>
    <TextBlock Text="Đơn vị giá" Style="{StaticResource TvLabel}"/>
    <ComboBox ItemsSource="{Binding Units}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding UnitCode}"/>
    <TextBlock Text="Số loại vàng mỗi trang (3–15)" Style="{StaticResource TvLabel}"/>
    <TextBox Text="{Binding RowCountText,UpdateSourceTrigger=PropertyChanged}" />
    <TextBlock Text="Tự chuyển trang sau 12 giây nếu vượt số dòng đã chọn." Style="{StaticResource TvLabel}"/>
   </StackPanel></Border>
   <Border Style="{StaticResource TvSection}"><StackPanel><TextBlock Text="Loại vàng hiển thị" Style="{StaticResource TvSectionTitle}"/>
    <TextBlock Text="Chọn loại vàng và sắp xếp thứ tự hiển thị." Style="{StaticResource TvLabel}"/>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
     <ListBox Height="200" ItemsSource="{Binding GoldRows}" SelectedItem="{Binding SelectedGold}" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="RowBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Visible}"><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/></CheckBox></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </Border>
    <WrapPanel Margin="0,10,0,0"><Button Content="↑ Đưa lên" Command="{Binding MoveUpCommand}" Style="{StaticResource TvButton}" Margin="0,0,8,0"/><Button Content="↓ Đưa xuống" Command="{Binding MoveDownCommand}" Style="{StaticResource TvButton}"/></WrapPanel>
   </StackPanel></Border>
   <Border Style="{StaticResource TvSection}"><StackPanel><TextBlock Text="Kết nối TV" Style="{StaticResource TvSectionTitle}"/>
    <TextBlock Text="Miracast — kết nối không dây" Style="{StaticResource TvLabel}"/>
    <TextBlock Text="Bật Screen Mirroring / Miracast trên TV. Mở danh sách bên dưới, chọn đúng thiết bị và chờ Windows kết nối."
               Style="{StaticResource TvLabel}" Margin="0,2,0,10"/>
    <Button Command="{Binding ConnectMiracastCommand}" Style="{StaticResource TvButton}" AutomationProperties.Name="Chọn thiết bị Miracast">
     <TextBlock Text="1. Chọn thiết bị Miracast…" TextWrapping="Wrap" TextAlignment="Center"/>
    </Button>
    <Button Command="{Binding ProjectionModeCommand}" Style="{StaticResource TvButton}" Margin="0,8,0,0">
     <TextBlock Text="2. Chọn chế độ Mở rộng (Extend)…" TextWrapping="Wrap" TextAlignment="Center"/>
    </Button>
    <TextBlock Text="Mở rộng cho phép TV chỉ hiện bảng giá trong khi máy tính tiếp tục làm việc. Nếu máy/TV không hỗ trợ Miracast, dùng HDMI hoặc LAN."
               Style="{StaticResource TvLabel}"/>
    <TextBlock Text="3. Chọn màn hình để chiếu (HDMI / Miracast)" Style="{StaticResource TvLabel}"/>
    <ComboBox ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor}" ToolTip="{Binding SelectedMonitor}"
              AutomationProperties.Name="Màn hình TV sẽ chiếu"/>
    <Button Content="Tải lại màn hình" Command="{Binding RefreshMonitorsCommand}" Style="{StaticResource TvButton}" Margin="0,8,0,0"/>
    <TextBlock Text="{Binding DisplayConnectionMessage}" Style="{StaticResource TvLabel}"/>
    <CheckBox IsChecked="{Binding AllowLan}" Margin="0,16,0,4"><TextBlock Text="Cho TV xem bằng trình duyệt qua LAN" TextWrapping="Wrap"/></CheckBox>
    <TextBlock Text="Cổng kết nối LAN" Style="{StaticResource TvLabel}"/>
    <TextBox Text="{Binding PortText,UpdateSourceTrigger=PropertyChanged}" />
   </StackPanel></Border>
    </StackPanel>
   </ScrollViewer>
   <ScrollViewer x:Name="PreviewScroller" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <Grid MinHeight="{Binding ViewportHeight, ElementName=PreviewScroller}">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Style="{StaticResource TvSection}" Margin="0,0,0,12" MinHeight="280">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,12"><TextBlock Text="Xem thử bảng giá" Style="{StaticResource TvSectionTitle}"/>
       <TextBlock Text="Bấm Áp dụng để cập nhật nội dung và màu sắc." Style="{StaticResource TvLabel}" Margin="0,2,0,0"/></StackPanel>
      <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True"><wv:WebView2 x:Name="PreviewBrowser"/></Border>
     </Grid>
    </Border>
    <Border Grid.Row="1" Style="{StaticResource TvSection}" Margin="0">
     <StackPanel>
      <TextBlock Text="Mở bảng giá trên TV qua LAN" Style="{StaticResource TvSectionTitle}"/>
      <TextBlock Text="Dùng trình duyệt TV trong cùng mạng với máy ERP." Style="{StaticResource TvLabel}" Margin="0,2,0,10"/>
      <TextBox Text="{Binding LanAddresses,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="84" VerticalScrollBarVisibility="Auto"/>
      <Button Content="Chép địa chỉ TV" Command="{Binding CopyUrlCommand}" Style="{StaticResource TvButton}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
      <TextBlock Text="Có thể đóng ERP sau khi bật phát; giữ máy tính mở và không ngủ. Trên TV, bấm ⛶ để xem toàn màn hình. Dừng phát tại biểu tượng Bảng giá TV ở khay hệ thống."
                 Style="{StaticResource TvLabel}" Margin="0,10,0,0"/>
     </StackPanel>
    </Border>
   </Grid>
   </ScrollViewer>
  </Grid>
  <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,16,0,0">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
     <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" FontSize="{DynamicResource FontSize.Caption}" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding Message}" Foreground="{DynamicResource SuccessBrush}" FontSize="{DynamicResource FontSize.Caption}" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding BackgroundStatus}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSize.Caption}" TextWrapping="Wrap"/>
     <TextBlock x:Name="BusyText" Text="Đang xử lý…" Style="{StaticResource TvLabel}" Margin="0"/>
    </StackPanel>
    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
     <Button Command="{Binding OpenDisplayCommand}" Style="{StaticResource TvButton}" Margin="0,0,10,0">
      <TextBlock Text="Chiếu lên màn hình đã chọn" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="230"/>
     </Button>
     <Button Content="Áp dụng &amp; xem thử" Command="{Binding ApplyCommand}" Style="{StaticResource TvPrimaryButton}"/>
    </WrapPanel>
   </Grid>
  </Border>
 </Grid>
</Window>
