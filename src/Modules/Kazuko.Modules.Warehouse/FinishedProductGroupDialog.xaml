<Window x:Class="Kazuko.Modules.Warehouse.FinishedProductGroupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:access="clr-namespace:Kazuko.Shared.UI.Behaviors;assembly=Kazuko.Shared.UI"
        Title="Thêm nhóm hàng"
        Width="440" SizeToContent="Height" MinWidth="400" MinHeight="340"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/WarehouseResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Hủy" Style="{StaticResource WhOutlineButtonStyle}"
              Command="{Binding CancelCommand}" MinHeight="40" IsCancel="True" Margin="0,0,8,0" />
      <Button access:PermissionAccess.Rule="INV_FINISHED_RECEIPT:Add|INV_FINISHED_RECEIPT:Edit" Content="Lưu" Style="{StaticResource WhPrimaryButtonStyle}"
              Command="{Binding SaveCommand}" MinHeight="40" IsDefault="True" Margin="0" />
    </StackPanel>

    <StackPanel>
      <TextBlock Text="Thêm nhóm hàng thành phẩm"
                 FontSize="{DynamicResource FontSize.Subtitle}"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 Margin="0,0,0,4" />
      <TextBlock Text="Mã dùng để phân loại và làm tiền tố mã thành phẩm."
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 FontSize="{DynamicResource FontSize.Caption}"
                 TextWrapping="Wrap"
                 Margin="0,0,0,12" />
      <TextBlock Text="{Binding ErrorMessage}"
                 Foreground="{DynamicResource DangerBrush}"
                 TextWrapping="Wrap"
                 Margin="0,0,0,8" />

      <TextBlock Text="Mã *" Style="{StaticResource WhFieldLabelStyle}" />
      <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
               Style="{StaticResource WhRoundedTextBoxStyle}"
               MinHeight="36" Margin="0,0,0,10"
               CharacterCasing="Upper" />

      <TextBlock Text="Tên *" Style="{StaticResource WhFieldLabelStyle}" />
      <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
               Style="{StaticResource WhRoundedTextBoxStyle}"
               MinHeight="36" />
    </StackPanel>
  </DockPanel>
</Window>
