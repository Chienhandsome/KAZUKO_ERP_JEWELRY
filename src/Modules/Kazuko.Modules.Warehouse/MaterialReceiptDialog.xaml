<Window x:Class="Kazuko.Modules.Warehouse.MaterialReceiptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nhập kho NVL"
        Width="920" Height="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Hủy" Style="{DynamicResource NavButtonStyle}" Command="{Binding CancelCommand}"
              MinHeight="40" Margin="0,0,8,0" IsCancel="True" />
      <Button Content="Ghi sổ" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding SaveCommand}"
              MinHeight="40" IsDefault="True" />
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="Nhập nguyên vật liệu"
                   FontSize="{DynamicResource FontSize.Heading}"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />

        <TextBlock Text="Nguồn nhập" Margin="0,12,0,4" Foreground="{DynamicResource TextSecondaryBrush}" />
        <StackPanel Orientation="Horizontal">
          <RadioButton Content="Nhà cung cấp" IsChecked="{Binding IsSupplierSource}" Margin="0,0,16,0"
                       Checked="SupplierSource_OnChecked" />
          <RadioButton Content="Thu mua vàng cũ" x:Name="OldGoldRadio"
                       Checked="OldGoldSource_OnChecked" />
        </StackPanel>

        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ComboBox x:Name="PartnerCombo"
                    Height="40"
                    DisplayMemberPath="Name" />
          <Button Grid.Column="2" Content="Tạo mới" Style="{DynamicResource PrimaryButtonStyle}"
                  MinHeight="40" x:Name="CreatePartnerButton" />
        </Grid>

        <TextBlock Text="Kho nhận" Margin="0,12,0,4" Foreground="{DynamicResource TextSecondaryBrush}" />
        <ComboBox ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation}"
                  DisplayMemberPath="DisplayName" Height="40" />

        <Border Style="{DynamicResource CardBorderStyle}" Padding="12" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="Dòng NVL" FontSize="{DynamicResource FontSize.Subtitle}"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ComboBox ItemsSource="{Binding Materials}" SelectedItem="{Binding SelectedMaterial}"
                        DisplayMemberPath="DisplayName" Height="40" />
              <TextBox Grid.Column="2" Text="{Binding LineQuantity, UpdateSourceTrigger=PropertyChanged}" Height="40" />
              <StackPanel Grid.Column="4">
                <TextBlock Text="{Binding UnitPriceLabel}" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBox Text="{Binding LineUnitPrice, UpdateSourceTrigger=PropertyChanged}" Height="40" />
              </StackPanel>
              <TextBox Grid.Column="6" Text="{Binding LineExchangeRate, UpdateSourceTrigger=PropertyChanged}" Height="40"
                       ToolTip="Tỷ giá" />
              <Button Grid.Column="8" Content="Thêm dòng" Command="{Binding AddLineCommand}"
                      Style="{DynamicResource PrimaryButtonStyle}" MinHeight="40" />
            </Grid>
            <DataGrid ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}"
                      AutoGenerateColumns="False" IsReadOnly="True" Height="160" Margin="0,8,0,0">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Mã" Binding="{Binding Code, Mode=OneWay}" Width="90" />
                <DataGridTextColumn Header="Tên" Binding="{Binding Name, Mode=OneWay}" Width="*" />
                <DataGridTextColumn Header="ĐVT" Binding="{Binding UnitCode, Mode=OneWay}" Width="60" />
                <DataGridTextColumn Header="SL" Binding="{Binding Quantity, Mode=OneWay}" Width="80" />
                <DataGridTextColumn Header="Đơn giá" Binding="{Binding UnitPrice, Mode=OneWay, StringFormat=N0}" Width="100" />
                <DataGridTextColumn Header="Thành tiền" Binding="{Binding AmountVnd, Mode=OneWay, StringFormat=N0}" Width="110" />
              </DataGrid.Columns>
            </DataGrid>
            <Button Content="Xóa dòng" Command="{Binding RemoveLineCommand}" HorizontalAlignment="Left"
                    Style="{DynamicResource NavButtonStyle}" MinHeight="40" Margin="0,8,0,0" />
          </StackPanel>
        </Border>

        <Border Style="{DynamicResource CardBorderStyle}" Padding="12" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="Thanh toán" FontSize="{DynamicResource FontSize.Subtitle}"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Content="Thêm phương thức" Command="{Binding AddPaymentCommand}"
                      Style="{DynamicResource PrimaryButtonStyle}" MinHeight="40" Margin="0,0,8,0" />
              <Button Content="Xóa dòng TT" Command="{Binding RemovePaymentCommand}"
                      Style="{DynamicResource NavButtonStyle}" MinHeight="40" />
            </StackPanel>
            <DataGrid ItemsSource="{Binding Payments}" SelectedItem="{Binding SelectedPayment}"
                      AutoGenerateColumns="False" Height="120" Margin="0,8,0,0"
                      CanUserAddRows="False">
              <DataGrid.Columns>
                <DataGridTextColumn Header="PT" Binding="{Binding PaymentMethod}" Width="120" />
                <DataGridTextColumn Header="Số tiền" Binding="{Binding AmountVnd}" Width="120" />
                <DataGridTextColumn Header="Quỹ" Binding="{Binding CashFundId}" Width="80" />
                <DataGridTextColumn Header="NH" Binding="{Binding BankAccountId}" Width="80" />
                <DataGridTextColumn Header="Tham chiếu" Binding="{Binding ReferenceNumber}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding TotalAmount, StringFormat=Tổng: {0:N0} đ}"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="Đã thanh toán" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBox Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged}" Height="40" />
              </StackPanel>
              <TextBlock Grid.Column="2" Text="{Binding DebtAmount, StringFormat=Còn nợ: {0:N0} đ}"
                         VerticalAlignment="Bottom"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock Text="Ghi chú" Margin="0,12,0,4" Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="60"
                 AcceptsReturn="True" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
