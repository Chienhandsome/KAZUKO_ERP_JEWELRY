<Window x:Class="Kazuko.Modules.Warehouse.MaterialReceiptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:access="clr-namespace:Kazuko.Shared.UI.Behaviors;assembly=Kazuko.Shared.UI"
        xmlns:behaviors="clr-namespace:Kazuko.Shared.UI.Behaviors;assembly=Kazuko.Shared.UI"
        xmlns:conv="clr-namespace:Kazuko.Modules.Warehouse.Converters"
        Title="Nhập kho NVL"
        Width="980" Height="780"
        MinWidth="860" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/WarehouseResources.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <conv:NullOrEmptyToVisibilityConverter x:Key="NotNullToVis" Invert="True" />

      <Style x:Key="CompactFieldStyle" TargetType="TextBox" BasedOn="{StaticResource WhRoundedTextBoxStyle}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Hủy"
              Style="{StaticResource WhOutlineButtonStyle}"
              Command="{Binding CancelCommand}"
              MinWidth="100"
              Margin="0,0,8,0"
              IsCancel="True" />
      <Button access:PermissionAccess.Rule="INV_MATERIAL_RECEIPT:Add" Content="Ghi sổ nhập kho"
              Style="{StaticResource WhPrimaryButtonStyle}"
              Command="{Binding SaveCommand}"
              MinWidth="160" />
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <!-- Header -->
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Nhập kho nguyên vật liệu"
                       FontSize="{DynamicResource FontSize.Heading}"
                       FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryBrush}" />
            <TextBlock Text="Nhập mua nguyên vật liệu từ nhà cung cấp. Khi ghi sổ sẽ tăng tồn NVL, tạo phiếu chi (nếu đã trả) và công nợ (nếu còn nợ)."
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="{DynamicResource FontSize.Body}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVis}}" />
          </StackPanel>

          <Border Grid.Column="2"
                  Style="{DynamicResource CardBorderStyle}"
                  Padding="16,10"
                  MinWidth="200"
                  VerticalAlignment="Top">
            <StackPanel>
              <TextBlock Text="Tổng phiếu"
                         Style="{StaticResource WhFieldLabelStyle}"
                         HorizontalAlignment="Center"
                         Margin="0" />
              <TextBlock Text="{Binding GrandTotal, StringFormat={}{0:N0} đ}"
                         FontSize="{DynamicResource FontSize.Display}"
                         FontWeight="Bold"
                         Foreground="{DynamicResource PrimaryBrush}"
                         HorizontalAlignment="Center"
                         Margin="0,2,0,0" />
            </StackPanel>
          </Border>
        </Grid>

        <!-- Nhà cung cấp & kho -->
        <Border Style="{DynamicResource CardBorderStyle}" Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Thông tin phiếu" Style="{StaticResource WhSectionHeaderStyle}" Margin="0,0,0,12" />

            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <StackPanel>
                <TextBlock Text="Ngày" Style="{StaticResource WhFieldLabelStyle}" />
                <DatePicker SelectedDate="{Binding DocumentDate}"
                            MinHeight="40"
                            FontSize="{DynamicResource FontSize.Body}"
                            VerticalContentAlignment="Center" />
              </StackPanel>

              <StackPanel Grid.Column="2">
                <TextBlock Text="Số phiếu" Style="{StaticResource WhFieldLabelStyle}" />
                <TextBox Text="{Binding DocumentNumberPreview, Mode=OneWay}"
                         Style="{StaticResource WhReadonlyFieldStyle}"
                         ToolTip="Số phiếu được sinh tự động khi ghi sổ" />
              </StackPanel>

              <StackPanel Grid.Column="4">
                <TextBlock Text="Nhân viên nhập" Style="{StaticResource WhFieldLabelStyle}" />
                <TextBox Text="{Binding ReceivedByName, Mode=OneWay}"
                         Style="{StaticResource WhReadonlyFieldStyle}"
                         IsReadOnly="True"
                         ToolTip="Người dùng đang đăng nhập" />
              </StackPanel>
            </Grid>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <StackPanel>
                <TextBlock Text="Nhà cung cấp *" Style="{StaticResource WhFieldLabelStyle}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ComboBox Style="{StaticResource WhComboStyle}"
                            ItemsSource="{Binding Suppliers}"
                            SelectedItem="{Binding SelectedSupplier}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock>
                          <Run Text="{Binding Name, Mode=OneWay}" />
                          <Run Text=" (" />
                          <Run Text="{Binding Code, Mode=OneWay}" />
                          <Run Text=")" />
                        </TextBlock>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button access:PermissionAccess.Rule="CAT_SUPPLIERS:Add" Grid.Column="2"
                          Content="Tạo mới"
                          Style="{StaticResource WhOutlineButtonStyle}"
                          MinWidth="96"
                          Margin="0"
                          Command="{Binding CreateSupplierCommand}"
                          ToolTip="Tạo nhanh đối tác khi chưa có trong danh mục" />
                </Grid>
              </StackPanel>

              <StackPanel Grid.Column="2">
                <TextBlock Text="Kho NVL nhận *" Style="{StaticResource WhFieldLabelStyle}" />
                <ComboBox ItemsSource="{Binding Locations}"
                          SelectedItem="{Binding SelectedLocation}"
                          DisplayMemberPath="DisplayName"
                          Style="{StaticResource WhComboStyle}" />
              </StackPanel>
            </Grid>

            <StackPanel Margin="0,12,0,0">
              <TextBlock Text="Diễn giải" Style="{StaticResource WhFieldLabelStyle}" />
              <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                       Style="{StaticResource WhRoundedTextBoxStyle}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Dòng NVL + Đối trừ -->
        <Border Style="{DynamicResource CardBorderStyle}" Padding="12" Margin="0,0,0,12">
          <TabControl Background="Transparent"
                      BorderThickness="0"
                      ItemContainerStyle="{StaticResource WhTabItemStyle}">
            <TabItem Header="Danh sách nguyên liệu nhập kho">
              <StackPanel Margin="0,12,0,0">
                <DockPanel Margin="0,0,0,12" LastChildFill="False">
                  <Button DockPanel.Dock="Right"
                          Content="Xóa dòng"
                          Command="{Binding RemoveLineCommand}"
                          Style="{StaticResource WhOutlineButtonStyle}"
                          MinWidth="100"
                          Margin="0"
                          HorizontalAlignment="Right" />
                  <TextBlock Text="Dòng nguyên vật liệu"
                             Style="{StaticResource WhSectionHeaderStyle}"
                             VerticalAlignment="Center" />
                </DockPanel>

                <Border Background="{DynamicResource SurfaceAltBrush}"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,12">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="2.2*" />
                      <ColumnDefinition Width="8" />
                      <ColumnDefinition Width="0.9*" />
                      <ColumnDefinition Width="8" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="8" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Column="0" Text="Nguyên vật liệu *" Style="{StaticResource WhFieldLabelStyle}" />
                    <TextBlock Grid.Column="2" Text="Số lượng (chỉ) *" Style="{StaticResource WhFieldLabelStyle}" />
                    <TextBlock Grid.Column="4" Text="{Binding UnitPriceLabel}" Style="{StaticResource WhFieldLabelStyle}" />

                    <Grid Grid.Row="1" Grid.Column="0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <ComboBox ItemsSource="{Binding Materials}"
                                SelectedItem="{Binding SelectedMaterial}"
                                DisplayMemberPath="DisplayName"
                                Style="{StaticResource WhComboStyle}" />
                  <Button access:PermissionAccess.Rule="CAT_GOLD_PRICE:Add" Grid.Column="2"
                              Content="Thêm loại vàng"
                              Command="{Binding CreateGoldTypeCommand}"
                              Style="{StaticResource WhOutlineButtonStyle}"
                              MinWidth="120"
                              Margin="0"
                              ToolTip="Thêm loại vàng mới vào danh mục và giá mua/bán lẻ" />
                    </Grid>
                    <TextBox Grid.Row="1" Grid.Column="2"
                             Text="{Binding LineQuantity, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ViQuantityConverter}}"
                             Style="{StaticResource WhRoundedTextBoxStyle}"
                             behaviors:NumericThousandSeparatorBehavior.EnableLiveThousandSeparator="True"
                             behaviors:NumericThousandSeparatorBehavior.AllowDecimal="True" />
                    <TextBox Grid.Row="1" Grid.Column="4"
                             Text="{Binding LineUnitPrice, UpdateSourceTrigger=LostFocus, Converter={StaticResource ViMoneyConverter}}"
                             Style="{StaticResource WhRoundedTextBoxStyle}"
                             behaviors:NumericThousandSeparatorBehavior.EnableLiveThousandSeparator="True" />
                    <Button Grid.Row="1" Grid.Column="6"
                            Content="Thêm dòng"
                            Command="{Binding AddLineCommand}"
                            Style="{StaticResource WhPrimaryButtonStyle}"
                            MinWidth="110"
                            VerticalAlignment="Stretch" />
                  </Grid>
                </Border>

                <DataGrid ItemsSource="{Binding Lines}"
                          SelectedItem="{Binding SelectedLine}"
                          Style="{StaticResource WhDataGridStyle}"
                          ColumnHeaderStyle="{StaticResource WhDataGridColumnHeaderStyle}"
                          Height="180">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã" Binding="{Binding Code, Mode=OneWay}" Width="90" />
                    <DataGridTextColumn Header="Tên NVL" Binding="{Binding Name, Mode=OneWay}" Width="*" />
                    <DataGridTextColumn Header="ĐVT" Binding="{Binding UnitCode, Mode=OneWay}" Width="70" />
                    <DataGridTextColumn Header="Số lượng (chỉ)" Binding="{Binding Quantity, Mode=OneWay, StringFormat={}{0:0.####}}" Width="100" />
                    <DataGridTextColumn Header="Đơn giá" Binding="{Binding UnitPrice, Mode=OneWay, StringFormat=N0}" Width="110" />
                    <DataGridTextColumn Header="Thành tiền" Binding="{Binding AmountVnd, Mode=OneWay, StringFormat=N0}" Width="120" />
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </TabItem>
          </TabControl>
        </Border>

        <!-- Tổng cộng -->
        <Border Style="{DynamicResource CardBorderStyle}" Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Tổng cộng" Style="{StaticResource WhSectionHeaderStyle}" Margin="0,0,0,12" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <StackPanel>
                <TextBlock Text="Tiền hàng" Style="{StaticResource WhFieldLabelStyle}" />
                <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N0} đ}"
                           Style="{StaticResource WhSummaryValueStyle}" />
              </StackPanel>

              <StackPanel Grid.Column="2">
                <TextBlock Text="Giảm giá" Style="{StaticResource WhFieldLabelStyle}" />
                <TextBox Text="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ViMoneyConverter}}"
                         Style="{StaticResource WhRoundedTextBoxStyle}"
                         behaviors:NumericThousandSeparatorBehavior.EnableLiveThousandSeparator="True" />
              </StackPanel>

              <StackPanel Grid.Column="4">
                <TextBlock Text="Thuế" Style="{StaticResource WhFieldLabelStyle}" />
                <TextBox Text="{Binding TaxAmount, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ViMoneyConverter}}"
                         Style="{StaticResource WhRoundedTextBoxStyle}"
                         behaviors:NumericThousandSeparatorBehavior.EnableLiveThousandSeparator="True" />
              </StackPanel>

              <StackPanel Grid.Row="2">
                <TextBlock Text="Phí vận chuyển" Style="{StaticResource WhFieldLabelStyle}" />
                <TextBox Text="{Binding ShippingFee, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ViMoneyConverter}}"
                         Style="{StaticResource WhRoundedTextBoxStyle}"
                         behaviors:NumericThousandSeparatorBehavior.EnableLiveThousandSeparator="True" />
              </StackPanel>

              <StackPanel Grid.Row="2" Grid.Column="2">
                <TextBlock Text="Tổng cộng" Style="{StaticResource WhFieldLabelStyle}" />
                <TextBlock Text="{Binding GrandTotal, StringFormat={}{0:N0} đ}"
                           Style="{StaticResource WhSummaryValueStyle}"
                           Foreground="{DynamicResource PrimaryBrush}"
                           ToolTip="Tiền hàng - giảm giá + thuế + phí vận chuyển" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Thanh toán -->
        <Border Style="{DynamicResource CardBorderStyle}" Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Thanh toán"
                       Style="{StaticResource WhSectionHeaderStyle}"
                       Margin="0,0,0,12" />

            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <StackPanel>
                <TextBlock Text="Tiền mặt" Style="{StaticResource WhFieldLabelStyle}" />
                <TextBox Text="{Binding CashAmount, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ViMoneyConverter}}"
                         Style="{StaticResource WhRoundedTextBoxStyle}"
                         behaviors:NumericThousandSeparatorBehavior.EnableLiveThousandSeparator="True" />
              </StackPanel>

              <StackPanel Grid.Column="2">
                <TextBlock Text="Chuyển khoản" Style="{StaticResource WhFieldLabelStyle}" />
                <TextBox Text="{Binding TransferAmount, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ViMoneyConverter}}"
                         Style="{StaticResource WhRoundedTextBoxStyle}"
                         behaviors:NumericThousandSeparatorBehavior.EnableLiveThousandSeparator="True" />
              </StackPanel>

              <StackPanel Grid.Column="4">
                <TextBlock Text="Thẻ" Style="{StaticResource WhFieldLabelStyle}" />
                <TextBox Text="{Binding CardAmount, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ViMoneyConverter}}"
                         Style="{StaticResource WhRoundedTextBoxStyle}"
                         behaviors:NumericThousandSeparatorBehavior.EnableLiveThousandSeparator="True"
                         ToolTip="Nhập số tiền hoặc quét thẻ" />
              </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <StackPanel>
                <TextBlock Text="Quỹ tiền mặt" Style="{StaticResource WhFieldLabelStyle}" />
                <ComboBox ItemsSource="{Binding Funds}"
                          SelectedItem="{Binding SelectedFund}"
                          DisplayMemberPath="Name"
                          Style="{StaticResource WhComboStyle}"
                          ToolTip="Quỹ ghi phiếu chi tiền mặt" />
              </StackPanel>

              <StackPanel Grid.Column="2">
                <TextBlock Text="Tài khoản ngân hàng" Style="{StaticResource WhFieldLabelStyle}" />
                <ComboBox ItemsSource="{Binding Banks}"
                          SelectedItem="{Binding SelectedBankAccount}"
                          DisplayMemberPath="DisplayName"
                          Style="{StaticResource WhComboStyle}"
                          ToolTip="Chọn TK ngân hàng cho chuyển khoản/thẻ" />
              </StackPanel>
            </Grid>

            <Border Background="{DynamicResource SurfaceAltBrush}"
                    CornerRadius="8"
                    Padding="14,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                  <TextBlock Text="Tổng tiền" Style="{StaticResource WhFieldLabelStyle}" />
                  <TextBlock Text="{Binding GrandTotal, StringFormat={}{0:N0} đ}"
                             Style="{StaticResource WhSummaryValueStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock Text="Đã thanh toán" Style="{StaticResource WhFieldLabelStyle}" />
                  <TextBlock Text="{Binding PaidAmount, StringFormat={}{0:N0} đ}"
                             Style="{StaticResource WhSummaryValueStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="4">
                  <TextBlock Text="Còn nợ" Style="{StaticResource WhFieldLabelStyle}" />
                  <TextBlock Text="{Binding DebtAmount, StringFormat={}{0:N0} đ}"
                             Style="{StaticResource WhSummaryValueStyle}"
                             Foreground="{DynamicResource DangerBrush}" />
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </Border>

        <!-- Ghi chú -->
        <Border Style="{DynamicResource CardBorderStyle}" Padding="16">
          <StackPanel>
            <TextBlock Text="Ghi chú" Style="{StaticResource WhSectionHeaderStyle}" Margin="0,0,0,8" />
            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource WhRoundedTextBoxStyle}"
                     MinHeight="72"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     Padding="12,10" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
