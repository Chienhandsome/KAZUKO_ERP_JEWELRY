<UserControl x:Class="Kazuko.Modules.Warehouse.WarehouseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:access="clr-namespace:Kazuko.Shared.UI.Behaviors;assembly=Kazuko.Shared.UI"
             xmlns:conv="clr-namespace:Kazuko.Modules.Warehouse.Converters"
             xmlns:charts="clr-namespace:Kazuko.Modules.Warehouse.Controls"
             xmlns:local="clr-namespace:Kazuko.Modules.Warehouse"
             xmlns:grid="clr-namespace:Kazuko.Shared.UI.DataGridLayout;assembly=Kazuko.Shared.UI"
             MinWidth="900" MinHeight="520">
    <UserControl.Resources>
        <!-- Original 24px vector icons: theme-aware strokes, no font glyph dependency. -->
        <Geometry x:Key="WhIcon.Overview">M3,10 L12,4 21,10 V21 H3 Z M3,10 H21 M8,21 V13 H16 V21 M8,17 H16 M12,13 V21</Geometry>
        <Geometry x:Key="WhIcon.Materials">M6,3 H12 L14,9 H4 Z M3,14 H9 L11,20 H1 Z M15,14 H21 L23,20 H13 Z M7,6 H10 M4,17 H7 M16,17 H19</Geometry>
        <Geometry x:Key="WhIcon.Finished">M7,4 H17 L22,10 12,21 2,10 Z M2,10 H22 M7,4 L9,10 12,21 15,10 17,4 M9,10 L12,4 15,10</Geometry>
        <Geometry x:Key="WhIcon.Sales">M4,10 V21 H20 V10 M2,10 L4,3 H20 L22,10 M2,10 Q4.5,14 7,10 Q9.5,14 12,10 Q14.5,14 17,10 Q19.5,14 22,10 M8,21 V15 H16 V21 M8,3 L7,10 M16,3 L17,10</Geometry>
        <Geometry x:Key="WhIcon.Receipt">M3,13 V21 H21 V13 M3,13 H7 L9,17 H15 L17,13 H21 M12,2 V12 M8,8 L12,12 16,8</Geometry>
        <Geometry x:Key="WhIcon.Issue">M3,13 V21 H21 V13 M3,13 H7 L9,17 H15 L17,13 H21 M12,12 V2 M8,6 L12,2 16,6</Geometry>
        <Geometry x:Key="WhIcon.Transfer">M3,7 H21 M17,3 L21,7 17,11 M21,17 H3 M7,13 L3,17 7,21</Geometry>
        <Geometry x:Key="WhIcon.Stocktake">M9,4 H5 V22 H21 V4 H17 M9,2 H17 V6 H9 Z M8,14 L11,17 17,11</Geometry>
        <Geometry x:Key="WhIcon.Chevron">M9,5 L16,12 9,19</Geometry>
        <Style x:Key="WarehouseIconPathStyle" TargetType="Path">
            <Setter Property="Width" Value="22"/><Setter Property="Height" Value="22"/>
            <Setter Property="Stretch" Value="Uniform"/><Setter Property="StrokeThickness" Value="1.7"/>
            <Setter Property="Stroke" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:BooleanToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <conv:NullOrEmptyToVisibilityConverter x:Key="NullToVis" />
        <conv:NullOrEmptyToVisibilityConverter x:Key="NotNullToVis" Invert="True" />
        <conv:BrushKeyToBrushConverter x:Key="BrushKeyToBrush" />

        <Style x:Key="RoundedTextBoxStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterFieldStyle" TargetType="TextBox" BasedOn="{StaticResource RoundedTextBoxStyle}">
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="DetailValueStyle" TargetType="TextBox" BasedOn="{StaticResource RoundedTextBoxStyle}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="10,4" />
        </Style>

        <Style x:Key="FilterComboStyle" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MaxDropDownHeight" Value="280" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboBd"
                                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                CornerRadius="8"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="24" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="Transparent" />
                                                <Path Grid.Column="1"
                                                      Data="M 0 0 L 5 5 L 10 0"
                                                      Stroke="{DynamicResource TextSecondaryBrush}"
                                                      StrokeThickness="1.5"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="10,0,28,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Margin="0,2,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer Margin="2" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True"
                    TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,0,0" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryActionButtonStyle}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        </Style>

        <Style x:Key="OutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryActionButtonStyle}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        </Style>

        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DetailLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>

        <Style x:Key="PanelTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="PanelSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="DashboardPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="MinWidth" Value="320" />
        </Style>

        <Style x:Key="SummaryCardStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WarehouseDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowBackground" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="RowHeight" Value="28" />
            <Setter Property="ColumnHeaderHeight" Value="30" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="grid:DataGridColumnLayout.EnableHeaderMenu" Value="True" />
            <Setter Property="grid:DataGridColumnLayout.AutoFitOnFirstLoad" Value="True" />
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="MinHeight" Value="28" />
                        <Setter Property="SnapsToDevicePixels" Value="True" />
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="6,2" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WarehouseDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Height" Value="30" />
        </Style>

        <Style x:Key="CompactPreviewGridStyle" TargetType="DataGrid" BasedOn="{StaticResource WarehouseDataGridStyle}">
            <Setter Property="MinHeight" Value="80" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="WarehouseTabItemStyle" TargetType="TabItem">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}"
                                SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource WarehouseIconPathStyle}"
                                  Width="18" Height="18" Stroke="{TemplateBinding Foreground}" Margin="0,0,7,0"/>
                            <TextBlock x:Name="HeaderText"
                                       Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
                            <Setter TargetName="TabBorder" Property="TextBlock.Foreground" Value="{DynamicResource OnPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Kazuko.Modules.Warehouse;component/Assets/icons/KHO.png"
                       Width="48" Height="48" Stretch="Uniform" Margin="0,0,12,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="KHO"
                               Foreground="{DynamicResource PrimaryBrush}"
                               FontSize="{DynamicResource FontSize.Heading}"
                               FontWeight="Bold" />
                    <TextBlock Text="Quản lý kho nguyên liệu - kho thành phẩm - kho bán hàng"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="{DynamicResource FontSize.Body}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button access:PermissionAccess.Rule="CAT_GOLD_PRICE" Content="Bảng giá vàng kho"
                        Style="{StaticResource OutlineButtonStyle}"
                        Command="{Binding OpenWarehouseGoldPricesCommand}"
                        MinWidth="170" Margin="0,0,8,0" />
                <Button Content="Làm mới"
                        Style="{StaticResource OutlineButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        MinWidth="120" Margin="0" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TabControl SelectedIndex="{Binding SelectedTabIndex}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            ItemContainerStyle="{StaticResource WarehouseTabItemStyle}">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <ScrollViewer Grid.Row="0"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled"
                                              Margin="0,0,0,8">
                                    <TabPanel IsItemsHost="True" />
                                </ScrollViewer>
                                <Border Grid.Row="1"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="SelectedContent" />
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </TabControl.Template>

                    <!-- 0 Tổng quan -->
                    <TabItem access:PermissionAccess.Rule="INV_STOCK_VIEW" Header="Tổng quan" Tag="{StaticResource WhIcon.Overview}">
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1.2*" MinHeight="140" />
                                <RowDefinition Height="*" MinHeight="140" />
                            </Grid.RowDefinitions>

                                <!-- Summary cards -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Style="{StaticResource SummaryCardStyle}"
                                            Command="{Binding NavigateToTabCommand}" CommandParameter="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="8"
                                                    Background="{DynamicResource SurfaceAltBrush}" Margin="0,0,10,0">
                                                <Path Data="{StaticResource WhIcon.Overview}" Style="{StaticResource WarehouseIconPathStyle}"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Tổng giá trị tồn kho" Style="{StaticResource DetailLabelStyle}" />
                                                <TextBlock Text="{Binding TotalStockValueText, Mode=OneWay}"
                                                           FontSize="{DynamicResource FontSize.Subtitle}"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource MoneyBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Path Grid.Column="2" Data="{StaticResource WhIcon.Chevron}" Style="{StaticResource WarehouseIconPathStyle}" Width="12" Height="12" Margin="8,0,0,0"/>
                                        </Grid>
                                    </Button>

                                    <Button access:PermissionAccess.Rule="INV_STOCK_VIEW" Grid.Column="2" Style="{StaticResource SummaryCardStyle}"
                                            Command="{Binding ViewAllRawMaterialsCommand}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="8"
                                                    Background="{DynamicResource SurfaceAltBrush}" Margin="0,0,10,0">
                                                <Path Data="{StaticResource WhIcon.Materials}" Style="{StaticResource WarehouseIconPathStyle}"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Kho nguyên liệu" Style="{StaticResource DetailLabelStyle}" />
                                                <TextBlock Text="{Binding RawMaterialStockValueText, Mode=OneWay}"
                                                           FontSize="{DynamicResource FontSize.Subtitle}"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource MoneyBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Path Grid.Column="2" Data="{StaticResource WhIcon.Chevron}" Style="{StaticResource WarehouseIconPathStyle}" Width="12" Height="12" Margin="8,0,0,0"/>
                                        </Grid>
                                    </Button>

                                    <Button access:PermissionAccess.Rule="INV_STOCK_VIEW" Grid.Column="4" Style="{StaticResource SummaryCardStyle}"
                                            Command="{Binding ViewAllFinishedProductsCommand}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="8"
                                                    Background="{DynamicResource SurfaceAltBrush}" Margin="0,0,10,0">
                                                <Path Data="{StaticResource WhIcon.Finished}" Style="{StaticResource WarehouseIconPathStyle}"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Kho thành phẩm" Style="{StaticResource DetailLabelStyle}" />
                                                <TextBlock Text="{Binding FinishedProductStockValueText, Mode=OneWay}"
                                                           FontSize="{DynamicResource FontSize.Subtitle}"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource MoneyBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Path Grid.Column="2" Data="{StaticResource WhIcon.Chevron}" Style="{StaticResource WarehouseIconPathStyle}" Width="12" Height="12" Margin="8,0,0,0"/>
                                        </Grid>
                                    </Button>

                                    <Button access:PermissionAccess.Rule="INV_STOCK_VIEW" Grid.Column="6" Style="{StaticResource SummaryCardStyle}"
                                            Command="{Binding ViewAllSalesGoodsCommand}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="8"
                                                    Background="{DynamicResource SurfaceAltBrush}" Margin="0,0,10,0">
                                                <Path Data="{StaticResource WhIcon.Sales}" Style="{StaticResource WarehouseIconPathStyle}"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Kho bán hàng" Style="{StaticResource DetailLabelStyle}" />
                                                <TextBlock Text="{Binding SalesGoodsStockValueText, Mode=OneWay}"
                                                           FontSize="{DynamicResource FontSize.Subtitle}"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource MoneyBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Path Grid.Column="2" Data="{StaticResource WhIcon.Chevron}" Style="{StaticResource WarehouseIconPathStyle}" Width="12" Height="12" Margin="8,0,0,0"/>
                                        </Grid>
                                    </Button>
                                </Grid>

                                <!-- 3 warehouse panels -->
                                <ScrollViewer Grid.Row="1"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled"
                                              Margin="0,0,0,12">
                                    <Grid MinWidth="1260"
                                          Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="400" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" MinWidth="400" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" MinWidth="400" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Raw materials panel -->
                                        <Border Grid.Column="0" Style="{StaticResource DashboardPanelStyle}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="KHO NGUYÊN LIỆU" Style="{StaticResource PanelTitleStyle}" />
                                                        <TextBlock Text="Vàng, bạc, đá quý, phụ kiện, hoá chất..." Style="{StaticResource PanelSubtitleStyle}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                                        <Button access:PermissionAccess.Rule="INV_MATERIAL_RECEIPT:Add" Content="Nhập NVL" Style="{StaticResource PrimaryActionButtonStyle}"
                                                                Command="{Binding OpenReceiptTabCommand}"
                                                                ToolTip="Nhập nguyên vật liệu (không nhập thành phẩm thủ công)" />
                                                    </StackPanel>
                                                </Grid>
                                                <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                                                    <TextBox Width="160" Style="{StaticResource FilterFieldStyle}"
                                                             Text="{Binding OverviewRawSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="Tìm mã, tên nguyên liệu..." />
                                                    <ComboBox Width="130" Style="{StaticResource FilterComboStyle}"
                                                              ItemsSource="{Binding GoldTypeFilterOptions}"
                                                              SelectedItem="{Binding OverviewRawGoldType}" />
                                                    <ComboBox Width="130" Style="{StaticResource FilterComboStyle}"
                                                              ItemsSource="{Binding StatusFilterOptions}"
                                                              SelectedItem="{Binding OverviewRawStatus}" />
                                                </WrapPanel>
                                                <Grid Grid.Row="2">
                                                    <DataGrid ItemsSource="{Binding OverviewRawBalances}"
                                                              Style="{StaticResource CompactPreviewGridStyle}"
                                                              ColumnHeaderStyle="{StaticResource WarehouseDataGridColumnHeaderStyle}"
                                                              grid:DataGridColumnLayout.SettingsKey="warehouse-overview-raw"
                                                              Visibility="{Binding IsOverviewRawEmpty, Converter={StaticResource InverseBoolToVis}}">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="STT" grid:DataGridColumnLayout.Key="Index" Binding="{Binding Index, Mode=OneWay}" Width="48" />
                                                            <DataGridTextColumn Header="Mã NVL" grid:DataGridColumnLayout.Key="MaterialCode" Binding="{Binding MaterialCode, Mode=OneWay}" Width="90" />
                                                            <DataGridTextColumn Header="Tên nguyên liệu" grid:DataGridColumnLayout.Key="MaterialName" Binding="{Binding MaterialName, Mode=OneWay}" Width="*" MinWidth="120" />
                                                            <DataGridTextColumn Header="Loại vàng" grid:DataGridColumnLayout.Key="GoldType" Binding="{Binding GoldTypeDisplay, Mode=OneWay}" Width="90" />
                                                            <DataGridTextColumn Header="Tồn kho" grid:DataGridColumnLayout.Key="Quantity" Binding="{Binding QuantityText, Mode=OneWay}" Width="80" />
                                                            <DataGridTextColumn Header="ĐVT" grid:DataGridColumnLayout.Key="Unit" Binding="{Binding UnitCode, Mode=OneWay}" Width="56" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                    <TextBlock Text="Chưa có dữ liệu tồn nguyên liệu."
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontSize="{DynamicResource FontSize.Caption}"
                                                               Visibility="{Binding IsOverviewRawEmpty, Converter={StaticResource BoolToVis}}" />
                                                </Grid>
                                                <Button access:PermissionAccess.Rule="INV_STOCK_VIEW" Grid.Row="3" Margin="0,8,0,0" HorizontalAlignment="Right"
                                                        Content="Xem tất cả" Style="{StaticResource LinkButtonStyle}"
                                                        Command="{Binding ViewAllRawMaterialsCommand}" />
                                            </Grid>
                                        </Border>

                                        <!-- Finished products panel -->
                                        <Border Grid.Column="2" Style="{StaticResource DashboardPanelStyle}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="KHO THÀNH PHẨM" Style="{StaticResource PanelTitleStyle}" />
                                                        <TextBlock Text="Trang sức hoàn thiện, sản phẩm chế tác" Style="{StaticResource PanelSubtitleStyle}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                                        <Button access:PermissionAccess.Rule="INV_FINISHED_RECEIPT:Add" Content="Nhập thành phẩm"
                                                                Style="{StaticResource RoundedPrimaryButtonStyle}"
                                                                Command="{Binding OpenProductionFinishedReceiptCommand}"
                                                                MinWidth="150"
                                                                ToolTip="Nhập toàn bộ thành phẩm của một lệnh sản xuất đã hoàn thành" />
                                                        <Button access:PermissionAccess.Rule="INV_TRANSFER:Add" Content="Xuất kho bán hàng"
                                                                Style="{StaticResource RoundedPrimaryButtonStyle}"
                                                                Command="{Binding OpenFinishedProductTransferCommand}"
                                                                MinWidth="150"
                                                                ToolTip="Gửi yêu cầu chuyển thành phẩm sang Kho bán hàng (chờ BH duyệt)" />
                                                    </StackPanel>
                                                </Grid>
                                                <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                                                    <TextBox Width="160" Style="{StaticResource FilterFieldStyle}"
                                                             Text="{Binding OverviewFinishedSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="Tìm mã, tên sản phẩm..." />
                                                    <ComboBox Width="130" Style="{StaticResource FilterComboStyle}"
                                                              ItemsSource="{Binding GoldTypeFilterOptions}"
                                                              SelectedItem="{Binding OverviewFinishedGoldType}" />
                                                    <ComboBox Width="130" Style="{StaticResource FilterComboStyle}"
                                                              ItemsSource="{Binding ProductGroupFilterOptions}"
                                                              SelectedItem="{Binding OverviewFinishedGroup}" />
                                                    <ComboBox Width="130" Style="{StaticResource FilterComboStyle}"
                                                              ItemsSource="{Binding FinishedStatusOptions}"
                                                              SelectedItem="{Binding OverviewFinishedStatus}" />
                                                </WrapPanel>
                                                <Grid Grid.Row="2">
                                                    <DataGrid ItemsSource="{Binding OverviewFinishedProducts}"
                                                              Style="{StaticResource CompactPreviewGridStyle}"
                                                              ColumnHeaderStyle="{StaticResource WarehouseDataGridColumnHeaderStyle}"
                                                              grid:DataGridColumnLayout.SettingsKey="warehouse-overview-finished"
                                                              Visibility="{Binding IsOverviewFinishedEmpty, Converter={StaticResource InverseBoolToVis}}">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="STT" grid:DataGridColumnLayout.Key="Index" Binding="{Binding Index, Mode=OneWay}" Width="48" />
                                                            <DataGridTextColumn Header="Mã SP" grid:DataGridColumnLayout.Key="Code" Binding="{Binding Code, Mode=OneWay}" Width="100" />
                                                            <DataGridTextColumn Header="Tên sản phẩm" grid:DataGridColumnLayout.Key="ProductName" Binding="{Binding ProductName, Mode=OneWay}" Width="*" MinWidth="120" />
                                                            <DataGridTextColumn Header="Nhóm" grid:DataGridColumnLayout.Key="ProductGroup" Binding="{Binding ProductGroupName, Mode=OneWay}" Width="100" />
                                                            <DataGridTextColumn Header="Loại vàng" grid:DataGridColumnLayout.Key="GoldType" Binding="{Binding GoldPurity, Mode=OneWay}" Width="90" />
                                                            <DataGridTextColumn Header="ĐVT" grid:DataGridColumnLayout.Key="Unit" Binding="{Binding UnitCode, Mode=OneWay}" Width="56" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                    <TextBlock Text="Chưa có dữ liệu thành phẩm."
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontSize="{DynamicResource FontSize.Caption}"
                                                               Visibility="{Binding IsOverviewFinishedEmpty, Converter={StaticResource BoolToVis}}" />
                                                </Grid>
                                                <Button access:PermissionAccess.Rule="INV_STOCK_VIEW" Grid.Row="3" Margin="0,8,0,0" HorizontalAlignment="Right"
                                                        Content="Xem tất cả" Style="{StaticResource LinkButtonStyle}"
                                                        Command="{Binding ViewAllFinishedProductsCommand}" />
                                            </Grid>
                                        </Border>

                                        <!-- Sales goods panel -->
                                        <Border Grid.Column="4" Style="{StaticResource DashboardPanelStyle}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="KHO BÁN HÀNG" Style="{StaticResource PanelTitleStyle}" />
                                                        <TextBlock Text="Hàng trưng bày, hàng bán lẻ" Style="{StaticResource PanelSubtitleStyle}" />
                                                    </StackPanel>
                                                    <Button access:PermissionAccess.Rule="INV_SALES_INTAKE" Grid.Column="1"
                                                            Content="Duyệt nhập từ kho TP"
                                                            Style="{StaticResource RoundedPrimaryButtonStyle}"
                                                            Command="{Binding OpenSalesIntakeApprovalCommand}"
                                                            MinWidth="170"
                                                            VerticalAlignment="Top"
                                                            ToolTip="Duyệt hoặc từ chối yêu cầu chuyển thành phẩm vào Kho bán hàng" />
                                                </Grid>
                                                <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                                                    <TextBox Width="160" Style="{StaticResource FilterFieldStyle}"
                                                             Text="{Binding OverviewSaleSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="Tìm mã, tên hàng..." />
                                                    <ComboBox Width="130" Style="{StaticResource FilterComboStyle}"
                                                              ItemsSource="{Binding GoldTypeFilterOptions}"
                                                              SelectedItem="{Binding OverviewSaleGoldType}" />
                                                    <ComboBox Width="130" Style="{StaticResource FilterComboStyle}"
                                                              ItemsSource="{Binding ProductGroupFilterOptions}"
                                                              SelectedItem="{Binding OverviewSaleGroup}" />
                                                    <ComboBox Width="130" Style="{StaticResource FilterComboStyle}"
                                                              ItemsSource="{Binding SaleStatusOptions}"
                                                              SelectedItem="{Binding OverviewSaleStatus}" />
                                                </WrapPanel>
                                                <Grid Grid.Row="2">
                                                    <DataGrid ItemsSource="{Binding OverviewSaleItems}"
                                                              Style="{StaticResource CompactPreviewGridStyle}"
                                                              ColumnHeaderStyle="{StaticResource WarehouseDataGridColumnHeaderStyle}"
                                                              grid:DataGridColumnLayout.SettingsKey="warehouse-overview-sale"
                                                              Visibility="{Binding IsOverviewSaleEmpty, Converter={StaticResource InverseBoolToVis}}">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="STT" grid:DataGridColumnLayout.Key="Index" Binding="{Binding Index, Mode=OneWay}" Width="48" />
                                                            <DataGridTextColumn Header="Mã HB" grid:DataGridColumnLayout.Key="Code" Binding="{Binding Code, Mode=OneWay}" Width="100" />
                                                            <DataGridTextColumn Header="Tên hàng" grid:DataGridColumnLayout.Key="ProductName" Binding="{Binding ProductName, Mode=OneWay}" Width="*" MinWidth="120" />
                                                            <DataGridTextColumn Header="Nhóm" grid:DataGridColumnLayout.Key="ProductGroup" Binding="{Binding ProductGroupName, Mode=OneWay}" Width="100" />
                                                            <DataGridTextColumn Header="Loại vàng" grid:DataGridColumnLayout.Key="GoldType" Binding="{Binding GoldPurity, Mode=OneWay}" Width="90" />
                                                            <DataGridTextColumn Header="ĐVT" grid:DataGridColumnLayout.Key="Unit" Binding="{Binding UnitCode, Mode=OneWay}" Width="56" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                    <TextBlock Text="Chưa có hàng bán trưng bày."
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontSize="{DynamicResource FontSize.Caption}"
                                                               Visibility="{Binding IsOverviewSaleEmpty, Converter={StaticResource BoolToVis}}" />
                                                </Grid>
                                                <Button access:PermissionAccess.Rule="INV_STOCK_VIEW" Grid.Row="3" Margin="0,8,0,0" HorizontalAlignment="Right"
                                                        Content="Xem tất cả" Style="{StaticResource LinkButtonStyle}"
                                                        Command="{Binding ViewAllSalesGoodsCommand}" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </ScrollViewer>

                                <!-- Bottom charts + recent -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="240" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" MinWidth="260" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="1.2*" MinWidth="300" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource DashboardPanelStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Tỷ trọng giá trị tồn kho" Style="{StaticResource PanelTitleStyle}" Margin="0,0,0,8" />
                                            <charts:DonutChart Grid.Row="1"
                                                               ItemsSource="{Binding CompositionSlices}"
                                                               CenterText="{Binding DonutCenterText}"
                                                               CenterSubText="{Binding DonutCenterSubText}" />
                                            <ItemsControl Grid.Row="2" ItemsSource="{Binding CompositionSlices}" Margin="0,8,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                                            <Border Width="10" Height="10" CornerRadius="2" Margin="0,0,6,0"
                                                                    Background="{Binding BrushKey, Converter={StaticResource BrushKeyToBrush}}" />
                                                            <TextBlock Text="{Binding LegendText}" FontSize="{DynamicResource FontSize.Caption}"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource DashboardPanelStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Biểu đồ giá trị tồn kho theo loại vàng"
                                                           Style="{StaticResource PanelTitleStyle}" TextWrapping="Wrap"
                                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <Button Grid.Column="1" Content="Cột"
                                                        ToolTip="Cấu hình loại vàng hiển thị"
                                                        Command="{Binding ConfigureGoldTypeChartCommand}"
                                                        Style="{StaticResource LinkButtonStyle}"
                                                        Padding="4,0"
                                                        VerticalAlignment="Center" />
                                            </Grid>
                                            <charts:BarChart Grid.Row="1"
                                                             ItemsSource="{Binding GoldTypeBars}" />
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="4" Style="{StaticResource DashboardPanelStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock Text="Lịch sử nhập xuất gần đây" Style="{StaticResource PanelTitleStyle}" />
                                                <Button access:PermissionAccess.Rule="INV_HISTORY" Content="Xem tất cả" Style="{StaticResource LinkButtonStyle}"
                                                        HorizontalAlignment="Right"
                                                        Command="{Binding ViewAllRecentHistoryCommand}" />
                                            </Grid>
                                            <Grid Grid.Row="1">
                                                <DataGrid ItemsSource="{Binding RecentDocuments}"
                                                          Style="{StaticResource WarehouseDataGridStyle}"
                                                          ColumnHeaderStyle="{StaticResource WarehouseDataGridColumnHeaderStyle}"
                                                          grid:DataGridColumnLayout.SettingsKey="warehouse-overview-recent"
                                                          Visibility="{Binding IsRecentHistoryEmpty, Converter={StaticResource InverseBoolToVis}}">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Ngày" grid:DataGridColumnLayout.Key="Date" Binding="{Binding DocumentDateText, Mode=OneWay}" Width="80" />
                                                        <DataGridTextColumn Header="Số phiếu" grid:DataGridColumnLayout.Key="Code" Binding="{Binding Code, Mode=OneWay}" Width="100" />
                                                        <DataGridTextColumn Header="Loại" grid:DataGridColumnLayout.Key="Type" Binding="{Binding DocumentTypeDisplay, Mode=OneWay}" Width="60" />
                                                        <DataGridTextColumn Header="Kho" grid:DataGridColumnLayout.Key="Warehouse" Binding="{Binding WarehouseDisplay, Mode=OneWay}" Width="*" MinWidth="80" />
                                                        <DataGridTextColumn Header="Tổng tiền" grid:DataGridColumnLayout.Key="Total" Binding="{Binding TotalAmountText, Mode=OneWay}" Width="90" />
                                                        <DataGridTextColumn Header="Người thực hiện" grid:DataGridColumnLayout.Key="CreatedBy" Binding="{Binding CreatedByName, Mode=OneWay}" Width="110" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                                <TextBlock Text="Chưa có lịch sử nhập xuất."
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="{DynamicResource FontSize.Caption}"
                                                           Visibility="{Binding IsRecentHistoryEmpty, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                        </Grid>
                    </TabItem>

                    <!-- 1 Kho nguyên liệu -->
                    <TabItem access:PermissionAccess.Rule="INV_STOCK_VIEW" Header="Kho nguyên liệu" Tag="{StaticResource WhIcon.Materials}">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="220" />
                            </Grid.RowDefinitions>
                            <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBox Width="240" Style="{StaticResource FilterFieldStyle}"
                                         Text="{Binding BalanceSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Tìm mã hoặc tên NVL" />
                                <ComboBox Width="140" Style="{StaticResource FilterComboStyle}"
                                          ItemsSource="{Binding MaterialTypeOptions}"
                                          SelectedItem="{Binding SelectedMaterialType}" />
                                <ComboBox Width="220" Style="{StaticResource FilterComboStyle}"
                                          ItemsSource="{Binding Locations}"
                                          SelectedItem="{Binding SelectedLocation}"
                                          DisplayMemberPath="DisplayName" />
                                <CheckBox Content="Chỉ tồn thấp" IsChecked="{Binding LowStockOnly}"
                                          VerticalAlignment="Center" Margin="0,0,12,0"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          FontSize="{DynamicResource FontSize.Body}" />
                                <Button access:PermissionAccess.Rule="INV_STOCK_VIEW" Content="Tìm" Style="{StaticResource RoundedPrimaryButtonStyle}"
                                        Command="{Binding SearchBalancesCommand}" Margin="0,0,8,0" MinWidth="90" />
                                <Button Content="Xóa lọc" Style="{StaticResource OutlineButtonStyle}"
                                        Command="{Binding ClearBalanceFiltersCommand}" MinWidth="90" />
                                <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                                    <Button access:PermissionAccess.Rule="INV_MATERIAL_RECEIPT:Add" Content="Nhập NVL"
