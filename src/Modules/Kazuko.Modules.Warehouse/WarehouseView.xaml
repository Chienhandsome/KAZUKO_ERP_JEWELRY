<UserControl x:Class="Kazuko.Modules.Warehouse.WarehouseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Kazuko.Modules.Warehouse.Converters"
             MinWidth="900" MinHeight="520">
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:BooleanToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <conv:NullOrEmptyToVisibilityConverter x:Key="NullToVis" />
        <conv:NullOrEmptyToVisibilityConverter x:Key="NotNullToVis" Invert="True" />

        <Style x:Key="RoundedTextBoxStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterFieldStyle" TargetType="TextBox" BasedOn="{StaticResource RoundedTextBoxStyle}">
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="DetailValueStyle" TargetType="TextBox" BasedOn="{StaticResource RoundedTextBoxStyle}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="10,4" />
        </Style>

        <Style x:Key="FilterComboStyle" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="RoundedPrimaryButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DetailLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>

        <Style x:Key="WarehouseDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowBackground" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="RowHeight" Value="28" />
            <Setter Property="ColumnHeaderHeight" Value="32" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="MinHeight" Value="28" />
                        <Setter Property="SnapsToDevicePixels" Value="True" />
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="8,2" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WarehouseDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Height" Value="32" />
        </Style>

        <Style x:Key="WarehouseTabItemStyle" TargetType="TabItem">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent" BorderThickness="0,0,0,3"
                                BorderBrush="Transparent" Padding="{TemplateBinding Padding}" Margin="0,0,4,0"
                                CornerRadius="6,6,0,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Kazuko.Modules.Warehouse;component/Assets/icons/KHO.png"
                       Width="48" Height="48" Stretch="Uniform" Margin="0,0,12,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="KHO"
                               Foreground="{DynamicResource PrimaryBrush}"
                               FontSize="{DynamicResource FontSize.Heading}"
                               FontWeight="Bold" />
                    <TextBlock Text="Quản lý kho nguyên liệu - phiếu kho - sổ giao dịch (chỉ đọc)"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="{DynamicResource FontSize.Body}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Làm mới"
                    Style="{StaticResource OutlineButtonStyle}"
                    Command="{Binding RefreshCommand}"
                    MinWidth="120"
                    Margin="0" />
        </Grid>

        <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TabControl SelectedIndex="{Binding SelectedTabIndex}"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemContainerStyle="{StaticResource WarehouseTabItemStyle}">

                    <!-- Tổng quan -->
                    <TabItem Header="Tổng quan">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}" Padding="12,8">
                                        <StackPanel>
                                            <TextBlock Text="Giá trị tồn NVL" Style="{StaticResource DetailLabelStyle}" />
                                            <TextBlock Text="{Binding MaterialStockValueText, Mode=OneWay}"
                                                       FontSize="{DynamicResource FontSize.Subtitle}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{DynamicResource CardBorderStyle}" Padding="12,8">
                                        <StackPanel>
                                            <TextBlock Text="Dòng tồn NVL" Style="{StaticResource DetailLabelStyle}" />
                                            <TextBlock Text="{Binding BalanceCount, Mode=OneWay}"
                                                       FontSize="{DynamicResource FontSize.Subtitle}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="4" Style="{DynamicResource CardBorderStyle}" Padding="12,8">
                                        <StackPanel>
                                            <TextBlock Text="Cảnh báo tồn thấp" Style="{StaticResource DetailLabelStyle}" />
                                            <TextBlock Text="{Binding LowStockCount, Mode=OneWay}"
                                                       FontSize="{DynamicResource FontSize.Subtitle}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource DangerBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="6" Style="{DynamicResource CardBorderStyle}" Padding="12,8">
                                        <StackPanel>
                                            <TextBlock Text="Phiếu kho hôm nay" Style="{StaticResource DetailLabelStyle}" />
                                            <TextBlock Text="{Binding TodayDocumentCount, Mode=OneWay}"
                                                       FontSize="{DynamicResource FontSize.Subtitle}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock Text="Tồn nguyên vật liệu (xem nhanh)"
                                           FontSize="{DynamicResource FontSize.Subtitle}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,0,0,8" />
                                <DataGrid ItemsSource="{Binding Balances}"
                                          SelectedItem="{Binding SelectedBalance}"
                                          Style="{StaticResource WarehouseDataGridStyle}"
                                          ColumnHeaderStyle="{StaticResource WarehouseDataGridColumnHeaderStyle}"
                                          MaxHeight="280"
                                          Margin="0,0,0,16">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="STT" Binding="{Binding Index, Mode=OneWay}" Width="50" />
                                        <DataGridTextColumn Header="Mã NVL" Binding="{Binding MaterialCode, Mode=OneWay}" Width="110" />
                                        <DataGridTextColumn Header="Tên NVL" Binding="{Binding MaterialName, Mode=OneWay}" Width="*" MinWidth="140" />
                                        <DataGridTextColumn Header="Loại" Binding="{Binding MaterialTypeDisplay, Mode=OneWay}" Width="90" />
                                        <DataGridTextColumn Header="Vị trí" Binding="{Binding LocationName, Mode=OneWay}" Width="140" />
                                        <DataGridTextColumn Header="Tồn" Binding="{Binding QuantityText, Mode=OneWay}" Width="90" />
                                        <DataGridTextColumn Header="ĐVT" Binding="{Binding UnitCode, Mode=OneWay}" Width="70" />
                                        <DataGridTextColumn Header="Giá trị" Binding="{Binding StockValueText, Mode=OneWay}" Width="110" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Text="Phiếu kho gần đây"
                                           FontSize="{DynamicResource FontSize.Subtitle}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,0,0,8" />
                                <DataGrid ItemsSource="{Binding Documents}"
                                          SelectedItem="{Binding SelectedDocument}"
                                          Style="{StaticResource WarehouseDataGridStyle}"
                                          ColumnHeaderStyle="{StaticResource WarehouseDataGridColumnHeaderStyle}"
                                          MaxHeight="240">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Ngày" Binding="{Binding DocumentDateText, Mode=OneWay}" Width="100" />
                                        <DataGridTextColumn Header="Số phiếu" Binding="{Binding Code, Mode=OneWay}" Width="130" />
                                        <DataGridTextColumn Header="Loại" Binding="{Binding DocumentTypeDisplay, Mode=OneWay}" Width="90" />
                                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusDisplay, Mode=OneWay}" Width="110" />
                                        <DataGridTextColumn Header="Đối tác" Binding="{Binding CounterpartyName, Mode=OneWay}" Width="*" MinWidth="120" />
                                        <DataGridTextColumn Header="Tổng tiền" Binding="{Binding TotalAmountText, Mode=OneWay}" Width="120" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Kho nguyên liệu -->
                    <TabItem Header="Kho nguyên liệu">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="220" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBox Width="240"
                                         Style="{StaticResource FilterFieldStyle}"
                                         Text="{Binding BalanceSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Tìm mã hoặc tên NVL" />
                                <ComboBox Width="140"
                                          Style="{StaticResource FilterComboStyle}"
                                          ItemsSource="{Binding MaterialTypeOptions}"
                                          SelectedItem="{Binding SelectedMaterialType}" />
                                <ComboBox Width="220"
                                          Style="{StaticResource FilterComboStyle}"
                                          ItemsSource="{Binding Locations}"
                                          SelectedItem="{Binding SelectedLocation}"
                                          DisplayMemberPath="DisplayName" />
                                <CheckBox Content="Chỉ tồn thấp"
                                          IsChecked="{Binding LowStockOnly}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          FontSize="{DynamicResource FontSize.Body}" />
                                <Button Content="Tìm"
                                        Style="{StaticResource RoundedPrimaryButtonStyle}"
                                        Command="{Binding SearchBalancesCommand}"
                                        Margin="0,0,8,0"
                                        MinWidth="90" />
                                <Button Content="Xóa lọc"
                                        Style="{StaticResource OutlineButtonStyle}"
                                        Command="{Binding ClearBalanceFiltersCommand}"
                                        MinWidth="90" />
                            </WrapPanel>

                            <Grid Grid.Row="1">
                                <DataGrid ItemsSource="{Binding Balances}"
                                          SelectedItem="{Binding SelectedBalance}"
                                          Style="{StaticResource WarehouseDataGridStyle}"
                                          ColumnHeaderStyle="{StaticResource WarehouseDataGridColumnHeaderStyle}"
                                          Visibility="{Binding IsBalancesEmpty, Converter={StaticResource InverseBoolToVis}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="STT" Binding="{Binding Index, Mode=OneWay}" Width="50" />
                                        <DataGridTextColumn Header="Mã NVL" Binding="{Binding MaterialCode, Mode=OneWay}" Width="110" />
                                        <DataGridTextColumn Header="Tên NVL" Binding="{Binding MaterialName, Mode=OneWay}" Width="*" MinWidth="150" />
                                        <DataGridTextColumn Header="Loại" Binding="{Binding MaterialTypeDisplay, Mode=OneWay}" Width="90" />
                                        <DataGridTextColumn Header="Hàm lượng" Binding="{Binding PurityCode, Mode=OneWay}" Width="100" />
                                        <DataGridTextColumn Header="Vị trí" Binding="{Binding LocationName, Mode=OneWay}" Width="140" />
                                        <DataGridTextColumn Header="Tồn" Binding="{Binding QuantityText, Mode=OneWay}" Width="90" />
                                        <DataGridTextColumn Header="ĐVT" Binding="{Binding UnitCode, Mode=OneWay}" Width="70" />
                                        <DataGridTextColumn Header="Giá TB" Binding="{Binding AverageCostText, Mode=OneWay}" Width="100" />
                                        <DataGridTextColumn Header="Giá trị" Binding="{Binding StockValueText, Mode=OneWay}" Width="110" />
                                        <DataGridTextColumn Header="Tồn tối thiểu" Binding="{Binding MinimumStockText, Mode=OneWay}" Width="110" />
                                        <DataGridTextColumn Header="Cảnh báo" Binding="{Binding LowStockText, Mode=OneWay}" Width="90" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="Không có dữ liệu tồn nguyên vật liệu."
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="{DynamicResource FontSize.Body}"
                                           Visibility="{Binding IsBalancesEmpty, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- Phiếu kho -->
                    <TabItem Header="Phiếu kho">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="180" />
                                <RowDefinition Height="*" MinHeight="180" />
                            </Grid.RowDefinitions>

                            <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBox Width="240"
                                         Style="{StaticResource FilterFieldStyle}"
                                         Text="{Binding DocumentSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Tìm số phiếu, tham chiếu, đối tác" />
                                <ComboBox Width="140"
                                          Style="{StaticResource FilterComboStyle}"
                                          ItemsSource="{Binding DocumentTypeOptions}"
                                          SelectedItem="{Binding SelectedDocumentType}" />
                                <ComboBox Width="140"
                                          Style="{StaticResource FilterComboStyle}"
                                          ItemsSource="{Binding DocumentStatusOptions}"
                                          SelectedItem="{Binding SelectedDocumentStatus}" />
                                <Button Content="Tìm"
                                        Style="{StaticResource RoundedPrimaryButtonStyle}"
                                        Command="{Binding SearchDocumentsCommand}"
                                        Margin="0,0,8,0"
                                        MinWidth="90" />
                                <Button Content="Xóa lọc"
                                        Style="{StaticResource OutlineButtonStyle}"
                                        Command="{Binding ClearDocumentFiltersCommand}"
                                        MinWidth="90" />
                            </WrapPanel>

                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <DataGrid ItemsSource="{Binding Documents}"
                                          SelectedItem="{Binding SelectedDocument}"
                                          Style="{StaticResource WarehouseDataGridStyle}"
                                          ColumnHeaderStyle="{StaticResource WarehouseDataGridColumnHeaderStyle}"
                                          Visibility="{Binding IsDocumentsEmpty, Converter={StaticResource InverseBoolToVis}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="STT" Binding="{Binding Index, Mode=OneWay}" Width="50" />
                                        <DataGridTextColumn Header="Ngày" Binding="{Binding DocumentDateText, Mode=OneWay}" Width="100" />
                                        <DataGridTextColumn Header="Số phiếu" Binding="{Binding Code, Mode=OneWay}" Width="130" />
                                        <DataGridTextColumn Header="Loại" Binding="{Binding DocumentTypeDisplay, Mode=OneWay}" Width="90" />
                                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusDisplay, Mode=OneWay}" Width="110" />
                                        <DataGridTextColumn Header="Kho nguồn" Binding="{Binding SourceLocationName, Mode=OneWay}" Width="120" />
                                        <DataGridTextColumn Header="Kho đích" Binding="{Binding DestinationLocationName, Mode=OneWay}" Width="120" />
                                        <DataGridTextColumn Header="Đối tác" Binding="{Binding CounterpartyName, Mode=OneWay}" Width="*" MinWidth="120" />
                                        <DataGridTextColumn Header="Số dòng" Binding="{Binding LineCount, Mode=OneWay}" Width="80" />
                                        <DataGridTextColumn Header="Tổng tiền" Binding="{Binding TotalAmountText, Mode=OneWay}" Width="110" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="Không có phiếu kho."
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="{DynamicResource FontSize.Body}"
                                           Visibility="{Binding IsDocumentsEmpty, Converter={StaticResource BoolToVis}}" />
                            </Grid>

                            <Border Grid.Row="2" Style="{DynamicResource CardBorderStyle}" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="280" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  Visibility="{Binding HasDocumentDetail, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="Chi tiết phiếu (chỉ đọc)"
                                                       FontWeight="SemiBold"
                                                       FontSize="{DynamicResource FontSize.Body}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Margin="0,0,0,8" />
                                            <TextBlock Text="Số phiếu" Style="{StaticResource DetailLabelStyle}" />
                                            <TextBox Text="{Binding DetailCode, Mode=OneWay}" Style="{StaticResource DetailValueStyle}" />
                                            <TextBlock Text="Ngày" Style="{StaticResource DetailLabelStyle}" />
                                            <TextBox Text="{Binding DetailDate, Mode=OneWay}" Style="{StaticResource DetailValueStyle}" />
                                            <TextBlock Text="Loại" Style="{StaticResource DetailLabelStyle}" />
                                            <TextBox Text="{Binding DetailType, Mode=OneWay}" Style="{StaticResource DetailValueStyle}" />
                                            <TextBlock Text="Trạng thái" Style="{StaticResource DetailLabelStyle}" />
                                            <TextBox Text="{Binding DetailStatus, Mode=OneWay}" Style="{StaticResource DetailValueStyle}" />
                                            <TextBlock Text="Tham chiếu" Style="{StaticResource DetailLabelStyle}" />
                                            <TextBox Text="{Binding DetailReference, Mode=OneWay}" Style="{StaticResource DetailValueStyle}" />
                                            <TextBlock Text="Đối tác" Style="{StaticResource DetailLabelStyle}" />
                                            <TextBox Text="{Binding DetailCounterparty, Mode=OneWay}" Style="{StaticResource DetailValueStyle}" />
                                            <TextBlock Text="Ghi chú" Style="{StaticResource DetailLabelStyle}" />
                                            <TextBox Text="{Binding DetailNotes, Mode=OneWay}"
                                                    Style="{StaticResource DetailValueStyle}"
                                                    TextWrapping="Wrap"
                                                    AcceptsReturn="True"
                                                    MinHeight="56"
                                                    VerticalScrollBarVisibility="Auto" />
                                            <TextBlock Text="Người tạo" Style="{StaticResource DetailLabelStyle}" />
                                            <TextBox Text="{Binding DetailCreatedBy, Mode=OneWay}" Style="{StaticResource DetailValueStyle}" />
                                            <TextBlock Text="Người ghi sổ" Style="{StaticResource DetailLabelStyle}" />
                                            <TextBox Text="{Binding DetailPostedBy, Mode=OneWay}" Style="{StaticResource DetailValueStyle}" />
                                            <TextBlock Text="Thời điểm ghi sổ" Style="{StaticResource DetailLabelStyle}" />
                                            <TextBox Text="{Binding DetailPostedAt, Mode=OneWay}" Style="{StaticResource DetailValueStyle}" />
                                        </StackPanel>
                                    </ScrollViewer>

                                    <TextBlock Grid.Column="0"
                                               Text="Chọn một phiếu để xem chi tiết."
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="{DynamicResource FontSize.Body}"
                                               Visibility="{Binding HasDocumentDetail, Converter={StaticResource InverseBoolToVis}}" />

                                    <DataGrid Grid.Column="2"
                                              ItemsSource="{Binding DocumentLines}"
                                              Style="{StaticResource WarehouseDataGridStyle}"
                                              ColumnHeaderStyle="{StaticResource WarehouseDataGridColumnHeaderStyle}"
                                              Visibility="{Binding HasDocumentDetail, Converter={StaticResource BoolToVis}}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="#" Binding="{Binding LineNumber, Mode=OneWay}" Width="40" />
                                            <DataGridTextColumn Header="Mã NVL" Binding="{Binding MaterialCode, Mode=OneWay}" Width="100" />
                                            <DataGridTextColumn Header="Tên" Binding="{Binding MaterialName, Mode=OneWay}" Width="*" MinWidth="120" />
                                            <DataGridTextColumn Header="SL" Binding="{Binding QuantityText, Mode=OneWay}" Width="80" />
                                            <DataGridTextColumn Header="ĐVT" Binding="{Binding UnitCode, Mode=OneWay}" Width="60" />
                                            <DataGridTextColumn Header="Đơn giá" Binding="{Binding UnitCostText, Mode=OneWay}" Width="90" />
                                            <DataGridTextColumn Header="Thành tiền" Binding="{Binding LineAmountText, Mode=OneWay}" Width="100" />
                                            <DataGridTextColumn Header="Lô" Binding="{Binding LotNo, Mode=OneWay}" Width="90" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- Sổ giao dịch -->
                    <TabItem Header="Sổ giao dịch">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="220" />
                            </Grid.RowDefinitions>

                            <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBox Width="240"
                                         Style="{StaticResource FilterFieldStyle}"
                                         Text="{Binding MovementSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Tìm số phiếu, mã/tên NVL" />
                                <ComboBox Width="220"
                                          Style="{StaticResource FilterComboStyle}"
                                          ItemsSource="{Binding MovementLocations}"
                                          SelectedItem="{Binding SelectedMovementLocation}"
                                          DisplayMemberPath="DisplayName" />
                                <Button Content="Tìm"
                                        Style="{StaticResource RoundedPrimaryButtonStyle}"
                                        Command="{Binding SearchMovementsCommand}"
                                        Margin="0,0,8,0"
                                        MinWidth="90" />
                                <Button Content="Xóa lọc"
                                        Style="{StaticResource OutlineButtonStyle}"
                                        Command="{Binding ClearMovementFiltersCommand}"
                                        MinWidth="90" />
                            </WrapPanel>

                            <Grid Grid.Row="1">
                                <DataGrid ItemsSource="{Binding Movements}"
                                          SelectedItem="{Binding SelectedMovement}"
                                          Style="{StaticResource WarehouseDataGridStyle}"
                                          ColumnHeaderStyle="{StaticResource WarehouseDataGridColumnHeaderStyle}"
                                          Visibility="{Binding IsMovementsEmpty, Converter={StaticResource InverseBoolToVis}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="STT" Binding="{Binding Index, Mode=OneWay}" Width="50" />
                                        <DataGridTextColumn Header="Thời điểm" Binding="{Binding OccurredAtText, Mode=OneWay}" Width="130" />
                                        <DataGridTextColumn Header="Số phiếu" Binding="{Binding DocumentCode, Mode=OneWay}" Width="120" />
                                        <DataGridTextColumn Header="Loại phiếu" Binding="{Binding DocumentTypeDisplay, Mode=OneWay}" Width="100" />
                                        <DataGridTextColumn Header="Mã NVL" Binding="{Binding MaterialCode, Mode=OneWay}" Width="100" />
                                        <DataGridTextColumn Header="Tên NVL" Binding="{Binding MaterialName, Mode=OneWay}" Width="*" MinWidth="140" />
                                        <DataGridTextColumn Header="Vị trí" Binding="{Binding LocationName, Mode=OneWay}" Width="120" />
                                        <DataGridTextColumn Header="Loại GD" Binding="{Binding MovementTypeDisplay, Mode=OneWay}" Width="80" />
                                        <DataGridTextColumn Header="SL" Binding="{Binding QuantityChangeText, Mode=OneWay}" Width="90" />
                                        <DataGridTextColumn Header="Đơn giá" Binding="{Binding UnitCostText, Mode=OneWay}" Width="90" />
                                        <DataGridTextColumn Header="Giá trị" Binding="{Binding ValueChangeText, Mode=OneWay}" Width="100" />
                                        <DataGridTextColumn Header="Người thực hiện" Binding="{Binding CreatedByName, Mode=OneWay}" Width="140" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="Không có giao dịch kho."
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="{DynamicResource FontSize.Body}"
                                           Visibility="{Binding IsMovementsEmpty, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Kho thành phẩm" IsEnabled="False" ToolTip="TASK-009E" />
                    <TabItem Header="Kiểm kê" IsEnabled="False" ToolTip="TASK-009F" />
                </TabControl>

                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusMessage, Mode=OneWay}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="{DynamicResource FontSize.Caption}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding ErrorMessage, Mode=OneWay}"
                               Foreground="{DynamicResource DangerBrush}"
                               FontSize="{DynamicResource FontSize.Caption}"
                               TextWrapping="Wrap"
                               MaxWidth="420"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVis}}" />
                </Grid>

                <Border Grid.Row="0" Grid.RowSpan="2"
                        Background="{DynamicResource SurfaceBrush}"
                        Opacity="0.72"
                        Visibility="{Binding IsBusyOverlayVisible, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Đang tải..."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource FontSize.Subtitle}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
