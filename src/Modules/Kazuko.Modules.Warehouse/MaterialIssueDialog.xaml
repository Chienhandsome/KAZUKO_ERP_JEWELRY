<Window x:Class="Kazuko.Modules.Warehouse.MaterialIssueDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:access="clr-namespace:Kazuko.Shared.UI.Behaviors;assembly=Kazuko.Shared.UI"
        xmlns:behaviors="clr-namespace:Kazuko.Shared.UI.Behaviors;assembly=Kazuko.Shared.UI"
        Title="Xuất kho nguyên vật liệu"
        Width="820" Height="620" MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Hủy" Style="{DynamicResource NavButtonStyle}" Command="{Binding CancelCommand}"
              MinHeight="40" Margin="0,0,8,0" IsCancel="True" />
      <Button access:PermissionAccess.Rule="INV_TRANSFER:Add" Content="Ghi sổ xuất kho" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding SaveCommand}"
              MinHeight="40" IsDefault="True" />
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="Xuất kho nguyên vật liệu" FontSize="{DynamicResource FontSize.Heading}"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />

        <TextBlock Text="Kho xuất" Margin="0,12,0,4" Foreground="{DynamicResource TextSecondaryBrush}" />
        <ComboBox ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation}"
                  DisplayMemberPath="DisplayName" Height="40" />
        <TextBlock Text="Người nhận" Margin="0,12,0,4" Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBox Text="{Binding ReceivedByName, UpdateSourceTrigger=PropertyChanged}" Height="40" />

        <Border Style="{DynamicResource CardBorderStyle}" Padding="12" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="Nguyên vật liệu xuất" FontSize="{DynamicResource FontSize.Subtitle}"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ComboBox ItemsSource="{Binding Materials}" SelectedItem="{Binding SelectedMaterial}"
                        DisplayMemberPath="DisplayName" Height="40" />
              <TextBox Grid.Column="2"
                       Text="{Binding LineQuantity, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource PlainDecimalConverter}, ConverterParameter=PositiveQuantity}"
                       Height="40"
                       ToolTip="Số lượng/trọng lượng: dùng 0.023 hoặc 0,023; không ngăn cách hàng nghìn." />
              <Button Grid.Column="4" Content="Thêm dòng" Command="{Binding AddLineCommand}"
                      Style="{DynamicResource PrimaryButtonStyle}" MinHeight="40" />
            </Grid>
            <DataGrid ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}"
                      AutoGenerateColumns="False" IsReadOnly="True" Height="190" Margin="0,8,0,0">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Mã NVL" Binding="{Binding Code, Mode=OneWay}" Width="110" />
                <DataGridTextColumn Header="Tên NVL" Binding="{Binding Name, Mode=OneWay}" Width="*" />
                <DataGridTextColumn Header="ĐVT" Binding="{Binding UnitCode, Mode=OneWay}" Width="80" />
                <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity, Mode=OneWay, StringFormat=N4}" Width="110" />
              </DataGrid.Columns>
            </DataGrid>
            <Button Content="Xóa dòng" Command="{Binding RemoveLineCommand}" HorizontalAlignment="Left"
                    Style="{DynamicResource NavButtonStyle}" MinHeight="40" Margin="0,8,0,0" />
          </StackPanel>
        </Border>

        <TextBlock Text="Ghi chú" Margin="0,12,0,4" Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="64"
                 AcceptsReturn="True" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
