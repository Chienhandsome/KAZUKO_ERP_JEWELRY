<Window x:Class="Kazuko.Modules.Warehouse.WarehouseGoldPriceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bảng giá vàng kho"
        Width="900" Height="620" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Hủy" Style="{DynamicResource NavButtonStyle}" Command="{Binding CancelCommand}"
                    MinHeight="40" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="Lưu bảng giá kho" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding SaveCommand}"
                    MinHeight="40" IsDefault="True" />
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Bảng giá vàng kho" FontSize="{DynamicResource FontSize.Heading}"
                           FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Đơn vị: VND/chỉ. Loại vàng lấy từ danh mục GOLD_TYPES (thêm loại mới ở Tỉ giá). Chỉnh giá kho tại đây không đổi giá bán lẻ."
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>

            <DataGrid Grid.Row="1" ItemsSource="{Binding Prices}" AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False" Margin="0,12,0,0"
                      FontSize="{DynamicResource FontSize.Subtitle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã" Binding="{Binding GoldCode}" Width="100" IsReadOnly="True" />
                    <DataGridTextColumn Header="Loại vàng" Binding="{Binding GoldName}" Width="*" IsReadOnly="True" />
                    <DataGridTextColumn Header="Giá kho / chỉ" Binding="{Binding IssuePricePerChi, UpdateSourceTrigger=LostFocus, StringFormat=N0}" Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="HorizontalContentAlignment" Value="Right" />
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Mua lẻ tham chiếu" Binding="{Binding RetailBuyPricePerChi, StringFormat=N0}" Width="150" IsReadOnly="True" />
                    <DataGridTextColumn Header="Bán lẻ tham chiếu" Binding="{Binding RetailSellPricePerChi, StringFormat=N0}" Width="150" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <TextBlock Text="Ghi chú thay đổi" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="56"
                         AcceptsReturn="True" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
