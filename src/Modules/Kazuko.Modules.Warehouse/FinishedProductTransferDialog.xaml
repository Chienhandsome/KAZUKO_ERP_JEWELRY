<Window x:Class="Kazuko.Modules.Warehouse.FinishedProductTransferDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nhập từ kho thành phẩm"
        Width="980" Height="760" MinWidth="800" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Hủy" Style="{DynamicResource NavButtonStyle}" Command="{Binding CancelCommand}"
              MinHeight="40" Margin="0,0,8,0" IsCancel="True" />
      <Button Content="Ghi sổ chuyển kho" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding SaveCommand}"
              MinHeight="40" IsDefault="True" />
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="Chuyển thành phẩm sang Kho bán hàng"
                   FontSize="{DynamicResource FontSize.Heading}"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="Mỗi dòng là một sản phẩm/serial riêng biệt."
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />

        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Kho thành phẩm" Foreground="{DynamicResource TextSecondaryBrush}" />
            <ComboBox ItemsSource="{Binding SourceLocations}" SelectedItem="{Binding SourceLocation}"
                      DisplayMemberPath="DisplayName" Height="40" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Kho bán hàng" Foreground="{DynamicResource TextSecondaryBrush}" />
            <ComboBox ItemsSource="{Binding DestinationLocations}" SelectedItem="{Binding DestinationLocation}"
                      DisplayMemberPath="DisplayName" Height="40" />
          </StackPanel>
        </Grid>

        <Border Style="{DynamicResource CardBorderStyle}" Padding="12" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="Thành phẩm đang có trong kho đã chọn"
                       FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                       Height="40" VerticalContentAlignment="Center"
                       ToolTip="Tìm theo serial, tên sản phẩm hoặc loại vàng" />
              <Button Grid.Column="2" Content="Thêm món đang chọn" Command="{Binding AddProductCommand}"
                      Style="{DynamicResource PrimaryButtonStyle}" MinHeight="40" />
            </Grid>
            <DataGrid ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}"
                      AutoGenerateColumns="False" IsReadOnly="True" Height="210" Margin="0,8,0,0"
                      SelectionMode="Single" SelectionUnit="FullRow">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Serial" Binding="{Binding Code, Mode=OneWay}" Width="155" />
                <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding ProductName, Mode=OneWay}" Width="*" />
                <DataGridTextColumn Header="Loại vàng" Binding="{Binding GoldPurity, Mode=OneWay}" Width="110" />
                <DataGridTextColumn Header="Giá trị" Binding="{Binding StockValue, Mode=OneWay, StringFormat={}{0:N0} VND}" Width="125" />
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusCode, Mode=OneWay}" Width="100" />
              </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="Các thành phẩm sẽ chuyển" Margin="0,12,0,0"
                       FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
            <DataGrid ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}"
                      AutoGenerateColumns="False" IsReadOnly="True" Height="170" Margin="0,8,0,0">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Serial" Binding="{Binding Code, Mode=OneWay}" Width="130" />
                <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding ProductName, Mode=OneWay}" Width="*" />
                <DataGridTextColumn Header="Loại vàng" Binding="{Binding GoldPurity, Mode=OneWay}" Width="100" />
                <DataGridTextColumn Header="Vị trí hiện tại" Binding="{Binding LocationName, Mode=OneWay}" Width="150" />
              </DataGrid.Columns>
            </DataGrid>
            <Button Content="Xóa sản phẩm" Command="{Binding RemoveProductCommand}" HorizontalAlignment="Left"
                    Style="{DynamicResource NavButtonStyle}" MinHeight="40" Margin="0,8,0,0" />
          </StackPanel>
        </Border>

        <TextBlock Text="Ghi chú" Margin="0,12,0,4" Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="64"
                 AcceptsReturn="True" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
