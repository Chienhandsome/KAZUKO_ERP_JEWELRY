<Window x:Class="Kazuko.Modules.Warehouse.FinishedProductTransferDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Kazuko.Modules.Warehouse.Converters"
        Title="Yêu cầu xuất kho bán hàng"
        Width="980" Height="760" MinWidth="800" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/WarehouseResources.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <conv:NullOrEmptyToVisibilityConverter x:Key="NotNullToVis" Invert="True" />
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Hủy"
              Style="{StaticResource WhOutlineButtonStyle}"
              Command="{Binding CancelCommand}"
              MinWidth="100"
              Margin="0,0,8,0"
              IsCancel="True" />
      <Button Content="Gửi yêu cầu"
              Style="{StaticResource WhPrimaryButtonStyle}"
              Command="{Binding SaveCommand}"
              MinWidth="160"
              IsDefault="True" />
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="Yêu cầu xuất kho bán hàng"
                   FontSize="{DynamicResource FontSize.Heading}"
                   FontWeight="Bold"
                   Foreground="{DynamicResource PrimaryBrush}" />
        <TextBlock Text="Gửi yêu cầu chuyển thành phẩm sang Kho bán hàng. Hàng vẫn ở Kho thành phẩm đến khi BH duyệt."
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="{DynamicResource FontSize.Body}"
                   TextWrapping="Wrap"
                   Margin="0,4,0,12" />
        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="{DynamicResource DangerBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVis}}" />

        <Border Style="{DynamicResource CardBorderStyle}" Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Kho nguồn / đích" Style="{StaticResource WhSectionHeaderStyle}" Margin="0,0,0,12" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Kho thành phẩm *" Style="{StaticResource WhFieldLabelStyle}" />
                <ComboBox ItemsSource="{Binding SourceLocations}"
                          SelectedItem="{Binding SourceLocation}"
                          DisplayMemberPath="DisplayName"
                          Style="{StaticResource WhComboStyle}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Kho bán hàng *" Style="{StaticResource WhFieldLabelStyle}" />
                <ComboBox ItemsSource="{Binding DestinationLocations}"
                          SelectedItem="{Binding DestinationLocation}"
                          DisplayMemberPath="DisplayName"
                          Style="{StaticResource WhComboStyle}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border Style="{DynamicResource CardBorderStyle}" Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Thành phẩm đang có trong kho đã chọn"
                       Style="{StaticResource WhSectionHeaderStyle}"
                       Margin="0,0,0,12" />

            <DockPanel Margin="0,0,0,10" LastChildFill="True">
              <Button DockPanel.Dock="Right"
                      Content="Thêm món đang chọn"
                      Command="{Binding AddProductCommand}"
                      Style="{StaticResource WhPrimaryButtonStyle}"
                      MinWidth="170"
                      Margin="8,0,0,0" />
              <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                       Style="{StaticResource WhRoundedTextBoxStyle}"
                       ToolTip="Tìm theo serial, tên sản phẩm hoặc loại vàng">
                <TextBox.InputBindings>
                  <KeyBinding Key="Return" Command="{Binding AddProductCommand}" />
                </TextBox.InputBindings>
              </TextBox>
            </DockPanel>

            <DataGrid ItemsSource="{Binding Candidates}"
                      SelectedItem="{Binding SelectedCandidate}"
                      Style="{StaticResource WhDataGridStyle}"
                      ColumnHeaderStyle="{StaticResource WhDataGridColumnHeaderStyle}"
                      Height="210"
                      Margin="0,0,0,12">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Serial" Binding="{Binding Code, Mode=OneWay}" Width="155" />
                <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding ProductName, Mode=OneWay}" Width="*" />
                <DataGridTextColumn Header="Nhóm" Binding="{Binding ProductGroupName, Mode=OneWay}" Width="110" />
                <DataGridTextColumn Header="Loại vàng" Binding="{Binding GoldPurity, Mode=OneWay}" Width="110" />
                <DataGridTextColumn Header="Giá trị" Binding="{Binding StockValue, Mode=OneWay, StringFormat={}{0:N0} VND}" Width="125" />
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusCode, Mode=OneWay}" Width="100" />
              </DataGrid.Columns>
            </DataGrid>

            <DockPanel Margin="0,0,0,8" LastChildFill="False">
              <Button DockPanel.Dock="Right"
                      Content="Xóa sản phẩm"
                      Command="{Binding RemoveProductCommand}"
                      Style="{StaticResource WhOutlineButtonStyle}"
                      MinWidth="120"
                      Margin="0"
                      HorizontalAlignment="Right" />
              <TextBlock Text="Các thành phẩm trên yêu cầu"
                         Style="{StaticResource WhSectionHeaderStyle}"
                         VerticalAlignment="Center" />
            </DockPanel>

            <DataGrid ItemsSource="{Binding Lines}"
                      SelectedItem="{Binding SelectedLine}"
                      Style="{StaticResource WhDataGridStyle}"
                      ColumnHeaderStyle="{StaticResource WhDataGridColumnHeaderStyle}"
                      Height="170">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Serial" Binding="{Binding Code, Mode=OneWay}" Width="130" />
                <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding ProductName, Mode=OneWay}" Width="*" />
                <DataGridTextColumn Header="Nhóm" Binding="{Binding ProductGroupName, Mode=OneWay}" Width="110" />
                <DataGridTextColumn Header="Loại vàng" Binding="{Binding GoldPurity, Mode=OneWay}" Width="100" />
                <DataGridTextColumn Header="Vị trí hiện tại" Binding="{Binding LocationName, Mode=OneWay}" Width="150" />
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </Border>

        <Border Style="{DynamicResource CardBorderStyle}" Padding="16">
          <StackPanel>
            <TextBlock Text="Ghi chú" Style="{StaticResource WhSectionHeaderStyle}" Margin="0,0,0,8" />
            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource WhRoundedTextBoxStyle}"
                     MinHeight="72"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     Padding="12,10" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
