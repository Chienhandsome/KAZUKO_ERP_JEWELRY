<Window x:Class="Kazuko.Modules.Warehouse.ExternalWorkerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:grid="clr-namespace:Kazuko.Shared.UI.DataGridLayout;assembly=Kazuko.Shared.UI"
             xmlns:access="clr-namespace:Kazuko.Shared.UI.Behaviors;assembly=Kazuko.Shared.UI"
        Title="Danh mục thợ ngoài"
        Width="920" Height="640" MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <DockPanel Margin="16">
        <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button access:PermissionAccess.Rule="CAT_EXTERNAL_WORKERS:Add" Content="Thêm mới" Command="{Binding NewCommand}"
                    Style="{DynamicResource FormPrimaryButtonStyle}" Margin="0,0,8,4" />
            <Button access:PermissionAccess.Rule="CAT_EXTERNAL_WORKERS:Edit" Content="Sửa" Command="{Binding EditCommand}"
                    Style="{DynamicResource FormSecondaryButtonStyle}" Margin="0,0,8,4" />
            <Button access:PermissionAccess.Rule="CAT_EXTERNAL_WORKERS:Delete" Content="Xóa" Command="{Binding DeleteCommand}"
                    ToolTip="Ngừng hoạt động thợ ngoài" Style="{DynamicResource FormSecondaryButtonStyle}" Margin="0,0,8,4" />
            <Button Content="Chọn" Command="{Binding ChooseCommand}" Visibility="{Binding CanChoose, Converter={StaticResource BoolToVisibility}}"
                    Style="{DynamicResource FormSecondaryButtonStyle}" Margin="0,0,8,4" />
            <Button Content="Đóng" Style="{DynamicResource FormSecondaryButtonStyle}" Command="{Binding CloseCommand}"
                    IsCancel="True" Margin="0,0,0,4" />
        </WrapPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" MinWidth="320" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" MinWidth="280" />
                </Grid.ColumnDefinitions>

                <DockPanel IsEnabled="{Binding CanBrowse}">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <CheckBox DockPanel.Dock="Right" Content="Chỉ đang hoạt động"
                                  IsChecked="{Binding ActiveOnly}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource FormTextBoxStyle}"
                                 AutomationProperties.Name="Lọc theo tên, mã, số điện thoại hoặc MST"
                                 VerticalContentAlignment="Center" />
                    </DockPanel>
                    <DataGrid grid:DataGridColumnLayout.EnableHeaderMenu="True" grid:DataGridColumnLayout.SettingsKey="warehouse.ExternalWorkerDialog.Workers" ItemsSource="{Binding Workers}" SelectedItem="{Binding SelectedWorker}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              SelectionMode="Single" FontSize="{DynamicResource FontSize.Body}">
                        <DataGrid.Columns>
                            <DataGridTextColumn grid:DataGridColumnLayout.Key="Code" Header="Mã" Binding="{Binding Code}" Width="90" />
                            <DataGridTextColumn grid:DataGridColumnLayout.Key="Name" Header="Tên" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn grid:DataGridColumnLayout.Key="Phone" Header="Điện thoại" Binding="{Binding Phone}" Width="110" />
                            <DataGridTextColumn grid:DataGridColumnLayout.Key="StatusDisplay" Header="TT" Binding="{Binding StatusDisplay}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <Border Grid.Column="2" Style="{DynamicResource CardBorderStyle}" Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Chi tiết thợ" FontSize="{DynamicResource FontSize.Subtitle}"
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                            <TextBlock Text="Mã *" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Style="{DynamicResource FormTextBoxStyle}" IsReadOnly="{Binding AreFieldsReadOnly}" Text="{Binding EditCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" MinHeight="{DynamicResource SingleLineFieldMinHeight}" />
                            <TextBlock Text="Tên *" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Style="{DynamicResource FormTextBoxStyle}" IsReadOnly="{Binding AreFieldsReadOnly}" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" MinHeight="{DynamicResource SingleLineFieldMinHeight}" />
                            <TextBlock Text="Điện thoại" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Style="{DynamicResource FormTextBoxStyle}" IsReadOnly="{Binding AreFieldsReadOnly}" Text="{Binding EditPhone, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" MinHeight="{DynamicResource SingleLineFieldMinHeight}" />
                            <TextBlock Text="Địa chỉ" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Style="{DynamicResource FormTextBoxStyle}" IsReadOnly="{Binding AreFieldsReadOnly}" Text="{Binding EditAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" MinHeight="{DynamicResource SingleLineFieldMinHeight}" />
                            <TextBlock Text="MST / CCCD" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Style="{DynamicResource FormTextBoxStyle}" IsReadOnly="{Binding AreFieldsReadOnly}" Text="{Binding EditIdTaxNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" MinHeight="{DynamicResource SingleLineFieldMinHeight}" />
                            <TextBlock Text="Thông tin thanh toán" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Style="{DynamicResource FormTextBoxStyle}" IsReadOnly="{Binding AreFieldsReadOnly}" Text="{Binding EditPaymentInfo, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" MinHeight="{DynamicResource SingleLineFieldMinHeight}" />
                            <TextBlock Text="Ghi chú" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Style="{DynamicResource FormTextBoxStyle}" IsReadOnly="{Binding AreFieldsReadOnly}" Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                                     Height="64" AcceptsReturn="True" TextWrapping="Wrap" />
                            <CheckBox Content="Đang hoạt động" IsChecked="{Binding EditIsActive}"
                                      IsEnabled="{Binding CanReactivate}" Margin="0,0,0,12" />
                            <WrapPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                                <Button access:PermissionAccess.Rule="CAT_EXTERNAL_WORKERS:Add|CAT_EXTERNAL_WORKERS:Edit" Content="Lưu"
                                        Style="{DynamicResource FormPrimaryButtonStyle}" Command="{Binding SaveCommand}" IsDefault="True"
                                        Margin="0,0,8,4" />
                                <Button Content="Hủy sửa" Style="{DynamicResource FormSecondaryButtonStyle}"
                                        Command="{Binding CancelEditCommand}" Margin="0,0,0,4" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <TextBlock Grid.Row="2" Text="{Binding HoldingsSummary}" Margin="0,12,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
        </Grid>
    </DockPanel>
</Window>
