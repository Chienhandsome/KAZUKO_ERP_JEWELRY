<Window x:Class="Kazuko.Modules.Warehouse.ExternalWorkerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:access="clr-namespace:Kazuko.Shared.UI.Behaviors;assembly=Kazuko.Shared.UI"
        Title="Danh mục thợ ngoài"
        Width="920" Height="640" MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Đóng" Style="{DynamicResource NavButtonStyle}" Command="{Binding CloseCommand}"
                    MinHeight="40" IsCancel="True" />
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Danh mục thợ ngoài" FontSize="{DynamicResource FontSize.Heading}"
                           FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Dùng cho lệnh sản xuất OUTSOURCED và luồng giao NVL thợ ngoài. Nút theo dõi NVL giao thợ là danh sách tồn đang ở thợ, không phải danh mục này."
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" MinWidth="320" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" MinWidth="280" />
                </Grid.ColumnDefinitions>

                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Tìm" Style="{DynamicResource PrimaryButtonStyle}"
                                Command="{Binding SearchCommand}" MinHeight="36" MinWidth="72" Margin="8,0,0,0" />
                        <CheckBox DockPanel.Dock="Right" Content="Chỉ đang hoạt động"
                                  IsChecked="{Binding ActiveOnly}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" MinHeight="36"
                                 VerticalContentAlignment="Center" />
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Workers}" SelectedItem="{Binding SelectedWorker}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              SelectionMode="Single" FontSize="{DynamicResource FontSize.Body}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="90" />
                            <DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Điện thoại" Binding="{Binding Phone}" Width="110" />
                            <DataGridTextColumn Header="TT" Binding="{Binding StatusDisplay}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <Border Grid.Column="2" Style="{DynamicResource CardBorderStyle}" Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Chi tiết thợ" FontSize="{DynamicResource FontSize.Subtitle}"
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                            <TextBlock Text="Mã *" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Text="{Binding EditCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" MinHeight="36" />
                            <TextBlock Text="Tên *" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" MinHeight="36" />
                            <TextBlock Text="Điện thoại" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Text="{Binding EditPhone, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" MinHeight="36" />
                            <TextBlock Text="Địa chỉ" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Text="{Binding EditAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" MinHeight="36" />
                            <TextBlock Text="MST / CCCD" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Text="{Binding EditIdTaxNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" MinHeight="36" />
                            <TextBlock Text="Thông tin thanh toán" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Text="{Binding EditPaymentInfo, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" MinHeight="36" />
                            <TextBlock Text="Ghi chú" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                                     Height="64" AcceptsReturn="True" TextWrapping="Wrap" />
                            <CheckBox Content="Đang hoạt động" IsChecked="{Binding EditIsActive}" Margin="0,0,0,12" />
                            <StackPanel Orientation="Horizontal">
                                <Button access:PermissionAccess.Rule="CAT_EXTERNAL_WORKERS:Add" Content="Thêm mới" Style="{DynamicResource NavButtonStyle}"
                                        Command="{Binding NewCommand}" MinHeight="40" Margin="0,0,8,0" />
                                <Button access:PermissionAccess.Rule="CAT_EXTERNAL_WORKERS:Add|CAT_EXTERNAL_WORKERS:Edit" Content="Lưu" Style="{DynamicResource PrimaryButtonStyle}"
                                        Command="{Binding SaveCommand}" MinHeight="40" IsDefault="True" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <TextBlock Grid.Row="2" Text="{Binding HoldingsSummary}" Margin="0,12,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
        </Grid>
    </DockPanel>
</Window>
