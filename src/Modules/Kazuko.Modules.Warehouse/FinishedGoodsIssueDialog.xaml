<Window x:Class="Kazuko.Modules.Warehouse.FinishedGoodsIssueDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xuất thành phẩm theo đơn"
        Width="900" Height="700" MinWidth="760" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Hủy" Style="{DynamicResource NavButtonStyle}" Command="{Binding CancelCommand}"
              MinHeight="40" Margin="0,0,8,0" IsCancel="True" />
      <Button Content="Ghi sổ xuất thành phẩm" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding SaveCommand}"
              MinHeight="40" IsDefault="True" />
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="Xuất thành phẩm theo đơn" FontSize="{DynamicResource FontSize.Heading}"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="Chỉ xuất kho (serial → Đã bán). Thu phần còn của đơn đặt thực hiện ở Bán hàng → tab Đơn đặt."
                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />

        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Đơn bán / đơn đặt" Foreground="{DynamicResource TextSecondaryBrush}" />
            <ComboBox ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}"
                      DisplayMemberPath="DisplayName" Height="40" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Kho/vị trí xuất" Foreground="{DynamicResource TextSecondaryBrush}" />
            <ComboBox ItemsSource="{Binding Locations}" SelectedItem="{Binding SourceLocation}"
                      DisplayMemberPath="DisplayName" Height="40" />
          </StackPanel>
        </Grid>

        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Người giao" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBox Text="{Binding DeliveredByName, UpdateSourceTrigger=PropertyChanged}" Height="40" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Người nhận" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBox Text="{Binding ReceivedByName, UpdateSourceTrigger=PropertyChanged}" Height="40" />
          </StackPanel>
        </Grid>

        <Border Style="{DynamicResource CardBorderStyle}" Padding="12" Margin="0,12,0,0">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ComboBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}"
                        DisplayMemberPath="Code" Height="40" ToolTip="Chọn serial thuộc đơn" />
              <Button Grid.Column="2" Content="Thêm sản phẩm" Command="{Binding AddProductCommand}"
                      Style="{DynamicResource PrimaryButtonStyle}" MinHeight="40" />
            </Grid>
            <DataGrid ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}"
                      AutoGenerateColumns="False" IsReadOnly="True" Height="260" Margin="0,8,0,0">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Serial" Binding="{Binding Code, Mode=OneWay}" Width="130" />
                <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding ProductName, Mode=OneWay}" Width="*" />
                <DataGridTextColumn Header="Nhóm" Binding="{Binding ProductGroupName, Mode=OneWay}" Width="110" />
                <DataGridTextColumn Header="Loại vàng" Binding="{Binding GoldPurity, Mode=OneWay}" Width="100" />
                <DataGridTextColumn Header="Vị trí" Binding="{Binding LocationName, Mode=OneWay}" Width="150" />
              </DataGrid.Columns>
            </DataGrid>
            <Button Content="Xóa sản phẩm" Command="{Binding RemoveProductCommand}" HorizontalAlignment="Left"
                    Style="{DynamicResource NavButtonStyle}" MinHeight="40" Margin="0,8,0,0" />
          </StackPanel>
        </Border>

        <TextBlock Text="Ghi chú" Margin="0,12,0,4" Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="64"
                 AcceptsReturn="True" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
