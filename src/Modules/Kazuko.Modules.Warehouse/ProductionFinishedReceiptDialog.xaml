<Window x:Class="Kazuko.Modules.Warehouse.ProductionFinishedReceiptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:Kazuko.Shared.UI.Behaviors;assembly=Kazuko.Shared.UI"
        xmlns:conv="clr-namespace:Kazuko.Modules.Warehouse.Converters"
        Title="Nhập kho thành phẩm" Width="1520" Height="920"
        MinWidth="1300" MinHeight="820" WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}">
  <Window.InputBindings>
    <KeyBinding Key="F1" Command="{Binding AddCommand}" />
    <KeyBinding Key="F2" Command="{Binding EditCommand}" />
    <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
    <KeyBinding Key="Enter" Command="{Binding SaveCommand}" />
    <KeyBinding Key="P" Modifiers="Control" Command="{Binding PrintReceiptCommand}" />
  </Window.InputBindings>
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/WarehouseResources.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
      <conv:BooleanToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
      <conv:NullOrEmptyToVisibilityConverter x:Key="NotNullToVis" Invert="True" />
      <conv:AlternationIndexToSttConverter x:Key="SttConverter" />
      <conv:ObjectEqualsConverter x:Key="ObjectEqualsConverter" />

      <Style x:Key="ReceiptFormLabelStyle" TargetType="TextBlock"
             BasedOn="{StaticResource WhFieldLabelStyle}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>

      <Style x:Key="ReceiptFieldStyle" TargetType="TextBox"
             BasedOn="{StaticResource WhRoundedTextBoxStyle}">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="10,4" />
      </Style>

      <Style x:Key="ReceiptReadonlyFieldStyle" TargetType="TextBox"
             BasedOn="{StaticResource WhReadonlyFieldStyle}">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="10,4" />
      </Style>

      <Style x:Key="ReceiptComboStyle" TargetType="ComboBox"
             BasedOn="{StaticResource WhComboStyle}">
        <Setter Property="MinHeight" Value="30" />
      </Style>

      <Style x:Key="ReceiptGridHeaderStyle" TargetType="DataGridColumnHeader"
             BasedOn="{StaticResource WhDataGridColumnHeaderStyle}">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>

      <Style x:Key="ReceiptBadgeStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="140" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="{Binding ErrorMessage}"
               Foreground="{DynamicResource DangerBrush}"
               TextWrapping="Wrap"
               Margin="0,0,0,8"
               Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVis}}" />

    <!-- 1. Form nhập: 3 cột + panel ảnh -->
    <Grid Grid.Row="1" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="300" />
      </Grid.ColumnDefinitions>

      <!-- Cột 1: định danh / phân loại -->
      <StackPanel Grid.Column="0">
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Lệnh sản xuất:" Style="{StaticResource ReceiptFormLabelStyle}" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding Orders}"
                    SelectedItem="{Binding SelectedOrder}"
                    Style="{StaticResource ReceiptComboStyle}"
                    ToolTip="Chỉ hiển thị lệnh đã hoàn thành và chưa nhập kho.">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Code}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Ngày nhập:" Style="{StaticResource ReceiptFormLabelStyle}" />
          <DatePicker Grid.Column="1" SelectedDate="{Binding ReceiptDate}" MinHeight="30"
                      VerticalContentAlignment="Center" />
        </Grid>
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Kho nhập:" Style="{StaticResource ReceiptFormLabelStyle}" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding Locations}"
                    SelectedItem="{Binding SelectedLocation}"
                    DisplayMemberPath="DisplayName"
                    Style="{StaticResource ReceiptComboStyle}" />
        </Grid>
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Nhóm hàng:" Style="{StaticResource ReceiptFormLabelStyle}" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding ProductGroups}"
                    SelectedItem="{Binding SelectedProductGroup}"
                    DisplayMemberPath="Name"
                    Style="{StaticResource ReceiptComboStyle}" />
          <Button Grid.Column="3" Content="Thêm"
                  Command="{Binding CreateProductGroupCommand}"
                  Style="{StaticResource WhOutlineButtonStyle}"
                  MinHeight="30" Padding="12,4"
                  ToolTip="Thêm nhóm hàng mới" />
        </Grid>
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Mặt hàng/Tên SP:" Style="{StaticResource ReceiptFormLabelStyle}" />
          <TextBox Grid.Column="1" Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}"
                   Style="{StaticResource ReceiptFieldStyle}" />
        </Grid>
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Loại vàng:" Style="{StaticResource ReceiptFormLabelStyle}"
                     ToolTip="Loại / tuổi vàng (GOLD_TYPES)" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding GoldPurityChoices}"
                    Text="{Binding GoldPurityCode, UpdateSourceTrigger=PropertyChanged}"
                    IsEditable="True"
                    IsTextSearchEnabled="True"
                    Style="{StaticResource ReceiptComboStyle}"
                    ToolTip="Chọn loại/tuổi vàng (750, 999…)" />
        </Grid>
        <Grid Margin="0,0,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Nhà cung cấp:" Style="{StaticResource ReceiptFormLabelStyle}" />
          <ComboBox Grid.Column="1" IsEditable="True"
                    ItemsSource="{Binding SupplierChoices}"
                    Text="{Binding SupplierName, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource ReceiptComboStyle}" />
        </Grid>
      </StackPanel>

      <!-- Cột 2: trọng lượng / số lượng / giá -->
      <StackPanel Grid.Column="2">
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="TL tổng (chỉ):" Style="{StaticResource ReceiptFormLabelStyle}" />
          <TextBox Grid.Column="1" Text="{Binding TotalWeightText, UpdateSourceTrigger=PropertyChanged}"
                   Style="{StaticResource ReceiptFieldStyle}" />
        </Grid>
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="TL đá (chỉ):" Style="{StaticResource ReceiptFormLabelStyle}" />
          <TextBox Grid.Column="1" Text="{Binding StoneWeightText, UpdateSourceTrigger=PropertyChanged}"
                   Style="{StaticResource ReceiptFieldStyle}" />
        </Grid>
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="TL vàng (chỉ):" Style="{StaticResource ReceiptFormLabelStyle}" />
          <TextBox Grid.Column="1" Text="{Binding GoldWeightText, UpdateSourceTrigger=PropertyChanged}"
                   Style="{StaticResource ReceiptFieldStyle}"
                   ToolTip="Tự tính = TL tổng − TL đá, có thể sửa tay." />
        </Grid>
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Số lượng (món):" Style="{StaticResource ReceiptFormLabelStyle}" />
          <TextBox Grid.Column="1" Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                   Style="{StaticResource ReceiptFieldStyle}"
                   behaviors:NumericThousandSeparatorBehavior.EnableLiveThousandSeparator="True"
                   ToolTip="Số lượng = N sẽ thêm N dòng, mỗi dòng 1 mã riêng." />
        </Grid>
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Giá vốn (VND):" Style="{StaticResource ReceiptFormLabelStyle}" />
          <TextBox Grid.Column="1" Text="{Binding CostPriceText, UpdateSourceTrigger=PropertyChanged}"
                   Style="{StaticResource ReceiptFieldStyle}"
                             behaviors:NumericThousandSeparatorBehavior.EnableLiveThousandSeparator="True" />
        </Grid>
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Giá bán (VND):" Style="{StaticResource ReceiptFormLabelStyle}" />
          <TextBox Grid.Column="1" Text="{Binding SalePriceText, UpdateSourceTrigger=PropertyChanged}"
                   Style="{StaticResource ReceiptFieldStyle}"
                             behaviors:NumericThousandSeparatorBehavior.EnableLiveThousandSeparator="True" />
        </Grid>
      </StackPanel>

      <!-- Cột 3: công / mã / ghi chú -->
      <StackPanel Grid.Column="4">
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Công bán (VND):" Style="{StaticResource ReceiptFormLabelStyle}" />
          <TextBox Grid.Column="1" Text="{Binding SaleLaborCostText, UpdateSourceTrigger=PropertyChanged}"
                   Style="{StaticResource ReceiptFieldStyle}"
                   behaviors:NumericThousandSeparatorBehavior.EnableLiveThousandSeparator="True" />
        </Grid>
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Công nhập (VND):" Style="{StaticResource ReceiptFormLabelStyle}" />
          <TextBox Grid.Column="1" Text="{Binding PurchaseLaborCostText, UpdateSourceTrigger=PropertyChanged}"
                   Style="{StaticResource ReceiptFieldStyle}"
                   behaviors:NumericThousandSeparatorBehavior.EnableLiveThousandSeparator="True" />
        </Grid>
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Mã hiệu:" Style="{StaticResource ReceiptFormLabelStyle}" />
          <TextBox Grid.Column="1" Text="{Binding ModelCode, UpdateSourceTrigger=PropertyChanged}"
                   Style="{StaticResource ReceiptFieldStyle}" />
        </Grid>
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Ký hiệu:" Style="{StaticResource ReceiptFormLabelStyle}" />
          <TextBox Grid.Column="1" Text="{Binding SymbolCode, UpdateSourceTrigger=PropertyChanged}"
                   Style="{StaticResource ReceiptFieldStyle}" />
        </Grid>
        <CheckBox Content="Tạo mã riêng cho từng món"
                  IsChecked="{Binding GenerateSeparateCodes}"
                  Margin="0,2,0,8" VerticalContentAlignment="Center" />
        <TextBlock Text="Ghi chú:" Style="{StaticResource WhFieldLabelStyle}" Margin="0,0,0,4" />
        <TextBox Text="{Binding FormNotes, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource ReceiptFieldStyle}"
                 MinHeight="72" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalContentAlignment="Top" Padding="10,6" />
      </StackPanel>

      <!-- Cột 4: Hình ảnh sản phẩm -->
      <Border Grid.Column="6"
              Style="{DynamicResource CardBorderStyle}"
              Padding="12"
              VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="Hình ảnh sản phẩm"
                     Style="{StaticResource WhSectionHeaderStyle}"
                     Foreground="{DynamicResource PrimaryBrush}"
                     FontWeight="SemiBold"
                     Margin="0,0,0,10" />

          <Border Height="210"
                  Background="{DynamicResource SurfaceAltBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  ClipToBounds="True">
            <Grid>
              <Image Source="{Binding SelectedImage.ImagePath, Mode=OneWay, Converter={StaticResource PathToImageSourceConverter}}"
                     Stretch="Uniform"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Margin="8"
                     RenderOptions.BitmapScalingMode="HighQuality"
                     Visibility="{Binding HasImages, Converter={StaticResource BoolToVis}}" />
              <TextBlock Text="Chưa có hình ảnh"
                         Style="{StaticResource WhFieldLabelStyle}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Visibility="{Binding HasImages, Converter={StaticResource InverseBoolToVis}}" />
            </Grid>
          </Border>

          <ScrollViewer Margin="0,10,0,0"
                        Height="64"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding ImageItems}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Width="64" Height="64"
                          Margin="0,0,8,0"
                          CornerRadius="6"
                          ClipToBounds="True"
                          Cursor="Hand"
                          BorderThickness="2"
                          Background="{DynamicResource SurfaceBrush}"
                          ToolTip="{Binding FileName}">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <Border.InputBindings>
                      <MouseBinding MouseAction="LeftClick"
                                    Command="{Binding DataContext.SelectImageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                    </Border.InputBindings>
                    <Image Source="{Binding ImagePath, Mode=OneWay, Converter={StaticResource PathToImageSourceConverter}}"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>
    </Grid>

    <!-- 2. Thanh nút action -->
    <DockPanel Grid.Row="2" Margin="0,0,0,12" LastChildFill="False">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
        <Button Content="+ Thêm (F1)"
                Command="{Binding AddCommand}"
                Style="{StaticResource WhPrimaryButtonStyle}"
                MinWidth="130" MinHeight="40" Margin="0,0,8,0" />
        <Button Content="Sửa (F2)"
                Command="{Binding EditCommand}"
                Style="{StaticResource WhOutlineButtonStyle}"
                MinWidth="110" MinHeight="40" Margin="0,0,8,0" />
        <Button Content="Xóa (Delete)"
                Command="{Binding DeleteCommand}"
                Style="{StaticResource WhOutlineButtonStyle}"
                MinWidth="130" MinHeight="40" Margin="0,0,8,0" />
        <Button Content="Lưu in (Enter)"
                Command="{Binding SaveCommand}"
                Style="{StaticResource WhPrimaryButtonStyle}"
                MinWidth="140" MinHeight="40" Margin="0,0,8,0" />
        <Button Content="Hủy"
                Command="{Binding CancelEditCommand}"
                Style="{StaticResource WhOutlineButtonStyle}"
                MinWidth="80" MinHeight="40" Margin="0,0,8,0"
                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" />
        <Button Content="Hủy"
                Command="{Binding CancelCommand}"
                Style="{StaticResource WhOutlineButtonStyle}"
                MinWidth="80" MinHeight="40"
                IsCancel="True" />
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="In lại tem"
                Command="{Binding PrintLabelCommand}"
                Style="{StaticResource WhOutlineButtonStyle}"
                MinWidth="110" MinHeight="40" Margin="8,0,0,0" />
        <Button Content="In phiếu (Ctrl+P)"
                Command="{Binding PrintReceiptCommand}"
                Style="{StaticResource WhOutlineButtonStyle}"
                MinWidth="150" MinHeight="40" Margin="8,0,0,0" />
      </StackPanel>
    </DockPanel>

    <!-- 3. DataGrid sản phẩm -->
    <Border Grid.Row="3" Style="{DynamicResource CardBorderStyle}" Padding="0">
      <DataGrid ItemsSource="{Binding Products}"
                SelectedItem="{Binding SelectedProduct}"
                AlternationCount="1000000"
                Style="{StaticResource WhEditableDataGridStyle}"
                IsReadOnly="True"
                ColumnHeaderStyle="{StaticResource ReceiptGridHeaderStyle}"
                Margin="8">
        <DataGrid.Columns>
          <DataGridTextColumn Header="#" Width="40"
                              Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=AlternationIndex, Converter={StaticResource SttConverter}}" />
          <DataGridTemplateColumn Header="" Width="36">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                          IsHitTestVisible="False" Focusable="False">
                  <CheckBox.IsChecked>
                    <MultiBinding Converter="{StaticResource ObjectEqualsConverter}" Mode="OneWay">
                      <Binding />
                      <Binding Path="DataContext.SelectedProduct"
                               RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                    </MultiBinding>
                  </CheckBox.IsChecked>
                </CheckBox>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Ngày" Width="90"
                              Binding="{Binding DataContext.ReceiptDate, RelativeSource={RelativeSource AncestorType=DataGrid}, StringFormat=dd/MM/yyyy}" />
          <DataGridTextColumn Header="Mã vạch" Binding="{Binding BarcodeValue}" Width="90" />
          <DataGridTextColumn Header="Nhóm" Binding="{Binding ProductGroup, TargetNullValue=—}" Width="80" />
          <DataGridTextColumn Header="Loại vàng" Binding="{Binding GoldPurityCode, TargetNullValue=—}" Width="80" />
          <DataGridTextColumn Header="Mặt hàng" Binding="{Binding ProductName}" Width="*" MinWidth="150" />
          <DataGridTextColumn Header="TL V+H" Binding="{Binding TotalWeight, StringFormat=0.###}"
                              Width="80" ElementStyle="{StaticResource WhRightAlignTextStyle}" />
          <DataGridTextColumn Header="TL hột" Binding="{Binding StoneWeight, StringFormat=0.###}"
                              Width="70" ElementStyle="{StaticResource WhRightAlignTextStyle}" />
          <DataGridTextColumn Header="TL vàng" Binding="{Binding GoldWeight, StringFormat=0.###}"
                              Width="80" ElementStyle="{StaticResource WhRightAlignTextStyle}" />
          <DataGridTextColumn Header="Công bán" Binding="{Binding SaleLaborCost, StringFormat=N0, TargetNullValue=—}"
                              Width="100" ElementStyle="{StaticResource WhRightAlignTextStyle}" />
          <DataGridTextColumn Header="Công nhập" Binding="{Binding PurchaseLaborCost, StringFormat=N0, TargetNullValue=—}"
                              Width="100" ElementStyle="{StaticResource WhRightAlignTextStyle}" />
          <DataGridTextColumn Header="Nhà cung cấp" Binding="{Binding SupplierName, TargetNullValue=—}" Width="110" />
          <DataGridTextColumn Header="Ghi chú" Binding="{Binding Notes, TargetNullValue=—}" Width="120" />
          <DataGridTextColumn Header="Giá nhập" Binding="{Binding CostPrice, StringFormat=N0, TargetNullValue=—}"
                              Width="110" ElementStyle="{StaticResource WhRightAlignTextStyle}" />
          <DataGridTemplateColumn Header="" Width="110">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Style="{StaticResource ReceiptBadgeStyle}">
                  <TextBlock Text="Chờ kiểm tra"
                             Foreground="{DynamicResource OnPrimaryBrush}"
                             FontSize="{DynamicResource FontSize.Caption}" />
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <!-- 4. Footer tổng -->
    <Grid Grid.Row="4" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}" Padding="10" Margin="0,0,8,0">
        <StackPanel>
          <TextBlock Text="TL tổng" Style="{StaticResource WhFieldLabelStyle}" />
          <TextBlock Text="{Binding FooterTotalWeightText, Mode=OneWay}"
                     FontWeight="Bold" FontSize="{DynamicResource FontSize.Subtitle}"
                     Foreground="{DynamicResource PrimaryBrush}" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Style="{DynamicResource CardBorderStyle}" Padding="10" Margin="0,0,8,0">
        <StackPanel>
          <TextBlock Text="TL vàng" Style="{StaticResource WhFieldLabelStyle}" />
          <TextBlock Text="{Binding FooterGoldWeightText, Mode=OneWay}"
                     FontWeight="Bold" FontSize="{DynamicResource FontSize.Subtitle}"
                     Foreground="{DynamicResource PrimaryBrush}" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Style="{DynamicResource CardBorderStyle}" Padding="10" Margin="0,0,8,0">
        <StackPanel>
          <TextBlock Text="TL đá" Style="{StaticResource WhFieldLabelStyle}" />
          <TextBlock Text="{Binding FooterStoneWeightText, Mode=OneWay}"
                     FontWeight="Bold" FontSize="{DynamicResource FontSize.Subtitle}"
                     Foreground="{DynamicResource PrimaryBrush}" />
        </StackPanel>
      </Border>
      <Border Grid.Column="3" Style="{DynamicResource CardBorderStyle}" Padding="10" Margin="0,0,8,0">
        <StackPanel>
          <TextBlock Text="Số lượng" Style="{StaticResource WhFieldLabelStyle}" />
          <TextBlock Text="{Binding FooterLineCountText, Mode=OneWay}"
                     FontWeight="Bold" FontSize="{DynamicResource FontSize.Subtitle}"
                     Foreground="{DynamicResource PrimaryBrush}" />
        </StackPanel>
      </Border>
      <Border Grid.Column="4" Style="{DynamicResource CardBorderStyle}" Padding="10" Margin="0,0,8,0">
        <StackPanel>
          <TextBlock Text="Tổng giá vốn" Style="{StaticResource WhFieldLabelStyle}" />
          <TextBlock Text="{Binding FooterCostPriceText, Mode=OneWay}"
                     FontWeight="Bold" FontSize="{DynamicResource FontSize.Subtitle}"
                     Foreground="{DynamicResource PrimaryBrush}" />
        </StackPanel>
      </Border>
      <Border Grid.Column="5" Style="{DynamicResource CardBorderStyle}" Padding="10" Margin="0,0,8,0">
        <StackPanel>
          <TextBlock Text="Tổng tiền" Style="{StaticResource WhFieldLabelStyle}" />
          <TextBlock Text="{Binding FooterSalePriceText, Mode=OneWay}"
                     FontWeight="Bold" FontSize="{DynamicResource FontSize.Subtitle}"
                     Foreground="{DynamicResource PrimaryBrush}" />
        </StackPanel>
      </Border>
      <Button Grid.Column="6" Content="Đối chiếu vàng"
              Command="{Binding OpenReconcileCommand}"
              Style="{StaticResource WhOutlineButtonStyle}"
              MinWidth="150" MinHeight="64" Margin="8,0,0,0"
              FontSize="{DynamicResource FontSize.Subtitle}" FontWeight="SemiBold"
              ToolTip="Mở đối chiếu vàng đã giao / đã nhận, ghi công nợ thợ." />
      <Button Grid.Column="7" Content="✓ ĐÃ KIỂM TRA"
              Command="{Binding SaveCommand}"
              Style="{StaticResource WhPrimaryButtonStyle}"
              MinWidth="180" MinHeight="64" Margin="8,0,0,0"
              FontSize="{DynamicResource FontSize.Subtitle}" FontWeight="Bold" />
    </Grid>
  </Grid>
</Window>
