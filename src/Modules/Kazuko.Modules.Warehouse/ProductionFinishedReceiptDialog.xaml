<Window x:Class="Kazuko.Modules.Warehouse.ProductionFinishedReceiptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nhập kho thành phẩm" Width="920" Height="710"
        MinWidth="760" MinHeight="560" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Hủy" Style="{DynamicResource NavButtonStyle}" Command="{Binding CancelCommand}"
                    MinHeight="40" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="Nhập kho toàn bộ" Style="{DynamicResource PrimaryButtonStyle}"
                    Command="{Binding SaveCommand}" MinHeight="40" IsDefault="True" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Nhập kho thành phẩm từ lệnh sản xuất"
                           FontSize="{DynamicResource FontSize.Heading}"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Chọn lệnh đã hoàn thành. Thông tin sản phẩm được lấy từ kết quả QC của lệnh."
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,12" />
                <TextBlock Text="Lệnh sản xuất" Foreground="{DynamicResource TextSecondaryBrush}" />
                <ComboBox ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}"
                          DisplayMemberPath="Code" MinHeight="40" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap" Margin="0,8,0,0" />
                <Border Style="{DynamicResource CardBorderStyle}" Padding="12" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Ngày lập lệnh" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding ProductionDate}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,12" />
                            <TextBlock Text="Loại sản xuất" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding ProductionType}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,12" />
                            <TextBlock Text="Đơn đặt" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding SalesOrderCode}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,12" />
                            <TextBlock Text="Nhà cung cấp" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding Supplier}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,12" />
                            <TextBlock Text="Kho nhập" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding FinishedLocation}" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Số sản phẩm" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding ProductCount}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,12" />
                            <TextBlock Text="Tổng trọng lượng vàng" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding TotalGoldWeight}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,12" />
                            <TextBlock Text="Ghi chú" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding Notes}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock Text="Sản phẩm sẽ nhập" FontSize="{DynamicResource FontSize.Subtitle}"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,16,0,8" />
                <DataGrid ItemsSource="{Binding Products}" AutoGenerateColumns="False" IsReadOnly="True"
                          Height="270">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Sản phẩm" Binding="{Binding ModelName, Mode=OneWay}" Width="*" />
                        <DataGridTextColumn Header="Món thứ" Binding="{Binding UnitNumber, Mode=OneWay}" Width="85" />
                        <DataGridTextColumn Header="Loại vàng" Binding="{Binding GoldPurityCode, Mode=OneWay}" Width="110" />
                        <DataGridTextColumn Header="TL vàng (chỉ)" Binding="{Binding ActualGoldWeight, Mode=OneWay, StringFormat=0.###}" Width="120" />
                        <DataGridTextColumn Header="Công chế tác" Binding="{Binding LaborCostSnapshot, Mode=OneWay, StringFormat=N0}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
