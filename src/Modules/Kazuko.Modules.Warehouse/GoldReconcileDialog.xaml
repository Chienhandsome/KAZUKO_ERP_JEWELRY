<Window x:Class="Kazuko.Modules.Warehouse.GoldReconcileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Kazuko.Modules.Warehouse.Converters"
        Title="Đối chiếu vàng" Width="760" Height="560"
        MinWidth="680" MinHeight="480" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/WarehouseResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
      <conv:NullOrEmptyToVisibilityConverter x:Key="NotNullToVis" Invert="True" />

      <Style x:Key="ReconcileMetricCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Margin" Value="0,0,10,0" />
      </Style>

      <Style x:Key="ReconcileMetricLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
      </Style>

      <Style x:Key="ReconcileMetricValueStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Heading}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,4,0,0" />
      </Style>

      <Style x:Key="ReconcileHeaderStyle" TargetType="DataGridColumnHeader"
             BasedOn="{StaticResource WhDataGridColumnHeaderStyle}">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="160" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="Đối chiếu vàng"
                 Style="{StaticResource WhSectionHeaderStyle}"
                 FontSize="{DynamicResource FontSize.Heading}" />
      <TextBlock Text="So sánh vàng đã giao với vàng đã nhận. Hao hụt nhập tay; phần còn lại ghi công nợ thợ."
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 FontSize="{DynamicResource FontSize.Caption}"
                 TextWrapping="Wrap"
                 Margin="0,4,0,0" />
    </StackPanel>

    <!-- Metric summary -->
    <UniformGrid Grid.Row="1" Rows="1" Columns="3" Margin="0,0,0,14">
      <Border Style="{StaticResource ReconcileMetricCardStyle}">
        <StackPanel>
          <TextBlock Text="Đã giao (chỉ)" Style="{StaticResource ReconcileMetricLabelStyle}" />
          <TextBlock Text="{Binding TotalIssuedGold, StringFormat={}{0:0.###}}"
                     Style="{StaticResource ReconcileMetricValueStyle}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource ReconcileMetricCardStyle}">
        <StackPanel>
          <TextBlock Text="Đã nhận (chỉ)" Style="{StaticResource ReconcileMetricLabelStyle}" />
          <TextBlock Text="{Binding TotalReceivedGold, StringFormat={}{0:0.###}}"
                     Style="{StaticResource ReconcileMetricValueStyle}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource ReconcileMetricCardStyle}" Margin="0">
        <StackPanel>
          <TextBlock Text="Tổng nợ (chỉ)" Style="{StaticResource ReconcileMetricLabelStyle}" />
          <TextBlock Text="{Binding TotalDebtGoldDisplay}"
                     Style="{StaticResource ReconcileMetricValueStyle}"
                     Foreground="{DynamicResource DangerBrush}" />
        </StackPanel>
      </Border>
    </UniformGrid>

    <!-- Reconcile grid -->
    <Border Grid.Row="2"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="0"
            ClipToBounds="True">
      <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
          <TextBlock Text="Chi tiết theo loại vàng"
                     FontWeight="SemiBold"
                     FontSize="{DynamicResource FontSize.Body}"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
        </Border>
        <DataGrid ItemsSource="{Binding GoldReconcileRows}"
                  Style="{StaticResource WhEditableDataGridStyle}"
                  ColumnHeaderStyle="{StaticResource ReconcileHeaderStyle}"
                  BorderThickness="0"
                  MinHeight="140">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Loại vàng"
                                Binding="{Binding PurityDisplay, Mode=OneWay}"
                                IsReadOnly="True" Width="*" MinWidth="100" />
            <DataGridTextColumn Header="Đã giao (chỉ)"
                                Binding="{Binding IssuedWeight, Mode=OneWay, StringFormat={}{0:0.###}}"
                                IsReadOnly="True" Width="120">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock" BasedOn="{StaticResource WhRightAlignTextStyle}" />
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="Đã nhận (chỉ)"
                                Binding="{Binding ReceivedWeight, Mode=OneWay, StringFormat={}{0:0.###}}"
                                IsReadOnly="True" Width="120">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock" BasedOn="{StaticResource WhRightAlignTextStyle}" />
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTemplateColumn Header="Hao hụt (chỉ)" Width="130">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBox Text="{Binding LossWeightText, UpdateSourceTrigger=PropertyChanged}"
                           Style="{StaticResource WhMoneyBoxStyle}"
                           ToolTip="Nhân viên tự gõ. Hao hụt không ghi công nợ." />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Nợ (chỉ)"
                                Binding="{Binding DebtDisplay, Mode=OneWay}"
                                IsReadOnly="True" Width="120">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock" BasedOn="{StaticResource WhRightAlignTextStyle}">
                  <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
          </DataGrid.Columns>
        </DataGrid>
        <!-- Đá đã giao (tham khảo, không tham gia đối chiếu): ẩn khi không có. -->
        <TextBlock DockPanel.Dock="Bottom"
                   Text="{Binding IssuedStoneSummaryText}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="{DynamicResource FontSize.Caption}"
                   FontStyle="Italic"
                   Margin="14,8"
                   TextWrapping="Wrap"
                   Visibility="{Binding IssuedStoneSummaryText, Converter={StaticResource NotNullToVis}}" />
      </DockPanel>
    </Border>

    <!-- Worker -->
    <Border Grid.Row="3"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14,12"
            Margin="0,14,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="220" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Thợ ghi công nợ" Style="{StaticResource WhFieldLabelStyle}" />
          <ComboBox ItemsSource="{Binding WorkerOptions}"
                    SelectedItem="{Binding SelectedWorker}"
                    Style="{StaticResource WhComboStyle}"
                    MinHeight="36"
                    ToolTip="Chọn thợ để ghi công nợ khi còn nợ vàng.">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock>
                  <Run Text="{Binding FullName, Mode=OneWay}" />
                  <Run Text=" (" Foreground="{DynamicResource TextSecondaryBrush}" />
                  <Run Text="{Binding EmployeeCode, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" />
                  <Run Text=")" Foreground="{DynamicResource TextSecondaryBrush}" />
                </TextBlock>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <Border Grid.Column="2"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,8"
                VerticalAlignment="Bottom"
                MinHeight="36">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Công thức" Style="{StaticResource ReconcileMetricLabelStyle}" />
            <TextBlock Text="Nợ = Giao − Nhận − Hao hụt"
                       FontSize="{DynamicResource FontSize.Caption}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontWeight="SemiBold"
                       Margin="0,2,0,0"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- Footer -->
    <DockPanel Grid.Row="4" Margin="0,16,0,0" LastChildFill="True">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="Ghi công nợ"
                Command="{Binding RecordDebtCommand}"
                Style="{StaticResource WhPrimaryButtonStyle}"
                MinWidth="140" MinHeight="40" Margin="0,0,8,0"
                IsDefault="True" />
        <Button Content="Đóng"
                Click="CloseButton_OnClick"
                Style="{StaticResource WhOutlineButtonStyle}"
                MinWidth="100" MinHeight="40" Margin="0"
                IsCancel="True" />
      </StackPanel>
      <TextBlock Text="{Binding ReconcileMessage}"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 FontSize="{DynamicResource FontSize.Caption}"
                 TextWrapping="Wrap"
                 VerticalAlignment="Center"
                 Margin="0,0,16,0"
                 Visibility="{Binding ReconcileMessage, Converter={StaticResource NotNullToVis}}" />
    </DockPanel>
  </Grid>
</Window>
