<Window x:Class="Kazuko.Modules.Warehouse.LabelPrintDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="In tem nữ trang"
        Width="520" SizeToContent="Height" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/LabelDialogResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Hủy" Style="{StaticResource WhOutlineButtonStyle}"
              Command="{Binding CancelCommand}" MinHeight="40" IsCancel="True" Margin="0,0,8,0" />
      <Button Content="In" Style="{StaticResource WhPrimaryButtonStyle}"
              Command="{Binding PrintCommand}" MinHeight="40" IsDefault="True" />
    </StackPanel>

    <StackPanel>
      <TextBlock Text="In tem nữ trang"
                 FontSize="{DynamicResource FontSize.Subtitle}"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 Margin="0,0,0,4" />
      <TextBlock Text="{Binding SummaryText}"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 FontSize="{DynamicResource FontSize.Caption}"
                 TextWrapping="Wrap"
                 Margin="0,0,0,12" />

      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="150" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Máy in" Style="{StaticResource WhFieldLabelStyle}" />
        <TextBlock Grid.Row="0" Grid.Column="2" Text="Lệch dọc (mm)" Style="{StaticResource WhFieldLabelStyle}" />
        <ComboBox Grid.Row="1" Grid.Column="0"
                  ItemsSource="{Binding Printers}"
                  SelectedItem="{Binding SelectedPrinter}"
                  MinHeight="40" Margin="0,4,0,0" />
        <TextBox Grid.Row="1" Grid.Column="2"
                 Text="{Binding VerticalOffsetText, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="40" Margin="0,4,0,0"
                 ToolTip="Số dương đẩy nội dung xuống, số âm kéo lên. Từ -20 đến 20." />
        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                   Text="Khổ tem 86 × 12 mm, lề 0. Số dương đẩy nội dung xuống, số âm kéo lên. Nhớ riêng theo từng máy in."
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="{DynamicResource FontSize.Caption}"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0" />
      </Grid>

      <TextBlock Text="Số bản in" Style="{StaticResource WhFieldLabelStyle}" />
      <TextBox Text="{Binding CopiesText, UpdateSourceTrigger=PropertyChanged}"
               MinHeight="40" Margin="0,4,0,0" />

      <TextBlock Text="{Binding ErrorMessage}"
                 Foreground="{DynamicResource DangerBrush}"
                 TextWrapping="Wrap"
                 Margin="0,8,0,0" />
    </StackPanel>
  </DockPanel>
</Window>
