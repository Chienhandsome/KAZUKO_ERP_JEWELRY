<UserControl x:Class="Kazuko.Modules.Authentication.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="LoginLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,8" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        </Style>

        <ControlTemplate x:Key="LoginRoundedTextBoxTemplate" TargetType="TextBox">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10"
                    SnapsToDevicePixels="True">
                <ScrollViewer x:Name="PART_ContentHost"
                              Margin="{TemplateBinding Padding}"
                              VerticalAlignment="Center"
                              Focusable="False" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.72" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="LoginRoundedPasswordTemplate" TargetType="PasswordBox">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10"
                    SnapsToDevicePixels="True">
                <ScrollViewer x:Name="PART_ContentHost"
                              Margin="{TemplateBinding Padding}"
                              VerticalAlignment="Center"
                              Focusable="False" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.72" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="LoginInputStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="12,0,12,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template" Value="{StaticResource LoginRoundedTextBoxTemplate}" />
        </Style>

        <Style x:Key="LoginPasswordStyle" TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="12,0,60,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template" Value="{StaticResource LoginRoundedPasswordTemplate}" />
        </Style>

        <ControlTemplate x:Key="LoginComboToggleTemplate" TargetType="ToggleButton">
            <Border x:Name="Bd"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1.5"
                    CornerRadius="10"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="34" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="1" Background="Transparent">
                        <Path HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M 0 0 L 8 0 L 4 5 Z"
                              Fill="{DynamicResource PrimaryBrush}" />
                    </Border>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.72" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="LoginComboTemplate" TargetType="ComboBox">
            <Grid>
                <ToggleButton x:Name="ToggleButton"
                              Template="{StaticResource LoginComboToggleTemplate}"
                              Focusable="False"
                              ClickMode="Press"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                <ContentPresenter x:Name="ContentSite"
                                  IsHitTestVisible="False"
                                  Margin="12,0,36,0"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                <TextBlock x:Name="Placeholder"
                           Margin="12,0,36,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="—"
                           Visibility="Collapsed"
                           IsHitTestVisible="False" />
                <Popup x:Name="Popup"
                       Placement="Bottom"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       AllowsTransparency="True"
                       Focusable="False"
                       PopupAnimation="Slide">
                    <Border x:Name="DropDownBorder"
                            MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                            MaxHeight="{TemplateBinding MaxDropDownHeight}"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1.5"
                            CornerRadius="10"
                            Margin="0,4,0,0"
                            Padding="2">
                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="HasItems" Value="False">
                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.85" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="LoginComboStyle" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="Template" Value="{StaticResource LoginComboTemplate}" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBd"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="{DynamicResource AppBackgroundBrush}">
        <Grid MinWidth="760" MinHeight="540" Margin="16,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40*" />
                <ColumnDefinition Width="60*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,16,0" Padding="24"
                    Background="{DynamicResource PrimaryBrush}" CornerRadius="26">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Center" Margin="0,0,0,24">
                        <Image Source="/Kazuko.Modules.Authentication;component/Assets/icons/logo.png"
                               Height="124" Margin="0,0,0,16" Stretch="Uniform"
                               HorizontalAlignment="Center" />
                        <TextBlock Text="KAZUKO ERP JEWELRY" Foreground="{DynamicResource OnPrimaryBrush}" FontWeight="Bold"
                                   FontSize="{DynamicResource FontSize.Heading}" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Text="Quản lý xưởng chế tác, bán sỉ, bán lẻ&#x0a;và tài chính ngành trang sức"
                                   Foreground="{DynamicResource OnPrimaryBrush}" Opacity="0.96" Margin="0,8,0,0"
                                   FontSize="{DynamicResource FontSize.Body}" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Text="Hotline: 0917 66 4444" Foreground="{DynamicResource OnPrimaryBrush}" FontWeight="Bold"
                                   Margin="0,14,0,0" FontSize="{DynamicResource FontSize.Subtitle}"
                                   TextAlignment="Center" TextWrapping="Wrap" />
                        <StackPanel Margin="0,20,0,0" HorizontalAlignment="Center">
                            <TextBlock Text="✓  Sản xuất và công đoạn" Foreground="{DynamicResource OnPrimaryBrush}" Margin="0,2"
                                       FontSize="{DynamicResource FontSize.Body}" />
                            <TextBlock Text="✓  Nguyên liệu – kho – giá vàng" Foreground="{DynamicResource OnPrimaryBrush}" Margin="0,2"
                                       FontSize="{DynamicResource FontSize.Body}" />
                            <TextBlock Text="✓  Bán sỉ, bán lẻ, POS" Foreground="{DynamicResource OnPrimaryBrush}" Margin="0,2"
                                       FontSize="{DynamicResource FontSize.Body}" />
                            <TextBlock Text="✓  Công nợ tiền và công nợ vàng" Foreground="{DynamicResource OnPrimaryBrush}" Margin="0,2"
                                       FontSize="{DynamicResource FontSize.Body}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="Giải Pháp Công Nghệ - Nâng Tầm Quản Lý!"
                               Foreground="{DynamicResource OnPrimaryBrush}" Opacity="0.9" FontStyle="Italic"
                               TextAlignment="Center" TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Body}" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Margin="0" Padding="32,24"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                <Grid VerticalAlignment="Center" MaxWidth="400">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="0" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="ĐĂNG NHẬP" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold"
                                   FontSize="{DynamicResource FontSize.Heading}" />
                        <TextBlock Text="Nhập thông tin để truy cập hệ thống" Margin="0,6,0,12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="{DynamicResource FontSize.Body}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,6,0,0">
                        <TextBlock Text="Chi nhánh" Style="{StaticResource LoginLabelStyle}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Branches}"
                                  SelectedItem="{Binding SelectedBranch}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource LoginComboStyle}"
                                  IsEnabled="{Binding IsFormEnabled}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,2,0,0">
                        <TextBlock Text="Tên đăng nhập" Style="{StaticResource LoginLabelStyle}" />
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource LoginInputStyle}"
                                 IsEnabled="{Binding IsFormEnabled}" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,2,0,0">
                        <TextBlock Text="Mật khẩu" Style="{StaticResource LoginLabelStyle}" />
                        <Grid MinHeight="44">
                            <PasswordBox x:Name="PasswordInput"
                                         Style="{StaticResource LoginPasswordStyle}"
                                         PasswordChanged="PasswordBox_OnPasswordChanged"
                                         IsEnabled="{Binding IsFormEnabled}" />
                            <TextBox x:Name="VisiblePasswordInput"
                                     Style="{StaticResource LoginInputStyle}"
                                     Padding="12,0,60,0"
                                     Visibility="Collapsed"
                                     TextChanged="VisiblePassword_OnTextChanged"
                                     IsEnabled="{Binding IsFormEnabled}" />
                            <Button x:Name="PasswordVisibilityButton"
                                    Content="Hiện"
                                    HorizontalAlignment="Right"
                                    Width="56"
                                    Margin="0,1,4,1"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    Foreground="{DynamicResource PrimaryBrush}"
                                    FontWeight="SemiBold"
                                    FontSize="{DynamicResource FontSize.Body}"
                                    Click="PasswordVisibilityButton_OnClick"
                                    IsEnabled="{Binding IsFormEnabled}" />
                        </Grid>
                    </StackPanel>

                    <CheckBox Grid.Row="4"
                              Content="Ghi nhớ tên đăng nhập"
                              Margin="0,10,0,0"
                              IsChecked="{Binding RememberUsername}"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              FontSize="{DynamicResource FontSize.Body}"
                              IsEnabled="{Binding IsFormEnabled}" />

                    <TextBlock Grid.Row="5"
                               Text="Đang tải danh sách chi nhánh..."
                               Margin="0,6,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="{DynamicResource FontSize.Body}"
                               Visibility="{Binding IsLoadingBranches, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Grid.Row="7"
                               Text="{Binding ErrorMessage}"
                               Margin="0,12,0,0" VerticalAlignment="Top"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource DangerBrush}"
                               FontSize="{DynamicResource FontSize.Body}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button Grid.Row="8" Content="ĐĂNG NHẬP" Margin="0,24,0,0"
                            MinHeight="48" Padding="18,12" FontWeight="Bold" IsDefault="True"
                            FontSize="{DynamicResource FontSize.Subtitle}"
                            Background="{DynamicResource PrimaryBrush}"
                            Foreground="{DynamicResource OnPrimaryBrush}" BorderThickness="0"
                            Cursor="Hand" Command="{Binding SignInCommand}"
                            IsEnabled="{Binding IsFormEnabled}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ButtonBorder" CornerRadius="10"
                                        Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                               FontWeight="{TemplateBinding FontWeight}" FontSize="{TemplateBinding FontSize}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.85" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding ConnectionStatusText}"
                               Margin="0,20,0,0" HorizontalAlignment="Center" TextWrapping="Wrap"
                               FontSize="{DynamicResource FontSize.Body}" ToolTip="{Binding ConnectionDetails}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
