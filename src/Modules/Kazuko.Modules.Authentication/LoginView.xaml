<UserControl x:Class="Kazuko.Modules.Authentication.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:local="clr-namespace:Kazuko.Modules.Authentication">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <system:Double x:Key="SingleLineFieldMinHeight">44</system:Double>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="{DynamicResource AppBackgroundBrush}">
        <Grid MinWidth="760" MinHeight="540" Margin="16,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40*" />
                <ColumnDefinition Width="60*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,16,0"
                    Background="{DynamicResource PrimaryBrush}" CornerRadius="26">
                <Grid>
                    <local:LoginBubbleBackground />
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Center" Margin="0,0,0,24">
                        <Image Source="/Kazuko.Modules.Authentication;component/Assets/icons/logo.png"
                               Height="124" Margin="0,0,0,16" Stretch="Uniform"
                               HorizontalAlignment="Center" />
                        <TextBlock Text="KAZUKO ERP JEWELRY" Foreground="{DynamicResource OnPrimaryBrush}" FontWeight="Bold"
                                   FontSize="{DynamicResource FontSize.Heading}" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Text="Quản lý xưởng chế tác, bán sỉ, bán lẻ&#x0a;và tài chính ngành trang sức"
                                   Foreground="{DynamicResource OnPrimaryBrush}" Opacity="0.96" Margin="0,8,0,0"
                                   FontSize="{DynamicResource FontSize.Body}" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Text="Hotline: 0917 66 4444" Foreground="{DynamicResource OnPrimaryBrush}" FontWeight="Bold"
                                   Margin="0,14,0,0" FontSize="{DynamicResource FontSize.Subtitle}"
                                   TextAlignment="Center" TextWrapping="Wrap" />
                        <StackPanel Margin="0,20,0,0" HorizontalAlignment="Center">
                            <TextBlock Text="✓  Sản xuất và công đoạn" Foreground="{DynamicResource OnPrimaryBrush}" Margin="0,2"
                                       FontSize="{DynamicResource FontSize.Body}" />
                            <TextBlock Text="✓  Nguyên liệu – kho – giá vàng" Foreground="{DynamicResource OnPrimaryBrush}" Margin="0,2"
                                       FontSize="{DynamicResource FontSize.Body}" />
                            <TextBlock Text="✓  Bán sỉ, bán lẻ, POS" Foreground="{DynamicResource OnPrimaryBrush}" Margin="0,2"
                                       FontSize="{DynamicResource FontSize.Body}" />
                            <TextBlock Text="✓  Công nợ tiền và công nợ vàng" Foreground="{DynamicResource OnPrimaryBrush}" Margin="0,2"
                                       FontSize="{DynamicResource FontSize.Body}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="Giải Pháp Công Nghệ - Nâng Tầm Quản Lý!"
                               Foreground="{DynamicResource OnPrimaryBrush}" Opacity="0.9" FontStyle="Italic"
                               TextAlignment="Center" TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Body}" />
                </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Margin="0" Padding="32,24"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="22">
                <Grid VerticalAlignment="Center" MaxWidth="400">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="0" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="ĐĂNG NHẬP" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold"
                                   FontSize="{DynamicResource FontSize.Heading}" />
                        <TextBlock Text="Nhập thông tin để truy cập hệ thống" Margin="0,6,0,12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="{DynamicResource FontSize.Body}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,6,0,0">
                        <TextBlock Text="Chi nhánh" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Branches}"
                                  SelectedItem="{Binding SelectedBranch}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource FormSelectionComboBoxStyle}"
                                  IsEnabled="{Binding IsFormEnabled}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,2,0,0">
                        <TextBlock Text="Tên đăng nhập" Style="{StaticResource FormLabelStyle}" />
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 IsEnabled="{Binding IsFormEnabled}" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,2,0,0">
                        <TextBlock Text="Mật khẩu" Style="{StaticResource FormLabelStyle}" />
                        <Grid>
                            <PasswordBox x:Name="PasswordInput"
                                         Style="{StaticResource FormPasswordStyle}"
                                         Padding="12,4,60,4"
                                         PasswordChanged="PasswordBox_OnPasswordChanged"
                                         IsEnabled="{Binding IsFormEnabled}" />
                            <TextBox x:Name="VisiblePasswordInput"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     Padding="12,4,60,4"
                                     Visibility="Collapsed"
                                     TextChanged="VisiblePassword_OnTextChanged"
                                     IsEnabled="{Binding IsFormEnabled}" />
                            <Button x:Name="PasswordVisibilityButton"
                                    Content="Hiện"
                                    HorizontalAlignment="Right"
                                    Width="56"
                                    Margin="0,1,4,1"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    Foreground="{DynamicResource PrimaryBrush}"
                                    FontWeight="SemiBold"
                                    FontSize="{DynamicResource FontSize.Body}"
                                    Click="PasswordVisibilityButton_OnClick"
                                    IsEnabled="{Binding IsFormEnabled}" />
                        </Grid>
                    </StackPanel>

                    <CheckBox Grid.Row="4"
                              Content="Ghi nhớ tên đăng nhập"
                              Margin="0,10,0,0"
                              IsChecked="{Binding RememberUsername}"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              FontSize="{DynamicResource FontSize.Body}"
                              IsEnabled="{Binding IsFormEnabled}" />

                    <TextBlock Grid.Row="5"
                               Text="Đang tải danh sách chi nhánh..."
                               Margin="0,6,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="{DynamicResource FontSize.Body}"
                               Visibility="{Binding IsLoadingBranches, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Grid.Row="7"
                               Text="{Binding ErrorMessage}"
                               Margin="0,12,0,0" VerticalAlignment="Top"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource DangerBrush}"
                               FontSize="{DynamicResource FontSize.Body}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button Grid.Row="8" Content="ĐĂNG NHẬP" Margin="0,24,0,0"
                            Style="{StaticResource FormPrimaryButtonStyle}"
                            MinHeight="48" FontWeight="Bold" IsDefault="True"
                            FontSize="{DynamicResource FontSize.Subtitle}"
                            Command="{Binding SignInCommand}" IsEnabled="{Binding IsFormEnabled}" />
                    <StackPanel Grid.Row="10" Margin="0,6,0,0">
                        <DockPanel Margin="0,14,0,8" LastChildFill="False">
                            <TextBlock Text="Cơ sở dữ liệu" Style="{StaticResource FormLabelStyle}" Margin="0" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ConnectionStatusText}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                       FontSize="{DynamicResource FontSize.Caption}" ToolTip="{Binding ConnectionDetails}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DockPanel>

                        <TextBox Text="{Binding DatabaseFileName, Mode=OneWay}" IsReadOnly="True"
                                 Style="{StaticResource FormTextBoxStyle}" ToolTip="{Binding DatabaseDisplayName}"
                                 AutomationProperties.Name="Cơ sở dữ liệu" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="Chọn DB" Command="{Binding ChooseDatabaseCommand}" Margin="0,0,8,0"
                                    Style="{StaticResource FormSecondaryButtonStyle}" />
                            <Button Content="Tạo mới" Command="{Binding CreateDatabaseCommand}"
                                    Style="{StaticResource FormPrimaryButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
