<UserControl x:Class="Kazuko.Modules.Authentication.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <SolidColorBrush x:Key="LoginBorderBrush" Color="#FFF1D8C7" />
        <SolidColorBrush x:Key="LoginLabelBrush" Color="#FF6B5145" />
        <SolidColorBrush x:Key="LoginMutedBrush" Color="#FF9A796A" />
        <SolidColorBrush x:Key="LoginSuccessBrush" Color="#FF15905A" />

        <Style x:Key="LoginLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource LoginLabelBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,4" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
        </Style>

        <ControlTemplate x:Key="LoginRoundedTextBoxTemplate" TargetType="TextBox">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10"
                    SnapsToDevicePixels="True">
                <ScrollViewer x:Name="PART_ContentHost"
                              Margin="{TemplateBinding Padding}"
                              VerticalAlignment="Center"
                              Focusable="False" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.72" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="LoginRoundedPasswordTemplate" TargetType="PasswordBox">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10"
                    SnapsToDevicePixels="True">
                <ScrollViewer x:Name="PART_ContentHost"
                              Margin="{TemplateBinding Padding}"
                              VerticalAlignment="Center"
                              Focusable="False" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.72" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="LoginInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,0,12,0" />
            <Setter Property="BorderBrush" Value="{StaticResource LoginBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template" Value="{StaticResource LoginRoundedTextBoxTemplate}" />
        </Style>

        <Style x:Key="LoginPasswordStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,0,48,0" />
            <Setter Property="BorderBrush" Value="{StaticResource LoginBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template" Value="{StaticResource LoginRoundedPasswordTemplate}" />
        </Style>

        <ControlTemplate x:Key="LoginComboToggleTemplate" TargetType="ToggleButton">
            <Border x:Name="Bd"
                    Background="White"
                    BorderBrush="{StaticResource LoginBorderBrush}"
                    BorderThickness="1.5"
                    CornerRadius="10"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="34" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="1" Background="Transparent">
                        <Path HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M 0 0 L 8 0 L 4 5 Z"
                              Fill="{DynamicResource PrimaryBrush}" />
                    </Border>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.72" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="LoginComboTemplate" TargetType="ComboBox">
            <Grid>
                <ToggleButton x:Name="ToggleButton"
                              Template="{StaticResource LoginComboToggleTemplate}"
                              Focusable="False"
                              ClickMode="Press"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                <ContentPresenter x:Name="ContentSite"
                                  IsHitTestVisible="False"
                                  Margin="12,0,36,0"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                <TextBlock x:Name="Placeholder"
                           Margin="12,0,36,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource LoginMutedBrush}"
                           Text="—"
                           Visibility="Collapsed"
                           IsHitTestVisible="False" />
                <Popup x:Name="Popup"
                       Placement="Bottom"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       AllowsTransparency="True"
                       Focusable="False"
                       PopupAnimation="Slide">
                    <Border x:Name="DropDownBorder"
                            MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                            MaxHeight="{TemplateBinding MaxDropDownHeight}"
                            Background="White"
                            BorderBrush="{StaticResource LoginBorderBrush}"
                            BorderThickness="1.5"
                            CornerRadius="10"
                            Margin="0,4,0,0"
                            Padding="2">
                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="HasItems" Value="False">
                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.85" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="LoginComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource LoginBorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="Template" Value="{StaticResource LoginComboTemplate}" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="Background" Value="White" />
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBd"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="#FFFFF1E8" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="#FFFFE4D4" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
        <Grid Width="980" Height="560" Background="#FFFFF8F2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="57*" />
                <ColumnDefinition Width="43*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="4,4,14,4" Padding="28,22"
                    Background="{DynamicResource PrimaryBrush}" CornerRadius="26">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Image Grid.Row="0"
                           Source="/Kazuko.Modules.Authentication;component/Assets/icons/logo.png"
                           Height="88" Margin="0,0,0,6" Stretch="Uniform"
                           HorizontalAlignment="Center" />

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="KAZUKO ERP JEWELRY" Foreground="White" FontWeight="Bold"
                                   FontSize="{DynamicResource FontSize.Heading}" TextAlignment="Center" />
                        <TextBlock Text="Quản lý xưởng chế tác, bán sỉ, bán lẻ&#x0a;và tài chính ngành trang sức"
                                   Foreground="White" Opacity="0.96" Margin="0,8,0,0"
                                   FontSize="{DynamicResource FontSize.Body}" TextAlignment="Center" />
                        <TextBlock Text="Hotline: 0917 66 4444" Foreground="White" FontWeight="Bold"
                                   Margin="0,14,0,0" FontSize="{DynamicResource FontSize.Subtitle}"
                                   TextAlignment="Center" />
                        <StackPanel Margin="36,14,0,0">
                            <TextBlock Text="✓  Sản xuất và công đoạn" Foreground="White" Margin="0,2"
                                       FontSize="{DynamicResource FontSize.Caption}" />
                            <TextBlock Text="✓  Nguyên liệu – kho – giá vàng" Foreground="White" Margin="0,2"
                                       FontSize="{DynamicResource FontSize.Caption}" />
                            <TextBlock Text="✓  Bán sỉ, bán lẻ, POS" Foreground="White" Margin="0,2"
                                       FontSize="{DynamicResource FontSize.Caption}" />
                            <TextBlock Text="✓  Công nợ tiền và công nợ vàng" Foreground="White" Margin="0,2"
                                       FontSize="{DynamicResource FontSize.Caption}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="Giải Pháp Công Nghệ - Nâng Tầm Quản Lý!"
                               Foreground="White" Opacity="0.9" FontStyle="Italic"
                               TextAlignment="Center" FontSize="{DynamicResource FontSize.Caption}" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Margin="0,8,8,8" Padding="22,18"
                    Background="White" BorderBrush="#FFF1DDD0" BorderThickness="1" CornerRadius="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="36" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="ĐĂNG NHẬP" FontWeight="Bold"
                                   FontSize="{DynamicResource FontSize.Heading}" />
                        <TextBlock Text="Nhập thông tin để truy cập hệ thống" Margin="0,2,0,0"
                                   Foreground="{StaticResource LoginMutedBrush}"
                                   FontSize="{DynamicResource FontSize.Caption}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,6,0,0">
                        <TextBlock Text="Chi nhánh" Style="{StaticResource LoginLabelStyle}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Branches}"
                                  SelectedItem="{Binding SelectedBranch}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource LoginComboStyle}"
                                  IsEnabled="{Binding IsFormEnabled}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,2,0,0">
                        <TextBlock Text="Tên đăng nhập" Style="{StaticResource LoginLabelStyle}" />
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource LoginInputStyle}"
                                 IsEnabled="{Binding IsFormEnabled}" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,2,0,0">
                        <TextBlock Text="Mật khẩu" Style="{StaticResource LoginLabelStyle}" />
                        <Grid Height="38">
                            <PasswordBox x:Name="PasswordInput"
                                         Style="{StaticResource LoginPasswordStyle}"
                                         PasswordChanged="PasswordBox_OnPasswordChanged"
                                         IsEnabled="{Binding IsFormEnabled}" />
                            <TextBox x:Name="VisiblePasswordInput"
                                     Style="{StaticResource LoginInputStyle}"
                                     Padding="12,0,48,0"
                                     Visibility="Collapsed"
                                     TextChanged="VisiblePassword_OnTextChanged"
                                     IsEnabled="{Binding IsFormEnabled}" />
                            <Button x:Name="PasswordVisibilityButton"
                                    Content="Hiện"
                                    HorizontalAlignment="Right"
                                    Width="48"
                                    Margin="0,1,4,1"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    Foreground="{DynamicResource PrimaryBrush}"
                                    FontWeight="SemiBold"
                                    FontSize="{DynamicResource FontSize.Caption}"
                                    Click="PasswordVisibilityButton_OnClick"
                                    IsEnabled="{Binding IsFormEnabled}" />
                        </Grid>
                    </StackPanel>

                    <CheckBox Grid.Row="4"
                              Content="Ghi nhớ tên đăng nhập"
                              Margin="0,10,0,0"
                              IsChecked="{Binding RememberUsername}"
                              Foreground="{StaticResource LoginLabelBrush}"
                              FontSize="{DynamicResource FontSize.Caption}"
                              IsEnabled="{Binding IsFormEnabled}" />

                    <TextBlock Grid.Row="5"
                               Text="Đang tải danh sách chi nhánh..."
                               Margin="0,6,0,0"
                               Foreground="{StaticResource LoginMutedBrush}"
                               FontSize="{DynamicResource FontSize.Caption}"
                               Visibility="{Binding IsLoadingBranches, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Grid.Row="7"
                               Text="{Binding ErrorMessage}"
                               VerticalAlignment="Top"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxHeight="34"
                               LineStackingStrategy="BlockLineHeight"
                               LineHeight="17"
                               Foreground="{DynamicResource DangerBrush}"
                               FontSize="{DynamicResource FontSize.Caption}" />

                    <Button Grid.Row="8"
                            Content="ĐĂNG NHẬP"
                            Margin="0,4,0,0"
                            Height="42"
                            Style="{DynamicResource PrimaryButtonStyle}"
                            Command="{Binding SignInCommand}"
                            IsEnabled="{Binding IsFormEnabled}" />

                    <StackPanel Grid.Row="10" Margin="0,10,0,0" VerticalAlignment="Bottom">
                        <TextBlock Text="● Máy chủ: Firebird Embedded 5.0.4"
                                   Foreground="{StaticResource LoginSuccessBrush}"
                                   FontSize="{DynamicResource FontSize.Caption}" />
                        <TextBlock Text="● data.fdb"
                                   Foreground="{StaticResource LoginSuccessBrush}"
                                   Margin="0,2,0,0"
                                   FontSize="{DynamicResource FontSize.Caption}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Viewbox>
</UserControl>
