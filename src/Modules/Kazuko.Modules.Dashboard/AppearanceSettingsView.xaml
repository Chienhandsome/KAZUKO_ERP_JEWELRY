<UserControl x:Class="Kazuko.Modules.Dashboard.AppearanceSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Border Width="560" Margin="32" Padding="32"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Style="{DynamicResource CardBorderStyle}">
            <StackPanel>
                <TextBlock Text="CÀI ĐẶT GIAO DIỆN"
                           Foreground="{DynamicResource PrimaryBrush}"
                           FontSize="{DynamicResource FontSize.Heading}"
                           FontWeight="Bold" />
                <TextBlock Text="Tùy chỉnh giao diện cho người dùng trên máy này."
                           Margin="0,6,0,24"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="{DynamicResource FontSize.Body}" />

                <TextBlock Text="Chủ đề" Margin="0,0,0,6" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding Themes}"
                          SelectedItem="{Binding SelectedTheme}"
                          DisplayMemberPath="Label" MinHeight="42" Padding="10,6" />

                <TextBlock Text="Cỡ chữ" Margin="0,20,0,6" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding FontScales}"
                          SelectedItem="{Binding SelectedFontScale}"
                          DisplayMemberPath="Label" MinHeight="42" Padding="10,6" />

                <TextBlock Text="Thay đổi được áp dụng và lưu tự động."
                           Margin="0,22,0,0"
                           Foreground="{DynamicResource SuccessBrush}"
                           FontSize="{DynamicResource FontSize.Caption}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
