<UserControl x:Class="Kazuko.Modules.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             MinWidth="760" MinHeight="560">
    <UserControl.Resources>
        <Style x:Key="HomeTileButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="178" />
            <Setter Property="Margin" Value="12,8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background"
                                        Value="{DynamicResource SurfaceAltBrush}" />
                                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InfoTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryHoverBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Kazuko.Modules.Dashboard;component/Assets/icons/bg.png"
                        Stretch="Fill" />
        </Grid.Background>

        <ScrollViewer x:Name="DashboardScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid MinHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="240" />
                    <RowDefinition Height="*" MinHeight="388" />
                    <RowDefinition Height="130" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="26,18,26,14">
                    <Image Source="/Kazuko.Modules.Dashboard;component/Assets/icons/logo.png"
                           Width="150" Height="122" Stretch="Uniform" />
                    <TextBlock Text="KAZUKO ERP JEWELRY"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource PrimaryBrush}"
                               FontSize="{DynamicResource FontSize.Display}"
                               FontWeight="Bold" />
                    <TextBlock Text="Hệ thống quản lý xưởng chế tác trang sức"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource PrimaryHoverBrush}"
                               FontSize="{DynamicResource FontSize.Heading}"
                               FontStyle="Italic" />
                </StackPanel>

                <ItemsControl Grid.Row="1" Margin="14,0" ItemsSource="{Binding HomeTiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <primitives:UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding NavigateCommand}"
                                    Style="{StaticResource HomeTileButtonStyle}"
                                    ToolTip="{Binding Label, Mode=OneWay}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Image Source="{Binding IconUri, Mode=OneWay, Converter={StaticResource PathToImageSourceConverter}}"
                                           Width="72" Height="66" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Text="{Binding Label, Mode=OneWay}"
                                               Margin="0,8,0,5"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               FontSize="{DynamicResource FontSize.Subtitle}"
                                               FontWeight="Bold" />
                                    <TextBlock Text="{Binding Description, Mode=OneWay}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="{DynamicResource FontSize.Body}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Row="2" Margin="26,14,26,16" Padding="24,14"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource PrimaryBrush}"
                        BorderThickness="1" CornerRadius="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34*" />
                            <ColumnDefinition Width="42*" />
                            <ColumnDefinition Width="24*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="8,0,20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE95B;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="{DynamicResource FontSize.Display}"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="HỖ TRỢ KHÁCH HÀNG" Style="{StaticResource InfoTitleStyle}" />
                                <TextBlock Text="Hotline: 0917.66.4444&#x0a;Hỗ trợ nhanh chóng - Tận tâm phục vụ"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="{DynamicResource FontSize.Caption}" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Column="1" Margin="8,0,20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE707;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="{DynamicResource FontSize.Display}"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="THÔNG TIN DOANH NGHIỆP" Style="{StaticResource InfoTitleStyle}" />
                                <TextBlock Text="KAZUKO ERP JEWELRY&#x0a;925/15 Âu Cơ - Tân Sơn Nhì - Hồ Chí Minh"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="{DynamicResource FontSize.Caption}" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Column="2" Margin="8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="{DynamicResource FontSize.Display}"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="PHIÊN BẢN" Style="{StaticResource InfoTitleStyle}" />
                                <TextBlock Text="{Binding VersionText, Mode=OneWay}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="{DynamicResource FontSize.Caption}" />
                                <TextBlock Text="{Binding UpdatedText, Mode=OneWay}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="{DynamicResource FontSize.Caption}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
