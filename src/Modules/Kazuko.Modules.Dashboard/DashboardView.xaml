<UserControl x:Class="Kazuko.Modules.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             MinWidth="760" MinHeight="560">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="ShortcutSettingsButtonStyle" TargetType="ToggleButton">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="SettingsBorder" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SettingsBorder" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SettingsBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SettingsBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="SettingsBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HomeTileButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="178" />
            <Setter Property="Margin" Value="12,8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background"
                                        Value="{DynamicResource SurfaceAltBrush}" />
                                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InfoTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryHoverBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Kazuko.Modules.Dashboard;component/Assets/icons/bg.png"
                        Stretch="Fill" />
        </Grid.Background>

        <ScrollViewer x:Name="DashboardScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid MinHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="240" />
                    <RowDefinition Height="*" MinHeight="388" />
                    <RowDefinition Height="130" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="26,18,26,14">
                    <Image Source="/Kazuko.Modules.Dashboard;component/Assets/icons/logo.png"
                           Width="150" Height="122" Stretch="Uniform" />
                    <TextBlock Text="KAZUKO ERP JEWELRY"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource PrimaryBrush}"
                               FontSize="{DynamicResource FontSize.Display}"
                               FontWeight="Bold" />
                    <TextBlock Text="Hệ thống quản lý xưởng chế tác trang sức"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource PrimaryHoverBrush}"
                               FontSize="{DynamicResource FontSize.Heading}"
                               FontStyle="Italic" />
                </StackPanel>

                <TextBlock Grid.Row="1" Text="Chưa có shortcut. Chọn Thiết lập để thêm nút trên trang chủ."
                           Margin="26" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource TextSecondaryBrush}"
                           Visibility="{Binding HasNoShortcuts, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl Grid.Row="1" Margin="14,0" ItemsSource="{Binding HomeTiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <primitives:UniformGrid Rows="2" Columns="5" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding NavigateCommand}"
                                    Style="{StaticResource HomeTileButtonStyle}"
                                    ToolTip="{Binding Label, Mode=OneWay}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Image Source="{Binding IconUri, Mode=OneWay, Converter={StaticResource PathToImageSourceConverter}}"
                                           Width="72" Height="66" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Text="{Binding Label, Mode=OneWay}"
                                               Margin="0,8,0,5"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               FontSize="{DynamicResource FontSize.Subtitle}"
                                               FontWeight="Bold" />
                                    <TextBlock Text="{Binding Description, Mode=OneWay}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="{DynamicResource FontSize.Body}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Row="2" Margin="26,14,26,16" Padding="24,14"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource PrimaryBrush}"
                        BorderThickness="1" CornerRadius="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34*" />
                            <ColumnDefinition Width="42*" />
                            <ColumnDefinition Width="24*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="8,0,20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE95B;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="{DynamicResource FontSize.Display}"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="HỖ TRỢ KHÁCH HÀNG" Style="{StaticResource InfoTitleStyle}" />
                                <TextBlock Text="Hotline: 0917.66.4444&#x0a;Hỗ trợ nhanh chóng - Tận tâm phục vụ"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="{DynamicResource FontSize.Caption}" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Column="1" Margin="8,0,20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE707;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="{DynamicResource FontSize.Display}"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="THÔNG TIN DOANH NGHIỆP" Style="{StaticResource InfoTitleStyle}" />
                                <TextBlock Text="KAZUKO ERP JEWELRY&#x0a;925/15 Âu Cơ - Tân Sơn Nhì - Hồ Chí Minh"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="{DynamicResource FontSize.Caption}" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Column="2" Margin="8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="{DynamicResource FontSize.Display}"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="PHIÊN BẢN" Style="{StaticResource InfoTitleStyle}" />
                                <TextBlock Text="{Binding VersionText, Mode=OneWay}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="{DynamicResource FontSize.Caption}" />
                                <TextBlock Text="{Binding UpdatedText, Mode=OneWay}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="{DynamicResource FontSize.Caption}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <Grid x:Name="ShortcutSettingsAnchor" Width="360" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,18,0">
            <ToggleButton x:Name="ShortcutSettingsButton" HorizontalAlignment="Right"
                          Style="{StaticResource ShortcutSettingsButtonStyle}"
                          IsChecked="{Binding IsShortcutSettingsOpen, Mode=TwoWay}"
                          ToolTip="Ẩn/hiện shortcut trang chủ" AutomationProperties.Name="Thiết lập shortcut trang chủ">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryBrush}" />
                    <TextBlock Text="Thiết lập" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}" />
                </StackPanel>
            </ToggleButton>
            <Popup Placement="Bottom" PlacementTarget="{Binding ElementName=ShortcutSettingsAnchor}"
                   Opened="ShortcutSettings_Opened" PreviewKeyDown="ShortcutSettings_PreviewKeyDown"
                   IsOpen="{Binding IsShortcutSettingsOpen, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True">
                <Border Width="360" Margin="0,6,0,0" Padding="16" CornerRadius="10"
                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel KeyboardNavigation.TabNavigation="Cycle">
                        <TextBlock Text="Shortcut trang chủ" FontSize="{DynamicResource FontSize.Subtitle}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ShortcutCountText}" Margin="0,6,0,4"
                                   Foreground="{DynamicResource PrimaryBrush}" FontSize="{DynamicResource FontSize.Body}" />
                        <TextBlock Text="Chọn tối đa 10 nút. Bỏ chọn một nút để chọn thêm. Thay đổi được lưu tự động."
                                   FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />
                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding ShortcutOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanToggle}" Padding="6" Margin="0,2" MinHeight="36"
                                                  VerticalContentAlignment="Center" FontSize="{DynamicResource FontSize.Body}">
                                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="{Binding ShortcutError}" Foreground="{DynamicResource DangerBrush}" FontSize="{DynamicResource FontSize.Caption}" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Grid>
</UserControl>
