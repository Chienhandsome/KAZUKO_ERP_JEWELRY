<UserControl x:Class="Kazuko.Modules.Dashboard.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Kazuko.Shared.UI.Converters;assembly=Kazuko.Shared.UI"
             MinWidth="900" MinHeight="520">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:PathToImageSourceConverter x:Key="PathToImageSourceConverter" />

        <Style x:Key="SettingsCategoryItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="10"
                                BorderThickness="0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background"
                                        Value="{DynamicResource SurfaceAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background"
                                        Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush"
                                        Value="{DynamicResource PrimaryHoverBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="16,20">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <TextBlock Text="CÀI ĐẶT"
                               FontSize="{DynamicResource FontSize.Heading}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryBrush}" />
                    <TextBlock Text="Chọn danh mục bên trái để chỉnh cấu hình."
                               Margin="0,6,0,0"
                               FontSize="{DynamicResource FontSize.Caption}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource SettingsCategoryItemStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}"
                                       FontSize="{DynamicResource FontSize.Body}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="28,24">
                <Grid>
                    <!-- Thông tin chung -->
                    <Border MaxWidth="720"
                            HorizontalAlignment="Left"
                            Style="{DynamicResource CardBorderStyle}"
                            Visibility="{Binding IsGeneralSelected, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="IsEnabled" Value="True" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="Thông tin chung"
                                       FontSize="{DynamicResource FontSize.Subtitle}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryBrush}" />
                            <TextBlock Text="Tên doanh nghiệp, số điện thoại, địa chỉ và logo dùng trên hồ sơ công ty."
                                       Margin="0,6,0,20"
                                       FontSize="{DynamicResource FontSize.Body}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="{DynamicResource DangerBrush}"
                                       FontSize="{DynamicResource FontSize.Body}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="Tên doanh nghiệp *" />
                            <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,14" />

                            <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="Số điện thoại" />
                            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,14" />

                            <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="Địa chỉ" />
                            <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,18"
                                     MinHeight="72"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalContentAlignment="Top"
                                     Padding="12,10" />

                            <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="Logo" />
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Width="120" Height="120"
                                        CornerRadius="12"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="Chưa có logo"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="{DynamicResource FontSize.Caption}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasLogo}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Image Source="{Binding LogoPath, Mode=OneWay, Converter={StaticResource PathToImageSourceConverter}}"
                                               Stretch="Uniform"
                                               Margin="8">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasLogo}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <Button Content="Chọn logo..."
                                            Command="{Binding PickLogoCommand}"
                                            Style="{DynamicResource PrimaryButtonStyle}"
                                            HorizontalAlignment="Left"
                                            MinWidth="140"
                                            Margin="0,0,0,8" />
                                    <Button Content="Xóa logo"
                                            Command="{Binding ClearLogoCommand}"
                                            Style="{DynamicResource NavButtonStyle}"
                                            HorizontalAlignment="Left"
                                            MinWidth="140"
                                            Margin="0" />
                                    <TextBlock Text="Ảnh được copy vào thư mục ứng dụng; xóa file gốc vẫn xem được."
                                               Margin="0,10,0,0"
                                               FontSize="{DynamicResource FontSize.Caption}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                                <Button Content="Lưu"
                                        Command="{Binding SaveCommand}"
                                        Style="{DynamicResource PrimaryButtonStyle}"
                                        MinWidth="120"
                                        Margin="0,0,10,0" />
                                <Button Content="Tải lại"
                                        Command="{Binding ReloadCommand}"
                                        Style="{DynamicResource NavButtonStyle}"
                                        MinWidth="120"
                                        Margin="0" />
                            </StackPanel>

                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="{DynamicResource FontSize.Caption}"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Mẫu in bill (FastReport .frx trong DB) -->
                    <Border MaxWidth="720"
                            HorizontalAlignment="Left"
                            Style="{DynamicResource CardBorderStyle}"
                            Visibility="{Binding IsReceiptTemplateSelected, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Mẫu in bill bán hàng"
                                       FontSize="{DynamicResource FontSize.Subtitle}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryBrush}" />
                            <TextBlock Text="Mẫu A5 ngang/dọc (FastReport Open Source) lưu trong database. Xuất .frx → chỉnh bằng FastReport Designer Community (miễn phí) → Import lại. Khi in phiếu có thể chọn khổ trên hộp xem trước."
                                       Margin="0,6,0,16"
                                       FontSize="{DynamicResource FontSize.Body}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Khổ mẫu:"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ComboBox Width="160"
                                          ItemsSource="{Binding ReceiptTemplateKinds}"
                                          SelectedItem="{Binding SelectedReceiptTemplateKind}"
                                          DisplayMemberPath="Label" />
                            </StackPanel>

                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="{DynamicResource DangerBrush}"
                                       FontSize="{DynamicResource FontSize.Body}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14"
                                    Margin="0,0,0,16">
                                <TextBlock Text="{Binding ReceiptTemplateSummary}"
                                           FontSize="{DynamicResource FontSize.Body}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextWrapping="Wrap" />
                            </Border>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Xuất .frx"
                                        Command="{Binding ExportReceiptTemplateCommand}"
                                        Style="{DynamicResource PrimaryButtonStyle}"
                                        MinWidth="130" Margin="0,0,10,0" />
                                <Button Content="Import .frx"
                                        Command="{Binding ImportReceiptTemplateCommand}"
                                        Style="{DynamicResource NavButtonStyle}"
                                        MinWidth="130" Margin="0,0,10,0" />
                                <Button Content="Tải lại"
                                        Command="{Binding ReloadReceiptTemplateCommand}"
                                        Style="{DynamicResource NavButtonStyle}"
                                        MinWidth="110" />
                            </StackPanel>

                            <TextBlock Text="{Binding StatusMessage}"
                                       Margin="0,14,0,0"
                                       FontSize="{DynamicResource FontSize.Caption}"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Giao diện: giữ DataContext ở StackPanel con để Visibility vẫn bind SettingsViewModel -->
                    <Border MaxWidth="560"
                            HorizontalAlignment="Left"
                            Style="{DynamicResource CardBorderStyle}"
                            Visibility="{Binding IsAppearanceSelected, Converter={StaticResource BoolToVis}}">
                        <StackPanel DataContext="{Binding Appearance}">
                            <TextBlock Text="Giao diện"
                                       FontSize="{DynamicResource FontSize.Subtitle}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryBrush}" />
                            <TextBlock Text="Tùy chỉnh giao diện cho người dùng trên máy này. Thay đổi được áp dụng và lưu tự động."
                                       Margin="0,6,0,24"
                                       FontSize="{DynamicResource FontSize.Body}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />

                            <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="Chủ đề" />
                            <ComboBox ItemsSource="{Binding Themes}"
                                      SelectedItem="{Binding SelectedTheme}"
                                      DisplayMemberPath="Label"
                                      MinHeight="42"
                                      Padding="10,6"
                                      Margin="0,0,0,20" />

                            <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="Cỡ chữ" />
                            <ComboBox ItemsSource="{Binding FontScales}"
                                      SelectedItem="{Binding SelectedFontScale}"
                                      DisplayMemberPath="Label"
                                      MinHeight="42"
                                      Padding="10,6" />
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <Border Background="{DynamicResource AppBackgroundBrush}"
                    Opacity="0.55"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                    IsHitTestVisible="True">
                <TextBlock Text="Đang xử lý..."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSize.Body}"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
