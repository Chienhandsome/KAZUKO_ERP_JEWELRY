<UserControl x:Class="Kazuko.Modules.Dashboard.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:access="clr-namespace:Kazuko.Shared.UI.Behaviors;assembly=Kazuko.Shared.UI"
             xmlns:conv="clr-namespace:Kazuko.Shared.UI.Converters;assembly=Kazuko.Shared.UI"
             MinWidth="900" MinHeight="520">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:PathToImageSourceConverter x:Key="PathToImageSourceConverter" />

        <Style x:Key="PrintTemplateTabStyle" TargetType="TabItem">
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Padding="{TemplateBinding Padding}"
                                Background="Transparent" BorderThickness="0,0,0,3" BorderBrush="Transparent">
                            <TextBlock x:Name="TabHeader" Text="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="TabHeader" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsCategoryItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="10"
                                BorderThickness="0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background"
                                        Value="{DynamicResource SurfaceAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background"
                                        Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
                                <Setter TargetName="ItemBorder" Property="TextBlock.Foreground" Value="{DynamicResource OnPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush"
                                        Value="{DynamicResource PrimaryHoverBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MaxDropDownHeight" Value="320" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboBd"
                                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                CornerRadius="8"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="28" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="Transparent" />
                                                <Path Grid.Column="1"
                                                      Data="M 0 0 L 6 6 L 12 0"
                                                      Stroke="{DynamicResource TextSecondaryBrush}"
                                                      StrokeThickness="1.5"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              Margin="12,0,32,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Margin="0,2,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer Margin="2" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsPrimaryButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True"
                    TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSecondaryButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsMetaLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingsFieldLabelStyle}">
            <Setter Property="Margin" Value="0,0,12,8" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="MinWidth" Value="100" />
        </Style>

        <Style x:Key="SettingsMetaValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="16,20">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <TextBlock Text="CÀI ĐẶT"
                               FontSize="{DynamicResource FontSize.Heading}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryBrush}" />
                    <TextBlock Text="Chọn danh mục bên trái để chỉnh cấu hình."
                               Margin="0,6,0,0"
                               FontSize="{DynamicResource FontSize.Caption}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource SettingsCategoryItemStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}"
                                       FontSize="{DynamicResource FontSize.Body}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="28,24">
                <Grid>
                    <!-- Thông tin chung -->
                    <Border HorizontalAlignment="Stretch"
                            Style="{DynamicResource CardBorderStyle}"
                            Visibility="{Binding IsGeneralSelected, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="IsEnabled" Value="True" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="Thông tin chung"
                                       FontSize="{DynamicResource FontSize.Subtitle}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryBrush}" />
                            <TextBlock Text="Tên doanh nghiệp, số điện thoại, địa chỉ, TCCS và logo. Tem nữ trang in tên doanh nghiệp làm NCC, cùng địa chỉ và TCCS tại đây."
                                       Margin="0,6,0,20"
                                       FontSize="{DynamicResource FontSize.Body}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="{DynamicResource DangerBrush}"
                                       FontSize="{DynamicResource FontSize.Body}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="Tên doanh nghiệp *" />
                            <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingsTextBoxStyle}"
                                     Margin="0,0,0,14" />

                            <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="Số điện thoại" />
                            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingsTextBoxStyle}"
                                     Margin="0,0,0,14" />

                            <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="Địa chỉ" />
                            <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingsTextBoxStyle}"
                                     Margin="0,0,0,18"
                                     MinHeight="72"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalContentAlignment="Top"
                                     Padding="12,10" />

                            <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="TCCS (tiêu chuẩn cơ sở)" />
                            <TextBox Text="{Binding FacilityStandard, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingsTextBoxStyle}"
                                     MaxLength="100"
                                     Margin="0,0,0,18" />

                            <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="Tên nhà phân phối (NPP) trên tem" />
                            <TextBox Text="{Binding DistributorName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBoxStyle}" MaxLength="200" Margin="0,0,0,12" />
                            <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="Địa chỉ NPP" />
                            <TextBox Text="{Binding DistributorAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBoxStyle}" MaxLength="500" Margin="0,0,0,12" />
                            <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="Tên nhà sản xuất (NSX) trên tem" />
                            <TextBox Text="{Binding ManufacturerName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBoxStyle}" MaxLength="200" Margin="0,0,0,12" />
                            <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="Địa chỉ NSX" />
                            <TextBox Text="{Binding ManufacturerAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBoxStyle}" MaxLength="500" Margin="0,0,0,12" />
                            <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="Xuất xứ trên tem" />
                            <TextBox Text="{Binding CountryOfOrigin, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBoxStyle}" MaxLength="100" Margin="0,0,0,18" />

                            <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="Logo" />
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Width="120" Height="120"
                                        CornerRadius="12"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="Chưa có logo"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="{DynamicResource FontSize.Caption}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasLogo}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Image Source="{Binding LogoPath, Mode=OneWay, Converter={StaticResource PathToImageSourceConverter}}"
                                               Stretch="Uniform"
                                               Margin="8">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasLogo}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <Button access:PermissionAccess.Rule="SYS_SETTINGS:Edit" Content="Chọn logo..."
                                            Command="{Binding PickLogoCommand}"
                                            Style="{StaticResource SettingsPrimaryButtonStyle}"
                                            HorizontalAlignment="Left"
                                            MinWidth="140"
                                            Margin="0,0,0,8" />
                                    <Button access:PermissionAccess.Rule="SYS_SETTINGS:Edit" Content="Xóa logo"
                                            Command="{Binding ClearLogoCommand}"
                                            Style="{StaticResource SettingsSecondaryButtonStyle}"
                                            HorizontalAlignment="Left"
                                            MinWidth="140"
                                            Margin="0" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button access:PermissionAccess.Rule="SYS_SETTINGS:Edit" Content="Lưu"
                                        Command="{Binding SaveCommand}"
                                        Style="{StaticResource SettingsPrimaryButtonStyle}"
                                        Margin="0,0,10,0" />
                                <Button Content="Tải lại"
                                        Command="{Binding ReloadCommand}"
                                        Style="{StaticResource SettingsSecondaryButtonStyle}"
                                        Margin="0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Mẫu in (FastReport .frx trong DB): bill bán hàng + tem nữ trang -->
                    <Border HorizontalAlignment="Stretch"
                            Style="{DynamicResource CardBorderStyle}"
                            Visibility="{Binding IsReceiptTemplateSelected, Converter={StaticResource BoolToVis}}">
                        <TabControl x:Name="PrintTemplatesTabs" SelectedIndex="0"
                                    Background="{DynamicResource SurfaceBrush}" BorderThickness="0"
                                    ItemContainerStyle="{StaticResource PrintTemplateTabStyle}">
                            <TabControl.Template>
                                <ControlTemplate TargetType="TabControl">
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                            <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                                        </Border>
                                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="0,20,0,0" />
                                    </DockPanel>
                                </ControlTemplate>
                            </TabControl.Template>
                            <TabItem Header="Mẫu bill">
                                <StackPanel>
                                    <TextBlock Text="Mẫu in bill bán hàng"
                                               FontSize="{DynamicResource FontSize.Subtitle}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryBrush}" />
                                    <TextBlock Text="Xem trước mẫu bill A5 ngang/dọc đã lưu. Bấm &quot;Sửa mẫu bill&quot; để kéo-thả bố cục và chỉnh nội dung trên trình thiết kế."
                                               Margin="0,6,0,16"
                                               FontSize="{DynamicResource FontSize.Body}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" />

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="Khổ mẫu:"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <ComboBox Width="200"
                                                  ItemsSource="{Binding ReceiptTemplateKinds}"
                                                  SelectedItem="{Binding SelectedReceiptTemplateKind}"
                                                  Style="{StaticResource SettingsComboBoxStyle}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <TextBlock Text="{Binding ErrorMessage}"
                                               Foreground="{DynamicResource DangerBrush}"
                                               FontSize="{DynamicResource FontSize.Body}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Border Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="10" Padding="16" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="Xem trước mẫu bill đã lưu · Dữ liệu minh họa"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="{DynamicResource FontSize.Caption}" TextWrapping="Wrap" Margin="0,0,0,12" />
                                            <Image Source="{Binding ReceiptPreview}" Stretch="Uniform" MaxHeight="420"
                                                   HorizontalAlignment="Left" AutomationProperties.Name="Xem trước mẫu bill đã lưu" />
                                            <TextBlock Text="{Binding ReceiptPreviewMessage}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Button Content="Sửa mẫu bill" Command="{Binding OpenReceiptDesignerCommand}"
                                            access:PermissionAccess.Rule="SYS_SETTINGS:Edit"
                                            HorizontalAlignment="Left"
                                            ToolTip="Sửa mẫu đã chọn bằng trình thiết kế kéo-thả"
                                            Style="{StaticResource SettingsPrimaryButtonStyle}" MinWidth="150" />
                                </StackPanel>
                            </TabItem>
                            <TabItem Header="Mẫu tem">
                                <StackPanel>
                                    <TextBlock Text="Mẫu tem nữ trang"
                                               FontSize="{DynamicResource FontSize.Subtitle}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryBrush}" />
                                    <TextBlock Text="Kéo-thả trực quan các khối chữ và mã vạch trên canvas. Bấm &quot;Sửa mẫu tem&quot; để mở trình thiết kế."
                                               Margin="0,6,0,16"
                                               FontSize="{DynamicResource FontSize.Body}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" />

                                    <Border Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="10" Padding="16" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="Xem trước mẫu tem đã lưu · Dữ liệu minh họa"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="{DynamicResource FontSize.Caption}" TextWrapping="Wrap" Margin="0,0,0,12" />
                                            <Image Source="{Binding LabelPreview}" Stretch="Uniform" MaxHeight="180"
                                                   HorizontalAlignment="Left" AutomationProperties.Name="Xem trước mẫu tem đã lưu" />
                                            <TextBlock Text="{Binding LabelPreviewMessage}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <Button access:PermissionAccess.Rule="SYS_SETTINGS:Edit" Content="Sửa mẫu tem"
                                                Command="{Binding OpenLabelDesignerCommand}"
                                                Style="{StaticResource SettingsPrimaryButtonStyle}"
                                                MinWidth="150" />
                                    </StackPanel>
                                <TextBlock Text="{Binding ErrorMessage}" Margin="0,12,0,0"
                                           Foreground="{DynamicResource DangerBrush}" FontSize="{DynamicResource FontSize.Body}"
                                           TextWrapping="Wrap" />
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                    </Border>

                    <!-- Giao diện: giữ DataContext ở StackPanel con để Visibility vẫn bind SettingsViewModel -->
                    <Border HorizontalAlignment="Stretch"
                            Style="{DynamicResource CardBorderStyle}"
                            Visibility="{Binding IsAppearanceSelected, Converter={StaticResource BoolToVis}}">
                        <StackPanel DataContext="{Binding Appearance}">
                            <TextBlock Text="Giao diện"
                                       FontSize="{DynamicResource FontSize.Subtitle}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryBrush}" />
                            <TextBlock Text="Tùy chỉnh giao diện cho người dùng trên máy này. Thay đổi được áp dụng và lưu tự động."
                                       Margin="0,6,0,24"
                                       FontSize="{DynamicResource FontSize.Body}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />

                            <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="Chủ đề" />
                            <ComboBox ItemsSource="{Binding Themes}"
                                      SelectedItem="{Binding SelectedTheme}"
                                      Style="{StaticResource SettingsComboBoxStyle}"
                                      MaxWidth="360"
                                      HorizontalAlignment="Left"
                                      Margin="0,0,0,20">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="Cỡ chữ" />
                            <ComboBox ItemsSource="{Binding FontScales}"
                                      SelectedItem="{Binding SelectedFontScale}"
                                      Style="{StaticResource SettingsComboBoxStyle}"
                                      MaxWidth="360"
                                      HorizontalAlignment="Left">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Cơ sở dữ liệu: chỉ admin mới thấy (DataContext ở StackPanel con để Visibility vẫn bind SettingsViewModel) -->
                    <Border HorizontalAlignment="Stretch"
                            Style="{DynamicResource CardBorderStyle}"
                            Visibility="{Binding IsDatabaseSelected, Converter={StaticResource BoolToVis}}">
                        <StackPanel DataContext="{Binding Database}">

                            <TextBlock Text="Cơ sở dữ liệu"
                                       FontSize="{DynamicResource FontSize.Subtitle}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryBrush}" />
                            <TextBlock Text="Thông tin file dữ liệu hiện tại và các thao tác quản trị. Mọi thao tác đổi/tạo mới đều yêu cầu khởi động lại ứng dụng."
                                       Margin="0,6,0,20"
                                       FontSize="{DynamicResource FontSize.Body}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="{DynamicResource DangerBrush}"
                                       FontSize="{DynamicResource FontSize.Body}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Text="{Binding StatusMessage}"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       FontSize="{DynamicResource FontSize.Body}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16"
                                    Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Đường dẫn" Style="{StaticResource SettingsMetaLabelStyle}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FilePath, Mode=OneWay}"
                                               Style="{StaticResource SettingsMetaValueStyle}" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Dung lượng" Style="{StaticResource SettingsMetaLabelStyle}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FileSize, Mode=OneWay}"
                                               Style="{StaticResource SettingsMetaValueStyle}" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Phiên bản" Style="{StaticResource SettingsMetaLabelStyle}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SchemaVersion, Mode=OneWay}"
                                               Style="{StaticResource SettingsMetaValueStyle}" />
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Chi nhánh" Style="{StaticResource SettingsMetaLabelStyle}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding BranchCount, Mode=OneWay}"
                                               Style="{StaticResource SettingsMetaValueStyle}" />
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Người dùng" Style="{StaticResource SettingsMetaLabelStyle}" Margin="0,0,12,0" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding UserCount, Mode=OneWay}"
                                               Style="{StaticResource SettingsMetaValueStyle}" Margin="0" />
                                </Grid>
                            </Border>

                            <WrapPanel Margin="0,0,0,20">
                                <Button access:PermissionAccess.Rule="SYS_DATABASE:Edit" Content="Thay đổi..."
                                        Command="{Binding ChangeDatabaseCommand}"
                                        Style="{StaticResource SettingsPrimaryButtonStyle}"
                                        MinWidth="130" Margin="0,0,10,0" />
                                <Button access:PermissionAccess.Rule="SYS_DATABASE:Edit" Content="Sao lưu..."
                                        Command="{Binding BackupCommand}"
                                        Style="{StaticResource SettingsSecondaryButtonStyle}"
                                        MinWidth="130" Margin="0,0,10,0" />
                                <Button access:PermissionAccess.Rule="SYS_DATABASE:Edit" Content="Kiểm tra bản sao lưu..."
                                        Command="{Binding VerifyBackupCommand}"
                                        Style="{StaticResource SettingsSecondaryButtonStyle}"
                                        MinWidth="180" Margin="0,0,10,0" />
                                <Button access:PermissionAccess.Rule="SYS_DATABASE:Add" Content="Tạo mới..."
                                        Command="{Binding CreateNewCommand}"
                                        Style="{StaticResource SettingsSecondaryButtonStyle}"
                                        MinWidth="130" Margin="0,0,10,0" />
                                <Button Content="Tải lại"
                                        Command="{Binding ReloadCommand}"
                                        Style="{StaticResource SettingsSecondaryButtonStyle}"
                                        MinWidth="110" />
                            </WrapPanel>

                            <StackPanel Margin="0,0,0,12">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OperationMessage}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ProgressBar IsIndeterminate="True" Height="6" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding OperationMessage}" TextWrapping="Wrap"
                                           FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Button Content="Hủy tác vụ" Command="{Binding CancelBackupCommand}"
                                        Style="{StaticResource SettingsSecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                            </StackPanel>

                            <TextBlock Text="{Binding BackupHistory}" TextWrapping="Wrap" Margin="0,0,0,12"
                                       FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="Bản .fbk được lưu trên máy này. Kiểm tra sẽ khôi phục vào database tạm, không thay database đang dùng. Bấm Tải lại để xem kết quả sao lưu tự động."
                                       TextWrapping="Wrap" Margin="0,0,0,12" FontSize="{DynamicResource FontSize.Caption}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />

                            <CheckBox IsChecked="{Binding AutoBackupEnabled}"
                                      FontSize="{DynamicResource FontSize.Body}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      VerticalContentAlignment="Center">
                                <TextBlock Text="Tự động sao lưu khi khởi động (giữ 7 bản .fbk gần nhất cho mỗi database)" TextWrapping="Wrap" />
                                <CheckBox.Style>
                                    <Style TargetType="CheckBox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </CheckBox.Style>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <Border Background="{DynamicResource AppBackgroundBrush}"
                    Opacity="0.55"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                    IsHitTestVisible="True">
                <TextBlock Text="Đang xử lý..."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSize.Body}"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
