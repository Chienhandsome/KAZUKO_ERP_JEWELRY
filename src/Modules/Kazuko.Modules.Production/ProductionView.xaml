<UserControl x:Class="Kazuko.Modules.Production.ProductionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:access="clr-namespace:Kazuko.Shared.UI.Behaviors;assembly=Kazuko.Shared.UI"
             xmlns:conv="clr-namespace:Kazuko.Modules.Production.Converters"
             xmlns:grid="clr-namespace:Kazuko.Shared.UI.DataGridLayout;assembly=Kazuko.Shared.UI"
             MinWidth="1100" MinHeight="520"
             PreviewKeyDown="UserControl_PreviewKeyDown">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/ProductionResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:NullOrEmptyToVisibilityConverter x:Key="NullToVis" />
            <conv:NullOrEmptyToVisibilityConverter x:Key="NotNullToVis" Invert="True" />
            <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
            <conv:StatusCodeToBrushConverter x:Key="StatusToBrush" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Hàng 1: Filter (trái) + Thẻ trạng thái (phải) -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Panel filter -->
            <Border Grid.Column="0" Style="{StaticResource ProductionCardStyle}" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Cột trái -->
                    <StackPanel Grid.Column="0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Từ ngày" VerticalAlignment="Center"
                                       Style="{StaticResource ProductionFilterLabelStyle}" />
                            <DatePicker Grid.Column="1" SelectedDate="{Binding FromDate}"
                                        VerticalContentAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Đến ngày" VerticalAlignment="Center"
                                       Style="{StaticResource ProductionFilterLabelStyle}" />
                            <DatePicker Grid.Column="1" SelectedDate="{Binding ToDate}"
                                        VerticalContentAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Trạng thái" VerticalAlignment="Center"
                                       Style="{StaticResource ProductionFilterLabelStyle}" />
                            <ComboBox Grid.Column="1"
                                      Style="{StaticResource ProductionFilterComboStyle}"
                                      ItemsSource="{Binding StatusFilterOptions}"
                                      SelectedItem="{Binding SelectedStatusFilter}" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Thợ sản xuất" VerticalAlignment="Center"
                                       Style="{StaticResource ProductionFilterLabelStyle}" />
                            <ComboBox Grid.Column="1"
                                      Style="{StaticResource ProductionFilterComboStyle}"
                                      ItemsSource="{Binding WorkerFilterOptions}"
                                      SelectedItem="{Binding WorkerFilterText}"
                                      ToolTip="Lọc theo thợ sản xuất" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Mã phiếu" VerticalAlignment="Center"
                                       Style="{StaticResource ProductionFilterLabelStyle}" />
                            <TextBox Grid.Column="1"
                                     Style="{StaticResource ProductionFilterFieldStyle}"
                                     Text="{Binding OrderCodeFilterText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Nhập mã phiếu..." />
                        </Grid>
                    </StackPanel>

                    <!-- Cột phải -->
                    <StackPanel Grid.Column="2">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Khách hàng" VerticalAlignment="Center"
                                       Style="{StaticResource ProductionFilterLabelStyle}" />
                            <ComboBox Grid.Column="1"
                                      Style="{StaticResource ProductionFilterComboStyle}"
                                      ItemsSource="{Binding CustomerFilterOptions}"
                                      SelectedItem="{Binding CustomerFilterText}"
                                      ToolTip="Lọc theo khách hàng" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Đơn đặt hàng" VerticalAlignment="Center"
                                       Style="{StaticResource ProductionFilterLabelStyle}" />
                            <ComboBox Grid.Column="1"
                                      Style="{StaticResource ProductionFilterComboStyle}"
                                      ItemsSource="{Binding SalesOrderFilterOptions}"
                                      SelectedItem="{Binding SalesOrderFilterText}"
                                      ToolTip="Lọc theo mã đơn đặt hàng" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,4">
                            <Button Content="Làm mới"
                                    Style="{StaticResource ProductionOutlineButtonStyle}"
                                    Command="{Binding ResetFiltersCommand}"
                                    MinWidth="110" MinHeight="30" />
                        </StackPanel>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Style="{StaticResource ProductionErrorStyle}"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVis}}"
                                   Margin="0,4,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   Style="{StaticResource ProductionHintStyle}"
                                   Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3 thẻ trạng thái -->
            <UniformGrid Grid.Column="2" Rows="1" Columns="3">
                <Border Style="{StaticResource ProductionMetricCardStyle}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Phiếu đang&#x0a;sản xuất" TextAlignment="Center"
                                   Style="{StaticResource ProductionMetricLabelStyle}" />
                        <TextBlock Text="{Binding InProgressCount}"
                                   Style="{StaticResource ProductionMetricValueStyle}"
                                   Foreground="#E8622C" TextAlignment="Center" FontSize="28" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ProductionMetricCardStyle}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Hoàn thành" TextAlignment="Center"
                                   Style="{StaticResource ProductionMetricLabelStyle}" />
                        <TextBlock Text="{Binding CompletedCount}"
                                   Style="{StaticResource ProductionMetricValueStyle}"
                                   Foreground="#2E9E5B" TextAlignment="Center" FontSize="28" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ProductionMetricCardStyle}" Margin="0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Đã hủy" TextAlignment="Center"
                                   Style="{StaticResource ProductionMetricLabelStyle}" />
                        <TextBlock Text="{Binding CancelledCount}"
                                   Style="{StaticResource ProductionMetricValueStyle}"
                                   Foreground="#D33F3F" TextAlignment="Center" FontSize="28" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </Grid>

        <!-- Hàng 2: Thanh action -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button access:PermissionAccess.Rule="PROD_ORDER:Add" Content="Tạo mới phiếu sản xuất"
                    Style="{StaticResource ProductionPrimaryButtonStyle}"
                    Command="{Binding CreateOrderCommand}"
                    Margin="0,0,8,0" MinWidth="170" />
            <Button Content="Chi tiết"
                    Style="{StaticResource ProductionOutlineButtonStyle}"
                    Command="{Binding OpenDetailCommand}"
                    CommandParameter="{Binding SelectedOrder}"
                    Margin="0,0,8,0" MinWidth="90" />
            <Button access:PermissionAccess.Rule="PROD_ORDER:Edit" Content="Sửa"
                    Style="{StaticResource ProductionOutlineButtonStyle}"
                    Command="{Binding EditOrderCommand}"
                    CommandParameter="{Binding SelectedOrder}"
                    Margin="0,0,8,0" MinWidth="90"
                    ToolTip="Chỉ sửa được khi phiếu còn là bản nháp" />
            <Button Content="In phiếu"
                    Style="{StaticResource ProductionOutlineButtonStyle}"
                    Command="{Binding PrintOrderCommand}"
                    CommandParameter="{Binding SelectedOrder}"
                    Margin="0,0,8,0" MinWidth="90" />
            <Button access:PermissionAccess.Rule="DATA_EXPORT" Content="Xuất Excel"
                    Style="{StaticResource ProductionOutlineButtonStyle}"
                    Command="{Binding ExportExcelCommand}"
                    CommandParameter="{Binding ElementName=OrdersGrid}"
                    Margin="0,0,8,0" MinWidth="90" />
            <Button access:PermissionAccess.Rule="PROD_CANCEL:Delete" Content="Xóa"
                    Style="{StaticResource ProductionGhostButtonStyle}"
                    Command="{Binding DeleteOrderCommand}"
                    CommandParameter="{Binding SelectedOrder}"
                    Margin="0,0,8,0" MinWidth="90" />
        </StackPanel>

        <!-- Hàng 3: Bảng -->
        <Border Grid.Row="2" Style="{StaticResource ProductionCardStyle}" Padding="0">
            <DataGrid x:Name="OrdersGrid"
                      Style="{StaticResource ProductionDataGridStyle}"
                      ItemsSource="{Binding Orders}"
                      SelectedItem="{Binding SelectedOrder}"
                      MouseDoubleClick="OrdersGrid_OnMouseDoubleClick"
                      BorderThickness="0"
                      grid:DataGridColumnLayout.SettingsKey="production.orders">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="STT" grid:DataGridColumnLayout.Key="Index"
                                        Binding="{Binding Index, Mode=OneWay}" Width="45" />
                    <DataGridTemplateColumn Header="" grid:DataGridColumnLayout.Key="Select" Width="36">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Mã phiếu" grid:DataGridColumnLayout.Key="Code"
                                        Binding="{Binding Code, Mode=OneWay}" Width="120" />
                    <DataGridTextColumn Header="Ngày giao" grid:DataGridColumnLayout.Key="MaterialIssueDate"
                                        Binding="{Binding MaterialIssueDateDisplay, Mode=OneWay}" Width="100" />
                    <DataGridTextColumn Header="Hạn hoàn thành" grid:DataGridColumnLayout.Key="DueDate"
                                        Binding="{Binding DueDateDisplay, Mode=OneWay}" Width="110" />
                    <DataGridTextColumn Header="Khách hàng" grid:DataGridColumnLayout.Key="Customer"
                                        Binding="{Binding CustomerName, Mode=OneWay}" Width="150" />
                    <DataGridTextColumn Header="Đơn đặt hàng" grid:DataGridColumnLayout.Key="SalesOrder"
                                        Binding="{Binding SalesOrderCode, Mode=OneWay}" Width="110" />
                    <DataGridTextColumn Header="Sản phẩm" grid:DataGridColumnLayout.Key="Models"
                                        Binding="{Binding ModelSummary, Mode=OneWay}" Width="*" MinWidth="140" />
                    <DataGridTextColumn Header="Thợ sản xuất" grid:DataGridColumnLayout.Key="Worker"
                                        Binding="{Binding WorkerDisplayName, Mode=OneWay}" Width="140" />
                    <DataGridTemplateColumn Header="Trạng thái" grid:DataGridColumnLayout.Key="Status" Width="105">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Center"
                                        Background="{Binding StatusCode, Converter={StaticResource StatusToBrush}}">
                                    <TextBlock Text="{Binding StatusDisplay, Mode=OneWay}"
                                               Foreground="White" FontSize="11" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Thao tác" grid:DataGridColumnLayout.Key="Actions" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button access:PermissionAccess.Rule="PROD_COMPLETE:Edit" Content="Hoàn thành"
                                        Command="{Binding DataContext.CompleteOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource ProductionPrimaryButtonStyle}"
                                        MinHeight="28" Padding="8,2"
                                        Visibility="{Binding IsInProgress, Converter={StaticResource BoolToVis}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
