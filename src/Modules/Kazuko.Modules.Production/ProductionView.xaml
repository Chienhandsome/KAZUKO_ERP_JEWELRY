<UserControl x:Class="Kazuko.Modules.Production.ProductionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Kazuko.Modules.Production.Converters"
             xmlns:grid="clr-namespace:Kazuko.Shared.UI.DataGridLayout;assembly=Kazuko.Shared.UI"
             MinWidth="900" MinHeight="520"
             PreviewKeyDown="UserControl_PreviewKeyDown">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/ProductionResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:NullOrEmptyToVisibilityConverter x:Key="NullToVis" />
            <conv:NullOrEmptyToVisibilityConverter x:Key="NotNullToVis" Invert="True" />
            <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Kazuko.Modules.Production;component/Assets/icons/SX.png"
                       Width="48" Height="48" Stretch="Uniform" Margin="0,0,12,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SẢN XUẤT"
                               Foreground="{DynamicResource PrimaryBrush}"
                               FontSize="{DynamicResource FontSize.Heading}"
                               FontWeight="Bold" />
                    <TextBlock Text="Quản lý lệnh sản xuất, mẫu và bản nháp"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="{DynamicResource FontSize.Body}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Tạo lệnh"
                        Style="{StaticResource ProductionPrimaryButtonStyle}"
                        Command="{Binding CreateOrderCommand}"
                        Margin="0" />
            </StackPanel>
        </Grid>

        <!-- KPI cards -->
        <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,0,0,12">
            <Border Style="{StaticResource ProductionMetricCardStyle}">
                <StackPanel>
                    <TextBlock Text="Đang làm" Style="{StaticResource ProductionMetricLabelStyle}" />
                    <TextBlock Text="{Binding InProgressCount}" Style="{StaticResource ProductionMetricValueStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ProductionMetricCardStyle}">
                <StackPanel>
                    <TextBlock Text="Hoàn thành kỳ" Style="{StaticResource ProductionMetricLabelStyle}" />
                    <TextBlock Text="{Binding CompletedPeriodCount}" Style="{StaticResource ProductionMetricValueStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ProductionMetricCardStyle}">
                <StackPanel>
                    <TextBlock Text="Thợ ngoài (đang làm)" Style="{StaticResource ProductionMetricLabelStyle}" />
                    <TextBlock Text="{Binding OutsourcedCount}" Style="{StaticResource ProductionMetricValueStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ProductionMetricCardStyle}" Margin="0">
                <StackPanel>
                    <TextBlock Text="Nội bộ (đang làm)" Style="{StaticResource ProductionMetricLabelStyle}" />
                    <TextBlock Text="{Binding InHouseCount}" Style="{StaticResource ProductionMetricValueStyle}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Filters -->
        <Border Grid.Row="2" Style="{StaticResource ProductionCardStyle}" Padding="12,10" Margin="0,0,0,12">
            <StackPanel>
                <WrapPanel>
                    <TextBox Width="240"
                             Style="{StaticResource ProductionFilterFieldStyle}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Mã lệnh, mẫu, đơn đặt, thợ/nhân viên" />
                    <ComboBox Width="150"
                              Style="{StaticResource ProductionFilterComboStyle}"
                              ItemsSource="{Binding StatusFilterOptions}"
                              SelectedItem="{Binding SelectedStatusFilter}" />
                    <ComboBox Width="190"
                              Style="{StaticResource ProductionFilterComboStyle}"
                              ItemsSource="{Binding SourceFilterOptions}"
                              SelectedItem="{Binding SelectedSourceFilter}" />
                    <ComboBox Width="150"
                              Style="{StaticResource ProductionFilterComboStyle}"
                              ItemsSource="{Binding ExecutionFilterOptions}"
                              SelectedItem="{Binding SelectedExecutionFilter}" />
                    <DatePicker Width="140" Margin="0,0,8,8" SelectedDate="{Binding FromDate}"
                                VerticalContentAlignment="Center" />
                    <DatePicker Width="140" Margin="0,0,8,8" SelectedDate="{Binding ToDate}"
                                VerticalContentAlignment="Center" />
                    <CheckBox Content="Gồm bản nháp"
                              IsChecked="{Binding IncludeDrafts}"
                              Style="{StaticResource ProductionCheckBoxStyle}"
                              Margin="4,8,8,8"
                              VerticalAlignment="Center" />
                </WrapPanel>
                <TextBlock Text="{Binding ErrorMessage}"
                           Style="{StaticResource ProductionErrorStyle}"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVis}}" />
            </StackPanel>
        </Border>

        <!-- Grid -->
        <Border Grid.Row="3" Style="{StaticResource ProductionCardStyle}" Padding="0">
            <DataGrid Style="{StaticResource ProductionDataGridStyle}"
                      ItemsSource="{Binding Orders}"
                      SelectedItem="{Binding SelectedOrder}"
                      MouseDoubleClick="OrdersGrid_OnMouseDoubleClick"
                      BorderThickness="0"
                      grid:DataGridColumnLayout.SettingsKey="production.orders">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã LSX" grid:DataGridColumnLayout.Key="Code"
                                        Binding="{Binding Code, Mode=OneWay}" Width="130" />
                    <DataGridTextColumn Header="Ngày lập" grid:DataGridColumnLayout.Key="OrderDate"
                                        Binding="{Binding OrderDateDisplay, Mode=OneWay}" Width="100" />
                    <DataGridTextColumn Header="Trạng thái" grid:DataGridColumnLayout.Key="Status"
                                        Binding="{Binding StatusDisplay, Mode=OneWay}" Width="110" />
                    <DataGridTextColumn Header="Nguồn" grid:DataGridColumnLayout.Key="Source"
                                        Binding="{Binding SourceDisplay, Mode=OneWay}" Width="110" />
                    <DataGridTextColumn Header="Hình thức" grid:DataGridColumnLayout.Key="Execution"
                                        Binding="{Binding ExecutionDisplay, Mode=OneWay}" Width="100" />
                    <DataGridTextColumn Header="Đơn đặt" grid:DataGridColumnLayout.Key="SalesOrder"
                                        Binding="{Binding SalesOrderCode, Mode=OneWay}" Width="120" />
                    <DataGridTextColumn Header="Thợ / NV" grid:DataGridColumnLayout.Key="Worker"
                                        Binding="{Binding WorkerDisplayName, Mode=OneWay}" Width="160" />
                    <DataGridTextColumn Header="SL kế hoạch" grid:DataGridColumnLayout.Key="Qty"
                                        Binding="{Binding PlannedQuantityTotal, Mode=OneWay}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left"
                       Text="{Binding StatusMessage}"
                       VerticalAlignment="Center"
                       Style="{StaticResource ProductionHintStyle}" />
        </DockPanel>
    </Grid>
</UserControl>
