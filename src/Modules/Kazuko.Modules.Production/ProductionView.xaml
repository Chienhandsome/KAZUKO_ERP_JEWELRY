<UserControl x:Class="Kazuko.Modules.Production.ProductionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Kazuko.Modules.Production.Converters"
             xmlns:grid="clr-namespace:Kazuko.Shared.UI.DataGridLayout;assembly=Kazuko.Shared.UI"
             MinWidth="900" MinHeight="520"
             PreviewKeyDown="UserControl_PreviewKeyDown">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/ProductionResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:NullOrEmptyToVisibilityConverter x:Key="NullToVis" />
            <conv:NullOrEmptyToVisibilityConverter x:Key="NotNullToVis" Invert="True" />
            <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Kazuko.Modules.Production;component/Assets/icons/SX.png"
                       Width="48" Height="48" Stretch="Uniform" Margin="0,0,12,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SẢN XUẤT"
                               Foreground="{DynamicResource PrimaryBrush}"
                               FontSize="{DynamicResource FontSize.Heading}"
                               FontWeight="Bold" />
                    <TextBlock Text="Quản lý lệnh sản xuất, mẫu và bản nháp"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="{DynamicResource FontSize.Body}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Tạo lệnh"
                        Style="{StaticResource ProductionPrimaryButtonStyle}"
                        Command="{Binding CreateOrderCommand}"
                        Margin="0" />
            </StackPanel>
        </Grid>

        <!-- KPI cards: M1 redesign (A1, B2) — 3 thẻ, đếm trên toàn bộ -->
        <UniformGrid Grid.Row="1" Rows="1" Columns="3" Margin="0,0,0,12">
            <Border Style="{StaticResource ProductionMetricCardStyle}">
                <StackPanel>
                    <TextBlock Text="Đang làm" Style="{StaticResource ProductionMetricLabelStyle}" />
                    <TextBlock Text="{Binding InProgressCount}" Style="{StaticResource ProductionMetricValueStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ProductionMetricCardStyle}">
                <StackPanel>
                    <TextBlock Text="Hoàn thành" Style="{StaticResource ProductionMetricLabelStyle}" />
                    <TextBlock Text="{Binding CompletedCount}" Style="{StaticResource ProductionMetricValueStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ProductionMetricCardStyle}" Margin="0">
                <StackPanel>
                    <TextBlock Text="Đã hủy" Style="{StaticResource ProductionMetricLabelStyle}" />
                    <TextBlock Text="{Binding CancelledCount}" Style="{StaticResource ProductionMetricValueStyle}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Filters -->
        <Border Grid.Row="2" Style="{StaticResource ProductionCardStyle}" Padding="12,10" Margin="0,0,0,12">
            <StackPanel>
                <WrapPanel>
                    <TextBox Width="240"
                             Style="{StaticResource ProductionFilterFieldStyle}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Mã lệnh, mẫu, đơn đặt, thợ/nhân viên" />
                    <ComboBox Width="150"
                              Style="{StaticResource ProductionFilterComboStyle}"
                              ItemsSource="{Binding StatusFilterOptions}"
                              SelectedItem="{Binding SelectedStatusFilter}" />
                    <ComboBox Width="190"
                              Style="{StaticResource ProductionFilterComboStyle}"
                              ItemsSource="{Binding SourceFilterOptions}"
                              SelectedItem="{Binding SelectedSourceFilter}" />
                    <ComboBox Width="150"
                              Style="{StaticResource ProductionFilterComboStyle}"
                              ItemsSource="{Binding ExecutionFilterOptions}"
                              SelectedItem="{Binding SelectedExecutionFilter}" />
                    <DatePicker Width="140" Margin="0,0,8,8" SelectedDate="{Binding FromDate}"
                                VerticalContentAlignment="Center" />
                    <DatePicker Width="140" Margin="0,0,8,8" SelectedDate="{Binding ToDate}"
                                VerticalContentAlignment="Center" />
                    <CheckBox Content="Gồm bản nháp"
                              IsChecked="{Binding IncludeDrafts}"
                              Style="{StaticResource ProductionCheckBoxStyle}"
                              Margin="4,8,8,8"
                              VerticalAlignment="Center" />
                </WrapPanel>
                <TextBlock Text="{Binding ErrorMessage}"
                           Style="{StaticResource ProductionErrorStyle}"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVis}}" />
            </StackPanel>
        </Border>

        <!-- Toolbar: giữ nút Tạo lệnh ở header; thêm thao tác dòng theo pattern các module khác -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Chi tiết"
                    Style="{StaticResource ProductionOutlineButtonStyle}"
                    Command="{Binding OpenDetailCommand}"
                    CommandParameter="{Binding SelectedOrder}"
                    Margin="0,0,8,0" MinWidth="90" />
            <Button Content="Sửa"
                    Style="{StaticResource ProductionOutlineButtonStyle}"
                    Command="{Binding EditOrderCommand}"
                    CommandParameter="{Binding SelectedOrder}"
                    Margin="0,0,8,0" MinWidth="90"
                    ToolTip="Chỉ sửa được khi phiếu còn là bản nháp" />
            <Button Content="Xóa"
                    Style="{StaticResource ProductionGhostButtonStyle}"
                    Command="{Binding DeleteOrderCommand}"
                    CommandParameter="{Binding SelectedOrder}"
                    Margin="0,0,8,0" MinWidth="90" />
        </StackPanel>

        <!-- Grid: M1 redesign — bỏ Ngày lập/Nguồn/Hình thức/SL kế hoạch (giữ ở filter);
             thêm Ngày giao, Hạn hoàn thành, Khách hàng; Sản phẩm bind ModelSummary (C4) -->
        <Border Grid.Row="4" Style="{StaticResource ProductionCardStyle}" Padding="0">
            <DataGrid Style="{StaticResource ProductionDataGridStyle}"
                      ItemsSource="{Binding Orders}"
                      SelectedItem="{Binding SelectedOrder}"
                      MouseDoubleClick="OrdersGrid_OnMouseDoubleClick"
                      BorderThickness="0"
                      grid:DataGridColumnLayout.SettingsKey="production.orders">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã phiếu" grid:DataGridColumnLayout.Key="Code"
                                        Binding="{Binding Code, Mode=OneWay}" Width="120" />
                    <DataGridTextColumn Header="Ngày giao" grid:DataGridColumnLayout.Key="MaterialIssueDate"
                                        Binding="{Binding MaterialIssueDateDisplay, Mode=OneWay}" Width="100" />
                    <DataGridTextColumn Header="Hạn hoàn thành" grid:DataGridColumnLayout.Key="DueDate"
                                        Binding="{Binding DueDateDisplay, Mode=OneWay}" Width="110" />
                    <DataGridTextColumn Header="Khách hàng" grid:DataGridColumnLayout.Key="Customer"
                                        Binding="{Binding CustomerName, Mode=OneWay}" Width="170" />
                    <DataGridTextColumn Header="Đơn đặt" grid:DataGridColumnLayout.Key="SalesOrder"
                                        Binding="{Binding SalesOrderCode, Mode=OneWay}" Width="120" />
                    <DataGridTextColumn Header="Sản phẩm" grid:DataGridColumnLayout.Key="Models"
                                        Binding="{Binding ModelSummary, Mode=OneWay}" Width="*" MinWidth="150" />
                    <DataGridTextColumn Header="Thợ sản xuất" grid:DataGridColumnLayout.Key="Worker"
                                        Binding="{Binding WorkerDisplayName, Mode=OneWay}" Width="150" />
                    <DataGridTextColumn Header="Trạng thái" grid:DataGridColumnLayout.Key="Status"
                                        Binding="{Binding StatusDisplay, Mode=OneWay}" Width="100" />
                    <DataGridTemplateColumn Header="" grid:DataGridColumnLayout.Key="Complete" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Hoàn thành"
                                        Command="{Binding DataContext.CompleteOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource ProductionPrimaryButtonStyle}"
                                        MinHeight="28" Padding="8,2"
                                        Visibility="{Binding IsInProgress, Converter={StaticResource BoolToVis}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer (B5): chỉ còn tổng số phiếu trên toàn bộ danh sách đã lọc -->
        <DockPanel Grid.Row="5" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left"
                       Text="{Binding StatusMessage}"
                       VerticalAlignment="Center"
                       Style="{StaticResource ProductionHintStyle}" />
        </DockPanel>
    </Grid>
</UserControl>
