<Window x:Class="Kazuko.Modules.Production.ProductionOrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Kazuko.Modules.Production.Converters"
        Title="{Binding WindowTitle}"
        Width="1020" Height="780" MinWidth="860" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />
    </Window.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Hủy lệnh" Style="{DynamicResource NavButtonStyle}" Command="{Binding CancelDraftCommand}"
                    MinHeight="40" Margin="0,0,8,0" />
            <Button Content="Đóng" Style="{DynamicResource NavButtonStyle}" Command="{Binding CloseCommand}"
                    MinHeight="40" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="Lưu bản nháp" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding SaveDraftCommand}"
                    MinHeight="40" IsDefault="True" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,8" />

        <TabControl SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="Thông tin lệnh">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Mã lệnh" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Text="{Binding Code, Mode=OneWay}" IsReadOnly="True" MinHeight="36" Margin="0,0,0,8" />
                                <TextBlock Text="Trạng thái" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Text="{Binding StatusDisplay, Mode=OneWay}" IsReadOnly="True" MinHeight="36" Margin="0,0,0,8" />
                                <TextBlock Text="Ngày lập" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <DatePicker SelectedDate="{Binding OrderDate}" MinHeight="36" Margin="0,0,0,8"
                                            IsEnabled="{Binding IsDraft}" />
                                <TextBlock Text="Nguồn lệnh" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ComboBox SelectedValue="{Binding OrderSource}" SelectedValuePath="Content"
                                          MinHeight="36" Margin="0,0,0,8" IsEnabled="{Binding IsDraft}">
                                    <ComboBoxItem Content="STOCK" />
                                    <ComboBoxItem Content="SALES_ORDER" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Đơn bán" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Visibility="{Binding IsSalesOrderSource, Converter={StaticResource BoolToVis}}" />
                                <ComboBox ItemsSource="{Binding SalesOrders}" DisplayMemberPath="DisplayName"
                                          SelectedValue="{Binding SalesOrderId}" SelectedValuePath="Id"
                                          MinHeight="36" Margin="0,0,0,8" IsEnabled="{Binding IsDraft}"
                                          Visibility="{Binding IsSalesOrderSource, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="Hình thức" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ComboBox SelectedValue="{Binding ExecutionType}" SelectedValuePath="Content"
                                          MinHeight="36" Margin="0,0,0,8" IsEnabled="{Binding IsDraft}">
                                    <ComboBoxItem Content="IN_HOUSE" />
                                    <ComboBoxItem Content="OUTSOURCED" />
                                </ComboBox>
                                <TextBlock Text="Kho xuất NVL" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ComboBox ItemsSource="{Binding Locations}" DisplayMemberPath="DisplayName"
                                          SelectedValue="{Binding SourceLocationId}" SelectedValuePath="Id"
                                          MinHeight="36" Margin="0,0,0,8" IsEnabled="{Binding IsDraft}" />
                                <TextBlock Text="Kho thành phẩm" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ComboBox ItemsSource="{Binding Locations}" DisplayMemberPath="DisplayName"
                                          SelectedValue="{Binding FinishedLocationId}" SelectedValuePath="Id"
                                          MinHeight="36" IsEnabled="{Binding IsDraft}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Nhân viên nội bộ" Margin="0,12,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding IsInHouse, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding Employees}" Margin="0,4,0,8"
                                      Visibility="{Binding IsInHouse, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}"
                                              IsEnabled="{Binding DataContext.IsDraft, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Thợ ngoài" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding IsOutsourced, Converter={StaticResource BoolToVis}}" />
                        <Grid Margin="0,4,0,8"
                              Visibility="{Binding IsOutsourced, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding ExternalWorkers}" DisplayMemberPath="DisplayName"
                                      SelectedValue="{Binding ExternalWorkerId}" SelectedValuePath="Id"
                                      MinHeight="36" IsEnabled="{Binding IsDraft}" />
                            <Button Grid.Column="2" Content="Thêm thợ"
                                    Command="{Binding CreateExternalWorkerCommand}"
                                    Style="{DynamicResource PrimaryButtonStyle}"
                                    MinHeight="36" Padding="12,0"
                                    IsEnabled="{Binding IsDraft}"
                                    ToolTip="Mở nhanh danh mục thêm/sửa thợ ngoài" />
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Người giao" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Text="{Binding DeliveredByName, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="36" IsEnabled="{Binding IsDraft}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Người nhận" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Text="{Binding ReceivedByName, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="36" IsEnabled="{Binding IsDraft}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Ghi chú" Margin="0,12,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" MinHeight="72"
                                 TextWrapping="Wrap" AcceptsReturn="True" IsEnabled="{Binding IsDraft}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Mẫu sản phẩm">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                        <Button Content="Thêm dòng mẫu" Style="{DynamicResource NavButtonStyle}" Command="{Binding AddLineCommand}"
                                MinHeight="36" IsEnabled="{Binding IsDraft}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False"
                              CanUserAddRows="False" MinHeight="200" IsReadOnly="{Binding IsDraft, Converter={StaticResource InverseBool}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT" Binding="{Binding LineNumber, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                            <DataGridTextColumn Header="Mã mẫu" Binding="{Binding ModelCode, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                            <DataGridTextColumn Header="Tên mẫu *" Binding="{Binding ModelName, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="120" />
                            <DataGridTextColumn Header="Mã vàng *" Binding="{Binding GoldTypeCode, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                            <DataGridTextColumn Header="Loại vàng *" Binding="{Binding GoldTypeName, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                            <DataGridTextColumn Header="SL *" Binding="{Binding PlannedQuantity, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                            <DataGridTextColumn Header="Tiền công/món" Binding="{Binding LaborCostPerUnit, UpdateSourceTrigger=PropertyChanged}" Width="110" />
                            <DataGridTemplateColumn Header="" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Xóa" Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" Style="{DynamicResource NavButtonStyle}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Thêm ảnh mẫu" Style="{DynamicResource NavButtonStyle}" Command="{Binding AddAttachmentCommand}"
                                    MinHeight="36" IsEnabled="{Binding IsDraft}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,4">
                                        <Button DockPanel.Dock="Right" Content="Gỡ" Style="{DynamicResource NavButtonStyle}"
                                                Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock Text="{Binding OriginalFileName}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DockPanel>
            </TabItem>

            <TabItem Header="Giao NVL" IsEnabled="{Binding CanUseExecutionTabs}">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <ComboBox ItemsSource="{Binding StockMaterials}"
                                      SelectedItem="{Binding SelectedStockMaterial}"
                                      DisplayMemberPath="Name" MinWidth="280" MinHeight="36" Margin="0,0,8,0"
                                      IsEnabled="{Binding CanIssueMaterials}" />
                            <TextBox Text="{Binding IssueQuantity, UpdateSourceTrigger=PropertyChanged}" Width="80" MinHeight="36" Margin="0,0,8,0"
                                     IsEnabled="{Binding CanIssueMaterials}" />
                            <Button Content="Thêm dòng" Style="{DynamicResource NavButtonStyle}" Command="{Binding AddIssueLineCommand}" MinHeight="36" Margin="0,0,8,0" />
                            <Button Content="Tải tồn" Style="{DynamicResource NavButtonStyle}" Command="{Binding RefreshStockMaterialsCommand}" MinHeight="36" Margin="0,0,8,0" />
                            <Button Content="Ghi sổ giao NVL" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding PostMaterialIssueCommand}" MinHeight="36" />
                        </StackPanel>
                        <TextBlock Text="Giá snapshot chỉ đọc — vàng lấy giá kho lúc ghi sổ." Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding IssueLines}" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="False" MinHeight="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã" Binding="{Binding MaterialCode}" IsReadOnly="True" Width="90" />
                            <DataGridTextColumn Header="Tên" Binding="{Binding MaterialName}" IsReadOnly="True" Width="*" />
                            <DataGridTextColumn Header="SL" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                            <DataGridTextColumn Header="ĐVT" Binding="{Binding UnitCode}" IsReadOnly="True" Width="60" />
                            <DataGridTextColumn Header="Gợi ý giá" Binding="{Binding DisplayCostHint}" IsReadOnly="True" Width="160" />
                            <DataGridTemplateColumn Header="" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Xóa" Command="{Binding DataContext.RemoveIssueLineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" Style="{DynamicResource NavButtonStyle}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Nhận &amp; đối soát" IsEnabled="{Binding CanUseExecutionTabs}">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                        <Button Content="Ghi nhận nhận hàng" Style="{DynamicResource PrimaryButtonStyle}"
                                Command="{Binding PostWorkerReturnCommand}" MinHeight="36" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding ReturnLines}" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="200"
                              IsReadOnly="{Binding CanPostReturn, Converter={StaticResource InverseBool}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã" Binding="{Binding MaterialCode}" IsReadOnly="True" Width="90" />
                            <DataGridTextColumn Header="Tên" Binding="{Binding MaterialName}" IsReadOnly="True" Width="*" />
                            <DataGridTextColumn Header="Đã giao" Binding="{Binding QuantityIssued}" IsReadOnly="True" Width="80" />
                            <DataGridTextColumn Header="Vào TP" Binding="{Binding QuantityInProduct, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                            <DataGridTextColumn Header="Trả lại" Binding="{Binding QuantityReturned, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                            <DataGridTextColumn Header="Phế liệu" Binding="{Binding QuantityScrap, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                            <DataGridTextColumn Header="Hao hụt" Binding="{Binding QuantityLoss, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                            <DataGridTextColumn Header="ĐVT" Binding="{Binding UnitCode}" IsReadOnly="True" Width="60" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="QC từng món" IsEnabled="{Binding CanUseExecutionTabs}">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ListBox ItemsSource="{Binding QcUnits}" SelectedItem="{Binding SelectedQcUnit}"
                             DisplayMemberPath="DisplayName" />
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Kết quả QC" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ComboBox SelectedValue="{Binding QcResultCode}" SelectedValuePath="Content" MinHeight="36" Margin="0,0,0,8"
                                      IsEnabled="{Binding CanWriteQc}">
                                <ComboBoxItem Content="PASS" />
                                <ComboBoxItem Content="FAIL" />
                            </ComboBox>
                            <TextBlock Text="Trọng lượng vàng" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBox Text="{Binding QcGoldWeight, UpdateSourceTrigger=PropertyChanged}" Width="120" MinHeight="36" Margin="0,0,8,0" />
                                <TextBox Text="{Binding QcWeightUnit, UpdateSourceTrigger=PropertyChanged}" Width="80" MinHeight="36" Margin="0,0,8,0" />
                                <TextBox Text="{Binding QcPurityCode, UpdateSourceTrigger=PropertyChanged}" Width="100" MinHeight="36"
                                         ToolTip="Tuổi vàng" />
                            </StackPanel>
                            <TextBlock Text="Lý do lỗi / ghi chú làm lại" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Text="{Binding QcDefectNotes, UpdateSourceTrigger=PropertyChanged}" MinHeight="56"
                                     TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,8" />
                            <TextBlock Text="Cấu thành (số lượng dùng > 0)" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <DataGrid ItemsSource="{Binding QcComponents}" AutoGenerateColumns="False" CanUserAddRows="False"
                                      MinHeight="120" Margin="0,0,0,8">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="NVL" Binding="{Binding DisplayName}" IsReadOnly="True" Width="*" />
                                    <DataGridTextColumn Header="Loại" Binding="{Binding ComponentKind, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                                    <DataGridTextColumn Header="SL dùng" Binding="{Binding QuantityUsed, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Thêm ảnh QC" Style="{DynamicResource NavButtonStyle}" Command="{Binding AddQcImageCommand}" MinHeight="36" Margin="0,0,8,0" />
                                <Button Content="Lưu QC" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding RecordQcCommand}" MinHeight="36" Margin="0,0,8,0" />
                                <Button Content="Nhận lại sau làm lại" Style="{DynamicResource NavButtonStyle}" Command="{Binding RecordReworkCommand}" MinHeight="36" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding QcImages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding OriginalFileName}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="Tổng kết" IsEnabled="{Binding CanUseExecutionTabs}">
                <StackPanel Margin="16">
                    <TextBlock Text="{Binding CompletionPreview}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Hoàn tất lệnh" Style="{DynamicResource PrimaryButtonStyle}"
                                Command="{Binding CompleteOrderCommand}" MinHeight="40" Margin="0,0,8,0" />
                        <Button Content="In phiếu giao" Style="{DynamicResource NavButtonStyle}" Command="{Binding PrintMaterialIssueCommand}" MinHeight="40" Margin="0,0,8,0" />
                        <Button Content="In nhận hàng" Style="{DynamicResource NavButtonStyle}" Command="{Binding PrintReturnCommand}" MinHeight="40" Margin="0,0,8,0" />
                        <Button Content="In QC" Style="{DynamicResource NavButtonStyle}" Command="{Binding PrintQcCommand}" MinHeight="40" Margin="0,0,8,0" />
                        <Button Content="In nhập TP" Style="{DynamicResource NavButtonStyle}" Command="{Binding PrintFinishedCommand}" MinHeight="40" Margin="0,0,8,0" />
                        <Button Content="In quyết toán" Style="{DynamicResource NavButtonStyle}" Command="{Binding PrintSettlementCommand}" MinHeight="40" />
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
