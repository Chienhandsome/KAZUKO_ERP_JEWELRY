<Window x:Class="Kazuko.Modules.Production.ProductionOrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Kazuko.Modules.Production.Converters"
        xmlns:grid="clr-namespace:Kazuko.Shared.UI.DataGridLayout;assembly=Kazuko.Shared.UI"
        Title="{Binding WindowTitle}"
        Width="1260" Height="860" MinWidth="900" MinHeight="680"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/ProductionResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
            <conv:BooleanToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
            <conv:InverseBooleanConverter x:Key="InverseBool" />
            <conv:NullOrEmptyToVisibilityConverter x:Key="NotNullToVis" Invert="True" />
            <Style x:Key="ProductionSectionExpanderStyle" TargetType="Expander">
                <Setter Property="Margin" Value="0,0,0,12" />
                <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="HeaderTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontWeight="SemiBold"
                                       FontSize="{DynamicResource FontSize.Subtitle}"
                                       Foreground="{DynamicResource PrimaryBrush}" />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{Binding WindowTitle}"
                       FontSize="{DynamicResource FontSize.Heading}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryBrush}" />
            <TextBlock Text="{Binding StatusDisplay, StringFormat=Trạng thái: {0}}"
                       Margin="0,4,0,0"
                       Style="{StaticResource ProductionHintStyle}" />
            <TextBlock Text="{Binding WorkflowHint}" Style="{StaticResource ProductionHintStyle}" />
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Text="{Binding ErrorMessage}"
                   Style="{StaticResource ProductionErrorStyle}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVis}}" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel MinWidth="1020">

            <Expander Header="1   Thông tin lệnh" IsExpanded="True" Style="{StaticResource ProductionSectionExpanderStyle}">
                <Grid Margin="0,12,0,0">
                    <Border Style="{StaticResource ProductionCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Thông tin chung" Style="{StaticResource ProductionSectionHeaderStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Mã lệnh" Style="{StaticResource ProductionFieldLabelStyle}" />
                                    <TextBox Text="{Binding Code, Mode=OneWay}" IsReadOnly="True"
                                             Style="{StaticResource ProductionDialogFieldStyle}" />
                                    <TextBlock Text="Ngày lập" Style="{StaticResource ProductionFieldLabelStyle}" />
                                    <DatePicker SelectedDate="{Binding OrderDate}"
                                                Margin="0,0,0,10" MinHeight="36"
                                                IsEnabled="{Binding IsDraft}" />
                                    <TextBlock Text="Ngày giao" Style="{StaticResource ProductionFieldLabelStyle}" />
                                    <TextBox Text="{Binding IssueDateDisplay, Mode=OneWay}" IsReadOnly="True"
                                             Style="{StaticResource ProductionDialogFieldStyle}"
                                             ToolTip="Ngày ghi sổ giao nguyên liệu cho thợ — trống khi còn bản nháp." />
                                    <TextBlock Text="Hạn hoàn thành" Style="{StaticResource ProductionFieldLabelStyle}" />
                                    <DatePicker SelectedDate="{Binding DueDate}"
                                                Margin="0,0,0,10" MinHeight="36"
                                                IsEnabled="{Binding IsDraft}" />
                                    <TextBlock Text="Loại sản xuất" Style="{StaticResource ProductionFieldLabelStyle}" />
                                    <ComboBox ItemsSource="{Binding OrderSourceOptions}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedItem="{Binding SelectedOrderSourceOption}"
                                              Style="{StaticResource ProductionDialogComboStyle}"
                                              IsEnabled="{Binding IsDraft}" />
                                    <StackPanel Visibility="{Binding IsSalesOrderSource, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Đơn đặt hàng *" Style="{StaticResource ProductionFieldLabelStyle}" />
                                        <ComboBox ItemsSource="{Binding SalesOrderOptions}"
                                                  SelectedItem="{Binding SelectedSalesOrder}"
                                                  DisplayMemberPath="Code"
                                                  Style="{StaticResource ProductionDialogComboStyle}"
                                                  IsEnabled="{Binding IsDraft}" />
                                        <TextBlock Text="Khách hàng" Style="{StaticResource ProductionFieldLabelStyle}" />
                                        <TextBlock Text="{Binding SelectedSalesOrderCustomer}" Style="{StaticResource ProductionHintStyle}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Hình thức" Style="{StaticResource ProductionFieldLabelStyle}" />
                                    <ComboBox ItemsSource="{Binding ExecutionTypeOptions}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedItem="{Binding SelectedExecutionTypeOption}"
                                              Style="{StaticResource ProductionDialogComboStyle}"
                                              IsEnabled="{Binding IsDraft}" />
                                    <TextBlock Text="Kho xuất NVL" Style="{StaticResource ProductionFieldLabelStyle}" />
                                    <ComboBox ItemsSource="{Binding Locations}" DisplayMemberPath="DisplayName"
                                              SelectedValue="{Binding SourceLocationId}" SelectedValuePath="Id"
                                              Style="{StaticResource ProductionDialogComboStyle}"
                                              IsEnabled="{Binding IsDraft}" />
                                    <TextBlock Text="Kho thành phẩm" Style="{StaticResource ProductionFieldLabelStyle}" />
                                    <ComboBox ItemsSource="{Binding Locations}" DisplayMemberPath="DisplayName"
                                              SelectedValue="{Binding FinishedLocationId}" SelectedValuePath="Id"
                                              Style="{StaticResource ProductionDialogComboStyle}"
                                              IsEnabled="{Binding IsDraft}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Nhân sự thực hiện" Style="{StaticResource ProductionSectionHeaderStyle}" Margin="0,8,0,10"
                                       Visibility="{Binding IsInHouse, Converter={StaticResource BoolToVis}}" />
                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12"
                                    Margin="0,0,0,12"
                                    Visibility="{Binding IsInHouse, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding Employees}"
                                                  SelectedItem="{Binding SelectedEmployeeToAdd}"
                                                  Style="{StaticResource ProductionDialogComboStyle}"
                                                  IsEnabled="{Binding IsDraft}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock>
                                                        <Run Text="{Binding FullName}" />
                                                        <Run Text=" (" />
                                                        <Run Text="{Binding Code}" />
                                                        <Run Text=")" />
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Grid.Column="2" Content="Thêm"
                                                Command="{Binding AddEmployeeCommand}"
                                                Style="{StaticResource ProductionPrimaryButtonStyle}"
                                                MinHeight="36"
                                                IsEnabled="{Binding IsDraft}" />
                                    </Grid>
                                    <DataGrid ItemsSource="{Binding SelectedEmployees}"
                                              Style="{StaticResource ProductionEditableDataGridStyle}"
                                              AutoGenerateColumns="False" IsReadOnly="True"
                                              MinHeight="96" MaxHeight="220"
                                              grid:DataGridColumnLayout.SettingsKey="production.order.workers">
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Xóa"
                                                          Command="{Binding PlacementTarget.DataContext.RemoveEmployeeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Mã NV" Binding="{Binding Code}" Width="120"
                                                                grid:DataGridColumnLayout.Key="Code" />
                                            <DataGridTextColumn Header="Tên nhân viên" Binding="{Binding FullName}" Width="*"
                                                                grid:DataGridColumnLayout.Key="FullName" />
                                            <DataGridTemplateColumn Header="" Width="80"
                                                                    grid:DataGridColumnLayout.Key="Actions">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="Xóa"
                                                                Command="{Binding DataContext.RemoveEmployeeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource ProductionGhostButtonStyle}"
                                                                MinHeight="28" Padding="8,2"
                                                                IsEnabled="{Binding DataContext.IsDraft, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Xưởng chế tác" Style="{StaticResource ProductionSectionHeaderStyle}" Margin="0,8,0,10"
                                       Visibility="{Binding IsOutsourced, Converter={StaticResource BoolToVis}}" />
                            <Grid Margin="0,0,0,12"
                                  Visibility="{Binding IsOutsourced, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding ExternalWorkers}" DisplayMemberPath="DisplayName"
                                          SelectedValue="{Binding ExternalWorkerId}" SelectedValuePath="Id"
                                          Style="{StaticResource ProductionDialogComboStyle}"
                                          Margin="0"
                                          IsEnabled="{Binding IsDraft}" />
                                <Button Grid.Column="2" Content="Thêm thợ"
                                        Command="{Binding CreateExternalWorkerCommand}"
                                        Style="{StaticResource ProductionPrimaryButtonStyle}"
                                        MinHeight="36"
                                        IsEnabled="{Binding IsDraft}"
                                        ToolTip="Mở nhanh danh mục thêm/sửa thợ ngoài" />
                            </Grid>

                            <TextBlock Text="Ghi chú" Style="{StaticResource ProductionFieldLabelStyle}" />
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ProductionDialogFieldStyle}"
                                     MinHeight="80" TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalContentAlignment="Top" IsEnabled="{Binding IsDraft}" />

                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Hình ảnh mẫu/thiết kế"
                                       Style="{StaticResource ProductionSectionHeaderStyle}"
                                       Margin="0,8,0,10" />
                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12"
                                    MinHeight="280"
                                    Visibility="{Binding HasGalleryImages, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>

                                    <Border Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            ClipToBounds="True"
                                            Cursor="Hand"
                                            ToolTip="Nhấn để phóng to">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding OpenGalleryImageCommand}"
                                                          CommandParameter="{Binding SelectedGalleryImage}" />
                                        </Border.InputBindings>
                                        <Image Source="{Binding SelectedGalleryImage.LocalPath, Mode=OneWay, Converter={StaticResource PathToImageSourceConverter}}"
                                               Stretch="Uniform"
                                               Margin="8"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>

                                    <ScrollViewer Grid.Column="2"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding GalleryImages}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="96" Height="96"
                                                            Margin="0,0,0,8"
                                                            CornerRadius="8"
                                                            ClipToBounds="True"
                                                            Cursor="Hand"
                                                            BorderThickness="2"
                                                            Background="{DynamicResource SurfaceBrush}"
                                                            ToolTip="{Binding Caption}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Border.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick"
                                                                          Command="{Binding DataContext.SelectGalleryImageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          CommandParameter="{Binding}" />
                                                        </Border.InputBindings>
                                                        <Image Source="{Binding LocalPath, Mode=OneWay, Converter={StaticResource PathToImageSourceConverter}}"
                                                               Stretch="UniformToFill"
                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                            <TextBlock Text="Chưa có ảnh sản phẩm. Thêm ảnh trong hộp thoại sản phẩm."
                                       Style="{StaticResource ProductionHintStyle}"
                                       Visibility="{Binding HasGalleryImages, Converter={StaticResource InverseBoolToVis}}" />
                        </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Expander>

            <Expander Header="2   Sản phẩm giao chế tác" IsExpanded="True" Style="{StaticResource ProductionSectionExpanderStyle}">
                <DockPanel Margin="0,12,0,0">
                    <Border DockPanel.Dock="Top" Style="{StaticResource ProductionCardStyle}" Padding="12,10" Margin="0,0,0,12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Thêm sản phẩm"
                                        Style="{StaticResource ProductionPrimaryButtonStyle}"
                                        Command="{Binding AddLineCommand}"
                                        MinHeight="36"
                                        IsEnabled="{Binding IsDraft}" />
                                <Button Content="Xem / sửa sản phẩm"
                                        Style="{StaticResource ProductionOutlineButtonStyle}"
                                        Command="{Binding EditLineCommand}"
                                        CommandParameter="{Binding SelectedLine}"
                                        MinHeight="36" />
                                <Button Content="Xóa sản phẩm"
                                        Style="{StaticResource ProductionGhostButtonStyle}"
                                        Command="{Binding RemoveLineCommand}"
                                        CommandParameter="{Binding SelectedLine}"
                                        MinHeight="36" Margin="0"
                                        IsEnabled="{Binding IsDraft}" />
                            </StackPanel>
                            <TextBlock Text="Nhấp đúp vào sản phẩm để xem hoặc sửa. Mỗi sản phẩm có thể đính kèm ảnh và file thiết kế."
                                       Style="{StaticResource ProductionHintStyle}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource ProductionCardStyle}" Padding="0">
                        <DataGrid Style="{StaticResource ProductionDataGridStyle}"
                                  ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}"
                                  Height="250"
                                  BorderThickness="0"
                                  MouseDoubleClick="LinesGrid_OnMouseDoubleClick"
                                  grid:DataGridColumnLayout.SettingsKey="production.order.lines">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT" Binding="{Binding LineNumber, Mode=OneWay}" Width="50"
                                                    grid:DataGridColumnLayout.Key="LineNumber" />
                                <DataGridTextColumn Header="Mã mẫu" Binding="{Binding ModelCode, Mode=OneWay}" Width="100"
                                                    grid:DataGridColumnLayout.Key="ModelCode" />
                                <DataGridTextColumn Header="Tên mẫu" Binding="{Binding ModelName, Mode=OneWay}" Width="*" MinWidth="140"
                                                    grid:DataGridColumnLayout.Key="ModelName" />
                                <DataGridTextColumn Header="Loại vàng" Binding="{Binding GoldTypeName, Mode=OneWay}" Width="120"
                                                    grid:DataGridColumnLayout.Key="GoldType" />
                                <DataGridTextColumn Header="Tuổi vàng" Binding="{Binding GoldTypeCode, Mode=OneWay}" Width="80"
                                                    grid:DataGridColumnLayout.Key="GoldAge" />
                                <DataGridTextColumn Header="SL" Binding="{Binding PlannedQuantity, Mode=OneWay}" Width="50"
                                                    grid:DataGridColumnLayout.Key="Qty" />
                                <DataGridTextColumn Header="TL vàng" Binding="{Binding EstimatedWeightChi, Mode=OneWay, StringFormat=0.###}" Width="70"
                                                    grid:DataGridColumnLayout.Key="Weight" />
                                <DataGridTextColumn Header="Giá vàng" Binding="{Binding GoldUnitPricePerChi, Mode=OneWay, StringFormat=N0}" Width="90"
                                                    grid:DataGridColumnLayout.Key="GoldPrice" />
                                <DataGridTextColumn Header="Công/món" Binding="{Binding LaborCostPerUnit, Mode=OneWay, StringFormat=N0}" Width="90"
                                                    grid:DataGridColumnLayout.Key="Labor" />
                                <DataGridTextColumn Header="Đá/món" Binding="{Binding StoneAmountPerUnitVnd, Mode=OneWay, StringFormat=N0}" Width="80"
                                                    grid:DataGridColumnLayout.Key="Stone" />
                                <DataGridTextColumn Header="Thành tiền" Binding="{Binding QuoteLineTotal, Mode=OneWay, StringFormat=N0}" Width="110"
                                                    grid:DataGridColumnLayout.Key="QuoteTotal" />
                                <DataGridTextColumn Header="Ghi chú" Binding="{Binding Notes, Mode=OneWay}" Width="160" MinWidth="100"
                                                    grid:DataGridColumnLayout.Key="LineNotes" />
                                <DataGridTextColumn Header="Đính kèm" Binding="{Binding AttachmentSummary, Mode=OneWay}" Width="110"
                                                    grid:DataGridColumnLayout.Key="Attachments" />
                                <DataGridTemplateColumn Header="" Width="120" grid:DataGridColumnLayout.Key="Actions">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Sửa"
                                                        Style="{StaticResource ProductionGridActionButtonStyle}"
                                                        Command="{Binding DataContext.EditLineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="Xóa"
                                                        Style="{StaticResource ProductionGridActionButtonStyle}"
                                                        Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding DataContext.IsDraft, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>
            </Expander>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="690" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" MinWidth="280" />
                </Grid.ColumnDefinitions>
            <Expander Grid.Column="0" Header="3   Giao nguyên vật liệu" IsExpanded="True" Style="{StaticResource ProductionSectionExpanderStyle}">
                <DockPanel Margin="0,12,0,0">
                    <Border DockPanel.Dock="Top" Style="{StaticResource ProductionEmptyStateStyle}"
                            Visibility="{Binding ShowIssueComposer, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="{Binding IssueTabEmptyMessage}" Style="{StaticResource ProductionHintStyle}" />
                    </Border>
                    <Border DockPanel.Dock="Top" Style="{StaticResource ProductionCardStyle}" Padding="12,10" Margin="0,0,0,12"
                            Visibility="{Binding ShowIssueComposer, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="220" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding StockMaterials}"
                                      SelectedItem="{Binding SelectedStockMaterial}"
                                      Style="{StaticResource ProductionDialogComboStyle}"
                                      Margin="0,0,8,0"
                                      IsEnabled="{Binding CanIssueMaterials}"
                                      ToolTip="Chọn loại nguyên vật liệu còn tồn tại kho xuất">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding Code, Mode=OneWay}" />
                                            <Run Text=" — " />
                                            <Run Text="{Binding Name, Mode=OneWay}" />
                                            <Run Text=" (" />
                                            <Run Text="{Binding QuantityOnHand, Mode=OneWay, StringFormat=N3}" />
                                            <Run Text=" " />
                                            <Run Text="{Binding UnitCode, Mode=OneWay}" />
                                            <Run Text=")" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBox Grid.Column="1"
                                     Text="{Binding IssueQuantity, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ProductionDialogFieldStyle}"
                                     Margin="0,0,8,0"
                                     IsEnabled="{Binding CanIssueMaterials}"
                                     ToolTip="{Binding IssueQuantityHint}" />
                            <Button Grid.Column="2" Content="Thêm"
                                    Style="{StaticResource ProductionOutlineButtonStyle}"
                                    Command="{Binding AddIssueLineCommand}" MinHeight="36" />
                            <Button Grid.Column="3" Content="Xác nhận giao vàng"
                                    Style="{StaticResource ProductionPrimaryButtonStyle}"
                                    Command="{Binding PostMaterialIssueCommand}" MinHeight="36" Margin="8,0,0,0"
                                    ToolTip="Ghi sổ giao NVL và khóa phiếu — không sửa được sau đó" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource ProductionCardStyle}" Padding="0">
                        <DataGrid Style="{StaticResource ProductionEditableDataGridStyle}"
                                  ItemsSource="{Binding IssueLines}"
                                  Height="220"
                                  IsReadOnly="{Binding ShowIssueHistory}"
                                  BorderThickness="0"
                                  grid:DataGridColumnLayout.SettingsKey="production.order.issue">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Loại NVL" Binding="{Binding MaterialName}" IsReadOnly="True" Width="*"
                                                    grid:DataGridColumnLayout.Key="Name" />
                                <DataGridTextColumn Header="Tuổi vàng" Binding="{Binding PurityDisplay}" IsReadOnly="True" Width="90"
                                                    grid:DataGridColumnLayout.Key="Purity" />
                                <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="100"
                                                    grid:DataGridColumnLayout.Key="Qty" />
                                <DataGridTextColumn Header="Đơn vị" Binding="{Binding UnitCode}" IsReadOnly="True" Width="70"
                                                    grid:DataGridColumnLayout.Key="Unit" />
                                <DataGridTemplateColumn Header="" Width="70" grid:DataGridColumnLayout.Key="Actions">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Xóa"
                                                    Style="{StaticResource ProductionGridActionButtonStyle}"
                                                    Command="{Binding DataContext.RemoveIssueLineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.ShowIssueComposer, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>
            </Expander>
            <Border Grid.Column="2" Style="{StaticResource ProductionCardStyle}" VerticalAlignment="Top" Margin="0,24,0,0">
                <StackPanel>
                    <TextBlock Text="4   Tiền công và thỏa thuận" Style="{StaticResource ProductionSectionHeaderStyle}" />
                    <TextBlock Text="Tiền công dự kiến" Style="{StaticResource ProductionFieldLabelStyle}" />
                    <TextBlock Text="{Binding QuoteLaborTotal, StringFormat={}{0:N0} VND}"
                               FontSize="{DynamicResource FontSize.Subtitle}" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,12" />
                </StackPanel>
            </Border>
            </Grid>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Margin="0,14,0,0" Padding="0,12,0,0"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Hủy lệnh" Style="{StaticResource ProductionGhostButtonStyle}"
                            Command="{Binding CancelDraftCommand}" />
                    <Button Content="Đóng" Style="{StaticResource ProductionOutlineButtonStyle}"
                            Command="{Binding CloseCommand}" IsCancel="True" />
                    <Button Content="Lưu bản nháp" Style="{StaticResource ProductionPrimaryButtonStyle}"
                            Command="{Binding SaveDraftCommand}" IsDefault="True" Margin="0" />
                </StackPanel>
                <UniformGrid DockPanel.Dock="Left" Rows="1" Columns="3" Margin="0,0,12,0">
                    <Border Style="{StaticResource ProductionMetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Tổng trọng lượng giao (chỉ)" Style="{StaticResource ProductionMetricLabelStyle}" />
                            <TextBlock Text="{Binding QuoteGoldWeightTotal, StringFormat={}{0:N3}}"
                                       Style="{StaticResource ProductionMetricValueStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ProductionMetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Tổng số lượng sản phẩm" Style="{StaticResource ProductionMetricLabelStyle}" />
                            <TextBlock Text="{Binding QuoteQuantityTotal}"
                                       Style="{StaticResource ProductionMetricValueStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ProductionMetricCardStyle}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="Tổng tiền công dự kiến (VND)" Style="{StaticResource ProductionMetricLabelStyle}" />
                            <TextBlock Text="{Binding QuoteLaborTotal, StringFormat={}{0:N0}}"
                                       Style="{StaticResource ProductionMetricValueStyle}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
