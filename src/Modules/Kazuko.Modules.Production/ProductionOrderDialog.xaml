<Window x:Class="Kazuko.Modules.Production.ProductionOrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:access="clr-namespace:Kazuko.Shared.UI.Behaviors;assembly=Kazuko.Shared.UI"
        xmlns:conv="clr-namespace:Kazuko.Modules.Production.Converters"
        xmlns:grid="clr-namespace:Kazuko.Shared.UI.DataGridLayout;assembly=Kazuko.Shared.UI"
        xmlns:behaviors="clr-namespace:Kazuko.Shared.UI.Behaviors;assembly=Kazuko.Shared.UI"
        Title="{Binding WindowTitle}"
        Width="1260" Height="860" MinWidth="900" MinHeight="680"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/ProductionResources.xaml" />
                <ResourceDictionary Source="/Kazuko.Shared.UI;component/Themes/DatePicker.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
            <conv:BooleanToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
            <conv:InverseBooleanConverter x:Key="InverseBool" />
            <conv:NullOrEmptyToVisibilityConverter x:Key="NotNullToVis" Invert="True" />
            <Style x:Key="ProductionDialogSectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource ProductionSectionHeaderStyle}">
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
            <Style x:Key="ProductionCompactRowLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource ProductionFieldLabelStyle}">
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="ProductionCompactFieldStyle" TargetType="TextBox" BasedOn="{StaticResource ProductionDialogFieldStyle}">
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Padding" Value="10,3" />
            </Style>
            <Style x:Key="ProductionCompactComboStyle" TargetType="ComboBox" BasedOn="{StaticResource ProductionDialogComboStyle}">
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Padding" Value="10,3" />
            </Style>
            <Style x:Key="ProductionCompactDateStyle" TargetType="DatePicker" BasedOn="{StaticResource RoundedDatePickerStyle}">
                <Setter Property="Margin" Value="0" />
            </Style>
            <!-- The header always shows the checked workers, never ComboBox.SelectionBoxItem. -->
            <Style x:Key="ProductionWorkerPickerStyle" TargetType="ComboBox" BasedOn="{StaticResource ProductionCompactComboStyle}">
                <Setter Property="IsTextSearchEnabled" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                    BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                    BorderThickness="1" CornerRadius="8" Padding="10,3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="WorkerSummary" Text="{Binding SelectedWorkerDisplayText, Mode=OneWay}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="{DynamicResource FontSize.Body}"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding SelectedWorkerDisplayText}" />
                                                    <Path Grid.Column="1" Data="M 0 0 L 6 6 L 12 0" Stroke="{DynamicResource TextSecondaryBrush}"
                                                          StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True" Focusable="False">
                                    <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                            MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,2,0,0" Padding="4"
                                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/></Trigger>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.7"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding ErrorMessage}"
                   Style="{StaticResource ProductionErrorStyle}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVis}}" />

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollBarVisibility="Auto">
            <Grid MinWidth="1020"
                  Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="100" />
                    <RowDefinition Height="*" MinHeight="100" />
                </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="1   Thông tin lệnh"
                           Style="{StaticResource ProductionDialogSectionHeaderStyle}" />
                <Border Style="{StaticResource ProductionCardStyle}" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" MinWidth="200" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Mã lệnh" Style="{StaticResource ProductionCompactRowLabelStyle}" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Code, Mode=OneWay}" IsReadOnly="True"
                                     Style="{StaticResource ProductionCompactFieldStyle}" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Hình thức" Style="{StaticResource ProductionCompactRowLabelStyle}" />
                            <ComboBox Grid.Row="0" Grid.Column="4"
                                      ItemsSource="{Binding ExecutionTypeOptions}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedItem="{Binding SelectedExecutionTypeOption}"
                                      Style="{StaticResource ProductionCompactComboStyle}"
                                      Margin="0,0,0,4"
                                      IsEnabled="{Binding IsDraft}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Ngày lập" Style="{StaticResource ProductionCompactRowLabelStyle}" />
                            <DatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding OrderDate}"
                                        Style="{StaticResource ProductionCompactDateStyle}"
                                        Margin="0,0,0,4"
                                        IsEnabled="{Binding IsDraft}" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="Loại SX" Style="{StaticResource ProductionCompactRowLabelStyle}"
                                       ToolTip="Loại sản xuất" />
                            <ComboBox Grid.Row="1" Grid.Column="4"
                                      ItemsSource="{Binding OrderSourceOptions}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedItem="{Binding SelectedOrderSourceOption}"
                                      Style="{StaticResource ProductionCompactComboStyle}"
                                      Margin="0,0,0,4"
                                      IsEnabled="{Binding IsDraft}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Ngày giao" Style="{StaticResource ProductionCompactRowLabelStyle}" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding IssueDateDisplay, Mode=OneWay}" IsReadOnly="True"
                                     Style="{StaticResource ProductionCompactFieldStyle}" Margin="0,0,0,4"
                                     ToolTip="Ngày ghi sổ giao nguyên liệu cho thợ — trống khi còn bản nháp." />
                            <TextBlock Grid.Row="2" Grid.Column="3" Text="Hạn HT" Style="{StaticResource ProductionCompactRowLabelStyle}"
                                       ToolTip="Hạn hoàn thành" />
                            <DatePicker Grid.Row="2" Grid.Column="4" SelectedDate="{Binding DueDate}"
                                        Style="{StaticResource ProductionCompactDateStyle}"
                                        Margin="0,0,0,4"
                                        IsEnabled="{Binding IsDraft}" />

                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,0,0,4"
                                        Visibility="{Binding IsSalesOrderSource, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Đơn ĐH *" Style="{StaticResource ProductionCompactRowLabelStyle}"
                                               ToolTip="Đơn đặt hàng" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding SalesOrderOptions}"
                                              SelectedItem="{Binding SelectedSalesOrder}"
                                              DisplayMemberPath="DisplayText"
                                              Style="{StaticResource ProductionCompactComboStyle}"
                                              IsEnabled="{Binding IsDraft}" />
                                    <TextBlock Grid.Column="3" Text="Khách hàng" Style="{StaticResource ProductionCompactRowLabelStyle}" />
                                    <TextBlock Grid.Column="4" Text="{Binding SelectedSalesOrderCustomer}"
                                               Style="{StaticResource ProductionHintStyle}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Thợ SX"
                                       Style="{StaticResource ProductionCompactRowLabelStyle}"
                                       Visibility="{Binding IsInHouse, Converter={StaticResource BoolToVis}}"
                                       ToolTip="Thợ sản xuất" />
                            <ComboBox x:Name="WorkerPicker" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4"
                                      Style="{StaticResource ProductionWorkerPickerStyle}"
                                      ItemsSource="{Binding SelectableEmployees}"
                                      PreviewKeyDown="WorkerPicker_OnPreviewKeyDown"
                                      IsEnabled="{Binding IsDraft}"
                                      Margin="0,0,0,4"
                                      Visibility="{Binding IsInHouse, Converter={StaticResource BoolToVis}}"
                                      ToolTip="Bấm để chọn nhiều thợ">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="WorkerItem_OnPreviewMouseLeftButtonDown" />
                                        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="WorkerItem_OnPreviewMouseLeftButtonUp" />
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding DisplayText}"
                                                  IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                  Focusable="False" Background="Transparent"
                                                  VerticalContentAlignment="Center"
                                                  Padding="4,2" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Xưởng"
                                       Style="{StaticResource ProductionCompactRowLabelStyle}"
                                       Visibility="{Binding IsOutsourced, Converter={StaticResource BoolToVis}}"
                                       ToolTip="Xưởng chế tác" />
                            <Grid Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,0,0,4"
                                  Visibility="{Binding IsOutsourced, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding ExternalWorkers}" DisplayMemberPath="DisplayName"
                                          SelectedValue="{Binding ExternalWorkerId}" SelectedValuePath="Id"
                                          Style="{StaticResource ProductionCompactComboStyle}"
                                          IsEnabled="{Binding IsDraft}" />
                                <Button access:PermissionAccess.Rule="CAT_EXTERNAL_WORKERS:Add" Grid.Column="2" Content="Thêm thợ"
                                        Command="{Binding CreateExternalWorkerCommand}"
                                        Style="{StaticResource ProductionPrimaryButtonStyle}"
                                        MinHeight="28" Padding="12,2"
                                        IsEnabled="{Binding IsDraft}"
                                        ToolTip="Mở nhanh danh mục thêm/sửa thợ ngoài" />
                            </Grid>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Ghi chú" Style="{StaticResource ProductionCompactRowLabelStyle}" />
                            <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="4"
                                     Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ProductionCompactFieldStyle}"
                                     MinHeight="28" TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalContentAlignment="Center" IsEnabled="{Binding IsDraft}" />
                        </Grid>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Hình ảnh mẫu/thiết kế"
                                       Style="{StaticResource ProductionFieldLabelStyle}"
                                       Margin="0,0,0,4" />
                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="6"
                                    MinHeight="96"
                                    MaxHeight="120"
                                    Visibility="{Binding HasGalleryImages, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>

                                    <Border Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            ClipToBounds="True"
                                            Cursor="Hand"
                                            ToolTip="Nhấn để phóng to">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding OpenGalleryImageCommand}"
                                                          CommandParameter="{Binding SelectedGalleryImage}" />
                                        </Border.InputBindings>
                                        <Image Source="{Binding SelectedGalleryImage.LocalPath, Mode=OneWay, Converter={StaticResource PathToImageSourceConverter}}"
                                               Stretch="Uniform"
                                               Margin="4"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>

                                    <ScrollViewer Grid.Column="2"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding GalleryImages}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="64" Height="64"
                                                            Margin="0,0,0,6"
                                                            CornerRadius="6"
                                                            ClipToBounds="True"
                                                            Cursor="Hand"
                                                            BorderThickness="2"
                                                            Background="{DynamicResource SurfaceBrush}"
                                                            ToolTip="{Binding Caption}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Border.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick"
                                                                          Command="{Binding DataContext.SelectGalleryImageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          CommandParameter="{Binding}" />
                                                        </Border.InputBindings>
                                                        <Image Source="{Binding LocalPath, Mode=OneWay, Converter={StaticResource PathToImageSourceConverter}}"
                                                               Stretch="UniformToFill"
                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                            <TextBlock Text="Chưa có ảnh sản phẩm. Thêm ảnh trong hộp thoại sản phẩm."
                                       Style="{StaticResource ProductionHintStyle}"
                                       Visibility="{Binding HasGalleryImages, Converter={StaticResource InverseBoolToVis}}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </DockPanel>

            <DockPanel Grid.Row="1" Margin="0,0,0,8" LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="2   Sản phẩm giao chế tác"
                           Style="{StaticResource ProductionDialogSectionHeaderStyle}" />
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Top" Style="{StaticResource ProductionCardStyle}" Padding="10,6" Margin="0,0,0,8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Thêm sản phẩm"
                                        Style="{StaticResource ProductionPrimaryButtonStyle}"
                                        Command="{Binding AddLineCommand}"
                                        MinHeight="36"
                                        IsEnabled="{Binding IsDraft}" />
                                <Button Content="Xem / sửa sản phẩm"
                                        Style="{StaticResource ProductionOutlineButtonStyle}"
                                        Command="{Binding EditLineCommand}"
                                        CommandParameter="{Binding SelectedLine}"
                                        MinHeight="36" />
                                <Button Content="Xóa sản phẩm"
                                        Style="{StaticResource ProductionGhostButtonStyle}"
                                        Command="{Binding RemoveLineCommand}"
                                        CommandParameter="{Binding SelectedLine}"
                                        MinHeight="36" Margin="0"
                                        IsEnabled="{Binding IsDraft}" />
                            </StackPanel>
                            <TextBlock Text="Nhấp đúp vào sản phẩm để xem hoặc sửa. Mỗi sản phẩm có thể đính kèm ảnh và file thiết kế."
                                       Style="{StaticResource ProductionHintStyle}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource ProductionCardStyle}" Padding="0">
                        <DataGrid Style="{StaticResource ProductionDataGridStyle}"
                                  ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}"
                                  MinHeight="80"
                                  BorderThickness="0"
                                  MouseDoubleClick="LinesGrid_OnMouseDoubleClick"
                                  grid:DataGridColumnLayout.SettingsKey="production.order.lines">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT" Binding="{Binding LineNumber, Mode=OneWay}" Width="50"
                                                    grid:DataGridColumnLayout.Key="LineNumber" />
                                <DataGridTextColumn Header="Mã mẫu" Binding="{Binding ModelCode, Mode=OneWay}" Width="100"
                                                    grid:DataGridColumnLayout.Key="ModelCode" />
                                <DataGridTextColumn Header="Tên mẫu" Binding="{Binding ModelName, Mode=OneWay}" Width="*" MinWidth="140"
                                                    grid:DataGridColumnLayout.Key="ModelName" />
                                <DataGridTextColumn Header="Loại vàng" Binding="{Binding GoldTypeName, Mode=OneWay}" Width="120"
                                                    grid:DataGridColumnLayout.Key="GoldType" />
                                <DataGridTextColumn Header="Tuổi vàng" Binding="{Binding GoldTypeCode, Mode=OneWay}" Width="80"
                                                    grid:DataGridColumnLayout.Key="GoldAge" />
                                <DataGridTextColumn Header="SL" Binding="{Binding PlannedQuantity, Mode=OneWay}" Width="50"
                                                    grid:DataGridColumnLayout.Key="Qty" />
                                <DataGridTextColumn Header="TL vàng" Binding="{Binding EstimatedWeightChi, Mode=OneWay, StringFormat=0.###}" Width="70"
                                                    grid:DataGridColumnLayout.Key="Weight" />
                                <DataGridTextColumn Header="Giá vàng" Binding="{Binding GoldUnitPricePerChi, Mode=OneWay, StringFormat=N0}" Width="90"
                                                    grid:DataGridColumnLayout.Key="GoldPrice" />
                                <DataGridTextColumn Header="Công/món" Binding="{Binding LaborCostPerUnit, Mode=OneWay, StringFormat=N0}" Width="90"
                                                    grid:DataGridColumnLayout.Key="Labor" />
                                <DataGridTextColumn Header="Thành tiền" Binding="{Binding QuoteLineTotal, Mode=OneWay, StringFormat=N0}" Width="110"
                                                    grid:DataGridColumnLayout.Key="QuoteTotal" />
                                <DataGridTextColumn Header="Ghi chú" Binding="{Binding Notes, Mode=OneWay}" Width="160" MinWidth="100"
                                                    grid:DataGridColumnLayout.Key="LineNotes" />
                                <DataGridTextColumn Header="Đính kèm" Binding="{Binding AttachmentSummary, Mode=OneWay}" Width="110"
                                                    grid:DataGridColumnLayout.Key="Attachments" />
                                <DataGridTemplateColumn Header="" Width="120" grid:DataGridColumnLayout.Key="Actions">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Sửa"
                                                        Style="{StaticResource ProductionGridActionButtonStyle}"
                                                        Command="{Binding DataContext.EditLineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="Xóa"
                                                        Style="{StaticResource ProductionGridActionButtonStyle}"
                                                        Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding DataContext.IsDraft, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>
            </DockPanel>

            <Grid Grid.Row="2" Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="690" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" MinWidth="280" />
                </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="3   Giao nguyên vật liệu"
                           Style="{StaticResource ProductionDialogSectionHeaderStyle}" />
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Top" Style="{StaticResource ProductionEmptyStateStyle}"
                            Visibility="{Binding ShowIssueComposer, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="{Binding IssueTabEmptyMessage}" Style="{StaticResource ProductionHintStyle}" />
                    </Border>
                    <Border DockPanel.Dock="Top" Style="{StaticResource ProductionCardStyle}" Padding="10,6" Margin="0,0,0,8"
                            Visibility="{Binding ShowIssueComposer, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="220" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding StockMaterials}"
                                      SelectedItem="{Binding SelectedStockMaterial}"
                                      Style="{StaticResource ProductionDialogComboStyle}"
                                      Margin="0,0,8,0"
                                      IsEnabled="{Binding CanIssueMaterials}"
                                      ToolTip="Chọn loại nguyên vật liệu còn tồn tại kho xuất">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding Code, Mode=OneWay}" />
                                            <Run Text=" — " />
                                            <Run Text="{Binding Name, Mode=OneWay}" />
                                            <Run Text=" (" />
                                            <Run Text="{Binding QuantityOnHand, Mode=OneWay, StringFormat=N3}" />
                                            <Run Text=" " />
                                            <Run Text="{Binding UnitCode, Mode=OneWay}" />
                                            <Run Text=")" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBox Grid.Column="1"
                                     Text="{Binding IssueQuantity, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ViQuantityConverter}}"
                                     Style="{StaticResource ProductionDialogFieldStyle}"
                                     Margin="0,0,8,0"
                                     IsEnabled="{Binding CanIssueMaterials}"
                                     ToolTip="{Binding IssueQuantityHint}"
                                     behaviors:NumericThousandSeparatorBehavior.EnableLiveThousandSeparator="True"
                                     behaviors:NumericThousandSeparatorBehavior.AllowDecimal="True" />
                            <Button Grid.Column="2" Content="Thêm"
                                    Style="{StaticResource ProductionOutlineButtonStyle}"
                                    Command="{Binding AddIssueLineCommand}" MinHeight="36" />
                            <Button access:PermissionAccess.Rule="PROD_MATERIAL_ISSUE:Add" Grid.Column="3" Content="Xác nhận giao vàng"
                                    Style="{StaticResource ProductionPrimaryButtonStyle}"
                                    Command="{Binding PostMaterialIssueCommand}" MinHeight="36" Margin="8,0,0,0"
                                    ToolTip="Ghi sổ giao NVL và khóa phiếu — không sửa được sau đó" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource ProductionCardStyle}" Padding="0">
                        <DataGrid Style="{StaticResource ProductionEditableDataGridStyle}"
                                  ItemsSource="{Binding IssueLines}"
                                  MinHeight="80"
                                  IsReadOnly="{Binding ShowIssueHistory}"
                                  BorderThickness="0"
                                  grid:DataGridColumnLayout.SettingsKey="production.order.issue">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Loại NVL" Binding="{Binding MaterialName}" IsReadOnly="True" Width="*"
                                                    grid:DataGridColumnLayout.Key="Name" />
                                <DataGridTextColumn Header="Số lượng"
                                                    Binding="{Binding Quantity, UpdateSourceTrigger=LostFocus, Converter={StaticResource ViQuantityConverter}}"
                                                    Width="100"
                                                    grid:DataGridColumnLayout.Key="Qty">
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="behaviors:NumericThousandSeparatorBehavior.EnableLiveThousandSeparator" Value="True" />
                                            <Setter Property="behaviors:NumericThousandSeparatorBehavior.AllowDecimal" Value="True" />
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Đơn vị" Binding="{Binding UnitCode}" IsReadOnly="True" Width="70"
                                                    grid:DataGridColumnLayout.Key="Unit" />
                                <DataGridTemplateColumn Header="" Width="70" grid:DataGridColumnLayout.Key="Actions">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Xóa"
                                                    Style="{StaticResource ProductionGridActionButtonStyle}"
                                                    Command="{Binding DataContext.RemoveIssueLineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.ShowIssueComposer, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>
            </DockPanel>
            <Border Grid.Column="2" Style="{StaticResource ProductionCardStyle}" VerticalAlignment="Stretch" Margin="0,22,0,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="4   Tiền công và thỏa thuận" Style="{StaticResource ProductionDialogSectionHeaderStyle}" />
                        <TextBlock Text="Tiền công dự kiến" Style="{StaticResource ProductionFieldLabelStyle}" />
                        <TextBlock Text="{Binding QuoteLaborTotal, StringFormat={}{0:N0} VND}"
                                   FontSize="{DynamicResource FontSize.Subtitle}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,8" />
                        <TextBlock Text="Ghi chú tiền công" Style="{StaticResource ProductionFieldLabelStyle}" />
                    </StackPanel>
                    <TextBox Text="{Binding LaborNotes, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ProductionDialogFieldStyle}"
                             MinHeight="40" Margin="0" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalContentAlignment="Top" VerticalAlignment="Stretch"
                             IsEnabled="{Binding IsDraft}" />
                </DockPanel>
            </Border>
            </Grid>

            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Margin="0,14,0,0" Padding="0,12,0,0"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button access:PermissionAccess.Rule="PROD_CANCEL:Delete" Content="Hủy lệnh" Style="{StaticResource ProductionGhostButtonStyle}"
                            Command="{Binding CancelDraftCommand}" />
                    <Button Content="Đóng" Style="{StaticResource ProductionOutlineButtonStyle}"
                            Command="{Binding CloseCommand}" IsCancel="True" />
                    <Button access:PermissionAccess.Rule="PROD_ORDER:Add|PROD_ORDER:Edit" Content="Lưu" Style="{StaticResource ProductionOutlineButtonStyle}"
                            Command="{Binding SaveDraftCommand}" Margin="0,0,8,0"
                            ToolTip="Lưu lệnh (chưa giao NVL), có thể sửa tiếp sau" />
                    <Button access:PermissionAccess.Rule="PROD_MATERIAL_ISSUE:Add" Content="Xác nhận giao vàng" Style="{StaticResource ProductionPrimaryButtonStyle}"
                            Command="{Binding PostMaterialIssueCommand}" IsDefault="True" Margin="0,0,8,0"
                            ToolTip="Lưu lệnh và ghi sổ giao NVL — không sửa được sau đó" />
                    <Button access:PermissionAccess.Rule="PROD_MATERIAL_ISSUE" Content="In phiếu" Style="{StaticResource ProductionOutlineButtonStyle}"
                            Command="{Binding PrintMaterialIssueCommand}" Margin="0" />
                </StackPanel>
                <UniformGrid DockPanel.Dock="Left" Rows="1" Columns="3" Margin="0,0,12,0">
                    <Border Style="{StaticResource ProductionMetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Tổng trọng lượng giao (chỉ)" Style="{StaticResource ProductionMetricLabelStyle}" />
                            <TextBlock Text="{Binding QuoteGoldWeightTotal, StringFormat={}{0:N3}}"
                                       Style="{StaticResource ProductionMetricValueStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ProductionMetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Tổng số lượng sản phẩm" Style="{StaticResource ProductionMetricLabelStyle}" />
                            <TextBlock Text="{Binding QuoteQuantityTotal}"
                                       Style="{StaticResource ProductionMetricValueStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ProductionMetricCardStyle}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="Tổng tiền công dự kiến (VND)" Style="{StaticResource ProductionMetricLabelStyle}" />
                            <TextBlock Text="{Binding QuoteLaborTotal, StringFormat={}{0:N0}}"
                                       Style="{StaticResource ProductionMetricValueStyle}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
