<Window x:Class="Kazuko.Modules.Production.Dialogs.ProductionLineEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Kazuko.Modules.Production.Converters"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Width="760" Height="760"
        MinWidth="680" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Kazuko.Modules.Production;component/Themes/ProductionResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
            <conv:BooleanToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding WindowTitle}"
                       FontSize="{DynamicResource FontSize.Heading}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryBrush}" />
            <TextBlock Text="Nhập thông tin mẫu và đính kèm ảnh / file thiết kế."
                       Margin="0,4,0,0"
                       Style="{StaticResource ProductionHintStyle}" />
            <TextBlock Text="{Binding ErrorMessage}"
                       Style="{StaticResource ProductionErrorStyle}"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource ProductionCardStyle}">
                <StackPanel>
                    <TextBlock Text="Thông tin mẫu" Style="{StaticResource ProductionSectionHeaderStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Mã mẫu" Style="{StaticResource ProductionFieldLabelStyle}" />
                            <TextBox Text="{Binding ModelCode, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ProductionDialogFieldStyle}"
                                     IsEnabled="{Binding IsEditable}" />
                            <TextBlock Text="Tên mẫu *" Style="{StaticResource ProductionFieldLabelStyle}" />
                            <TextBox Text="{Binding ModelName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ProductionDialogFieldStyle}"
                                     IsEnabled="{Binding IsEditable}" />
                            <TextBlock Text="Số lượng cần làm *" Style="{StaticResource ProductionFieldLabelStyle}" />
                            <TextBox Text="{Binding PlannedQuantityText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ProductionDialogFieldStyle}"
                                     IsEnabled="{Binding IsEditable}" />
                            <TextBlock Text="Tiền công mỗi món" Style="{StaticResource ProductionFieldLabelStyle}" />
                            <TextBox Text="{Binding LaborCostPerUnitText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ProductionDialogFieldStyle}"
                                     IsEnabled="{Binding IsEditable}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Loại vàng (kho NVL) *" Style="{StaticResource ProductionFieldLabelStyle}" />
                            <ComboBox ItemsSource="{Binding GoldStockOptions}"
                                      SelectedItem="{Binding SelectedGoldStock}"
                                      Style="{StaticResource ProductionDialogComboStyle}"
                                      IsEnabled="{Binding IsEditable}"
                                      ToolTip="Chọn vàng còn tồn tại kho xuất; mỗi dòng hiện tồn hiện tại">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding Code, Mode=OneWay}" />
                                            <Run Text=" — " />
                                            <Run Text="{Binding Name, Mode=OneWay}" />
                                            <Run Text=" (" />
                                            <Run Text="{Binding QuantityOnHand, Mode=OneWay, StringFormat=N3}" />
                                            <Run Text=" " />
                                            <Run Text="{Binding UnitCode, Mode=OneWay}" />
                                            <Run Text=")" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{Binding SelectedGoldStockHint, Mode=OneWay}"
                                       Style="{StaticResource ProductionHintStyle}"
                                       Margin="0,0,0,10"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Mô tả mẫu" Style="{StaticResource ProductionFieldLabelStyle}" />
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ProductionDialogFieldStyle}"
                             MinHeight="72" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalContentAlignment="Top"
                             IsEnabled="{Binding IsEditable}" />

                    <TextBlock Text="Ghi chú" Style="{StaticResource ProductionFieldLabelStyle}" />
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ProductionDialogFieldStyle}"
                             MinHeight="56" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalContentAlignment="Top"
                             IsEnabled="{Binding IsEditable}" />

                    <DockPanel Margin="0,8,0,8">
                        <Button DockPanel.Dock="Right" Content="Thêm ảnh mẫu..."
                                Style="{StaticResource ProductionOutlineButtonStyle}"
                                Command="{Binding AddSampleImageCommand}"
                                MinHeight="36" Margin="0"
                                Visibility="{Binding IsEditable, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="Ảnh mẫu" Style="{StaticResource ProductionSectionHeaderStyle}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding SampleImages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ProductionAttachmentCardStyle}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="Mở" Style="{StaticResource ProductionGridActionButtonStyle}"
                                                    Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Gỡ" Style="{StaticResource ProductionGridActionButtonStyle}"
                                                    Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding OriginalFileName}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Chưa có ảnh mẫu."
                               Style="{StaticResource ProductionHintStyle}"
                               Margin="0,0,0,12"
                               Visibility="{Binding HasSampleImages, Converter={StaticResource InverseBoolToVis}}" />

                    <DockPanel Margin="0,4,0,8">
                        <Button DockPanel.Dock="Right" Content="Thêm file thiết kế..."
                                Style="{StaticResource ProductionOutlineButtonStyle}"
                                Command="{Binding AddDesignFileCommand}"
                                MinHeight="36" Margin="0"
                                Visibility="{Binding IsEditable, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="File thiết kế" Style="{StaticResource ProductionSectionHeaderStyle}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding DesignFiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ProductionAttachmentCardStyle}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="Mở" Style="{StaticResource ProductionGridActionButtonStyle}"
                                                    Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Gỡ" Style="{StaticResource ProductionGridActionButtonStyle}"
                                                    Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding OriginalFileName}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding KindDisplayName}"
                                                       Style="{StaticResource ProductionHintStyle}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Chưa có file thiết kế."
                               Style="{StaticResource ProductionHintStyle}"
                               Visibility="{Binding HasDesignFiles, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="2" Margin="0,14,0,0" Padding="0,12,0,0"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy" Style="{StaticResource ProductionGhostButtonStyle}"
                        Command="{Binding CancelCommand}" IsCancel="True" />
                <Button Content="Lưu mẫu" Style="{StaticResource ProductionPrimaryButtonStyle}"
                        Command="{Binding SaveCommand}" IsDefault="True" Margin="0"
                        Visibility="{Binding IsEditable, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
