<Window x:Class="Kazuko.Modules.Production.Dialogs.CraftOrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Kazuko.Modules.Production.Converters"
        Title="Tạo đơn đặt chế tác"
        Width="920" Height="780"
        MinWidth="800" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Kazuko.Modules.Production;component/Themes/ProductionResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
            <conv:NullOrEmptyToVisibilityConverter x:Key="NotNullToVis" Invert="True" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Tạo đơn đặt chế tác"
                       FontSize="{DynamicResource FontSize.Heading}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryBrush}" />
            <TextBlock Text="Chọn khách, khai mẫu báo giá và thu đặt cọc. Sau đó gắn lệnh sản xuất theo đơn đặt này."
                       Margin="0,4,0,0"
                       Style="{StaticResource ProductionHintStyle}" />
            <TextBlock Text="{Binding ErrorMessage}"
                       Style="{StaticResource ProductionErrorStyle}"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVis}}" />
            <TextBlock Text="{Binding StatusMessage}"
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource SuccessBrush}"
                       Visibility="{Binding StatusMessage, Converter={StaticResource NotNullToVis}}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource ProductionCardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Khách hàng" Style="{StaticResource ProductionSectionHeaderStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <TextBox x:Name="CustomerSearchBox"
                                         Text="{Binding CustomerSearch, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ProductionDialogFieldStyle}"
                                         Margin="0"
                                         ToolTip="Gõ mã, tên hoặc SĐT để xem gợi ý" />
                                <Popup IsOpen="{Binding IsCustomerSuggestionsOpen}"
                                       PlacementTarget="{Binding ElementName=CustomerSearchBox}"
                                       Placement="Bottom"
                                       StaysOpen="False"
                                       AllowsTransparency="True"
                                       PopupAnimation="Fade">
                                    <Border Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            MinWidth="{Binding ActualWidth, ElementName=CustomerSearchBox}"
                                            MaxHeight="220"
                                            Padding="0">
                                        <ListBox ItemsSource="{Binding Customers}"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 MaxHeight="220">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding DisplayText}"
                                                            Command="{Binding DataContext.SelectCustomerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            HorizontalContentAlignment="Left"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="10,8"
                                                            Cursor="Hand"
                                                            FontSize="{DynamicResource FontSize.Body}"
                                                            Foreground="{DynamicResource TextPrimaryBrush}" />
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </Popup>
                            </Grid>
                            <Button Grid.Column="2"
                                    Content="+"
                                    Style="{StaticResource ProductionOutlineButtonStyle}"
                                    Command="{Binding CreateCustomerCommand}"
                                    ToolTip="Thêm khách hàng"
                                    MinHeight="36" MinWidth="40"
                                    FontSize="{DynamicResource FontSize.Subtitle}"
                                    FontWeight="SemiBold" />
                        </Grid>
                        <TextBlock Text="{Binding SelectedCustomerHint}"
                                   Margin="0,6,0,0"
                                   Style="{StaticResource ProductionHintStyle}"
                                   Visibility="{Binding HasSelectedCustomer, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="Ngày đặt" Style="{StaticResource ProductionFieldLabelStyle}" />
                        <DatePicker SelectedDate="{Binding OrderDate}" Margin="0,0,0,8" MinHeight="36" />
                        <TextBlock Text="Ghi chú" Style="{StaticResource ProductionFieldLabelStyle}" />
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ProductionDialogFieldStyle}"
                                 AcceptsReturn="True" Height="56"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ProductionCardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Thêm mẫu"
                                    Style="{StaticResource ProductionOutlineButtonStyle}"
                                    Command="{Binding AddLineCommand}"
                                    MinHeight="32" />
                            <TextBlock Text="Mẫu báo giá" Style="{StaticResource ProductionSectionHeaderStyle}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Lines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="Tên mẫu *" Style="{StaticResource ProductionFieldLabelStyle}" />
                                                <TextBox Text="{Binding ModelName, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource ProductionDialogFieldStyle}" Margin="0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                <TextBlock Text="Tuổi vàng *" Style="{StaticResource ProductionFieldLabelStyle}" />
                                                <ComboBox ItemsSource="{Binding DataContext.GoldTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedValue="{Binding GoldPurity}"
                                                          SelectedValuePath="Code"
                                                          DisplayMemberPath="Code"
                                                          Style="{StaticResource ProductionDialogComboStyle}"
                                                          Margin="0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="0,0,8,0" MinWidth="64">
                                                <TextBlock Text="SL *" Style="{StaticResource ProductionFieldLabelStyle}" />
                                                <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource ProductionDialogFieldStyle}" Margin="0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                                <TextBlock Text="TL (chỉ)" Style="{StaticResource ProductionFieldLabelStyle}" />
                                                <TextBox Text="{Binding EstimatedWeightChi, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource ProductionDialogFieldStyle}" Margin="0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" Margin="0,0,8,0">
                                                <TextBlock Text="Giá vàng" Style="{StaticResource ProductionFieldLabelStyle}" />
                                                <TextBox Text="{Binding GoldUnitPricePerChi, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource ProductionDialogFieldStyle}" Margin="0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="5" Margin="0,0,8,0">
                                                <TextBlock Text="Tiền công" Style="{StaticResource ProductionFieldLabelStyle}" />
                                                <TextBox Text="{Binding LaborAmountPerUnitVnd, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource ProductionDialogFieldStyle}" Margin="0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="6" Margin="0,0,8,0">
                                                <TextBlock Text="Đá" Style="{StaticResource ProductionFieldLabelStyle}" />
                                                <TextBox Text="{Binding StoneAmountPerUnitVnd, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource ProductionDialogFieldStyle}" Margin="0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="7" VerticalAlignment="Bottom">
                                                <TextBlock Text="{Binding LineTotalDisplay}" Margin="0,0,0,6"
                                                           FontWeight="SemiBold" />
                                                <Button Content="Xóa"
                                                        Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource ProductionOutlineButtonStyle}"
                                                        MinHeight="32" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding QuotedTotalDisplay, StringFormat=Tổng báo giá: {0}}"
                                   FontWeight="SemiBold"
                                   FontSize="{DynamicResource FontSize.Body}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ProductionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Đặt cọc" Style="{StaticResource ProductionSectionHeaderStyle}" />
                        <TextBlock Text="Số tiền cọc *" Style="{StaticResource ProductionFieldLabelStyle}" />
                        <TextBox Text="{Binding DepositAmount, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ProductionDialogFieldStyle}" />
                        <TextBlock Text="Phương thức" Style="{StaticResource ProductionFieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding PaymentMethodOptions}"
                                  SelectedItem="{Binding SelectedPaymentMethodOption}"
                                  DisplayMemberPath="DisplayName"
                                  Style="{StaticResource ProductionDialogComboStyle}" />
                        <StackPanel Visibility="{Binding RequiresCashFund, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Quỹ tiền mặt *" Style="{StaticResource ProductionFieldLabelStyle}" />
                            <ComboBox ItemsSource="{Binding CashFunds}"
                                      SelectedItem="{Binding SelectedCashFund}"
                                      DisplayMemberPath="DisplayName"
                                      Style="{StaticResource ProductionDialogComboStyle}" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding RequiresBankAccount, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Tài khoản NH *" Style="{StaticResource ProductionFieldLabelStyle}" />
                            <ComboBox ItemsSource="{Binding BankAccounts}"
                                      SelectedItem="{Binding SelectedBankAccount}"
                                      DisplayMemberPath="DisplayName"
                                      Style="{StaticResource ProductionDialogComboStyle}" />
                        </StackPanel>
                        <TextBlock Text="Tham chiếu" Style="{StaticResource ProductionFieldLabelStyle}" />
                        <TextBox Text="{Binding PaymentReference, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ProductionDialogFieldStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Đóng"
                    Style="{StaticResource ProductionOutlineButtonStyle}"
                    Command="{Binding CloseCommand}"
                    MinWidth="100" MinHeight="36" Margin="0,0,8,0" />
            <Button Content="Lưu đơn + thu cọc"
                    Style="{StaticResource ProductionPrimaryButtonStyle}"
                    Command="{Binding SaveCommand}"
                    MinWidth="160" MinHeight="36" />
        </StackPanel>
    </Grid>
</Window>
