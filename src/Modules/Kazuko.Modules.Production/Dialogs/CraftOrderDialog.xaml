<Window x:Class="Kazuko.Modules.Production.Dialogs.CraftOrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:Kazuko.Shared.UI.Behaviors;assembly=Kazuko.Shared.UI"
        xmlns:conv="clr-namespace:Kazuko.Modules.Production.Converters"
        Title="Tạo đơn đặt chế tác"
        Width="920" Height="780"
        MinWidth="800" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Kazuko.Modules.Production;component/Themes/ProductionResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
            <conv:NullOrEmptyToVisibilityConverter x:Key="NotNullToVis" Invert="True" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Tạo đơn đặt chế tác"
                       FontSize="{DynamicResource FontSize.Heading}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryBrush}" />
            <TextBlock Text="Chọn khách, khai mẫu báo giá và thu đặt cọc. Sau đó gắn lệnh sản xuất theo đơn đặt này."
                       Margin="0,4,0,0"
                       Style="{StaticResource ProductionHintStyle}" />
            <TextBlock Text="{Binding ErrorMessage}"
                       Style="{StaticResource ProductionErrorStyle}"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVis}}" />
            <TextBlock Text="{Binding StatusMessage}"
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource SuccessBrush}"
                       Visibility="{Binding StatusMessage, Converter={StaticResource NotNullToVis}}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource ProductionCardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Khách hàng" Style="{StaticResource ProductionSectionHeaderStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox IsEditable="True"
                                      IsTextSearchEnabled="False"
                                      Text="{Binding CustomerSearch, UpdateSourceTrigger=PropertyChanged}"
                                      ItemsSource="{Binding Customers}"
                                      DisplayMemberPath="DisplayText"
                                      SelectedItem="{Binding SelectedCustomer}"
                                      IsDropDownOpen="{Binding IsCustomerSuggestionsOpen, Mode=TwoWay}"
                                      Style="{StaticResource ProductionDialogComboStyle}"
                                      Margin="0"
                                      ToolTip="Gõ mã, tên hoặc SĐT để tìm khách hàng" />
                            <Button Grid.Column="2"
                                    Content="+"
                                    Style="{StaticResource ProductionOutlineButtonStyle}"
                                    Command="{Binding CreateCustomerCommand}"
                                    ToolTip="Thêm khách hàng"
                                    MinHeight="36" MinWidth="40"
                                    FontSize="{DynamicResource FontSize.Subtitle}"
                                    FontWeight="SemiBold" />
                        </Grid>
                        <TextBlock Text="{Binding SelectedCustomerHint}"
                                   Margin="0,6,0,0"
                                   Style="{StaticResource ProductionHintStyle}"
                                   Visibility="{Binding HasSelectedCustomer, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="Ngày đặt" Style="{StaticResource ProductionFieldLabelStyle}" />
                        <DatePicker SelectedDate="{Binding OrderDate}" Margin="0,0,0,8" MinHeight="36" />
                        <TextBlock Text="Ghi chú" Style="{StaticResource ProductionFieldLabelStyle}" />
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ProductionDialogFieldStyle}"
                                 AcceptsReturn="True" Height="56"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ProductionCardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="+ Thêm mẫu"
                                    Command="{Binding AddLineCommand}"
                                    Style="{StaticResource ProductionPrimaryButtonStyle}"
                                    MinHeight="36" MinWidth="110" />
                            <StackPanel>
                                <TextBlock Text="Mẫu báo giá" Style="{StaticResource ProductionSectionHeaderStyle}" />
                                <TextBlock Text="Mở cùng biểu mẫu sản phẩm của lệnh sản xuất; hỗ trợ mã mẫu, ảnh và file thiết kế."
                                           Style="{StaticResource ProductionHintStyle}" />
                            </StackPanel>
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding Lines}"
                                  Style="{StaticResource ProductionDataGridStyle}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  Margin="0,0,0,8"
                                  MaxHeight="220">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT" Binding="{Binding LineNumber}" Width="50"
                                                    IsReadOnly="True" />
                                <DataGridTextColumn Header="Mã mẫu" Binding="{Binding ModelCode}" Width="105"
                                                    IsReadOnly="True" />
                                <DataGridTextColumn Header="Tên mẫu" Binding="{Binding ModelName}" Width="*"
                                                    IsReadOnly="True" />
                                <DataGridTextColumn Header="Tuổi vàng" Binding="{Binding GoldTypeCode}" Width="80"
                                                    IsReadOnly="True" />
                                <DataGridTextColumn Header="SL" Binding="{Binding PlannedQuantity}" Width="60"
                                                    IsReadOnly="True" />
                                <DataGridTextColumn Header="TL (chỉ)" Binding="{Binding EstimatedWeightChi}" Width="80"
                                                    IsReadOnly="True" />
                                <DataGridTextColumn Header="Giá vàng" Binding="{Binding GoldUnitPricePerChi, StringFormat=N0}" Width="100"
                                                    IsReadOnly="True" />
                                <DataGridTextColumn Header="Tiền công" Binding="{Binding LaborCostPerUnit, StringFormat=N0}" Width="110"
                                                    IsReadOnly="True" />
                                <DataGridTextColumn Header="Đính kèm" Binding="{Binding AttachmentSummary}" Width="100"
                                                    IsReadOnly="True" />
                                <DataGridTextColumn Header="Thành tiền" Binding="{Binding QuoteLineTotal, StringFormat=N0}" Width="120"
                                                    IsReadOnly="True" />
                                <DataGridTemplateColumn Header="" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Sửa"
                                                        Command="{Binding DataContext.EditLineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource ProductionOutlineButtonStyle}"
                                                        MinHeight="28" Padding="8,2" Margin="0,0,4,0" />
                                                <Button Content="Xóa"
                                                        Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource ProductionOutlineButtonStyle}"
                                                        MinHeight="28" Padding="8,2" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{Binding QuotedTotalDisplay, StringFormat=Tổng báo giá: {0}}"
                                   FontWeight="SemiBold"
                                   FontSize="{DynamicResource FontSize.Body}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ProductionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Đặt cọc" Style="{StaticResource ProductionSectionHeaderStyle}" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Tiền mặt (VND)" Style="{StaticResource ProductionFieldLabelStyle}" />
                                <TextBox Text="{Binding CashAmount, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ViMoneyConverter}}"
                                         Style="{StaticResource ProductionDialogFieldStyle}" Margin="0"
                             behaviors:NumericThousandSeparatorBehavior.EnableLiveThousandSeparator="True" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Chuyển khoản (VND)" Style="{StaticResource ProductionFieldLabelStyle}" />
                                <TextBox Text="{Binding TransferAmount, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ViMoneyConverter}}"
                                         Style="{StaticResource ProductionDialogFieldStyle}" Margin="0"
                             behaviors:NumericThousandSeparatorBehavior.EnableLiveThousandSeparator="True" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Thẻ (VND)" Style="{StaticResource ProductionFieldLabelStyle}" />
                                <TextBox Text="{Binding CardAmount, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ViMoneyConverter}}"
                                         Style="{StaticResource ProductionDialogFieldStyle}" Margin="0"
                             behaviors:NumericThousandSeparatorBehavior.EnableLiveThousandSeparator="True" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding DepositTotalDisplay, StringFormat=Tổng cọc: {0}}"
                                   FontWeight="SemiBold"
                                   FontSize="{DynamicResource FontSize.Body}"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="Quỹ tiền mặt" Style="{StaticResource ProductionFieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding CashFunds}"
                                  SelectedItem="{Binding SelectedCashFund}"
                                  DisplayMemberPath="DisplayName"
                                  Style="{StaticResource ProductionDialogComboStyle}"
                                  Margin="0,0,0,8" />
                        <TextBlock Text="Tài khoản NH" Style="{StaticResource ProductionFieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding BankAccounts}"
                                  SelectedItem="{Binding SelectedBankAccount}"
                                  DisplayMemberPath="DisplayName"
                                  Style="{StaticResource ProductionDialogComboStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Đóng"
                    Style="{StaticResource ProductionOutlineButtonStyle}"
                    Command="{Binding CloseCommand}"
                    MinWidth="100" MinHeight="36" Margin="0,0,8,0" />
            <Button Content="Lưu đơn + thu cọc"
                    Style="{StaticResource ProductionPrimaryButtonStyle}"
                    Command="{Binding SaveCommand}"
                    MinWidth="160" MinHeight="36" />
        </StackPanel>
    </Grid>
</Window>
