<Window x:Class="Kazuko.Modules.Production.Dialogs.ProductionImageViewerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title, Mode=OneWay}"
        Width="960" Height="720"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding Title, Mode=OneWay}"
                   FontSize="{DynamicResource FontSize.Subtitle}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryBrush}"
                   TextTrimming="CharacterEllipsis"
                   Margin="0,0,0,10" />

        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                ClipToBounds="True">
            <ScrollViewer x:Name="ImageScroll"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          CanContentScroll="False">
                <Image Source="{Binding ImagePath, Mode=OneWay, Converter={StaticResource PathToImageSourceConverter}}"
                       Stretch="None"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                    </Image.RenderTransform>
                </Image>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="2"
                   Margin="0,10,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="{DynamicResource FontSize.Caption}"
                   Text="Cuộn chuột để phóng to/thu nhỏ · Esc để đóng" />
    </Grid>
</Window>
