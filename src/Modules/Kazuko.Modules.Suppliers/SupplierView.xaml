<UserControl x:Class="Kazuko.Modules.Suppliers.SupplierView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:access="clr-namespace:Kazuko.Shared.UI.Behaviors;assembly=Kazuko.Shared.UI"
             xmlns:conv="clr-namespace:Kazuko.Modules.Suppliers.Converters"
             xmlns:behaviors="clr-namespace:Kazuko.Shared.UI.Behaviors;assembly=Kazuko.Shared.UI"
             xmlns:grid="clr-namespace:Kazuko.Shared.UI.DataGridLayout;assembly=Kazuko.Shared.UI"
             MinWidth="900" MinHeight="520">
    <UserControl.InputBindings>
        <KeyBinding Key="F1" Command="{Binding AddCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Kazuko.Modules.Suppliers;component/Themes/SupplierWorkspaceResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
            <conv:BooleanToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
            <conv:NullOrEmptyToVisibilityConverter x:Key="NullToVis" />
            <conv:NullOrEmptyToVisibilityConverter x:Key="NotNullToVis" Invert="True" />

            <Style x:Key="FilterFieldStyle" TargetType="TextBox" BasedOn="{StaticResource RoundedTextBoxStyle}">
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>

            <Style x:Key="DetailValueStyle" TargetType="TextBox" BasedOn="{StaticResource RoundedTextBoxStyle}">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="10,4" />
            </Style>

            <!-- Rounded ComboBox -->
            <Style x:Key="FilterComboStyle" TargetType="ComboBox">
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="ToggleButton"
                                              Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="ComboBd"
                                                    Background="{DynamicResource SurfaceBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="28" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="Transparent" />
                                                    <Path Grid.Column="1"
                                                          Data="M 0 0 L 6 6 L 12 0"
                                                          Stroke="{DynamicResource TextSecondaryBrush}"
                                                          StrokeThickness="1.5"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter Margin="12,0,32,0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                                <Popup x:Name="Popup"
                                       Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Slide">
                                    <Border Margin="0,2,0,0"
                                            MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                            MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DisabledImportButtonStyle" TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="Opacity" Value="0.75" />
                <Setter Property="ToolTip" Value="Chưa triển khai" />
            </Style>

            <Style x:Key="SupplierTabItemStyle" TargetType="TabItem">
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="TabBorder" Background="Transparent" BorderThickness="0,0,0,3"
                                    BorderBrush="Transparent" Padding="{TemplateBinding Padding}" Margin="0,0,4,0"
                                    CornerRadius="6,6,0,0">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.55" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tiêu đề & Nút Thêm mới -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid VerticalAlignment="Center" Margin="0,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="/Kazuko.Modules.Suppliers;component/Assets/icons/hop.png"
                       Width="48" Height="48" Stretch="Uniform" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="NHÀ CUNG CẤP"
                               Foreground="{DynamicResource PrimaryBrush}"
                               FontSize="{DynamicResource FontSize.Heading}"
                               FontWeight="Bold" />
                    <TextBlock Text="Danh mục đối tác cung ứng - Lịch sử mua hàng - Công nợ nhà cung cấp"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="{DynamicResource FontSize.Body}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button access:PermissionAccess.Rule="CAT_SUPPLIERS:Add" Content="Thêm nhà cung cấp (F1)"
                        Style="{StaticResource RoundedPrimaryButtonStyle}"
                        Command="{Binding AddCommand}"
                        Margin="0,0,8,0"
                        MinWidth="210" />
                <Button Content="Nhập Excel"
                        Style="{StaticResource DisabledImportButtonStyle}"
                        Command="{Binding ImportExcelCommand}"
                        IsEnabled="False"
                        MinWidth="120" />
            </StackPanel>
        </Grid>

        <!-- Nội dung chính -->
        <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}" Padding="12">
            <TabControl SelectedIndex="{Binding SelectedTabIndex}"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource SupplierTabItemStyle}">
                <TabItem Header="Danh sách nhà cung cấp">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="0.72*" MinHeight="150" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1.28*" MinHeight="240" />
                        </Grid.RowDefinitions>

                        <!-- Row 0: KPI Summary Cards -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="1.3*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="1.3*" />
                            </Grid.ColumnDefinitions>

                            <!-- Thẻ 1: Tổng NCC -->
                            <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}" Padding="12,8">
                                <StackPanel>
                                    <TextBlock Text="Tổng NCC" Style="{StaticResource DetailLabelStyle}" />
                                    <TextBlock Text="{Binding TotalCount, Mode=OneWay}"
                                               FontSize="{DynamicResource FontSize.Subtitle}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Thẻ 2: Đang hợp tác -->
                            <Border Grid.Column="2" Style="{DynamicResource CardBorderStyle}" Padding="12,8">
                                <StackPanel>
                                    <TextBlock Text="Đang hợp tác" Style="{StaticResource DetailLabelStyle}" />
                                    <TextBlock Text="{Binding ActiveCount, Mode=OneWay}"
                                               FontSize="{DynamicResource FontSize.Subtitle}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource SuccessBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Thẻ 3: Ngừng hợp tác -->
                            <Border Grid.Column="4" Style="{DynamicResource CardBorderStyle}" Padding="12,8">
                                <StackPanel>
                                    <TextBlock Text="Ngừng hợp tác" Style="{StaticResource DetailLabelStyle}" />
                                    <TextBlock Text="{Binding InactiveCount, Mode=OneWay}"
                                               FontSize="{DynamicResource FontSize.Subtitle}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource DangerBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Thẻ 4: Tổng tiền mua -->
                            <Border Grid.Column="6" Style="{DynamicResource CardBorderStyle}" Padding="12,8">
                                <StackPanel>
                                    <TextBlock Text="Tổng tiền hàng nhập" Style="{StaticResource DetailLabelStyle}" />
                                    <TextBlock Text="{Binding TotalPurchasesSumText, Mode=OneWay}"
                                               FontSize="{DynamicResource FontSize.Subtitle}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Thẻ 5: Tổng nợ -->
                            <Border Grid.Column="8" Style="{DynamicResource CardBorderStyle}" Padding="12,8">
                                <StackPanel>
                                    <TextBlock Text="Tổng công nợ" Style="{StaticResource DetailLabelStyle}" />
                                    <TextBlock Text="{Binding TotalDebtSumText, Mode=OneWay}"
                                               FontSize="{DynamicResource FontSize.Subtitle}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Row 1: Filter Toolbar -->
                        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                            <TextBox Width="280"
                                     Style="{StaticResource FilterFieldStyle}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Tìm mã NCC, tên, SĐT, MST, người liên hệ...">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <ComboBox Width="160"
                                      Style="{StaticResource FilterComboStyle}"
                                      ItemsSource="{Binding Groups}"
                                      SelectedItem="{Binding SelectedGroup}"
                                      DisplayMemberPath="Name" />
                            <ComboBox Width="160"
                                      Style="{StaticResource FilterComboStyle}"
                                      ItemsSource="{Binding Regions}"
                                      SelectedItem="{Binding SelectedRegion}" />
                            <ComboBox Width="150"
                                      Style="{StaticResource FilterComboStyle}"
                                      ItemsSource="{Binding StatusOptions}"
                                      SelectedItem="{Binding SelectedStatus}" />
                            <Button Content="Làm mới"
                                    Style="{StaticResource OutlineButtonStyle}"
                                    Command="{Binding RefreshCommand}"
                                    MinWidth="100" />
                            <Button access:PermissionAccess.Rule="DATA_EXPORT" Content="Xuất Excel"
                                    Style="{StaticResource OutlineButtonStyle}"
                                    Command="{Binding ExportExcelCommand}"
                                    CommandParameter="{Binding ElementName=SupplierListGrid}"
                                    MinWidth="110" />
                        </WrapPanel>

                        <!-- Row 2: DataGrid Danh sách -->
                        <Grid Grid.Row="2">
                            <DataGrid x:Name="SupplierListGrid"
                                      ItemsSource="{Binding Suppliers}"
                                      SelectedItem="{Binding SelectedSupplier}"
                                      Style="{StaticResource SupplierDataGridStyle}"
                                      ColumnHeaderStyle="{StaticResource SupplierDataGridColumnHeaderStyle}"
                                      grid:DataGridColumnLayout.SettingsKey="suppliers-grid-layout"
                                      grid:DataGridColumnLayout.EnableHeaderMenu="True"
                                      behaviors:DataGridRowActions.EditCommand="{Binding EditCommand}"
                                      behaviors:DataGridRowActions.DeleteCommand="{Binding DeleteCommand}"
                                      behaviors:DataGridRowActions.ToggleActiveCommand="{Binding ToggleActiveCommand}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="STT"
                                                        grid:DataGridColumnLayout.Key="Index"
                                                        Binding="{Binding Index, Mode=OneWay}" Width="50" />
                                    <DataGridTextColumn Header="Mã NCC"
                                                        grid:DataGridColumnLayout.Key="Code"
                                                        Binding="{Binding Code, Mode=OneWay}"
                                                        Width="100"
                                                        Visibility="Collapsed" />
                                    <DataGridTextColumn Header="Tên nhà cung cấp"
                                                        grid:DataGridColumnLayout.Key="Name"
                                                        Binding="{Binding Name, Mode=OneWay}" Width="*" MinWidth="160" />
                                    <DataGridTextColumn Header="Số điện thoại"
                                                        grid:DataGridColumnLayout.Key="Phone"
                                                        Binding="{Binding Phone, Mode=OneWay}" Width="120" />
                                    <DataGridTextColumn Header="Nhóm NCC"
                                                        grid:DataGridColumnLayout.Key="SupplierGroup"
                                                        Binding="{Binding SupplierGroupName, Mode=OneWay}" Width="110" />
                                    <DataGridTextColumn Header="Khu vực"
                                                        grid:DataGridColumnLayout.Key="Region"
                                                        Binding="{Binding Region, Mode=OneWay}"
                                                        Width="110"
                                                        Visibility="Collapsed" />
                                    <DataGridTextColumn Header="Người liên hệ"
                                                        grid:DataGridColumnLayout.Key="ContactName"
                                                        Binding="{Binding ContactName, Mode=OneWay}" Width="130" />
                                    <DataGridTextColumn Header="Tổng mua (VND)"
                                                        grid:DataGridColumnLayout.Key="TotalPurchases"
                                                        Binding="{Binding TotalPurchasesText, Mode=OneWay}" Width="120" />
                                    <DataGridTextColumn Header="Nợ hiện tại (VND)"
                                                        grid:DataGridColumnLayout.Key="CurrentDebt"
                                                        Binding="{Binding CurrentDebtText, Mode=OneWay}" Width="120" />
                                    <DataGridTextColumn Header="Lần mua cuối"
                                                        grid:DataGridColumnLayout.Key="LastPurchase"
                                                        Binding="{Binding LastPurchaseText, Mode=OneWay}" Width="105" />
                                    <DataGridTemplateColumn Header="Trạng thái"
                                                            grid:DataGridColumnLayout.Key="Status"
                                                            Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Background="{DynamicResource SuccessBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive, Mode=OneWay}" Value="False">
                                                                    <Setter Property="Background" Value="{DynamicResource TextSecondaryBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StatusText, Mode=OneWay}"
                                                               Foreground="{DynamicResource OnPrimaryBrush}"
                                                               FontSize="{DynamicResource FontSize.Caption}"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Thao tác"
                                                            grid:DataGridColumnLayout.Key="Actions"
                                                            Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Button access:PermissionAccess.Rule="CAT_SUPPLIERS:Edit" Content="Sửa"
                                                            Style="{StaticResource GridActionButtonStyle}"
                                                            ToolTip="Sửa"
                                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button access:PermissionAccess.Rule="CAT_SUPPLIERS:Delete" Content="Xóa"
                                                            Style="{StaticResource GridActionButtonStyle}"
                                                            ToolTip="Xóa (ngừng hợp tác)"
                                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button access:PermissionAccess.Rule="CAT_SUPPLIERS:Edit" Content="TT"
                                                            Style="{StaticResource GridActionButtonStyle}"
                                                            ToolTip="{Binding ToggleActiveLabel, Mode=OneWay}"
                                                            Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Background="{DynamicResource SurfaceBrush}" Opacity="0.85"
                                    Visibility="{Binding IsBusyOverlayVisible, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Đang tải..."
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           FontSize="{DynamicResource FontSize.Subtitle}"
                                           FontWeight="SemiBold" />
                            </Border>

                            <TextBlock Text="{Binding StatusMessage, Mode=OneWay}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="{DynamicResource FontSize.Body}"
                                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                        </Grid>

                        <!-- Row 3: Error Message -->
                        <TextBlock Grid.Row="3"
                                   Text="{Binding ErrorMessage, Mode=OneWay}"
                                   Foreground="{DynamicResource DangerBrush}"
                                   FontSize="{DynamicResource FontSize.Body}"
                                   Margin="0,8,0,4"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVis}}" />

                        <!-- Row 4: Master-Detail Panel -->
                        <Grid Grid.Row="4" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" MinWidth="420" />
                                <ColumnDefinition Width="*" MinWidth="260" />
                            </Grid.ColumnDefinitions>

                            <!-- Panel trái: Thông tin nhà cung cấp đang chọn -->
                            <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}" Margin="0,0,10,0" Padding="16">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,12">
                                            <TextBlock Text="Thông tin nhà cung cấp"
                                                       DockPanel.Dock="Left"
                                                       Foreground="{DynamicResource PrimaryBrush}"
                                                       FontSize="{DynamicResource FontSize.Subtitle}"
                                                       FontWeight="Bold" />
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button access:PermissionAccess.Rule="CAT_SUPPLIERS:Edit" Content="Sửa"
                                                        Style="{StaticResource RoundedPrimaryButtonStyle}"
                                                        Command="{Binding EditSelectedCommand}"
                                                        MinWidth="90"
                                                        MinHeight="32"
                                                        Padding="12,4"
                                                        Margin="0,0,8,0" />
                                                    <Button access:PermissionAccess.Rule="CAT_SUPPLIERS:Delete" Content="Xóa"
                                                        Style="{StaticResource OutlineButtonStyle}"
                                                        Command="{Binding DeleteSelectedCommand}"
                                                        MinWidth="90"
                                                        MinHeight="32"
                                                        Padding="12,4"
                                                        Margin="0" />
                                            </StackPanel>
                                        </DockPanel>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Cột 1 -->
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="Mã nhà cung cấp" Style="{StaticResource DetailLabelStyle}" />
                                                <TextBox Text="{Binding SelectedCode, Mode=OneWay}" Style="{StaticResource DetailValueStyle}" />

                                                <TextBlock Text="Tên nhà cung cấp" Style="{StaticResource DetailLabelStyle}" />
                                                <TextBox Text="{Binding SelectedName, Mode=OneWay}" Style="{StaticResource DetailValueStyle}" />

                                                <TextBlock Text="Nhóm nhà cung cấp" Style="{StaticResource DetailLabelStyle}" />
                                                <TextBox Text="{Binding SelectedGroupName, Mode=OneWay}" Style="{StaticResource DetailValueStyle}" />

                                                <TextBlock Text="Mã số thuế" Style="{StaticResource DetailLabelStyle}" />
                                                <TextBox Text="{Binding SelectedTaxCode, Mode=OneWay}" Style="{StaticResource DetailValueStyle}" />

                                                <TextBlock Text="Số điện thoại" Style="{StaticResource DetailLabelStyle}" />
                                                <TextBox Text="{Binding SelectedPhone, Mode=OneWay}" Style="{StaticResource DetailValueStyle}" />

                                                <TextBlock Text="Email" Style="{StaticResource DetailLabelStyle}" />
                                                <TextBox Text="{Binding SelectedEmail, Mode=OneWay}" Style="{StaticResource DetailValueStyle}" />
                                            </StackPanel>

                                            <!-- Cột 2 -->
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Người liên hệ" Style="{StaticResource DetailLabelStyle}" />
                                                <TextBox Text="{Binding SelectedContactName, Mode=OneWay}" Style="{StaticResource DetailValueStyle}" />

                                                <TextBlock Text="Chức vụ liên hệ" Style="{StaticResource DetailLabelStyle}" />
                                                <TextBox Text="{Binding SelectedContactTitle, Mode=OneWay}" Style="{StaticResource DetailValueStyle}" />

                                                <TextBlock Text="Khu vực" Style="{StaticResource DetailLabelStyle}" />
                                                <TextBox Text="{Binding SelectedRegionName, Mode=OneWay}" Style="{StaticResource DetailValueStyle}" />

                                                <TextBlock Text="Địa chỉ" Style="{StaticResource DetailLabelStyle}" />
                                                <TextBox Text="{Binding SelectedAddress, Mode=OneWay}" Style="{StaticResource DetailValueStyle}" />

                                                <TextBlock Text="Ghi chú" Style="{StaticResource DetailLabelStyle}" />
                                                <TextBox Text="{Binding SelectedNotes, Mode=OneWay}"
                                                         Style="{StaticResource DetailValueStyle}"
                                                         AcceptsReturn="True" MinHeight="50"
                                                         TextWrapping="Wrap" VerticalContentAlignment="Top" />

                                                <TextBlock Text="Trạng thái" Style="{StaticResource DetailLabelStyle}" />
                                                <TextBlock FontSize="{DynamicResource FontSize.Body}" Margin="0,4,0,0"
                                                           Text="{Binding SelectedSupplier.StatusText, Mode=OneWay, TargetNullValue=''}"
                                                           Foreground="{DynamicResource SuccessBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedIsActive, Mode=OneWay}" Value="False">
                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- Panel phải: Tóm tắt giao dịch & công nợ -->
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,10" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="Tổng quan nhập hàng"
                                                       Foreground="{DynamicResource PrimaryBrush}"
                                                       FontWeight="Bold"
                                                       FontSize="{DynamicResource FontSize.Body}" />
                                            <TextBlock Text="Tổng tiền hàng đã nhập:"
                                                       Margin="0,8,0,2"
                                                       Style="{StaticResource DetailLabelStyle}" />
                                            <TextBlock Text="{Binding SelectedTotalPurchasesText, Mode=OneWay, StringFormat='{}{0} đ'}"
                                                       FontSize="{DynamicResource FontSize.Subtitle}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryBrush}" />

                                            <TextBlock Text="Lần nhập gần nhất:"
                                                       Margin="0,8,0,2"
                                                       Style="{StaticResource DetailLabelStyle}" />
                                            <TextBlock Text="{Binding SelectedLastPurchaseText, Mode=OneWay}"
                                                       FontSize="{DynamicResource FontSize.Body}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{DynamicResource CardBorderStyle}" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="Công nợ đối tác"
                                                       Foreground="{DynamicResource PrimaryBrush}"
                                                       FontWeight="Bold"
                                                       FontSize="{DynamicResource FontSize.Body}" />
                                            <TextBlock Text="Số dư nợ hiện tại:"
                                                       Margin="0,8,0,2"
                                                       Style="{StaticResource DetailLabelStyle}" />
                                            <TextBlock Text="{Binding SelectedDebtText, Mode=OneWay, StringFormat='{}{0} đ'}"
                                                       FontSize="{DynamicResource FontSize.Subtitle}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                                            <TextBlock Text="Ghi chú công nợ:"
                                                       Margin="0,8,0,2"
                                                       Style="{StaticResource DetailLabelStyle}" />
                                            <TextBlock Text="Theo dõi công nợ chi tiết sẽ được tự động đồng bộ khi hoàn tất phân hệ Phiếu chi &amp; Thanh toán NCC."
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="{DynamicResource FontSize.Caption}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="Nhóm nhà cung cấp">
                    <Grid Margin="16" TextElement.FontWeight="Normal">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="200" />
                        </Grid.RowDefinitions>

                        <WrapPanel Grid.Row="0" Margin="0,0,0,4">
                            <Button access:PermissionAccess.Rule="CAT_SUPPLIERS:Add" Content="Thêm nhóm" Command="{Binding AddGroupCommand}"
                                    Style="{DynamicResource WorkspaceActionStyle}" Margin="0,0,8,8" />
                            <Button access:PermissionAccess.Rule="CAT_SUPPLIERS:Edit" Content="Sửa" Command="{Binding EditGroupCommand}" Style="{DynamicResource WorkspaceExportStyle}"
                                    Margin="0,0,8,8" />
                            <Button access:PermissionAccess.Rule="CAT_SUPPLIERS:Delete" Content="Xóa" Command="{Binding DeleteGroupCommand}" Style="{DynamicResource WorkspaceDangerStyle}"
                                    />
                            <TextBlock Text="Đang tải..." VerticalAlignment="Center" Margin="16,0,0,0"
                                       Visibility="{Binding IsGroupLoading, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Margin="0,4,0,8"
                                       Foreground="{DynamicResource DangerBrush}"
                                       Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVis}}" />
                        </WrapPanel>

                        <DataGrid grid:DataGridColumnLayout.SettingsKey="suppliers.SupplierGroups" grid:DataGridColumnLayout.EnableHeaderMenu="True" Grid.Row="1" ItemsSource="{Binding SupplierGroups}"
                                  SelectedItem="{Binding SelectedGroupRow}"
                                  Style="{DynamicResource WorkspaceGridStyle}"
                                  AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn grid:DataGridColumnLayout.Key="Code" Header="Mã nhóm" Binding="{Binding Code, Mode=OneWay}" Width="120" />
                                <DataGridTextColumn ElementStyle="{DynamicResource WorkspaceTextStyle}" grid:DataGridColumnLayout.Key="Name" Header="Tên nhóm" Binding="{Binding Name, Mode=OneWay}" Width="*" MinWidth="200" />
                                <DataGridTextColumn ElementStyle="{DynamicResource WorkspaceTextStyle}" grid:DataGridColumnLayout.Key="Description" Header="Diễn giải" Binding="{Binding Description, Mode=OneWay}" Width="2*" MinWidth="200" />
                                <DataGridTextColumn grid:DataGridColumnLayout.Key="SupplierCount" Header="Số NCC" Binding="{Binding SupplierCount, Mode=OneWay}" Width="80" />
                                <DataGridTextColumn ElementStyle="{DynamicResource WorkspaceTextStyle}" grid:DataGridColumnLayout.Key="Status" Header="Trạng thái" Binding="{Binding StatusText, Mode=OneWay}" Width="220" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
                <TabItem Header="Lịch sử nhập hàng">
                    <Grid Margin="16" TextElement.FontWeight="Normal">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="200" />
                        </Grid.RowDefinitions>

                        <WrapPanel Grid.Row="0" Margin="0,0,0,4">
                            <TextBlock Text="Từ ngày" VerticalAlignment="Center" Margin="0,0,8,8" />
                            <DatePicker Language="vi-VN" Style="{DynamicResource ReportDateStyle}" SelectedDate="{Binding HistoryFromDate}" Width="170" Margin="0,0,16,8" />
                            <TextBlock Text="Đến ngày" VerticalAlignment="Center" Margin="0,0,8,8" />
                            <DatePicker Language="vi-VN" Style="{DynamicResource ReportDateStyle}" SelectedDate="{Binding HistoryToDate}" Width="170" Margin="0,0,16,8" />
                            <Button Content="Xem" Command="{Binding LoadPurchaseHistoryCommand}"
                                    Style="{DynamicResource WorkspaceActionStyle}" />
                            <TextBlock Text="Đang tải..." VerticalAlignment="Center" Margin="16,0,0,0"
                                       Visibility="{Binding IsHistoryLoading, Converter={StaticResource BoolToVis}}" />
                        </WrapPanel>

                        <DataGrid grid:DataGridColumnLayout.SettingsKey="suppliers.PurchaseHistory" grid:DataGridColumnLayout.EnableHeaderMenu="True" Grid.Row="1" ItemsSource="{Binding PurchaseHistory}"
                                  Style="{DynamicResource WorkspaceGridStyle}"
                                  AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn grid:DataGridColumnLayout.Key="Index" Header="STT" Binding="{Binding Index, Mode=OneWay}" Width="50" />
                                <DataGridTextColumn grid:DataGridColumnLayout.Key="PurchaseDate" Header="Ngày" Binding="{Binding PurchaseDateText, Mode=OneWay}" Width="130" />
                                <DataGridTextColumn grid:DataGridColumnLayout.Key="DocumentCode" Header="Số phiếu" Binding="{Binding Item.DocumentCode, Mode=OneWay}" Width="180" />
                                <DataGridTextColumn grid:DataGridColumnLayout.Key="TotalAmount" Header="Tổng tiền (VND)" Binding="{Binding TotalAmountText, Mode=OneWay}" Width="180">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn grid:DataGridColumnLayout.Key="PaidAmount" Header="Đã trả (VND)" Binding="{Binding PaidAmountText, Mode=OneWay}" Width="180">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn grid:DataGridColumnLayout.Key="RemainingAmount" Header="Còn nợ (VND)" Binding="{Binding RemainingAmountText, Mode=OneWay}" Width="180">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn ElementStyle="{DynamicResource WorkspaceTextStyle}" grid:DataGridColumnLayout.Key="Status" Header="Trạng thái" Binding="{Binding StatusText, Mode=OneWay}" Width="220" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
                <TabItem Header="Công nợ chi tiết">
                    <ScrollViewer Margin="16" VerticalScrollBarVisibility="Auto" FontWeight="Normal">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSize.Subtitle}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryBrush}">
                                    <Run Text="Công nợ — " />
                                    <Run Text="{Binding SelectedCode, Mode=OneWay}" />
                                    <Run Text=" " />
                                    <Run Text="{Binding SelectedName, Mode=OneWay}" />
                                </TextBlock>
                                <Button Grid.Column="1" Content="Chi tiền"
                                        access:PermissionAccess.Rule="DEBT_SETTLEMENT:Add"
                                        Style="{DynamicResource WorkspaceActionStyle}"

                                        Command="{Binding PaySupplierCommand}" />
                            </Grid>

                            <UniformGrid Columns="4">
                                <Border Style="{DynamicResource DebtMetricCardStyle}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="Tổng phát sinh" Style="{StaticResource DetailLabelStyle}" />
                                        <TextBlock Text="{Binding DebtIncurredText, Mode=OneWay}"
                                                   FontWeight="Bold"
                                                   FontSize="{DynamicResource FontSize.Subtitle}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{DynamicResource DebtMetricCardStyle}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="Đã thanh toán" Style="{StaticResource DetailLabelStyle}" />
                                        <TextBlock Text="{Binding DebtPaidText, Mode=OneWay}"
                                                   FontWeight="Bold"
                                                   FontSize="{DynamicResource FontSize.Subtitle}"
                                                   Foreground="{DynamicResource SuccessBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{DynamicResource DebtMetricCardStyle}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="Còn phải trả" Style="{StaticResource DetailLabelStyle}" />
                                        <TextBlock Text="{Binding DebtCurrentText, Mode=OneWay}"
                                                   FontWeight="Bold"
                                                   FontSize="{DynamicResource FontSize.Subtitle}"
                                                   Foreground="{DynamicResource DangerBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{DynamicResource DebtMetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Quá hạn (&gt; 30 ngày)" Style="{StaticResource DetailLabelStyle}" />
                                        <TextBlock Text="{Binding DebtOverdueText, Mode=OneWay}"
                                                   FontWeight="Bold"
                                                   FontSize="{DynamicResource FontSize.Subtitle}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <TextBlock Margin="0,24,0,8" Text="Lịch sử thanh toán"
                                       FontSize="{DynamicResource FontSize.Subtitle}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryBrush}" />
                            <TextBlock Text="Đang tải công nợ..."
                                       Visibility="{Binding IsDetailLoading, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding PaymentHistoryError}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Foreground="{DynamicResource DangerBrush}"
                                       Visibility="{Binding PaymentHistoryError, Converter={StaticResource NotNullToVis}}" />
                            <DataGrid grid:DataGridColumnLayout.SettingsKey="suppliers.PaymentHistory" grid:DataGridColumnLayout.EnableHeaderMenu="True" ItemsSource="{Binding PaymentHistory}"
                                      Style="{DynamicResource WorkspaceGridStyle}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      MaxHeight="300" Margin="0,0,0,8">
                                <DataGrid.Columns>
                                    <DataGridTextColumn grid:DataGridColumnLayout.Key="Date" Header="Ngày" Binding="{Binding EntryDateText, Mode=OneWay}" Width="100" />
                                    <DataGridTextColumn grid:DataGridColumnLayout.Key="Document" Header="Chứng từ" Binding="{Binding DocumentCode, Mode=OneWay}" Width="180" />
                                    <DataGridTextColumn ElementStyle="{DynamicResource WorkspaceTextStyle}" grid:DataGridColumnLayout.Key="Description" Header="Diễn giải" Binding="{Binding Description, Mode=OneWay}" Width="*" MinWidth="200" />
                                    <DataGridTextColumn grid:DataGridColumnLayout.Key="Receipt" Header="Thu (VND)" Binding="{Binding ReceiptAmountText, Mode=OneWay}" Width="130">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn grid:DataGridColumnLayout.Key="Payment" Header="Chi (VND)" Binding="{Binding PaymentAmountText, Mode=OneWay}" Width="130">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn grid:DataGridColumnLayout.Key="Method" Header="Phương thức" Binding="{Binding MethodText, Mode=OneWay}" Width="120" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Báo cáo NCC">
                    <ScrollViewer Margin="16" VerticalScrollBarVisibility="Auto" FontWeight="Normal">
                        <StackPanel>
                            <Border Style="{DynamicResource ReportCardStyle}">
                                <StackPanel>
<!-- Top NCC -->
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Top nhà cung cấp theo tổng nhập" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSize.Subtitle}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryBrush}" />
                                <WrapPanel Margin="0,8,0,0">
                                    <TextBlock Text="Từ" VerticalAlignment="Center" Margin="0,0,8,8" />
                                    <DatePicker Language="vi-VN" Style="{DynamicResource ReportDateStyle}" SelectedDate="{Binding ReportFromDate}" Width="170" Margin="0,0,16,8" />
                                    <TextBlock Text="Đến" VerticalAlignment="Center" Margin="0,0,8,8" />
                                    <DatePicker Language="vi-VN" Style="{DynamicResource ReportDateStyle}" SelectedDate="{Binding ReportToDate}" Width="170" Margin="0,0,16,8" />
                                    <TextBlock Text="Top" VerticalAlignment="Center" Margin="0,0,8,8" />
                                    <TextBox Style="{DynamicResource ReportNumberStyle}" Text="{Binding ReportTopN, UpdateSourceTrigger=PropertyChanged}" Width="72" Margin="0,0,16,8" />
                                    <Button Content="Xem" Command="{Binding LoadTopSuppliersCommand}"
                                            Style="{DynamicResource WorkspaceActionStyle}" Margin="0,0,8,8" />
                                    <Button Style="{DynamicResource WorkspaceExportStyle}" Content="Xuất Excel" Command="{Binding ExportTopSuppliersCommand}"
                                            CommandParameter="{Binding ElementName=TopSuppliersGrid}" />
                                </WrapPanel>
                            </StackPanel>
                            <DataGrid grid:DataGridColumnLayout.SettingsKey="suppliers.TopSuppliers" grid:DataGridColumnLayout.EnableHeaderMenu="True" x:Name="TopSuppliersGrid" ItemsSource="{Binding TopSuppliers}"
                                      Style="{DynamicResource WorkspaceGridStyle}"
                                      AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="260" Margin="0,0,0,4">
                                <DataGrid.Columns>
                                    <DataGridTextColumn grid:DataGridColumnLayout.Key="Rank" Header="Hạng" Binding="{Binding Rank, Mode=OneWay}" Width="60" />
                                    <DataGridTextColumn grid:DataGridColumnLayout.Key="Code" Header="Mã NCC" Binding="{Binding Item.Code, Mode=OneWay}" Width="120" />
                                    <DataGridTextColumn ElementStyle="{DynamicResource WorkspaceTextStyle}" grid:DataGridColumnLayout.Key="Name" Header="Tên NCC" Binding="{Binding Item.Name, Mode=OneWay}" Width="*" MinWidth="240" />
                                    <DataGridTextColumn grid:DataGridColumnLayout.Key="Group" Header="Nhóm" Binding="{Binding Item.SupplierGroupName, Mode=OneWay}" Width="180" />
                                    <DataGridTextColumn grid:DataGridColumnLayout.Key="PurchaseCount" Header="Số lần nhập" Binding="{Binding Item.PurchaseCount, Mode=OneWay}" Width="100" />
                                    <DataGridTextColumn grid:DataGridColumnLayout.Key="TotalPurchases" Header="Tổng nhập (VND)" Binding="{Binding TotalPurchasesText, Mode=OneWay}" Width="180">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            </StackPanel>
                            </Border>
                            <Border Style="{DynamicResource ReportCardStyle}">
                                <StackPanel>
<!-- NCC chưa nhập lại -->
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Nhà cung cấp chưa nhập lại" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSize.Subtitle}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryBrush}" />
                                <WrapPanel Margin="0,8,0,0">
                                    <TextBlock Text="Quá" VerticalAlignment="Center" Margin="0,0,8,8" />
                                    <TextBox Style="{DynamicResource ReportNumberStyle}" Text="{Binding ReportInactiveDays, UpdateSourceTrigger=PropertyChanged}" Width="72" Margin="0,0,8,8" />
                                    <TextBlock Text="ngày" VerticalAlignment="Center" Margin="0,0,8,8" />
                                    <Button Content="Xem" Command="{Binding LoadInactiveSuppliersCommand}"
                                            Style="{DynamicResource WorkspaceActionStyle}" Margin="0,0,8,8" />
                                    <Button Style="{DynamicResource WorkspaceExportStyle}" Content="Xuất Excel" Command="{Binding ExportInactiveSuppliersCommand}"
                                            CommandParameter="{Binding ElementName=InactiveSuppliersGrid}" />
                                </WrapPanel>
                            </StackPanel>
                            <DataGrid grid:DataGridColumnLayout.SettingsKey="suppliers.InactiveSuppliers" grid:DataGridColumnLayout.EnableHeaderMenu="True" x:Name="InactiveSuppliersGrid" ItemsSource="{Binding InactiveSuppliers}"
                                      Style="{DynamicResource WorkspaceGridStyle}"
                                      AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="260" Margin="0,0,0,4">
                                <DataGrid.Columns>
                                    <DataGridTextColumn grid:DataGridColumnLayout.Key="Code" Header="Mã NCC" Binding="{Binding Code, Mode=OneWay}" Width="120" />
                                    <DataGridTextColumn ElementStyle="{DynamicResource WorkspaceTextStyle}" grid:DataGridColumnLayout.Key="Name" Header="Tên NCC" Binding="{Binding Name, Mode=OneWay}" Width="*" MinWidth="240" />
                                    <DataGridTextColumn grid:DataGridColumnLayout.Key="Group" Header="Nhóm" Binding="{Binding GroupName, Mode=OneWay}" Width="180" />
                                    <DataGridTextColumn grid:DataGridColumnLayout.Key="LastPurchase" Header="Lần nhập cuối" Binding="{Binding LastPurchaseText, Mode=OneWay}" Width="120" />
                                    <DataGridTextColumn grid:DataGridColumnLayout.Key="Days" Header="Số ngày" Binding="{Binding DaysSinceLastPurchase, Mode=OneWay}" Width="80" />
                                    <DataGridTextColumn grid:DataGridColumnLayout.Key="TotalPurchases" Header="Tổng đã nhập (VND)" Binding="{Binding TotalPurchasesText, Mode=OneWay}" Width="180">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            </StackPanel>
                            </Border>
                            <Border Style="{DynamicResource ReportCardStyle}">
                                <StackPanel>
<!-- Phân bố -->
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Phân bố theo nhóm / khu vực" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSize.Subtitle}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryBrush}" />
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Xem" Command="{Binding LoadDistributionCommand}"
                                            Style="{DynamicResource WorkspaceActionStyle}" Margin="0,0,8,8" />
                                    <Button Style="{DynamicResource WorkspaceExportStyle}" Content="Xuất Excel" Command="{Binding ExportDistributionCommand}"
                                            CommandParameter="{Binding ElementName=GroupDistGrid}" />
                                </WrapPanel>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Theo nhóm" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <DataGrid grid:DataGridColumnLayout.SettingsKey="suppliers.GroupDistribution" grid:DataGridColumnLayout.EnableHeaderMenu="True" x:Name="GroupDistGrid" ItemsSource="{Binding GroupDistribution}"
                                              Style="{DynamicResource WorkspaceGridStyle}"
                                              AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="220">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn ElementStyle="{DynamicResource WorkspaceTextStyle}" grid:DataGridColumnLayout.Key="Name" Header="Nhóm" Binding="{Binding Name, Mode=OneWay}" Width="*" />
                                            <DataGridTextColumn grid:DataGridColumnLayout.Key="Count" Header="Số NCC" Binding="{Binding SupplierCount, Mode=OneWay}" Width="80" />
                                            <DataGridTextColumn grid:DataGridColumnLayout.Key="Total" Header="Tổng nhập (VND)" Binding="{Binding TotalPurchasesText, Mode=OneWay}" Width="180">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Theo khu vực" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <DataGrid grid:DataGridColumnLayout.SettingsKey="suppliers.RegionDistribution" grid:DataGridColumnLayout.EnableHeaderMenu="True" ItemsSource="{Binding RegionDistribution}"
                                              Style="{DynamicResource WorkspaceGridStyle}"
                                              AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="220">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn ElementStyle="{DynamicResource WorkspaceTextStyle}" grid:DataGridColumnLayout.Key="Name" Header="Khu vực" Binding="{Binding Name, Mode=OneWay}" Width="*" />
                                            <DataGridTextColumn grid:DataGridColumnLayout.Key="Count" Header="Số NCC" Binding="{Binding SupplierCount, Mode=OneWay}" Width="80" />
                                            <DataGridTextColumn grid:DataGridColumnLayout.Key="Total" Header="Tổng nhập (VND)" Binding="{Binding TotalPurchasesText, Mode=OneWay}" Width="180">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Grid>
                            </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding ReportErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                                       TextWrapping="Wrap" Margin="0,12,0,0"
                                       Visibility="{Binding ReportErrorMessage, Converter={StaticResource NotNullToVis}}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>
