<Window x:Class="Kazuko.Modules.Suppliers.Dialogs.SupplierGroupEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nhóm nhà cung cấp" Height="400" Width="500" MinHeight="360" MinWidth="440"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Kazuko.Modules.Suppliers;component/Themes/SupplierWorkspaceResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding DialogTitle}" FontSize="{DynamicResource FontSize.Heading}"
                   FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,12" />

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Tên nhóm *" Style="{StaticResource DetailLabelStyle}" />
            <TextBox Style="{DynamicResource RoundedTextBoxStyle}" MinHeight="40"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="Diễn giải" Style="{StaticResource DetailLabelStyle}" />
            <TextBox Style="{DynamicResource RoundedTextBoxStyle}"
                     Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" MaxLength="500"
                     MinHeight="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto" />
        </StackPanel>

        <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                   TextWrapping="Wrap" VerticalAlignment="Top" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Lưu" Command="{Binding SaveCommand}" Style="{DynamicResource WorkspaceActionStyle}"
                    MinWidth="90" Margin="0,0,8,0" IsDefault="True" />
            <Button Content="Hủy" Command="{Binding CancelCommand}" Style="{DynamicResource WorkspaceExportStyle}" MinWidth="90" IsCancel="True" />
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>
