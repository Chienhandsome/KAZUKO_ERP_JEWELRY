<Window x:Class="Kazuko.Modules.Suppliers.SupplierEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:access="clr-namespace:Kazuko.Shared.UI.Behaviors;assembly=Kazuko.Shared.UI"
        Title="{Binding Title, Mode=OneWay}"
        Width="860" Height="680"
        MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="FieldErrorStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="DialogFieldStyle" TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="IsEnabled" Value="{Binding IsFormEnabled, Mode=OneWay}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DialogComboStyle" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="IsEnabled" Value="{Binding IsFormEnabled, Mode=OneWay}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="28" />
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1"
                                                      Data="M 0 0 L 6 6 L 12 0"
                                                      Stroke="{DynamicResource TextSecondaryBrush}"
                                                      StrokeThickness="1.5"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="12,0,32,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                            <Popup Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Margin="0,2,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoundedPrimaryButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoundedOutlineButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding Title, Mode=OneWay}"
                   Foreground="{DynamicResource PrimaryBrush}"
                   FontSize="{DynamicResource FontSize.Heading}"
                   FontWeight="Bold"
                   Margin="0,0,0,12" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Style="{DynamicResource CardBorderStyle}" Padding="18">
                <Grid IsEnabled="{Binding IsFormEnabled, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Cột trái: Thông tin chính -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Mã nhà cung cấp" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding CodeDisplay, Mode=OneWay}"
                                 Style="{StaticResource DialogFieldStyle}"
                                 IsReadOnly="True"
                                 Background="{DynamicResource SurfaceAltBrush}" />

                        <TextBlock Text="Tên nhà cung cấp *" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DialogFieldStyle}" />
                        <TextBlock Text="{Binding NameError, Mode=OneWay}" Style="{StaticResource FieldErrorStyle}" />

                        <TextBlock Text="Nhóm nhà cung cấp *" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding Groups}"
                                  SelectedItem="{Binding SelectedGroup}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource DialogComboStyle}" />
                        <TextBlock Text="{Binding GroupError, Mode=OneWay}" Style="{StaticResource FieldErrorStyle}" />

                        <TextBlock Text="Số điện thoại *" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DialogFieldStyle}" />
                        <TextBlock Text="{Binding PhoneError, Mode=OneWay}" Style="{StaticResource FieldErrorStyle}" />

                        <TextBlock Text="Email" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DialogFieldStyle}" />
                        <TextBlock Text="{Binding EmailError, Mode=OneWay}" Style="{StaticResource FieldErrorStyle}" />

                        <TextBlock Text="Mã số thuế" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding TaxCode, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DialogFieldStyle}" />

                        <TextBlock Text="Mã thương hiệu" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding BrandCode, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DialogFieldStyle}" />

                        <TextBlock Text="TCCS" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding Tccs, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DialogFieldStyle}" />
                    </StackPanel>

                    <!-- Cột phải: Người liên hệ, địa chỉ & trạng thái -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Người liên hệ" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding ContactName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DialogFieldStyle}" />

                        <TextBlock Text="Chức vụ liên hệ" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding ContactTitle, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DialogFieldStyle}" />

                        <TextBlock Text="Khu vực" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding Regions}"
                                  SelectedItem="{Binding Region}"
                                  Style="{StaticResource DialogComboStyle}"
                                  IsEditable="False" />

                        <TextBlock Text="Địa chỉ" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DialogFieldStyle}" />

                        <TextBlock Text="Ghi chú" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DialogFieldStyle}"
                                 AcceptsReturn="True" MinHeight="75"
                                 TextWrapping="Wrap" VerticalContentAlignment="Top" />

                        <CheckBox Content="Đang hợp tác"
                                  IsChecked="{Binding IsActive}"
                                  Margin="0,12,0,0"
                                  FontSize="{DynamicResource FontSize.Body}"
                                  Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left"
                       Text="{Binding FormError, Mode=OneWay}"
                       Foreground="{DynamicResource DangerBrush}"
                       FontSize="{DynamicResource FontSize.Body}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       MaxWidth="480" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy (Esc)"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource RoundedOutlineButtonStyle}"
                        MinWidth="120"
                        Margin="0,0,10,0" />
                <Button access:PermissionAccess.Rule="CAT_SUPPLIERS:Add|CAT_SUPPLIERS:Edit" Content="Lưu (Enter)"
                        IsDefault="True"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource RoundedPrimaryButtonStyle}"
                        MinWidth="140" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
