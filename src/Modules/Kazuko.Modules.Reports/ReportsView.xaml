<UserControl x:Class="Kazuko.Modules.Reports.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:access="clr-namespace:Kazuko.Shared.UI.Behaviors;assembly=Kazuko.Shared.UI"
             xmlns:local="clr-namespace:Kazuko.Modules.Reports"
             xmlns:shared="clr-namespace:Kazuko.Modules.Reports.Shared"
             MinWidth="900" MinHeight="520">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Shared/ReportSharedResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:BooleanToVisibilityConverter x:Key="BoolToVis" />
            <local:BooleanToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />

            <Style x:Key="ReportExpandToggleStyle" TargetType="ToggleButton">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Width" Value="18" />
                <Setter Property="Height" Value="18" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent">
                                <Path x:Name="Arrow"
                                      Data="M 0,0 L 5,5 L 0,10 Z"
                                      Fill="{DynamicResource TextSecondaryBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </Path.RenderTransform>
                                </Path>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Arrow" Property="RenderTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="90" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource PrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource PrimaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ReportTreeItemStyle" TargetType="TreeViewItem">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=OneTime}" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TreeViewItem">
                            <StackPanel>
                                <Border x:Name="ItemBorder"
                                        Background="Transparent"
                                        CornerRadius="6"
                                        Padding="8,7"
                                        SnapsToDevicePixels="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton x:Name="Expander"
                                                      Grid.Column="0"
                                                      Style="{StaticResource ReportExpandToggleStyle}"
                                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                      ClickMode="Press" />
                                        <ContentPresenter x:Name="PART_Header"
                                                          Grid.Column="1"
                                                          ContentSource="Header"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <ItemsPresenter x:Name="ItemsHost" Margin="18,2,0,0" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="HasItems" Value="False">
                                    <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                                </Trigger>
                                <Trigger Property="IsExpanded" Value="False">
                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="False" />
                                        <Condition Property="IsMouseOver" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <HierarchicalDataTemplate DataType="{x:Type local:ReportTreeNode}"
                                      ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" MinHeight="22">
                    <Border x:Name="GroupAccent"
                            Width="3"
                            Height="16"
                            CornerRadius="1.5"
                            Background="{DynamicResource PrimaryBrush}"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            Visibility="Collapsed" />
                    <TextBlock x:Name="TitleText"
                               Text="{Binding Title, Mode=OneWay}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </StackPanel>
                <HierarchicalDataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsReport, Mode=OneWay}" Value="False">
                        <Setter TargetName="GroupAccent" Property="Visibility" Value="Visible" />
                        <Setter TargetName="TitleText" Property="FontWeight" Value="SemiBold" />
                        <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsReport, Mode=OneWay}" Value="True">
                        <Setter TargetName="TitleText" Property="FontWeight" Value="Normal" />
                        <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        <Setter TargetName="TitleText" Property="Margin" Value="4,0,0,0" />
                    </DataTrigger>
                </HierarchicalDataTemplate.Triggers>
            </HierarchicalDataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="True">
            <Button DockPanel.Dock="Right"
                    Content="{Binding CatalogToggleLabel, Mode=OneWay}"
                    Command="{Binding ToggleCatalogCommand}"
                    Style="{StaticResource ReportOutlineButtonStyle}"
                    MinWidth="120"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    ToolTip="Ẩn/hiện danh mục báo cáo bên trái" />
            <StackPanel Orientation="Horizontal">
                <Image Source="/Kazuko.Modules.Reports;component/Assets/icons/BC.png"
                       Width="48" Height="48" Stretch="Uniform" Margin="0,0,12,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="BÁO CÁO"
                               Foreground="{DynamicResource PrimaryBrush}"
                               FontSize="{DynamicResource FontSize.Heading}"
                               FontWeight="Bold" />
                    <TextBlock Text="Thống kê quỹ, bán hàng, kho và danh mục"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="{DynamicResource FontSize.Body}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="340"
                    Padding="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding IsCatalogVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Top"
                            Padding="14,12"
                            Background="{DynamicResource SurfaceAltBrush}"
                            CornerRadius="8,8,0,0"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Content="Ẩn"
                                    Command="{Binding ToggleCatalogCommand}"
                                    Style="{StaticResource ReportOutlineButtonStyle}"
                                    MinWidth="56"
                                    Padding="8,4"
                                    MinHeight="32"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip="Ẩn danh mục báo cáo" />
                            <TextBlock Text="Danh mục báo cáo"
                                       FontSize="{DynamicResource FontSize.Subtitle}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Padding="8,8,8,10">
                        <TreeView x:Name="ReportTree"
                                  ItemsSource="{Binding Menu, Mode=OneWay}"
                                  ItemContainerStyle="{StaticResource ReportTreeItemStyle}"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  Padding="0"
                                  SelectedItemChanged="ReportTree_OnSelectedItemChanged" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="1"
                    Width="12"
                    Visibility="{Binding IsCatalogVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

            <Grid Grid.Column="2">
                <Border Padding="32"
                        Style="{DynamicResource CardBorderStyle}"
                        Visibility="{Binding ShowPlaceholder, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center" MaxWidth="560">
                        <TextBlock Text="{Binding PlaceholderTitle, Mode=OneWay}"
                                   TextAlignment="Center"
                                   FontSize="{DynamicResource FontSize.Heading}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryBrush}" />
                        <TextBlock Margin="0,16,0,0"
                                   Text="{Binding PlaceholderMessage, Mode=OneWay}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontSize="{DynamicResource FontSize.Body}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Một ContentControl: đổi báo cáo = gỡ WebView2 khỏi visual tree (tránh HWND đè pane). -->
                <ContentControl Content="{Binding ActiveWorkspace, Mode=OneWay}"
                                Visibility="{Binding ShowWorkspace, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type local:PayrollReportViewModel}"><local:PayrollReportView/></DataTemplate>
                        <DataTemplate DataType="{x:Type local:JewelryOnHandReportViewModel}">
                            <shared:ReportWorkspaceView EmptyMessage="Không có dữ liệu nữ trang tồn kho.">
                                <shared:ReportWorkspaceView.FilterContent>
                                    <StackPanel>
                                        <TextBlock Text="Báo cáo nữ trang tồn kho"
                                                   FontSize="{DynamicResource FontSize.Subtitle}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="Thành phẩm đang tồn tại kho thành phẩm và kho bán hàng (theo chi nhánh đăng nhập)"
                                                   FontSize="{DynamicResource FontSize.Caption}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,14" />

                                        <TextBlock Text="Bộ lọc"
                                                   FontSize="{DynamicResource FontSize.Caption}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Margin="0,0,0,8" />

                                        <TextBox Style="{StaticResource ReportFilterFieldStyle}"
                                                 Margin="0,0,0,8"
                                                 HorizontalAlignment="Stretch"
                                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Mã hoặc tên sản phẩm" />
                                        <ComboBox Style="{StaticResource ReportFilterComboStyle}"
                                                  Margin="0,0,0,8"
                                                  HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding GoldTypeOptions}"
                                                  SelectedItem="{Binding SelectedGoldType}" />
                                        <ComboBox Style="{StaticResource ReportFilterComboStyle}"
                                                  Margin="0,0,0,8"
                                                  HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding ScopeOptions}"
                                                  SelectedItem="{Binding SelectedScope}" />
                                        <ComboBox Style="{StaticResource ReportFilterComboStyle}"
                                                  Margin="0,0,0,14"
                                                  HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding StatusOptions}"
                                                  SelectedItem="{Binding SelectedStatus}" />

                                        <Button Content="Cột báo cáo"
                                                Style="{StaticResource ReportOutlineButtonStyle}"
                                                Command="{Binding ConfigureColumnsCommand}"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,0,0,8"
                                                ToolTip="Ẩn/hiện và đổi thứ tự cột trên bản in" />
                                        <Button Content="Xóa lọc"
                                                Style="{StaticResource ReportOutlineButtonStyle}"
                                                Command="{Binding ClearFiltersCommand}"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,0,0,8" />
                                        <Button Content="Làm mới"
                                                Style="{StaticResource ReportOutlineButtonStyle}"
                                                Command="{Binding RefreshCommand}"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,0,0,8" />
                                        <Button access:PermissionAccess.Rule="REP_EXPORT" Content="Mở PDF"
                                                Style="{StaticResource ReportOutlineButtonStyle}"
                                                Command="{Binding PreviewCommand}"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,0,0,8"
                                                ToolTip="Mở file PDF bằng ứng dụng bên ngoài" />
                                        <Button access:PermissionAccess.Rule="REP_EXPORT" Content="In"
                                                Style="{StaticResource ReportPrimaryButtonStyle}"
                                                Command="{Binding PrintCommand}"
                                                HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </shared:ReportWorkspaceView.FilterContent>
                            </shared:ReportWorkspaceView>
                        </DataTemplate>

                        <DataTemplate DataType="{x:Type local:JewelryOnHandSummaryReportViewModel}">
                            <shared:ReportWorkspaceView EmptyMessage="Không có dữ liệu tổng hợp nữ trang tồn kho.">
                                <shared:ReportWorkspaceView.FilterContent>
                                    <StackPanel>
                                        <TextBlock Text="Tổng hợp nữ trang tồn kho"
                                                   FontSize="{DynamicResource FontSize.Subtitle}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="Gom nhóm theo kho và loại vàng: số món, trọng lượng, giá trị tồn"
                                                   FontSize="{DynamicResource FontSize.Caption}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,14" />

                                        <TextBlock Text="Bộ lọc"
                                                   FontSize="{DynamicResource FontSize.Caption}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Margin="0,0,0,8" />

                                        <ComboBox Style="{StaticResource ReportFilterComboStyle}"
                                                  Margin="0,0,0,8"
                                                  HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding GoldTypeOptions}"
                                                  SelectedItem="{Binding SelectedGoldType}" />
                                        <ComboBox Style="{StaticResource ReportFilterComboStyle}"
                                                  Margin="0,0,0,8"
                                                  HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding ScopeOptions}"
                                                  SelectedItem="{Binding SelectedScope}" />
                                        <ComboBox Style="{StaticResource ReportFilterComboStyle}"
                                                  Margin="0,0,0,14"
                                                  HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding StatusOptions}"
                                                  SelectedItem="{Binding SelectedStatus}" />

                                        <Button Content="Cột báo cáo"
                                                Style="{StaticResource ReportOutlineButtonStyle}"
                                                Command="{Binding ConfigureColumnsCommand}"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,0,0,8"
                                                ToolTip="Ẩn/hiện và đổi thứ tự cột trên bản in" />
                                        <Button Content="Xóa lọc"
                                                Style="{StaticResource ReportOutlineButtonStyle}"
                                                Command="{Binding ClearFiltersCommand}"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,0,0,8" />
                                        <Button Content="Làm mới"
                                                Style="{StaticResource ReportOutlineButtonStyle}"
                                                Command="{Binding RefreshCommand}"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,0,0,8" />
                                        <Button access:PermissionAccess.Rule="REP_EXPORT" Content="Mở PDF"
                                                Style="{StaticResource ReportOutlineButtonStyle}"
                                                Command="{Binding PreviewCommand}"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,0,0,8"
                                                ToolTip="Mở file PDF bằng ứng dụng bên ngoài" />
                                        <Button access:PermissionAccess.Rule="REP_EXPORT" Content="In"
                                                Style="{StaticResource ReportPrimaryButtonStyle}"
                                                Command="{Binding PrintCommand}"
                                                HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </shared:ReportWorkspaceView.FilterContent>
                            </shared:ReportWorkspaceView>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type local:FundBalanceReportViewModel}">
                            <shared:ReportWorkspaceView EmptyMessage="Không có dữ liệu tồn quỹ.">
                                <shared:ReportWorkspaceView.FilterContent>
                                    <StackPanel>
                                        <TextBlock Text="Báo cáo tồn quỹ"
                                                   FontSize="{DynamicResource FontSize.Subtitle}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="Số dư các quỹ tiền mặt và tài khoản ngân hàng theo kỳ"
                                                   FontSize="{DynamicResource FontSize.Caption}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,14" />

                                        <TextBlock Text="Bộ lọc"
                                                   FontSize="{DynamicResource FontSize.Caption}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Margin="0,0,0,8" />

                                        <TextBlock Text="Từ ngày"
                                                   FontSize="{DynamicResource FontSize.Caption}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,0,0,4" />
                                        <DatePicker SelectedDate="{Binding FromDate}"
                                                    Margin="0,0,0,8"
                                                    HorizontalAlignment="Stretch" />
                                        <TextBlock Text="Đến ngày"
                                                   FontSize="{DynamicResource FontSize.Caption}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,0,0,4" />
                                        <DatePicker SelectedDate="{Binding ToDate}"
                                                    Margin="0,0,0,14"
                                                    HorizontalAlignment="Stretch" />
                                        <Button Content="Cột báo cáo"
                                                Style="{StaticResource ReportOutlineButtonStyle}"
                                                Command="{Binding ConfigureColumnsCommand}"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,0,0,8"
                                                ToolTip="Ẩn/hiện và đổi thứ tự cột trên bản in" />
                                        <Button Content="Xóa lọc"
                                                Style="{StaticResource ReportOutlineButtonStyle}"
                                                Command="{Binding ClearFiltersCommand}"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,0,0,8" />
                                        <Button Content="Làm mới"
                                                Style="{StaticResource ReportOutlineButtonStyle}"
                                                Command="{Binding RefreshCommand}"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,0,0,8" />
                                        <Button access:PermissionAccess.Rule="REP_EXPORT" Content="Mở PDF"
                                                Style="{StaticResource ReportOutlineButtonStyle}"
                                                Command="{Binding PreviewCommand}"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,0,0,8"
                                                ToolTip="Mở file PDF bằng ứng dụng bên ngoài" />
                                        <Button access:PermissionAccess.Rule="REP_EXPORT" Content="In"
                                                Style="{StaticResource ReportPrimaryButtonStyle}"
                                                Command="{Binding PrintCommand}"
                                                HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </shared:ReportWorkspaceView.FilterContent>
                            </shared:ReportWorkspaceView>
                        </DataTemplate>

                        <DataTemplate DataType="{x:Type local:FundCashReportViewModel}">
                            <shared:ReportWorkspaceView EmptyMessage="Không có dữ liệu quỹ tiền mặt.">
                                <shared:ReportWorkspaceView.FilterContent>
                                    <StackPanel>
                                        <TextBlock Text="Báo cáo quỹ tiền mặt"
                                                   FontSize="{DynamicResource FontSize.Subtitle}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="Tổng hợp thu/chi/tồn quỹ tiền mặt theo ngày"
                                                   FontSize="{DynamicResource FontSize.Caption}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,14" />

                                        <TextBlock Text="Bộ lọc"
                                                   FontSize="{DynamicResource FontSize.Caption}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Margin="0,0,0,8" />

                                        <TextBlock Text="Từ ngày"
                                                   FontSize="{DynamicResource FontSize.Caption}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,0,0,4" />
                                        <DatePicker SelectedDate="{Binding FromDate}"
                                                    Margin="0,0,0,8"
                                                    HorizontalAlignment="Stretch" />
                                        <TextBlock Text="Đến ngày"
                                                   FontSize="{DynamicResource FontSize.Caption}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,0,0,4" />
                                        <DatePicker SelectedDate="{Binding ToDate}"
                                                    Margin="0,0,0,14"
                                                    HorizontalAlignment="Stretch" />
                                        <Button Content="Cột báo cáo"
                                                Style="{StaticResource ReportOutlineButtonStyle}"
                                                Command="{Binding ConfigureColumnsCommand}"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,0,0,8"
                                                ToolTip="Ẩn/hiện và đổi thứ tự cột trên bản in" />
                                        <Button Content="Xóa lọc"
                                                Style="{StaticResource ReportOutlineButtonStyle}"
                                                Command="{Binding ClearFiltersCommand}"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,0,0,8" />
                                        <Button Content="Làm mới"
                                                Style="{StaticResource ReportOutlineButtonStyle}"
                                                Command="{Binding RefreshCommand}"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,0,0,8" />
                                        <Button access:PermissionAccess.Rule="REP_EXPORT" Content="Mở PDF"
                                                Style="{StaticResource ReportOutlineButtonStyle}"
                                                Command="{Binding PreviewCommand}"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,0,0,8"
                                                ToolTip="Mở file PDF bằng ứng dụng bên ngoài" />
                                        <Button access:PermissionAccess.Rule="REP_EXPORT" Content="In"
                                                Style="{StaticResource ReportPrimaryButtonStyle}"
                                                Command="{Binding PrintCommand}"
                                                HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </shared:ReportWorkspaceView.FilterContent>
                            </shared:ReportWorkspaceView>
                        </DataTemplate>

                        <DataTemplate DataType="{x:Type local:FundCashReceiptsReportViewModel}">
                            <shared:ReportWorkspaceView EmptyMessage="Không có phiếu thu tiền mặt.">
                                <shared:ReportWorkspaceView.FilterContent>
                                    <StackPanel>
                                        <TextBlock Text="Danh sách phiếu thu tiền mặt"
                                                   FontSize="{DynamicResource FontSize.Subtitle}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="Chi tiết các phiếu thu tiền mặt trong kỳ"
                                                   FontSize="{DynamicResource FontSize.Caption}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,14" />

                                        <TextBlock Text="Bộ lọc"
                                                   FontSize="{DynamicResource FontSize.Caption}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Margin="0,0,0,8" />

                                        <TextBlock Text="Từ ngày"
                                                   FontSize="{DynamicResource FontSize.Caption}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,0,0,4" />
                                        <DatePicker SelectedDate="{Binding FromDate}"
                                                    Margin="0,0,0,8"
                                                    HorizontalAlignment="Stretch" />
                                        <TextBlock Text="Đến ngày"
                                                   FontSize="{DynamicResource FontSize.Caption}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,0,0,4" />
                                        <DatePicker SelectedDate="{Binding ToDate}"
                                                    Margin="0,0,0,14"
                                                    HorizontalAlignment="Stretch" />
                                        <Button Content="Cột báo cáo"
                                                Style="{StaticResource ReportOutlineButtonStyle}"
                                                Command="{Binding ConfigureColumnsCommand}"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,0,0,8"
                                                ToolTip="Ẩn/hiện và đổi thứ tự cột trên bản in" />
                                        <Button Content="Xóa lọc"
                                                Style="{StaticResource ReportOutlineButtonStyle}"
