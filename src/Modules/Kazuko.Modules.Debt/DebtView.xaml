<UserControl x:Class="Kazuko.Modules.Debt.DebtView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:access="clr-namespace:Kazuko.Shared.UI.Behaviors;assembly=Kazuko.Shared.UI"
             xmlns:local="clr-namespace:Kazuko.Modules.Debt"
             xmlns:grid="clr-namespace:Kazuko.Shared.UI.DataGridLayout;assembly=Kazuko.Shared.UI"
             MinWidth="960" MinHeight="560">
  <UserControl.Resources>
    <local:BooleanToVisibilityConverter x:Key="BoolToVis" />
    <local:BooleanToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
    <local:NullOrEmptyToVisibilityConverter x:Key="NotNullToVis" Invert="True" />
    <local:DebtStatusToBrushConverter x:Key="StatusBrush" />
    <local:DebtDirectionToBrushConverter x:Key="ReceiveBrush" Direction="RECEIVE" />
    <local:DebtDirectionToBrushConverter x:Key="PayBrush" Direction="PAY" />

    <Style x:Key="RoundedTextBoxStyle" TargetType="TextBox">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    SnapsToDevicePixels="True">
              <ScrollViewer x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FilterFieldStyle" TargetType="TextBox" BasedOn="{StaticResource RoundedTextBoxStyle}">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style x:Key="DetailValueStyle" TargetType="TextBox" BasedOn="{StaticResource RoundedTextBoxStyle}">
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="10,4" />
    </Style>

    <Style x:Key="FilterComboStyle" TargetType="ComboBox">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="ToggleButton"
                            Focusable="False"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            ClickMode="Press">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ComboBd"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="28" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="Transparent" />
                        <Path Grid.Column="1"
                              Data="M 0 0 L 6 6 L 12 0"
                              Stroke="{DynamicResource TextSecondaryBrush}"
                              StrokeThickness="1.5"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter Margin="12,0,32,0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
              <Popup x:Name="Popup"
                     Placement="Bottom"
                     IsOpen="{TemplateBinding IsDropDownOpen}"
                     AllowsTransparency="True"
                     Focusable="False"
                     PopupAnimation="Slide">
                <Border Margin="0,2,0,0"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="RoundedPrimaryButtonStyle" TargetType="Button">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="16,6" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True"
                    TextElement.Foreground="{TemplateBinding Foreground}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="RoundedSuccessButtonStyle" TargetType="Button">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="RoundedDangerButtonStyle" TargetType="Button"
           BasedOn="{StaticResource RoundedSuccessButtonStyle}">
      <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
    </Style>

    <Style x:Key="OutlineButtonStyle" TargetType="Button">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DisabledImportButtonStyle" TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="ToolTip" Value="Chưa triển khai" />
    </Style>

    <Style x:Key="DetailLabelStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
      <Setter Property="Margin" Value="0,0,0,3" />
    </Style>

    <Style x:Key="DebtDataGridStyle" TargetType="DataGrid">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="RowBackground" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="SelectionMode" Value="Single" />
      <Setter Property="SelectionUnit" Value="FullRow" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="CanUserDeleteRows" Value="False" />
      <Setter Property="CanUserResizeRows" Value="False" />
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="RowHeight" Value="28" />
      <Setter Property="ColumnHeaderHeight" Value="32" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
      <Setter Property="RowStyle">
        <Setter.Value>
          <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
          </Style>
        </Setter.Value>
      </Setter>
      <Setter Property="CellStyle">
        <Setter.Value>
          <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                  <Border Padding="{TemplateBinding Padding}"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          SnapsToDevicePixels="True">
                    <ContentPresenter VerticalAlignment="Center" />
                  </Border>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
            <Style.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DebtDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
      <Setter Property="Height" Value="32" />
    </Style>

    <Style x:Key="DebtTabItemStyle" TargetType="TabItem">
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="TabBorder" Background="Transparent" BorderThickness="0,0,0,3"
                    BorderBrush="Transparent" Padding="{TemplateBinding Padding}" Margin="0,0,4,0"
                    CornerRadius="6,6,0,0">
              <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="280" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header: giống KHÁCH HÀNG -->
    <Grid Grid.Row="0" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Image Source="/Kazuko.Modules.Debt;component/Assets/icons/TC.png"
               Width="48" Height="48" Stretch="Uniform" Margin="0,0,12,0" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="CÔNG NỢ"
                     Foreground="{DynamicResource PrimaryBrush}"
                     FontSize="{DynamicResource FontSize.Heading}"
                     FontWeight="Bold" />
          <TextBlock Text="Quản lý công nợ khách hàng / nhà cung cấp — thu / chi — đối chiếu"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     FontSize="{DynamicResource FontSize.Body}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="{Binding AddPartyButtonText}"
                Style="{StaticResource RoundedPrimaryButtonStyle}"
                Command="{Binding AddPartyCommand}"
                Margin="0,0,8,0"
                MinWidth="180" />
        <Button Content="? Hướng dẫn"
                Style="{StaticResource OutlineButtonStyle}"
                Command="{Binding GuideCommand}"
                MinWidth="120"
                Margin="0" />
      </StackPanel>
    </Grid>

    <!-- KPI -->
    <Grid Grid.Row="1" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}" Padding="12,8">
        <StackPanel>
          <TextBlock Text="Tổng công nợ khách hàng" Style="{StaticResource DetailLabelStyle}" />
          <TextBlock FontSize="{DynamicResource FontSize.Subtitle}" FontWeight="Bold"
                     Foreground="{DynamicResource DangerBrush}">
            <Run Text="{Binding KpiCustomerRemainingText, Mode=OneWay}" />
            <Run Text=" VND" />
          </TextBlock>
          <TextBlock Margin="0,6,0,0" FontSize="{DynamicResource FontSize.Caption}"
                     Foreground="{DynamicResource TextSecondaryBrush}">
            <Run Text="Còn phải thu: " />
            <Run Text="{Binding KpiCustomerCollectText, Mode=OneWay}" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}" />
          </TextBlock>
          <TextBlock FontSize="{DynamicResource FontSize.Caption}"
                     Foreground="{DynamicResource TextSecondaryBrush}">
            <Run Text="Đã thu: " />
            <Run Text="{Binding KpiCustomerPaidText, Mode=OneWay}" />
          </TextBlock>
        </StackPanel>
      </Border>

      <Border Grid.Column="2" Style="{DynamicResource CardBorderStyle}" Padding="12,8">
        <StackPanel>
          <TextBlock Text="Tổng công nợ nhà cung cấp" Style="{StaticResource DetailLabelStyle}" />
          <TextBlock FontSize="{DynamicResource FontSize.Subtitle}" FontWeight="Bold"
                     Foreground="{DynamicResource DangerBrush}">
            <Run Text="{Binding KpiSupplierRemainingText, Mode=OneWay}" />
            <Run Text=" VND" />
          </TextBlock>
          <TextBlock Margin="0,6,0,0" FontSize="{DynamicResource FontSize.Caption}"
                     Foreground="{DynamicResource TextSecondaryBrush}">
            <Run Text="Còn phải trả: " />
            <Run Text="{Binding KpiSupplierPayText, Mode=OneWay}" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}" />
          </TextBlock>
          <TextBlock FontSize="{DynamicResource FontSize.Caption}"
                     Foreground="{DynamicResource TextSecondaryBrush}">
            <Run Text="Đã trả: " />
            <Run Text="{Binding KpiSupplierPaidText, Mode=OneWay}" />
          </TextBlock>
        </StackPanel>
      </Border>

      <Border Grid.Column="4" Style="{DynamicResource CardBorderStyle}" Padding="12,8">
        <StackPanel>
          <TextBlock Text="Công nợ quá hạn (KH)" Style="{StaticResource DetailLabelStyle}" />
          <TextBlock FontSize="{DynamicResource FontSize.Subtitle}" FontWeight="Bold"
                     Foreground="{DynamicResource PrimaryBrush}">
            <Run Text="{Binding KpiCustomerOverdueText, Mode=OneWay}" />
            <Run Text=" VND" />
          </TextBlock>
          <TextBlock Margin="0,6,0,0"
                     Text="{Binding KpiCustomerOverdueCountText, Mode=OneWay}"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     FontSize="{DynamicResource FontSize.Caption}" />
        </StackPanel>
      </Border>

      <Border Grid.Column="6" Style="{DynamicResource CardBorderStyle}" Padding="12,8">
        <StackPanel>
          <TextBlock Text="Công nợ quá hạn (NCC)" Style="{StaticResource DetailLabelStyle}" />
          <TextBlock FontSize="{DynamicResource FontSize.Subtitle}" FontWeight="Bold"
                     Foreground="{DynamicResource PrimaryBrush}">
            <Run Text="{Binding KpiSupplierOverdueText, Mode=OneWay}" />
            <Run Text=" VND" />
          </TextBlock>
          <TextBlock Margin="0,6,0,0"
                     Text="{Binding KpiSupplierOverdueCountText, Mode=OneWay}"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     FontSize="{DynamicResource FontSize.Caption}" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Main card + tabs -->
    <Border Grid.Row="2" Style="{DynamicResource CardBorderStyle}" Padding="12">
      <TabControl x:Name="DebtTabControl"
                  SelectedIndex="{Binding SelectedTabIndex}"
                  Background="Transparent"
                  BorderThickness="0"
                  ItemContainerStyle="{StaticResource DebtTabItemStyle}">

        <TabItem access:PermissionAccess.Rule="DEBT_CUSTOMER" Header="Công nợ khách hàng">
          <Grid Margin="0,12,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="0.72*" MinHeight="160" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="1.28*" MinHeight="220" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Tìm kiếm" Style="{StaticResource RoundedPrimaryButtonStyle}"
                        Command="{Binding SearchCommand}" MinWidth="110" Margin="0,0,8,0" />
                <Button Content="Làm mới" Style="{StaticResource OutlineButtonStyle}"
                        Command="{Binding RefreshCommand}" MinWidth="100" Margin="0" />
              </StackPanel>
              <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Từ ngày" VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="{DynamicResource FontSize.Caption}" />
                <DatePicker SelectedDate="{Binding FromDate}" Width="170" Margin="0,0,8,0"
                            VerticalContentAlignment="Center" />
                <TextBlock Text="Đến ngày" VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="{DynamicResource FontSize.Caption}" />
                <DatePicker SelectedDate="{Binding ToDate}" Width="170" Margin="0,0,8,0"
                            VerticalContentAlignment="Center" />
                <TextBox Width="200" Style="{StaticResource FilterFieldStyle}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Tìm kiếm (mã, tên, SĐT)...">
                  <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                  </TextBox.InputBindings>
                </TextBox>
                <ComboBox Width="150" Style="{StaticResource FilterComboStyle}"
                          ItemsSource="{Binding Groups}"
                          SelectedItem="{Binding SelectedGroup}"
                          DisplayMemberPath="Name" />
                <ComboBox Width="140" Style="{StaticResource FilterComboStyle}"
                          ItemsSource="{Binding StatusOptions}"
                          SelectedItem="{Binding SelectedStatus}"
                          DisplayMemberPath="DisplayName" />
              </WrapPanel>
            </DockPanel>

            <Grid Grid.Row="1">
              <DataGrid ItemsSource="{Binding Customers}"
                        SelectedItem="{Binding SelectedCustomer}"
                        Style="{StaticResource DebtDataGridStyle}"
                        ColumnHeaderStyle="{StaticResource DebtDataGridColumnHeaderStyle}"
                        grid:DataGridColumnLayout.SettingsKey="debt-customers"
                        grid:DataGridColumnLayout.EnableHeaderMenu="True">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="STT" grid:DataGridColumnLayout.Key="Index"
                                      Binding="{Binding Index, Mode=OneWay}" Width="50" />
                  <DataGridTextColumn Header="Mã KH" grid:DataGridColumnLayout.Key="Code"
                                      Binding="{Binding Code, Mode=OneWay}" Width="90" />
                  <DataGridTextColumn Header="Tên khách hàng" grid:DataGridColumnLayout.Key="Name"
                                      Binding="{Binding Name, Mode=OneWay}" Width="*" MinWidth="140" />
                  <DataGridTextColumn Header="SĐT" grid:DataGridColumnLayout.Key="Phone"
                                      Binding="{Binding Phone, Mode=OneWay}" Width="110" />
                  <DataGridTextColumn Header="Tổng phát sinh" grid:DataGridColumnLayout.Key="Incurred"
                                      Binding="{Binding TotalIncurredText, Mode=OneWay}" Width="110" />
                  <DataGridTextColumn Header="Đã thanh toán" grid:DataGridColumnLayout.Key="Paid"
                                      Binding="{Binding PaidText, Mode=OneWay}" Width="110" />
                  <DataGridTemplateColumn Header="Còn nợ" grid:DataGridColumnLayout.Key="Remaining" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding RemainingText, Mode=OneWay}"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding RemainingVnd, Converter={StaticResource ReceiveBrush}}"
                                   VerticalAlignment="Center" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Ngày nợ cuối" grid:DataGridColumnLayout.Key="LastDebt"
                                      Binding="{Binding LastDebtDateText, Mode=OneWay}" Width="100" />
                  <DataGridTemplateColumn Header="Trạng thái" grid:DataGridColumnLayout.Key="Status" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="{Binding StatusCode, Converter={StaticResource StatusBrush}}">
                          <TextBlock Text="{Binding StatusText, Mode=OneWay}"
                                     Foreground="{DynamicResource OnPrimaryBrush}"
                                     FontSize="{DynamicResource FontSize.Caption}"
                                     FontWeight="SemiBold" />
                        </Border>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Thao tác" grid:DataGridColumnLayout.Key="Actions" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <Button access:PermissionAccess.Rule="DEBT_SETTLEMENT:Add" Content="Thu toàn bộ"
