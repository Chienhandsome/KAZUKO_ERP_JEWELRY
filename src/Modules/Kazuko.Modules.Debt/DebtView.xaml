                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Lệnh SX" grid:DataGridColumnLayout.Key="Order"
                                      Binding="{Binding ProductionOrderCode, Mode=OneWay}" Width="120" />
                  <DataGridTextColumn Header="Ngày ghi" grid:DataGridColumnLayout.Key="CreatedAt"
                                      Binding="{Binding CreatedAtText, Mode=OneWay}" Width="100" />
                  <DataGridTemplateColumn Header="Trạng thái" grid:DataGridColumnLayout.Key="Status" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="{Binding StatusBrushCode, Converter={StaticResource StatusBrush}}">
                          <TextBlock Text="{Binding StatusText, Mode=OneWay}"
                                     Foreground="{DynamicResource OnPrimaryBrush}"
                                     FontSize="{DynamicResource FontSize.Caption}"
                                     FontWeight="SemiBold" />
                        </Border>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Thao tác" grid:DataGridColumnLayout.Key="Actions" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Button access:PermissionAccess.Rule="DEBT_WORKER_GOLD:Edit" Content="Ghi trả vàng"
                                Style="{StaticResource RoundedSuccessButtonStyle}"
                                Visibility="{Binding CanRecordRepayment, Converter={StaticResource BoolToVis}}"
                                Command="{Binding DataContext.RecordRepaymentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                CommandParameter="{Binding}"
                                ToolTip="Ghi nhận thợ trả vàng cho khoản nợ này" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
              <Border Background="{DynamicResource SurfaceBrush}" Opacity="0.85"
                      Visibility="{Binding IsBusyOverlayVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Đang tải..." HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource PrimaryBrush}"
                           FontSize="{DynamicResource FontSize.Subtitle}" FontWeight="SemiBold" />
              </Border>
              <TextBlock Text="Không có dữ liệu nợ vàng thợ."
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Visibility="{Binding IsWorkerGoldDebtEmpty, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <DockPanel Grid.Row="3" Margin="0,8,0,4">
              <TextBlock Text="{Binding ErrorMessage, Mode=OneWay}"
                         Foreground="{DynamicResource DangerBrush}"
                         FontSize="{DynamicResource FontSize.Body}"
                         Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVis}}" />
              <TextBlock Text="{Binding StatusMessage, Mode=OneWay}"
                         HorizontalAlignment="Right"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         FontSize="{DynamicResource FontSize.Caption}" />
            </DockPanel>
          </Grid>
        </TabItem>
      </TabControl>
    </Border>

    <!-- Bottom actions: chỉ dùng cho 2 tab KH/NCC (tab nợ vàng thợ thao tác trên từng dòng) -->
    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0"
                Visibility="{Binding IsWorkerGoldDebtTab, Converter={StaticResource InverseBoolToVis}}">
      <Button access:PermissionAccess.Rule="DEBT_SETTLEMENT:Add" Content="{Binding CollectOrPayButtonText}"
              Style="{StaticResource RoundedPrimaryButtonStyle}"
              Command="{Binding CollectOrPayCommand}"
              MinWidth="120" Margin="0,0,8,0" />
      <Button Content="Xem chi tiết"
              Style="{StaticResource OutlineButtonStyle}"
              Command="{Binding ViewDetailCommand}"
              MinWidth="120" />
      <Button Content="In công nợ"
              Style="{StaticResource DisabledImportButtonStyle}"
              Command="{Binding PrintCommand}"
              IsEnabled="False"
              MinWidth="110" />
      <Button access:PermissionAccess.Rule="DATA_EXPORT" Content="Xuất Excel"
              Style="{StaticResource OutlineButtonStyle}"
              Command="{Binding ExportExcelCommand}"
              CommandParameter="{Binding ElementName=DebtTabControl}"
              MinWidth="110"
              Margin="0" />
    </StackPanel>
  </Grid>
</UserControl>
