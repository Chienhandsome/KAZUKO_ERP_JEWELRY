<Window x:Class="Kazuko.Modules.Debt.DebtPaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="720" Height="560"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource AppBackgroundBrush}">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Hủy" Style="{DynamicResource NavButtonStyle}" Command="{Binding CancelCommand}"
              MinHeight="40" MinWidth="100" Margin="0,0,8,0" IsCancel="True" />
      <Button Content="Xác nhận" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding ConfirmCommand}"
              MinHeight="40" MinWidth="120" IsDefault="True" />
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="{Binding Title}"
                   FontSize="{DynamicResource FontSize.Heading}"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   FontWeight="SemiBold" />
        <TextBlock Text="{Binding PartyLabel}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,4,0,8"
                   TextWrapping="Wrap" />
        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="{DynamicResource DangerBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Foreground="{DynamicResource TextSecondaryBrush}">
            <Run Text="Còn nợ:" />
            <Run Text="{Binding MaxAmount, Mode=OneWay, StringFormat=N0}" />
          </TextBlock>
          <TextBlock Grid.Column="1" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold">
            <Run Text="Tổng thanh toán:" />
            <Run Text="{Binding TotalPayment, Mode=OneWay, StringFormat=N0}" />
          </TextBlock>
          <TextBlock Grid.Column="2" Foreground="{DynamicResource TextSecondaryBrush}">
            <Run Text="Còn lại sau thu/chi:" />
            <Run Text="{Binding RemainingAfterPayment, Mode=OneWay, StringFormat=N0}" />
          </TextBlock>
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Button Content="Thêm dòng" Style="{DynamicResource PrimaryButtonStyle}"
                  Command="{Binding AddLineCommand}" MinHeight="40" MinWidth="110" Margin="0,0,8,0" />
          <Button Content="Xóa dòng" Style="{DynamicResource NavButtonStyle}"
                  Command="{Binding RemoveLineCommand}" MinHeight="40" MinWidth="100" />
        </StackPanel>

        <DataGrid ItemsSource="{Binding Lines}"
                  SelectedItem="{Binding SelectedLine}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  MinHeight="180"
                  MaxHeight="280">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Phương thức" Width="140">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding PaymentMethod, UpdateSourceTrigger=PropertyChanged}"
                            Height="36">
                    <ComboBoxItem Content="Tiền mặt" Tag="CASH" />
                    <ComboBoxItem Content="Chuyển khoản" Tag="BANK_TRANSFER" />
                  </ComboBox>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Số tiền"
                                Binding="{Binding AmountVnd, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                Width="120" />
            <DataGridTemplateColumn Header="Quỹ tiền mặt" Width="180">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ComboBox ItemsSource="{Binding DataContext.Funds, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            SelectedItem="{Binding SelectedFund, UpdateSourceTrigger=PropertyChanged}"
                            DisplayMemberPath="DisplayName"
                            IsEnabled="{Binding IsCash}"
                            Height="36" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Tài khoản NH" Width="200">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ComboBox ItemsSource="{Binding DataContext.Banks, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            SelectedItem="{Binding SelectedBank, UpdateSourceTrigger=PropertyChanged}"
                            DisplayMemberPath="DisplayName"
                            IsEnabled="{Binding IsBankTransfer}"
                            Height="36" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Tham chiếu"
                                Binding="{Binding ReferenceNo, UpdateSourceTrigger=PropertyChanged}"
                                Width="*" />
          </DataGrid.Columns>
        </DataGrid>

        <TextBlock Text="Ghi chú" Margin="0,12,0,4" Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                 Height="64" TextWrapping="Wrap" AcceptsReturn="True" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
