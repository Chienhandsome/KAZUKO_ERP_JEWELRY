<Window x:Class="Kazuko.Modules.Debt.WorkerGoldRepaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:Kazuko.Shared.UI.Behaviors;assembly=Kazuko.Shared.UI"
        Title="Ghi nhận trả vàng"
        Width="440"
        SizeToContent="Height"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}">
  <Window.Resources>
    <Style x:Key="RepayLabelStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="RepayFieldStyle" TargetType="TextBox">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="RepayReadonlyFieldStyle" TargetType="TextBox" BasedOn="{StaticResource RepayFieldStyle}">
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    </Style>
    <Style x:Key="RepayPrimaryButtonStyle" TargetType="Button">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="MinWidth" Value="110" />
      <Setter Property="Padding" Value="16,6" />
      <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="RepayOutlineButtonStyle" TargetType="Button">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="MinWidth" Value="100" />
      <Setter Property="Padding" Value="16,6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </Window.Resources>

  <StackPanel Margin="20">
    <TextBlock Text="Ghi nhận trả vàng"
               FontSize="{DynamicResource FontSize.Heading}"
               Foreground="{DynamicResource PrimaryBrush}"
               FontWeight="Bold" />
    <TextBlock Text="Thợ trả lại vàng còn thiếu — số vàng trả được cộng dồn vào khoản nợ."
               Foreground="{DynamicResource TextSecondaryBrush}"
               FontSize="{DynamicResource FontSize.Body}"
               TextWrapping="Wrap"
               Margin="0,4,0,12" />

    <TextBlock Text="Thợ" Style="{StaticResource RepayLabelStyle}" />
    <TextBox x:Name="WorkerNameBox" Style="{StaticResource RepayReadonlyFieldStyle}" IsTabStop="False" />

    <Grid Margin="0,0,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Text="Loại vàng" Style="{StaticResource RepayLabelStyle}" />
        <TextBox x:Name="PurityBox" Style="{StaticResource RepayReadonlyFieldStyle}" IsTabStop="False" />
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="Còn nợ (chỉ)" Style="{StaticResource RepayLabelStyle}" />
        <TextBox x:Name="RemainingBox" Style="{StaticResource RepayReadonlyFieldStyle}"
                 IsTabStop="False" FontWeight="Bold"
                 Foreground="{DynamicResource SuccessBrush}" />
      </StackPanel>
    </Grid>

    <TextBlock Text="Số chỉ trả *" Style="{StaticResource RepayLabelStyle}" />
    <TextBox x:Name="AmountBox" Style="{StaticResource RepayFieldStyle}"
             behaviors:NumericThousandSeparatorBehavior.EnableLiveThousandSeparator="True"
             behaviors:NumericThousandSeparatorBehavior.AllowDecimal="True" />

    <TextBlock Text="Ngày trả" Style="{StaticResource RepayLabelStyle}" />
    <DatePicker x:Name="PaidDatePicker" Margin="0,0,0,10"
                VerticalContentAlignment="Center" />

    <TextBlock Text="Ghi chú" Style="{StaticResource RepayLabelStyle}" />
    <TextBox x:Name="NotesBox" Style="{StaticResource RepayFieldStyle}"
             MinHeight="56" TextWrapping="Wrap" AcceptsReturn="True"
             VerticalContentAlignment="Top" Padding="10,8" />

    <TextBlock x:Name="ErrorText"
               Foreground="{DynamicResource DangerBrush}"
               FontSize="{DynamicResource FontSize.Body}"
               TextWrapping="Wrap"
               Margin="0,0,0,8"
               Visibility="Collapsed" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="Hủy" Style="{StaticResource RepayOutlineButtonStyle}"
              Margin="0,0,8,0" IsCancel="True" Click="OnCancelClick" />
      <Button Content="Lưu" Style="{StaticResource RepayPrimaryButtonStyle}"
              IsDefault="True" Click="OnSaveClick" />
    </StackPanel>
  </StackPanel>
</Window>
