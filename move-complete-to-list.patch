+++ b/src/Modules/Kazuko.Modules.Production/ProductionView.xaml
@@ -159,6 +159,18 @@
                                         Binding="{Binding WorkerDisplayName, Mode=OneWay}" Width="150" />
                     <DataGridTextColumn Header="Trạng thái" grid:DataGridColumnLayout.Key="Status"
                                         Binding="{Binding StatusDisplay, Mode=OneWay}" Width="100" />
