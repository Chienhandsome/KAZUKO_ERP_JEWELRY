--- /dev/null
+++ b/database/migrations/0075__worker_gold_debt_payments.sql
@@ -0,0 +1,114 @@
+/*
+================================================================================
+KAZUKO ERP JEWELRY - DATABASE MIGRATION SCRIPT
+================================================================================
+Migration Version: 75
+Migration Name:    WORKER_GOLD_DEBT_PAYMENTS
+Description:       Track worker gold repayments (thợ trả vàng thiếu sau khi ghi
+                   công nợ ở nhập kho thành phẩm):
+                   - Add WEIGHT_PAID_CHI to WORKER_GOLD_DEBTS (total repaid weight,
+                     non-negative and never exceeding the debt weight).
+                   - Create WORKER_GOLD_DEBT_PAYMENTS history table: one row per
+                     repayment recorded from the Debt module ("Nợ vàng thợ" tab).
+Target Database:   Firebird 5.0 (Dialect 3, UTF8)
+================================================================================
+Rollback (dev):
+  DROP TABLE WORKER_GOLD_DEBT_PAYMENTS;
+  ALTER TABLE WORKER_GOLD_DEBTS DROP CONSTRAINT CK_WGD_PAID_NONNEG;
+  ALTER TABLE WORKER_GOLD_DEBTS DROP CONSTRAINT CK_WGD_PAID_LE_DEBT;
+  ALTER TABLE WORKER_GOLD_DEBTS DROP WEIGHT_PAID_CHI;
+  DELETE FROM SCHEMA_MIGRATIONS WHERE VERSION_NO = 75;
+================================================================================
+*/
+
+SET AUTODDL OFF;
+
+CREATE EXCEPTION EX_MIGRATION_CHECK 'Migration 75 validation failed';
+
+SET TERM ^ ;
+EXECUTE BLOCK AS
+DECLARE VARIABLE v_cnt INTEGER;
+BEGIN
+    SELECT COUNT(*) FROM SCHEMA_MIGRATIONS WHERE VERSION_NO = 75 INTO :v_cnt;
+    IF (:v_cnt > 0) THEN
+        EXCEPTION EX_MIGRATION_CHECK 'Phien ban migration 75 da ton tai.';
+
+    SELECT COUNT(*) FROM SCHEMA_MIGRATIONS WHERE VERSION_NO = 74 INTO :v_cnt;
+    IF (:v_cnt <> 1) THEN
+        EXCEPTION EX_MIGRATION_CHECK 'Can migration 74 truoc migration 75.';
+
+    SELECT COUNT(*) FROM RDB$RELATIONS
+    WHERE RDB$RELATION_NAME = 'WORKER_GOLD_DEBTS'
+    INTO :v_cnt;
+    IF (:v_cnt <> 1) THEN
+        EXCEPTION EX_MIGRATION_CHECK 'Thieu bang WORKER_GOLD_DEBTS.';
+
+    SELECT COUNT(*) FROM RDB$RELATION_FIELDS
+    WHERE RDB$RELATION_NAME = 'WORKER_GOLD_DEBTS'
+      AND RDB$FIELD_NAME = 'WEIGHT_PAID_CHI'
+    INTO :v_cnt;
+    IF (:v_cnt > 0) THEN
+        EXCEPTION EX_MIGRATION_CHECK 'Cot WEIGHT_PAID_CHI da ton tai.';
+
+    SELECT COUNT(*) FROM RDB$RELATIONS
+    WHERE RDB$RELATION_NAME = 'WORKER_GOLD_DEBT_PAYMENTS'
+    INTO :v_cnt;
+    IF (:v_cnt > 0) THEN
+        EXCEPTION EX_MIGRATION_CHECK 'Bang WORKER_GOLD_DEBT_PAYMENTS da ton tai.';
+END^
+SET TERM ; ^
+
+ALTER TABLE WORKER_GOLD_DEBTS ADD WEIGHT_PAID_CHI NUMERIC(18,3) DEFAULT 0 NOT NULL;
+
+ALTER TABLE WORKER_GOLD_DEBTS ADD CONSTRAINT CK_WGD_PAID_NONNEG
+    CHECK (WEIGHT_PAID_CHI >= 0);
+
+ALTER TABLE WORKER_GOLD_DEBTS ADD CONSTRAINT CK_WGD_PAID_LE_DEBT
+    CHECK (WEIGHT_PAID_CHI <= WEIGHT_CHI);
+
+CREATE TABLE WORKER_GOLD_DEBT_PAYMENTS (
+    ID BIGINT GENERATED BY DEFAULT AS IDENTITY NOT NULL,
+    COMPANY_ID BIGINT NOT NULL,
+    BRANCH_ID BIGINT NOT NULL,
+    DEBT_ID BIGINT NOT NULL,
+    WEIGHT_PAID_CHI NUMERIC(18,3) NOT NULL,
+    PAID_DATE DATE NOT NULL,
+    NOTES VARCHAR(500),
+    CREATED_BY BIGINT,
+    CREATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,
+    CONSTRAINT PK_WORKER_GOLD_DEBT_PAYMENTS PRIMARY KEY (ID),
+    CONSTRAINT FK_WGDP_COMPANY FOREIGN KEY (COMPANY_ID) REFERENCES COMPANIES (ID),
+    CONSTRAINT FK_WGDP_BRANCH FOREIGN KEY (BRANCH_ID) REFERENCES BRANCHES (ID),
+    CONSTRAINT FK_WGDP_DEBT FOREIGN KEY (DEBT_ID) REFERENCES WORKER_GOLD_DEBTS (ID),
+    CONSTRAINT CK_WGDP_WEIGHT_POSITIVE CHECK (WEIGHT_PAID_CHI > 0)
+);
+
+CREATE INDEX IX_WGDP_DEBT ON WORKER_GOLD_DEBT_PAYMENTS (COMPANY_ID, DEBT_ID);
+
+SET TERM ^ ;
+EXECUTE BLOCK AS
+DECLARE VARIABLE v_cnt INTEGER;
+BEGIN
+    SELECT COUNT(*) FROM RDB$RELATION_FIELDS
+    WHERE RDB$RELATION_NAME = 'WORKER_GOLD_DEBTS'
+      AND RDB$FIELD_NAME = 'WEIGHT_PAID_CHI'
+    INTO :v_cnt;
+    IF (:v_cnt <> 1) THEN
+        EXCEPTION EX_MIGRATION_CHECK 'Khong them duoc cot WEIGHT_PAID_CHI.';
+
+    SELECT COUNT(*) FROM RDB$RELATIONS
+    WHERE RDB$RELATION_NAME = 'WORKER_GOLD_DEBT_PAYMENTS'
+    INTO :v_cnt;
+    IF (:v_cnt <> 1) THEN
+        EXCEPTION EX_MIGRATION_CHECK 'Khong tao duoc bang WORKER_GOLD_DEBT_PAYMENTS.';
+
+    SELECT COUNT(*) FROM RDB$RELATION_CONSTRAINTS
+    WHERE RDB$RELATION_NAME = 'WORKER_GOLD_DEBTS'
+      AND RDB$CONSTRAINT_NAME IN ('CK_WGD_PAID_NONNEG', 'CK_WGD_PAID_LE_DEBT')
+    INTO :v_cnt;
+    IF (:v_cnt <> 2) THEN
+        EXCEPTION EX_MIGRATION_CHECK 'Thieu check constraint tren WEIGHT_PAID_CHI.';
+END^
+SET TERM ; ^
+
+DROP EXCEPTION EX_MIGRATION_CHECK;
